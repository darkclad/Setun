// Benchmark: the Setun-387 through math.tri; exits with a checksum.

import "math.tri";

fn main() -> int {
    var s: real = 0.0;
    var i: int = 1;
    while (i <= 400) {
        var x: real = i / 37.0;
        s = s + sin(x) * cos(x) + ln(x) + exp(-x) + sqrt(x) + atan(x);
        i += 1;
    }
    var k: int = 0;
    var p: real = 1.0;
    while (k < 20000) { p = p * 1.0001 + 1.0 / (k + 1); k += 1; }
    return (s + p) as int;
}
