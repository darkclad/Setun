// The integer core of int.tri (a sieve and an insertion sort), for the
// comparison with the same code compiled natively (setun-bench --vs-native).

import "rt.tri";

var sieve: [20000]tryte;
var nums: [1500]int;

fn primes(n: int) -> int {
    var i: int = 2;
    while (i < n) { sieve[i] = 1; i += 1; }
    var count: int = 0;
    i = 2;
    while (i < n) {
        if (sieve[i] != 0) {
            count += 1;
            var j: int = i * i;
            while (j < n) { sieve[j] = 0; j += i; }
        }
        i += 1;
    }
    return count;
}

fn sort_check() -> int {
    var seed: int = 12345;
    var i: int = 0;
    while (i < 1500) { seed = modr(seed * 1103 + 12345, 1000003); nums[i] = seed; i += 1; }
    i = 1;
    while (i < 1500) {
        var v: int = nums[i];
        var j: int = i - 1;
        while (j >= 0 && nums[j] > v) { nums[j + 1] = nums[j]; j -= 1; }
        nums[j + 1] = v;
        i += 1;
    }
    var bad: int = 0;
    i = 1;
    while (i < 1500) { if (nums[i - 1] > nums[i]) { bad += 1; } i += 1; }
    return bad;
}

fn main() -> int {
    var p: int = primes(20000);
    var s: int = sort_check();
    return modr(p * 1000 + s + nums[750] % 1000, 9841);
}
