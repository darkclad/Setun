// Runtime: memory and string routines.

fn memset(p: *tryte, value: tryte, n: int) {
    var i: int = 0;
    while (i < n) { p[i] = value; i += 1; }
}

fn memcpy(dst: *tryte, src: *tryte, n: int) {
    var i: int = 0;
    while (i < n) { dst[i] = src[i]; i += 1; }
}

fn strlen(s: *char) -> int {
    var n: int = 0;
    while (s[n] != 0) { n += 1; }
    return n;
}

// Three-way string comparison: -1, 0 or +1.
fn strcmp(a: *char, b: *char) -> trit {
    var i: int = 0;
    loop {
        var c: trit = a[i] <=> b[i];
        if (c != 0 || a[i] == 0) { return c; }
        i += 1;
    }
}

// Decimal text of `v` into `buf` (at least 15 trytes); returns `buf`.
fn itoa(v: int, buf: *char) -> *char {
    var tmp: [15]char;
    var n: int = 0;
    var neg: int = v < 0;
    if (neg) { v = -v; }
    loop {
        tmp[n] = ('0' + v % 10) as char;
        n += 1;
        v = v / 10;
        if (v == 0) { break; }
    }
    var j: int = 0;
    if (neg) { buf[0] = '-'; j = 1; }
    while (n > 0) { n -= 1; buf[j] = tmp[n]; j += 1; }
    buf[j] = 0;
    return buf;
}

// One balanced base-27 digit, -13..13, as a character: 0-9 and A-D for
// 0..13, and for a negative digit the overlined one, which the machine's
// character set writes as the negated code point (overlined 5 is -'5').
fn b27_digit(d: int) -> char {
    var a: int = d < 0 ? -d : d;
    var c: int = a <= 9 ? '0' + a : 'A' + a - 10;
    return (d < 0 ? -c : c) as char;
}

// Base-27 text of a word `v`: 9 digits (see b27_digit).
fn itoa27(v: int, buf: *char) -> *char {
    var i: int = 8;
    while (i >= 0) {
        var d: int = modr(v, 27);
        v = divr(v, 27);
        buf[i] = b27_digit(d);
        i -= 1;
    }
    buf[9] = 0;
    return buf;
}

// Base-3 text of the low `n` trits of `v` (n <= 27; buf holds n + 1):
// 1, 0 and an overlined 1 (the code point -'1').
fn itoa3(v: int, n: int, buf: *char) -> *char {
    var i: int = n - 1;
    while (i >= 0) {
        var t: int = modr(v, 3);
        v = divr(v, 3);
        buf[i] = (t > 0 ? '1' : (t < 0 ? -'1' : '0')) as char;
        i -= 1;
    }
    buf[n] = 0;
    return buf;
}
