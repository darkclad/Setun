// Runtime: memory and string routines.
//
// memset and memcpy go a word (three trytes) at a time where they can: a
// word is the trytes p-1, p, p+1 around its address p, so trytes q..q+2
// are one word when (q + 1) % 3 == 0, and a copy can use words when its
// two ends sit alike in their words, from 18 trytes on. (strlen and strcmp stay tryte by
// tryte: finding a zero tryte in a word costs as much as loading them.)

fn memset(p: *tryte, value: tryte, n: int) {
    var i: int = 0;
    if (n < 18) { while (i < n) { p[i] = value; i += 1; } return; }   // short: words do not pay
    while (i < n && ((p as int) + i + 1) % 3 != 0) { p[i] = value; i += 1; }
    var w: int = (n - i) / 3;
    var pw: *int = ((p as int) + i + 1) as *int;
    var v: int = value * 387440173;                     // the tryte three times: 3^18 + 3^9 + 1
    var k: int = 0;
    while (k + 3 <= w) { pw[k] = v; pw[k + 1] = v; pw[k + 2] = v; k += 3; }
    while (k < w) { pw[k] = v; k += 1; }
    if (w > 0) { i += 3 * w; }
    while (i < n) { p[i] = value; i += 1; }
}

fn memcpy(dst: *tryte, src: *tryte, n: int) {
    var i: int = 0;
    if (n >= 18 && ((dst as int) - (src as int)) % 3 == 0) {       // short ones: words do not pay
        while (i < n && ((dst as int) + i + 1) % 3 != 0) { dst[i] = src[i]; i += 1; }
        var w: int = (n - i) / 3;
        var dw: *int = ((dst as int) + i + 1) as *int;
        var sw: *int = ((src as int) + i + 1) as *int;
        var k: int = 0;
        while (k + 3 <= w) { dw[k] = sw[k]; dw[k + 1] = sw[k + 1]; dw[k + 2] = sw[k + 2]; k += 3; }
        while (k < w) { dw[k] = sw[k]; k += 1; }
        if (w > 0) { i += 3 * w; }
    }
    while (i < n) { dst[i] = src[i]; i += 1; }
}

fn strlen(s: *char) -> int {
    var n: int = 0;
    while (s[n] != 0) { n += 1; }
    return n;
}

// Three-way string comparison: -1, 0 or +1.
fn strcmp(a: *char, b: *char) -> trit {
    var i: int = 0;
    loop {
        var c: trit = a[i] <=> b[i];
        if (c != 0 || a[i] == 0) { return c; }
        i += 1;
    }
}

// Decimal text of `v` into `buf` (at least 15 trytes); returns `buf`.
fn itoa(v: int, buf: *char) -> *char {
    var tmp: [15]char;
    var n: int = 0;
    var neg: int = v < 0;
    if (neg) { v = -v; }
    loop {
        tmp[n] = ('0' + v % 10) as char;
        n += 1;
        v = v / 10;
        if (v == 0) { break; }
    }
    var j: int = 0;
    if (neg) { buf[0] = '-'; j = 1; }
    while (n > 0) { n -= 1; buf[j] = tmp[n]; j += 1; }
    buf[j] = 0;
    return buf;
}

// One balanced base-27 digit, -13..13, as a character: 0-9 and A-D for
// 0..13, and for a negative digit the overlined one, which the machine's
// character set writes as the negated code point (overlined 5 is -'5').
fn b27_digit(d: int) -> char {
    var a: int = d < 0 ? -d : d;
    var c: int = a <= 9 ? '0' + a : 'A' + a - 10;
    return (d < 0 ? -c : c) as char;
}

// Base-27 text of a word `v`: 9 digits (see b27_digit).
fn itoa27(v: int, buf: *char) -> *char {
    var i: int = 8;
    while (i >= 0) {
        var d: int = modr(v, 27);
        v = divr(v, 27);
        buf[i] = b27_digit(d);
        i -= 1;
    }
    buf[9] = 0;
    return buf;
}

// Base-3 text of the low `n` trits of `v` (n <= 27; buf holds n + 1):
// 1, 0 and an overlined 1 (the code point -'1').
fn itoa3(v: int, n: int, buf: *char) -> *char {
    var i: int = n - 1;
    while (i >= 0) {
        var t: int = modr(v, 3);
        v = divr(v, 3);
        buf[i] = (t > 0 ? '1' : (t < 0 ? -'1' : '0')) as char;
        i -= 1;
    }
    buf[n] = 0;
    return buf;
}
