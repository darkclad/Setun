// Console output: the serial port and the text screen (80x30 to start
// with; screen_text_mode picks another size).

import "ports.tri";
import "rt.tri";

// ---- serial ----------------------------------------------------------------

fn putc(c: char) {
    while (in(SERIAL_TX_READY) <= 0) {}
    out(SERIAL_DATA, c);
}

fn puts(s: *char) {
    while (*s != 0) { putc(*s); s = s + 1; }
}

fn put_int(v: int) {
    var buf: [15]char;
    puts(itoa(v, &buf[0]));
}

// Next character from the serial console, or 0 if none is waiting.
fn getc() -> char {
    if (in(SERIAL_RX_COUNT) > 0) { return in(SERIAL_DATA) as char; }
    return 0;
}

// ---- text screen -------------------------------------------------------------

// The text mode in use and its cells.
var con_mode: int = -1;
var con_cols: int = 80;
var con_rows: int = 30;

// Attribute tryte: foreground R G B, background R G B, style (one trit each).
fn attr(fr: trit, fg: trit, fb: trit, br: trit, bg: trit, bb: trit) -> tryte {
    return (fr * 2187 + fg * 729 + fb * 243 + br * 81 + bg * 27 + bb * 9) as tryte;
}

var screen_row: int = 0;
var screen_col: int = 0;
var screen_attr: tryte = 0t111TTT000;     // white on black

fn cell(i: int) -> *tryte { return (FB_BASE + 3 * i) as *tryte; }

fn screen_clear() {
    out(DISPLAY_MODE, con_mode);
    var i: int = 0;
    while (i < con_cols * con_rows) {
        var c: *tryte = cell(i);
        c[0] = ' ';
        c[1] = screen_attr;
        i += 1;
    }
    screen_row = 0;
    screen_col = 0;
    out(DISPLAY_CURSOR, 0);
}

// Text mode m (-1 .. -7): the screen of graphics mode -m-1 in 8x16 cells.
// The display reports the cells; the screen starts empty.
fn screen_text_mode(m: int) {
    con_mode = m;
    out(DISPLAY_MODE, m);
    con_cols = in(DISPLAY_WIDTH);
    con_rows = in(DISPLAY_HEIGHT);
    screen_clear();
}

fn screen_scroll() {
    var i: int = 0;
    while (i < con_cols * (con_rows - 1)) {
        var d: *tryte = cell(i);
        var s: *tryte = cell(i + con_cols);
        d[0] = s[0];
        d[1] = s[1];
        i += 1;
    }
    while (i < con_cols * con_rows) {
        var c: *tryte = cell(i);
        c[0] = ' ';
        c[1] = screen_attr;
        i += 1;
    }
}

fn screen_putc(c: char) {
    if (c == '\n') {
        screen_col = 0;
        screen_row += 1;
    } else {
        var p: *tryte = cell(screen_row * con_cols + screen_col);
        p[0] = c;
        p[1] = screen_attr;
        screen_col += 1;
        if (screen_col == con_cols) { screen_col = 0; screen_row += 1; }
    }
    if (screen_row == con_rows) { screen_scroll(); screen_row = con_rows - 1; }
    out(DISPLAY_CURSOR, screen_row * con_cols + screen_col);
}

fn screen_puts(s: *char) {
    while (*s != 0) { screen_putc(*s); s = s + 1; }
}

// Print to both the serial console and the screen.
fn print(s: *char) {
    puts(s);
    screen_puts(s);
}

fn print_int(v: int) {
    var buf: [15]char;
    print(itoa(v, &buf[0]));
}
