// math.tri: elementary functions on the FPU's `real`, from its +-*/
// and sqrt. Accurate to about 30 significant digits for ordinary arguments.
//
//   exp(x)  ln(x)  log3(x)  log10(x)  pow(x, y)
//   sin(x)  cos(x)  tan(x)  asin(x)  acos(x)  atan(x)  atan2(y, x)
//   sinh(x)  cosh(x)  tanh(x)  hypot(x, y)
//   pi()  e()
//
// The machine counts in threes, so the reductions do too: every real is
// m·3^E with 1/6 < |m| <= 1/2 (exponent3), and scale3 multiplies by powers
// of 3 exactly. log3 of a power of 3 is exact.
//
// Special values follow C: ln(0) = -inf (DZ), ln(-1) = NaN (IV), exp of a
// large argument overflows to inf (OF), and a NaN goes through unchanged.

import "real.tri";

fn pi() -> real { return fconst(2); }
fn e() -> real { return fconst(3); }

fn _math_nan() -> real { var z: real = 0.0; return z / z; }   // raises IV
fn _math_inf() -> real { var z: real = 0.0; return 1.0 / z; } // raises DZ

fn _math_isnan(x: real) -> int { return x != x; }
fn _fabs(x: real) -> real { return x < 0 ? -x : x; }   // tlibc has an int abs

// exp: x = k·ln3 + r with |r| <= ln3/2, then a Taylor series for e^r.
fn exp(x: real) -> real {
    var c: int = fclass(x);
    if (c == 4) { return x; }
    if (c == 3) { return x; }
    if (c == -3) { return 0.0; }
    if (c == 0) { return 1.0; }
    if (x > 22400.0) { return scale3(1.0, 30000); }     // beyond 3^9841: overflows (OF)
    if (x < -22400.0) { return scale3(1.0, -30000); }   // underflows to 0 (UF)
    var k: int = (x * fconst(5)) as int;                 // x·log3(e), to nearest
    var r: real = x - k * fconst(4);
    var s: real = 1.0;
    var term: real = 1.0;
    var n: int = 1;
    loop {
        term = term * r / n;
        var t: real = s + term;
        if (t == s) { break; }
        s = t;
        n += 1;
    }
    return scale3(s, k);
}

// ln: x = m·3^E with m moved into (1/2, 3/2], then ln m = 2·atanh(t),
// t = (m-1)/(m+1), |t| <= 1/5.
fn _ln_mant(x: real, e3: *int) -> real {
    var e: int = exponent3(x) - 1;
    var m: real = scale3(x, -e);                         // in (1/2, 3/2]
    *e3 = e;
    var t: real = (m - 1) / (m + 1);
    var t2: real = t * t;
    var s: real = t;
    var p: real = t;
    var n: int = 3;
    loop {
        p = p * t2;
        var u: real = s + p / n;
        if (u == s) { break; }
        s = u;
        n += 2;
    }
    return 2 * s;
}

fn ln(x: real) -> real {
    var c: int = fclass(x);
    if (c == 4) { return x; }
    if (c == 0) { return -_math_inf(); }
    if (x < 0) { return _math_nan(); }
    if (c == 3) { return x; }
    var e: int = 0;
    var lm: real = _ln_mant(x, &e);
    return e * fconst(4) + lm;
}

fn log3(x: real) -> real {
    var c: int = fclass(x);
    if (c == 4) { return x; }
    if (c == 0) { return -_math_inf(); }
    if (x < 0) { return _math_nan(); }
    if (c == 3) { return x; }
    var e: int = 0;
    var lm: real = _ln_mant(x, &e);
    return e + lm * fconst(5);                           // exact when m = 1
}

fn log10(x: real) -> real {
    var r: real = log3(x);
    if (_math_isnan(r) || fclass(r) == 3 || fclass(r) == -3) { return r; }
    var y: real = r / fconst(6);
    var n: real = round(y);
    if (_fabs(n) <= 33 && pow10(n as int) == x) { return n; }   // exact for powers of 10
    return y;
}

fn _is_int(y: real) -> int { return trunc(y) == y; }

fn _ipow(x: real, n: int) -> real {
    var r: real = 1.0;
    var b: real = x;
    var k: int = n < 0 ? -n : n;
    while (k > 0) {
        if (k % 2 == 1) { r = r * b; }
        k = k / 2;
        if (k > 0) { b = b * b; }
    }
    return n < 0 ? 1.0 / r : r;
}

fn pow(x: real, y: real) -> real {
    if (y == 0.0) { return 1.0; }                        // even for a NaN x, as in C
    if (_math_isnan(x) || _math_isnan(y)) { return x + y; }
    if (_is_int(y) && _fabs(y) < 1000000.0) { return _ipow(x, y as int); }
    if (x == 0.0) { return y > 0 ? 0.0 : _math_inf(); }
    if (x < 0) {
        if (!_is_int(y)) { return _math_nan(); }
        var odd: int = rem(y, 2) != 0.0;
        var a: real = exp(y * ln(-x));
        return odd ? -a : a;
    }
    return exp(y * ln(x));
}

// sin and cos: x = k·π/2 + r with |r| <= π/4, then a series for the
// quadrant's function.
fn _sin_series(r: real) -> real {
    var r2: real = r * r;
    var s: real = r;
    var term: real = r;
    var n: int = 1;
    loop {
        term = -term * r2 / ((n + 1) * (n + 2));
        var t: real = s + term;
        if (t == s) { break; }
        s = t;
        n += 2;
    }
    return s;
}

fn _cos_series(r: real) -> real {
    var r2: real = r * r;
    var s: real = 1.0;
    var term: real = 1.0;
    var n: int = 0;
    loop {
        term = -term * r2 / ((n + 1) * (n + 2));
        var t: real = s + term;
        if (t == s) { break; }
        s = t;
        n += 2;
    }
    return s;
}

// The quadrant k (mod 4) and the remainder r; NaN for an infinite x.
fn _reduce(x: real, k: *int) -> real {
    var half_pi: real = fconst(2) / 2;
    var q: real = round(x / half_pi);
    *k = rem(q, 4) as int;
    return x - q * half_pi;
}

fn sin(x: real) -> real {
    var c: int = fclass(x);
    if (c == 4 || c == 0) { return x; }
    if (c == 3 || c == -3) { return _math_nan(); }
    var k: int = 0;
    var r: real = _reduce(x, &k);
    if (k < 0) { k += 4; }
    switch (k) {
        case 0: return _sin_series(r);
        case 1: return _cos_series(r);
        case 2: return -_sin_series(r);
    }
    return -_cos_series(r);
}

fn cos(x: real) -> real {
    var c: int = fclass(x);
    if (c == 4) { return x; }
    if (c == 3 || c == -3) { return _math_nan(); }
    var k: int = 0;
    var r: real = _reduce(x, &k);
    if (k < 0) { k += 4; }
    switch (k) {
        case 0: return _cos_series(r);
        case 1: return -_sin_series(r);
        case 2: return -_cos_series(r);
    }
    return _sin_series(r);
}

fn tan(x: real) -> real { return sin(x) / cos(x); }

// atan: fold into |x| <= 1, halve the angle twice (x / (1 + sqrt(1 + x²))),
// then the series.
fn atan(x: real) -> real {
    var c: int = fclass(x);
    if (c == 4 || c == 0) { return x; }
    if (c == 3) { return fconst(2) / 2; }
    if (c == -3) { return -fconst(2) / 2; }
    var neg: int = x < 0;
    var a: real = _fabs(x);
    var inv: int = a > 1;
    if (inv) { a = 1.0 / a; }
    a = a / (1 + sqrt(1 + a * a));
    a = a / (1 + sqrt(1 + a * a));
    var a2: real = a * a;
    var s: real = a;
    var p: real = a;
    var n: int = 3;
    loop {
        p = -p * a2;
        var t: real = s + p / n;
        if (t == s) { break; }
        s = t;
        n += 2;
    }
    s = 4 * s;
    if (inv) { s = fconst(2) / 2 - s; }
    return neg ? -s : s;
}

fn _math_isinf(x: real) -> int { return fclass(x) == 3 || fclass(x) == -3; }

fn atan2(y: real, x: real) -> real {
    if (_math_isnan(x) || _math_isnan(y)) { return x + y; }
    var p: real = fconst(2);
    var a: real = 0.0;
    if (_math_isinf(y)) {
        a = !_math_isinf(x) ? p / 2 : x > 0 ? p / 4 : 3 * p / 4;
        return y < 0 ? -a : a;
    }
    if (_math_isinf(x)) {
        if (x > 0) { return 0.0; }
        return y < 0 ? -p : p;
    }
    if (x == 0.0) {
        if (y == 0.0) { return 0.0; }
        return y > 0 ? p / 2 : -p / 2;
    }
    a = atan(y / x);
    if (x > 0) { return a; }
    return y < 0 ? a - p : a + p;
}

fn asin(x: real) -> real {
    if (_fabs(x) > 1) { return _math_nan(); }
    return atan2(x, sqrt((1 - x) * (1 + x)));
}

fn acos(x: real) -> real {
    if (_fabs(x) > 1) { return _math_nan(); }
    return atan2(sqrt((1 - x) * (1 + x)), x);
}

fn sinh(x: real) -> real {
    if (_fabs(x) < 0.001) {                                // no cancellation near 0
        var x2: real = x * x;
        return x * (1 + x2 / 6 * (1 + x2 / 20 * (1 + x2 / 42 * (1 + x2 / 72))));
    }
    var t: real = exp(x);
    return (t - 1 / t) / 2;
}

fn cosh(x: real) -> real {
    var t: real = exp(x);
    return (t + 1 / t) / 2;
}

fn tanh(x: real) -> real {
    if (x > 40.0) { return 1.0; }
    if (x < -40.0) { return -1.0; }
    if (_fabs(x) < 0.001) { return sinh(x) / cosh(x); }
    var t: real = exp(2 * x);
    return (t - 1) / (t + 1);
}

fn hypot(x: real, y: real) -> real {
    if (fclass(x) == 3 || fclass(x) == -3) { return _fabs(x); }   // even with a NaN, as in C
    if (fclass(y) == 3 || fclass(y) == -3) { return _fabs(y); }
    return sqrt(x * x + y * y);                          // the exponent range is too wide to overflow
}
