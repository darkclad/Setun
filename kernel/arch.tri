// arch: the trap entry stub, context switching and the kernel page tables.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "sched.tri";
import "vm.tri";
import "fpu.tri";
import "drivers/tty.tri";
import "drivers/input.tri";
import "drivers/tnic.tri";

// ---- trap frame ---------------------------------------------------------------
//
// trap_stub saves every register on the current kernel stack, as words at
// frame + 3*i:   0..11 = r1..r12   12..24 = r-1..r-13   25 = EPC
//                26 = EMODE        27 = KSP (the other stack pointer)
// When a trap comes from user mode the CPU has already swapped r13 and KSP,
// so r13 is the task's kernel stack and KSP holds the user stack pointer.

const FRAME_WORDS: int = 28;
const F_R1: int = 0;
const F_LR: int = 11;                 // r12
const F_EPC: int = 25;
const F_EMODE: int = 26;
const F_KSP: int = 27;

extern fn trap_stub();
extern fn trap_return();
extern fn switch_to(prev: *Task, next: *Task);

// The assembly lives inside a function that is never called; the code
// jumps over it.
fn _arch_asm() {
    asm {
        "        b     _arch_asm_end"
        "trap_stub:"
        "        sub   sp, sp, 84"
        "        stw   r1, [sp]"
        "        stw   r2, [sp+3]"
        "        stw   r3, [sp+6]"
        "        stw   r4, [sp+9]"
        "        stw   r5, [sp+12]"
        "        stw   r6, [sp+15]"
        "        stw   r7, [sp+18]"
        "        stw   r8, [sp+21]"
        "        stw   r9, [sp+24]"
        "        stw   r10, [sp+27]"
        "        stw   r11, [sp+30]"
        "        stw   r12, [sp+33]"
        "        stw   r-1, [sp+36]"
        "        stw   r-2, [sp+39]"
        "        stw   r-3, [sp+42]"
        "        stw   r-4, [sp+45]"
        "        stw   r-5, [sp+48]"
        "        stw   r-6, [sp+51]"
        "        stw   r-7, [sp+54]"
        "        stw   r-8, [sp+57]"
        "        stw   r-9, [sp+60]"
        "        stw   r-10, [sp+63]"
        "        stw   r-11, [sp+66]"
        "        stw   r-12, [sp+69]"
        "        stw   r-13, [sp+72]"
        "        mfc   r1, epc"
        "        stw   r1, [sp+75]"
        "        mfc   r1, emode"
        "        stw   r1, [sp+78]"
        "        mfc   r1, ksp"
        "        stw   r1, [sp+81]"
        "        mov   r1, sp"
        "        call  trap_handler"
        "trap_return:"
        "        mov   r1, sp"
        "        call  fpu_fixup"
        "        ldw   r1, [sp+81]"
        "        mtc   ksp, r1"
        "        ldw   r1, [sp+78]"
        "        mtc   emode, r1"
        "        ldw   r1, [sp+75]"
        "        mtc   epc, r1"
        "        ldw   r2, [sp+3]"
        "        ldw   r3, [sp+6]"
        "        ldw   r4, [sp+9]"
        "        ldw   r5, [sp+12]"
        "        ldw   r6, [sp+15]"
        "        ldw   r7, [sp+18]"
        "        ldw   r8, [sp+21]"
        "        ldw   r9, [sp+24]"
        "        ldw   r10, [sp+27]"
        "        ldw   r11, [sp+30]"
        "        ldw   r12, [sp+33]"
        "        ldw   r-1, [sp+36]"
        "        ldw   r-2, [sp+39]"
        "        ldw   r-3, [sp+42]"
        "        ldw   r-4, [sp+45]"
        "        ldw   r-5, [sp+48]"
        "        ldw   r-6, [sp+51]"
        "        ldw   r-7, [sp+54]"
        "        ldw   r-8, [sp+57]"
        "        ldw   r-9, [sp+60]"
        "        ldw   r-10, [sp+63]"
        "        ldw   r-11, [sp+66]"
        "        ldw   r-12, [sp+69]"
        "        ldw   r-13, [sp+72]"
        "        ldw   r1, [sp]"
        "        add   sp, sp, 84"
        "        iret"
        // switch_to(prev, next): save prev's kernel stack, resume next's.
        // A Task's first field is its saved kernel sp. The callee-saved
        // registers r-1..r-9 (compiled code keeps locals there) go with
        // the stack: prepare_stack builds the same frame for a new task.
        "switch_to:"
        "        push  lr"
        "        push  fp"
        "        sub   sp, sp, 27"
        "        stw   r-1, [sp+24]"
        "        stw   r-2, [sp+21]"
        "        stw   r-3, [sp+18]"
        "        stw   r-4, [sp+15]"
        "        stw   r-5, [sp+12]"
        "        stw   r-6, [sp+9]"
        "        stw   r-7, [sp+6]"
        "        stw   r-8, [sp+3]"
        "        stw   r-9, [sp]"
        "        stw   sp, [r1]"
        "        ldw   sp, [r2]"
        "        ldw   r-1, [sp+24]"
        "        ldw   r-2, [sp+21]"
        "        ldw   r-3, [sp+18]"
        "        ldw   r-4, [sp+15]"
        "        ldw   r-5, [sp+12]"
        "        ldw   r-6, [sp+9]"
        "        ldw   r-7, [sp+6]"
        "        ldw   r-8, [sp+3]"
        "        ldw   r-9, [sp]"
        "        add   sp, sp, 27"
        "        pop   fp"
        "        pop   lr"
        "        ret"
        "_arch_asm_end:"
    }
}

// ---- traps and interrupts ----------------------------------------------------

@align(729) var idt: [243]int;        // the vector table; vector v is idt[121 + v]
var irq_count: [81]int;
var jiffies: int;

const HZ: int = 100;

fn fault_name(v: int) -> *char {
    switch (v) {
        case -1: return "illegal instruction";
        case -2: return "privilege violation";
        case -3: return "page fault";
        case -4: return "protection fault";
        case -5: return "misaligned access";
        case -6: return "divide by zero";
        case -7: return "breakpoint";
        case -8: return "single step";
        case -9: return "double fault";
        case -10: return "bus error";
        case -11: return "floating-point exception";
        case -12: return "FPU not available";
    }
    return "unknown trap";
}

fn traps_init() {
    var i: int = 0;
    while (i < 243) { idt[i] = &trap_stub as int; i += 1; }
    mtc(ITB, &idt[121] as int);
}

fn irqs_enabled() -> int { return trit(mfc(MODE), 26) == 1; }

fn local_irq_enable() {
    if (!irqs_enabled()) { mtc(MODE, mfc(MODE) + MODE_IE); }
}

fn local_irq_disable() {
    if (irqs_enabled()) { mtc(MODE, mfc(MODE) - MODE_IE); }
}

// Called by trap_stub with the saved frame, interrupts off.
fn trap_handler(f: *int) {
    var cause: int = mfc(FCAUSE);
    var v: int = ext(cause, 23, 5);
    if (v == 0) {
        do_syscall(f, ext(cause, 1, 18));
        do_signal(f);                       // a system call always comes from user mode
        return;
    }
    if (v >= 1) {
        var irq: int = in(TPIC_CLAIM);
        if (irq >= 0) {
            irq_count[irq] += 1;
            out(TPIC_EOI, irq);
            if (irq == IRQ_KEYBOARD || irq == IRQ_SERIAL) { tty_poll(); }
            if (irq == IRQ_MOUSE) { mouse_poll(); }
            if (irq == IRQ_NIC) { tnic_poll(); }
            if (irq == IRQ_TIMER) {
                jiffies += 1;
                tty_poll();
                net_tick();
                scheduler_tick();
            }
        }
        if (trit(f[F_EMODE], 27) == -1) { do_signal(f); }
        return;
    }
    var from_user: int = trit(f[F_EMODE], 27) == -1;
    if (v == -12 && from_user) {
        fpu_unavailable();
        do_signal(f);
        return;
    }
    var addr: int = mfc(FADDR);
    var access: int = ext(cause, 22, 1);
    // User faults, and kernel faults on user memory (a system call touching
    // a demand-zero or copy-on-write page), go to the VM.
    if (from_user || ((v == -3 || v == -4) && current_task().l1 != 0 && is_user_address(addr))) {
        user_fault(v, f[F_EPC], addr, access, fault_name(v), from_user);
        if (from_user) { do_signal(f); }
        return;
    }
    printk("trap: ");
    pr(fault_name(v));
    pr(" (vector ");
    pr_int(v);
    pr(") at ");
    pr_int(f[F_EPC]);
    pr(", address ");
    pr_int(addr);
    pr_nl();
    panic("unhandled trap in the kernel");
}

// ---- kernel page tables -----------------------------------------------------------

var kernel_l1: int;                   // centre frame of the kernel's L1 table
var kernel_l2: [2]int;                // centre frames of the L2 tables for slots 0, +1

fn table_entry(table_centre_frame: int, i: int) -> *int {
    return (frame_centre(table_centre_frame) + 3 * i) as *int;
}

fn kernel_pte(frame: int) -> int {
    return frame * PTE_FRAME + PTE_V + PTE_X + PTE_RING + PTE_G;
}

fn is_device_frame(f: int) -> int {
    return (f >= -3 && f <= -1) || (f >= -81 && f <= -55);     // BIOS ROM, framebuffer
}

// Build the kernel half: L1 slots 0 and +1 map all RAM, the ROM and the
// framebuffer at their physical addresses (ring +1, global).
fn paging_init() {
    kernel_l1 = alloc_table();
    var slot: int = 0;
    var mapped: int = 0;
    while (slot <= 1) {
        var l2: int = alloc_table();
        if (l2 < 0 || kernel_l1 < 0) { panic("out of memory for page tables"); }
        kernel_l2[slot] = l2;
        var i: int = -9841;
        while (i <= 9841) {
            var f: int = slot * 19683 + i;
            if ((f >= 0 && f < ram_frames) || is_device_frame(f)) {
                *table_entry(l2, i) = kernel_pte(f);
                mapped += 1;
            }
            i += 1;
        }
        *table_entry(kernel_l1, slot) = kernel_pte(l2);
        slot += 1;
    }
    mtc(PTB, frame_centre(kernel_l1));
    tlbflush();
    mtc(MODE, mfc(MODE) + MODE_PG);
    printk("Paging: 9|9|9, kernel identity-mapped in L1 slots 0..+1, ");
    pr_int(mapped);
    pr(" pages, PTB ");
    pr_int(frame_centre(kernel_l1));
    pr_nl();
}

fn paging_enabled() -> int { return trit(mfc(MODE), 25) == 1; }
