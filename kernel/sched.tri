// sched: tasks, the round-robin scheduler, and system calls.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "arch.tri";
import "vm.tri";
import "exec.tri";
import "fs/vfs.tri";
import "fs/file.tri";
import "drivers/tty.tri";
import "signal.tri";
import "fs/tfs.tri";
import "fs/procfs.tri";
import "sys.tri";
import "cred.tri";

const NTASKS: int = 27;
const TASK_UNUSED: int = 0;
const TASK_RUNNABLE: int = 1;
const TASK_ZOMBIE: int = 2;
const TASK_SLEEPING: int = 3;
const TASK_STOPPED: int = 4;

// MODE for a user task: ring -1, interrupts on, paging on.
const USER_MODE: int = -1 + MODE_IE + MODE_PG;

// Linux errno values
const EBADF: int = 9;
const ECHILD: int = 10;
const EAGAIN: int = 11;
const EFAULT: int = 14;
const EINVAL: int = 22;
const ENOSYS: int = 38;

// Linux signal numbers for CPU faults (the rest are in signal.tri)
const SIGILL: int = 4;
const SIGTRAP: int = 5;
const SIGBUS: int = 7;
const SIGFPE: int = 8;
const SIGSEGV: int = 11;
const SIGCHLD: int = 17;

// Linux generic system-call numbers
const SYS_GETCWD: int = 17;
const SYS_DUP: int = 23;
const SYS_DUP3: int = 24;
const SYS_IOCTL: int = 29;
const SYS_MKDIRAT: int = 34;
const SYS_UNLINKAT: int = 35;
const SYS_CHDIR: int = 49;
const SYS_OPENAT: int = 56;
const SYS_CLOSE: int = 57;
const SYS_PIPE2: int = 59;
const SYS_GETDENTS64: int = 61;
const SYS_LSEEK: int = 62;
const SYS_READ: int = 63;
const SYS_WRITE: int = 64;
const SYS_PREAD64: int = 67;
const SYS_PWRITE64: int = 68;
const SYS_NEWFSTATAT: int = 79;
const SYS_FSTAT: int = 80;
const SYS_EXIT: int = 93;
const SYS_EXIT_GROUP: int = 94;
const SYS_SCHED_YIELD: int = 124;
const SYS_GETPID: int = 172;
const SYS_GETPPID: int = 173;
const SYS_FCNTL: int = 25;
const SYS_PPOLL: int = 73;
const SYS_MMAP: int = 222;
const SYS_MUNMAP: int = 215;
const SYS_FUTEX: int = 98;
const SYS_LINKAT: int = 37;
const SYS_FCHMODAT: int = 53;
const SYS_UTIMENSAT: int = 88;
const SYS_CLOCK_GETTIME: int = 113;
const SYS_CLOCK_SETTIME: int = 112;
const SYS_UNAME: int = 160;
const SYS_UMASK: int = 166;
const SYS_GETUID: int = 174;
const SYS_GETEUID: int = 175;
const SYS_GETGID: int = 176;
const SYS_GETEGID: int = 177;
const SYS_SETREGID: int = 143;
const SYS_SETGID: int = 144;
const SYS_SETREUID: int = 145;
const SYS_SETUID: int = 146;
const SYS_SETRESUID: int = 147;
const SYS_GETRESUID: int = 148;
const SYS_SETRESGID: int = 149;
const SYS_GETRESGID: int = 150;
const SYS_GETGROUPS: int = 158;
const SYS_SETGROUPS: int = 159;
const SYS_FCHOWNAT: int = 54;
const SYS_FCHOWN: int = 55;
const SYS_RENAMEAT: int = 38;
const SYS_UMOUNT2: int = 39;
const SYS_MOUNT: int = 40;
const SYS_STATFS: int = 43;
const SYS_SYNC: int = 81;
const SYS_FSYNC: int = 82;
const SYS_REBOOT: int = 142;
const SYS_NANOSLEEP: int = 101;
const SYS_GETITIMER: int = 102;
const SYS_SETITIMER: int = 103;
const SYS_KILL: int = 129;
const SYS_RT_SIGSUSPEND: int = 133;
const SYS_RT_SIGACTION: int = 134;
const SYS_RT_SIGPROCMASK: int = 135;
const SYS_RT_SIGPENDING: int = 136;
const SYS_RT_SIGRETURN: int = 139;
const SYS_SETPGID: int = 154;
const SYS_GETPGID: int = 155;
const SYS_GETSID: int = 156;
const SYS_SETSID: int = 157;
const SYS_SYSINFO: int = 179;
const SYS_BRK: int = 214;
const SYS_CLONE: int = 220;
const SYS_EXECVE: int = 221;
const SYS_WAIT4: int = 260;
const SYS_SOCKET: int = 198;
const SYS_BIND: int = 200;
const SYS_LISTEN: int = 201;
const SYS_ACCEPT: int = 202;
const SYS_CONNECT: int = 203;
const SYS_GETSOCKNAME: int = 204;
const SYS_GETPEERNAME: int = 205;
const SYS_SENDTO: int = 206;
const SYS_RECVFROM: int = 207;
const SYS_SETSOCKOPT: int = 208;
const SYS_GETSOCKOPT: int = 209;
const SYS_SHUTDOWN: int = 210;
const SYS_ACCEPT4: int = 242;
const SYS_GETRANDOM: int = 278;

const WNOHANG: int = 1;
const WUNTRACED: int = 2;
const EPERM_: int = 1;
const TIMER_CHAN: int = 40000;        // woken on every tick
const POLL_CHAN: int = 40001;         // tasks in poll(): woken by any wake_up
const HEAP_MAX: int = 729 * 19683;    // brk may grow 729 pages past the bss

struct Task {
    kernel_sp: int;                   // must stay first: switch_to saves it at [task]
    pid: int;
    ppid: int;
    state: int;
    l1: int;                          // centre frame of the L1 table; 0 = none
    kstack: int;                      // frame holding the kernel stack
    status: int;                      // wait status: code*256, or the signal number
    ticks: int;
    heap_start: int;                  // first tryte of the bss
    brk: int;                         // end of the heap
    wchan: int;                       // what a SLEEPING task waits for
    cwd: int;                         // inode of the working directory
    fds: [27]int;                     // open file + 1 per descriptor; 0 = closed
    pgid: int;                        // process group
    sid: int;                         // session
    sig_pending: int;                 // signal sets: bit (sig - 1)
    sig_blocked: int;
    saved_mask: int;                  // the mask to restore after sigsuspend
    has_saved_mask: int;
    stop_sig: int;                    // STOPPED: the signal that stopped it
    stop_reported: int;               // wait4 has reported this stop
    sig_handler: [32]int;             // per signal: SIG_DFL, SIG_IGN or a handler
    sig_flags: [32]int;
    sig_restorer: [32]int;
    sig_mask: [32]int;
    in_syscall: int;                  // returning from a restartable system call
    orig_r1: int;                     // its first argument, for a restart
    restart_nanosleep: int;           // the restarted nanosleep resumes at...
    nanosleep_until: int;             // ...this jiffy
    start_time: int;                  // jiffies at fork
    it_at: int;                       // ITIMER_REAL: SIGALRM at this jiffy (0 = off)...
    it_every: int;                    // ...then every this many (0 = once)
    cmdline_len: int;
    umask: int;
    fd_cloexec: [27]tryte;            // per descriptor: close on execve
    comm: [27]char;                   // the program's name (procfs)
    cmdline: [81]char;                // its arguments, NUL-separated
    uid: int;                         // credentials (cred.tri): real, effective, saved
    euid: int;
    suid: int;
    gid: int;
    egid: int;
    sgid: int;
    ngroups: int;                     // supplementary groups
    groups: [9]int;
    fpu_used: int;                    // fpu.tri: the task has touched the FPU
    fpu: [82]int;                     // its saved FSR and registers while not the owner
    vec_used: int;                    // vec.tri: the task has touched the vector unit
    vec: [80]int;                     // its saved vector registers (78 words, aligned within)
}

var tasks: [27]Task;
var task_top: int = 1;                // above every slot alloc_task has handed out
var current: int;                     // index into tasks; 0 is the idle task
var next_pid: int;
var user_tasks_alive: int;

fn current_task() -> *Task { return &tasks[current]; }

fn sched_init() {
    tasks[0].pid = 0;
    tasks[0].state = TASK_RUNNABLE;
    tasks[0].l1 = 0;
    current = 0;
    next_pid = 1;
}

fn alloc_task() -> int {
    var i: int = 1;
    while (i < NTASKS) {
        if (tasks[i].state == TASK_UNUSED) {
            if (i >= task_top) { task_top = i + 1; }
            return i;
        }
        i += 1;
    }
    return -1;
}

fn find_task(pid: int) -> int {
    var i: int = 1;
    while (i < task_top) {
        if (tasks[i].state != TASK_UNUSED && tasks[i].pid == pid) { return i; }
        i += 1;
    }
    return -1;
}

fn task_frame(t: *Task) -> *int {
    var top: int = frame_centre(t.kstack) + 9840 + 3;
    return (top - 3 * FRAME_WORDS) as *int;
}

// Make `t`'s kernel stack hold `frame` as its trap frame, with a switch
// frame on top that returns into trap_return.
fn prepare_stack(t: *Task) {
    var base: int = task_frame(t) as int;
    // what switch_to pops: r-9..r-1 (9 words, zero), fp, lr
    var sw: *int = (base - 33) as *int;
    var k: int = 0;
    while (k < 9) { sw[k] = 0; k += 1; }
    sw[9] = 0;
    sw[10] = &trap_return as int;
    t.kernel_sp = base - 33;
}

// Enter user mode at `entry` with stack `sp`, r1 = argc, r2 = argv.
fn set_user_entry(f: *int, entry: int, sp: int, argc: int, argv: int, envp: int) {
    var i: int = 0;
    while (i < FRAME_WORDS) { f[i] = 0; i += 1; }
    f[F_EPC] = entry;
    f[F_EMODE] = USER_MODE;
    f[F_KSP] = sp;
    f[0] = argc;
    f[1] = argv;
    f[2] = envp;
}

// Pick the next runnable user task after `from` (round robin), or idle.
fn pick_next(from: int) -> int {
    var k: int = 1;
    while (k <= NTASKS) {
        var i: int = (from + k) % NTASKS;
        if (i != 0 && tasks[i].state == TASK_RUNNABLE) { return i; }
        k += 1;
    }
    return 0;
}

fn schedule() {
    var prev: int = current;
    var next: int = pick_next(prev);
    if (next == prev) { return; }
    if (next == 0 && tasks[prev].state == TASK_RUNNABLE && prev != 0) { return; }
    current = next;
    var l1: int = tasks[next].l1;
    mtc(PTB, frame_centre(l1 != 0 ? l1 : kernel_l1));
    tlbflush();
    switch_to(&tasks[prev], &tasks[next]);
}

fn scheduler_tick() {
    tasks[current].ticks += 1;
    itimer_tick();
    wake_up(TIMER_CHAN);
    schedule();
}

// Block the current task until wake_up(chan). Callers re-check their
// condition in a loop: a wake-up only means "look again".
//
// Returns 1 if a signal is pending: the caller should give up with EINTR.
fn sleep_on(chan: int) -> int {
    var t: *Task = current_task();
    if (signal_pending(t)) { return 1; }
    t.wchan = chan;
    t.state = TASK_SLEEPING;
    schedule();
    return signal_pending(t);
}

// Every wake-up also wakes the tasks in poll(), which then look again.
fn wake_up(chan: int) {
    var i: int = 1;
    while (i < task_top) {                // the slots above were never used
        if (tasks[i].state == TASK_SLEEPING && (tasks[i].wchan == chan || tasks[i].wchan == POLL_CHAN)) {
            tasks[i].state = TASK_RUNNABLE;
            tasks[i].wchan = 0;
        }
        i += 1;
    }
}

// A parent in wait4 sleeps on its own negated pid.
fn child_chan(pid: int) -> int { return -pid; }

// ---- process lifetime ---------------------------------------------------------

// Start /sbin/init as pid 1.
fn spawn_init(path: *char) -> int {
    set_kernel_exec(path);
    exec_cwd = root_ino;
    var r: int = exec_load();
    if (r < 0) { return r; }
    var slot: int = alloc_task();
    var t: *Task = &tasks[slot];
    t.kstack = alloc_pages(0);
    t.l1 = load_l1;
    t.pid = next_pid;
    next_pid += 1;
    t.ppid = 0;
    t.start_time = jiffies;
    t.umask = 18;                                     // 022
    set_comm(t);
    t.pgid = t.pid;
    t.sid = t.pid;
    var sig: int = 0;
    while (sig < NSIG) { t.sig_handler[sig] = SIG_DFL; t.sig_mask[sig] = 0; sig += 1; }
    t.sig_pending = 0;
    t.sig_blocked = 0;
    t.heap_start = load_heap;
    t.brk = load_brk;
    t.fpu_used = 0;
    t.vec_used = 0;
    fs_init_task(t);
    set_user_entry(task_frame(t), load_entry, load_sp, exec_argc, load_argv, load_envp);
    prepare_stack(t);
    t.state = TASK_RUNNABLE;
    user_tasks_alive += 1;
    return t.pid;
}

fn do_fork(f: *int) -> int {
    var slot: int = alloc_task();
    if (slot < 0) { return -EAGAIN; }
    var parent: *Task = current_task();
    var child: *Task = &tasks[slot];
    var l1: int = copy_address_space(parent.l1);
    if (l1 < 0) { return -12; }
    child.kstack = alloc_pages(0);
    if (child.kstack < 0) { free_address_space(l1); return -12; }
    child.l1 = l1;
    child.pid = next_pid;
    next_pid += 1;
    child.ppid = parent.pid;
    child.ticks = 0;
    child.status = 0;
    child.heap_start = parent.heap_start;
    child.brk = parent.brk;
    fs_fork(parent, child);
    signals_fork(parent, child);
    child.start_time = jiffies;
    child.it_at = 0;                  // a child has no timer of its own yet (POSIX)
    child.it_every = 0;
    copy_str(&child.comm[0], &parent.comm[0], 27);
    var k: int = 0;
    while (k < 81) { child.cmdline[k] = parent.cmdline[k]; k += 1; }
    child.cmdline_len = parent.cmdline_len;
    child.umask = parent.umask;
    creds_fork(parent, child);
    fpu_fork(parent, child);
    vec_fork(parent, child);
    var c: int = 0;
    while (c < 27) { child.fd_cloexec[c] = parent.fd_cloexec[c]; c += 1; }
    child.pgid = parent.pgid;
    child.sid = parent.sid;
    var cf: *int = task_frame(child);
    var i: int = 0;
    while (i < FRAME_WORDS) { cf[i] = f[i]; i += 1; }
    cf[F_R1] = 0;                                     // fork returns 0 in the child
    prepare_stack(child);
    child.state = TASK_RUNNABLE;
    user_tasks_alive += 1;
    return child.pid;
}

fn do_execve(f: *int) -> int {
    var r: int = collect_exec_args(f[0], f[1], f[2]);
    if (r < 0) { return r; }
    exec_cwd = current_task().cwd;
    r = exec_load();
    if (r < 0) { return r; }
    var t: *Task = current_task();
    var old: int = t.l1;
    t.l1 = load_l1;
    t.heap_start = load_heap;
    t.brk = load_brk;
    mtc(PTB, frame_centre(load_l1));
    tlbflush();
    if (old != 0) { free_address_space(old); }
    signals_exec(t);
    fpu_drop(t);
    vec_drop(t);
    close_on_exec(t);
    set_comm(t);
    set_user_entry(f, load_entry, load_sp, exec_argc, load_argv, load_envp);
    return exec_argc;                                 // r1 = argc (set_user_entry already wrote it)
}

fn do_exit(status: int) {
    var t: *Task = current_task();
    fpu_drop(t);
    vec_drop(t);
    fs_exit(t);
    if (t.l1 != 0) {
        mtc(PTB, frame_centre(kernel_l1));
        free_address_space(t.l1);
        t.l1 = 0;
    }
    t.status = status;
    t.state = TASK_ZOMBIE;
    user_tasks_alive -= 1;
    if (t.pid == 1) {
        printk("Kernel panic - not syncing: Attempted to kill init! exit status ");
        pr_int(status);
        pr(", ");
        pr_int(free_frames);
        pr(" pages free\n");
        panic("init exited");
    }
    // Orphans go to init; a waiting parent wakes up.
    var i: int = 1;
    while (i < NTASKS) {
        if (tasks[i].state != TASK_UNUSED && tasks[i].ppid == t.pid) { tasks[i].ppid = 1; }
        i += 1;
    }
    var p: int = find_task(t.ppid);
    if (p >= 0) { send_signal(p, SIGCHLD); }
    wake_up(child_chan(t.ppid));
    schedule();                                       // never comes back
    panic("a zombie was scheduled");
}

fn kill_current(sig: int, what: *char, epc: int, addr: int) {
    printk("[pid ");
    pr_int(current_task().pid);
    pr("] ");
    pr(what);
    pr(" at ");
    pr_int(epc);
    pr(", address ");
    pr_int(addr);
    pr(" - killed by signal ");
    pr_int(sig);
    pr_nl();
    do_exit(sig);
}

fn fault_signal(v: int) -> int {
    switch (v) {
        case -1, -2: return SIGILL;
        case -5: return SIGBUS;
        case -6, -11: return SIGFPE;
        case -7, -8: return SIGTRAP;
    }
    return SIGSEGV;
}

// A fault in user mode, or in the kernel touching user memory.
fn user_fault(v: int, epc: int, addr: int, access: int, what: *char, from_user: int) {
    if ((v == -3 || v == -4) && handle_user_fault(current_task(), addr, access)) { return; }
    // A handler can only run for a fault in user code: a system call that
    // faults would just fault again on retry.
    if (!from_user) { kill_current(fault_signal(v), what, epc, addr); }
    force_signal(fault_signal(v), what, epc, addr);
}

// Is task `c` one that wait4(pid) asks about? (pid: >0 that child, -1 any,
// 0 our process group, < -1 group -pid)
fn wait_matches(c: *Task, me: *Task, pid: int) -> int {
    if (c.state == TASK_UNUSED || c.ppid != me.pid) { return 0; }
    if (pid > 0) { return c.pid == pid; }
    if (pid == -1) { return 1; }
    if (pid == 0) { return c.pgid == me.pgid; }
    return c.pgid == -pid;
}

fn put_status(status_ptr: int, st: int) -> int {
    if (status_ptr == 0) { return 0; }
    if (!user_range_ok(status_ptr - 1, 3)) { return -EFAULT; }
    *(status_ptr as *int) = st;
    return 0;
}

fn do_wait4(pid: int, status_ptr: int, options: int) -> int {
    var me: *Task = current_task();
    loop {
        var children: int = 0;
        var i: int = 1;
        while (i < NTASKS) {
            var c: *Task = &tasks[i];
            if (wait_matches(c, me, pid)) {
                children += 1;
                if (c.state == TASK_ZOMBIE) {
                    var cpid: int = c.pid;
                    if (put_status(status_ptr, c.status) < 0) { return -EFAULT; }
                    free_pages(c.kstack, 0);
                    c.state = TASK_UNUSED;
                    c.pid = 0;
                    return cpid;
                }
                if (c.state == TASK_STOPPED && !c.stop_reported && options / WUNTRACED % 2 != 0) {
                    if (put_status(status_ptr, c.stop_sig * 256 + 127) < 0) { return -EFAULT; }
                    c.stop_reported = 1;
                    return c.pid;
                }
            }
            i += 1;
        }
        if (children == 0) { return -ECHILD; }
        if (options % 2 == WNOHANG) { return 0; }
        if (sleep_on(child_chan(me.pid))) { return -ERESTARTSYS; }
    }
}

// nanosleep(req, rem): timespec = { seconds, nanoseconds }, one word each.
fn sys_nanosleep(req: int, rem: int) -> int {
    if (!user_range_ok(req - 1, 6)) { return -EFAULT; }
    var ts: *int = req as *int;
    if (ts[0] < 0 || ts[1] < 0 || ts[1] > 999999999) { return -EINVAL; }
    var ticks: int = ts[0] * HZ + (ts[1] + 9999999) / 10000000;
    var until: int = jiffies + ticks;
    var t: *Task = current_task();
    if (t.restart_nanosleep) {                     // resumed after a stop: the time left
        until = t.nanosleep_until;
        t.restart_nanosleep = 0;
    }
    while (jiffies < until) {
        if (sleep_on(TIMER_CHAN)) {
            t.nanosleep_until = until;
            if (rem != 0 && user_range_ok(rem - 1, 6)) {
                var left: int = until - jiffies;
                var r: *int = rem as *int;
                r[0] = left / HZ;
                r[1] = left % HZ * 10000000;
            }
            return -ERESTART_RESTARTBLOCK;
        }
    }
    return 0;
}

fn group_exists(pgid: int, sid: int) -> int {
    var i: int = 1;
    while (i < NTASKS) {
        if (tasks[i].state != TASK_UNUSED && tasks[i].state != TASK_ZOMBIE && tasks[i].pgid == pgid && tasks[i].sid == sid) { return 1; }
        i += 1;
    }
    return 0;
}

// setpgid(pid, pgid): ourselves or a child, within our session.
fn sys_setpgid(pid: int, pgid: int) -> int {
    var me: *Task = current_task();
    if (pid == 0) { pid = me.pid; }
    if (pgid == 0) { pgid = pid; }
    if (pgid < 0) { return -EINVAL; }
    var i: int = find_task(pid);
    if (i < 0) { return -ESRCH; }
    var t: *Task = &tasks[i];
    if (t.pid != me.pid && t.ppid != me.pid) { return -ESRCH; }
    if (t.sid != me.sid || t.sid == t.pid) { return -EPERM_; }      // other session, or a session leader
    if (pgid != pid && !group_exists(pgid, me.sid)) { return -EPERM_; }
    t.pgid = pgid;
    return 0;
}

fn sys_getpgid(pid: int) -> int {
    if (pid == 0) { return current_task().pgid; }
    var i: int = find_task(pid);
    return i < 0 ? -ESRCH : tasks[i].pgid;
}

fn sys_getsid(pid: int) -> int {
    if (pid == 0) { return current_task().sid; }
    var i: int = find_task(pid);
    return i < 0 ? -ESRCH : tasks[i].sid;
}

fn sys_setsid() -> int {
    var t: *Task = current_task();
    if (t.pgid == t.pid) { return -EPERM_; }                      // already a group leader
    t.sid = t.pid;
    t.pgid = t.pid;
    return t.sid;
}

// ---- system calls ---------------------------------------------------------------

fn user_range_ok(addr: int, n: int) -> int {
    return n >= 0 && is_user_address(addr) && is_user_address(addr + n - 1 + (n == 0));
}

fn sys_brk(addr: int) -> int {
    var t: *Task = current_task();
    if (addr >= t.heap_start && addr <= t.heap_start + HEAP_MAX) { t.brk = addr; }
    return t.brk;
}

// struct sysinfo, in Linux's field order, one word per field.
fn sys_sysinfo(info: int) -> int {
    if (!user_range_ok(info, 3 * 14)) { return -EFAULT; }
    var w: *int = info as *int;
    var procs: int = 0;
    var i: int = 1;
    while (i < NTASKS) {
        if (tasks[i].state != TASK_UNUSED) { procs += 1; }
        i += 1;
    }
    w[0] = jiffies / HZ;                 // uptime (s)
    w[1] = 0; w[2] = 0; w[3] = 0;        // loads
    w[4] = ram_frames * PAGE;            // totalram
    w[5] = free_frames * PAGE;           // freeram
    w[6] = 0; w[7] = 0;                  // sharedram, bufferram
    w[8] = 0; w[9] = 0;                  // totalswap, freeswap
    w[10] = procs;
    w[11] = 0; w[12] = 0;                // totalhigh, freehigh
    w[13] = 1;                           // mem_unit: 1 tryte
    return 0;
}

// Arguments are r1..r6 in the frame; the result goes back in r1.
// comm = the last component of exec_path; cmdline = the arguments.
fn set_comm(t: *Task) {
    var start: int = 0;
    var k: int = 0;
    while (exec_path[k] != 0) { if (exec_path[k] == '/') { start = k + 1; } k += 1; }
    copy_str(&t.comm[0], &exec_path[start], 16);
    var n: int = 0;
    var a: int = 0;
    while (a < exec_argc && n < 80) {
        var s: *char = &exec_buf[exec_arg[a]];
        var j: int = 0;
        loop {
            if (n >= 80) { break; }
            t.cmdline[n] = s[j];
            n += 1;
            if (s[j] == 0) { break; }
            j += 1;
        }
        a += 1;
    }
    t.cmdline_len = n;
}

fn do_syscall(f: *int, n: int) {
    var t: *Task = current_task();
    vfs_stamp += 1;
    t.orig_r1 = f[F_R1];
    t.in_syscall = n != SYS_RT_SIGRETURN;
    if (n != SYS_NANOSLEEP) { t.restart_nanosleep = 0; }
    switch (n) {
        case SYS_READ: f[F_R1] = sys_read(f[0], f[1], f[2]);
        case SYS_WRITE: f[F_R1] = sys_write(f[0], f[1], f[2]);
        case SYS_PREAD64: f[F_R1] = sys_pread64(f[0], f[1], f[2], f[3]);
        case SYS_PWRITE64: f[F_R1] = sys_pwrite64(f[0], f[1], f[2], f[3]);
        case SYS_GETITIMER: f[F_R1] = sys_getitimer(f[0], f[1]);
        case SYS_SETITIMER: f[F_R1] = sys_setitimer(f[0], f[1], f[2]);
        case SYS_OPENAT: f[F_R1] = sys_openat(f[0], f[1], f[2], f[3]);
        case SYS_CLOSE: f[F_R1] = sys_close(f[0]);
        case SYS_LSEEK: f[F_R1] = sys_lseek(f[0], f[1], f[2]);
        case SYS_DUP: f[F_R1] = sys_dup(f[0]);
        case SYS_DUP3: f[F_R1] = sys_dup3(f[0], f[1], f[2]);
        case SYS_PIPE2: f[F_R1] = sys_pipe2(f[0], f[1]);
        case SYS_FSTAT: f[F_R1] = sys_fstat(f[0], f[1]);
        case SYS_NEWFSTATAT: f[F_R1] = sys_newfstatat(f[0], f[1], f[2], f[3]);
        case SYS_GETDENTS64: f[F_R1] = sys_getdents64(f[0], f[1], f[2]);
        case SYS_MKDIRAT: f[F_R1] = sys_mkdirat(f[0], f[1], f[2]);
        case SYS_UNLINKAT: f[F_R1] = sys_unlinkat(f[0], f[1], f[2]);
        case SYS_CHDIR: f[F_R1] = sys_chdir(f[0]);
        case SYS_GETCWD: f[F_R1] = sys_getcwd(f[0], f[1]);
        case SYS_IOCTL: f[F_R1] = sys_ioctl(f[0], f[1], f[2]);
        case SYS_EXIT, SYS_EXIT_GROUP: do_exit((f[0] % 256 + 256) % 256 * 256);
        case SYS_GETPID: f[F_R1] = current_task().pid;
        case SYS_GETPPID: f[F_R1] = current_task().ppid;
        case SYS_SCHED_YIELD: { f[F_R1] = 0; schedule(); }
        case SYS_BRK: f[F_R1] = sys_brk(f[0]);
        case SYS_SYSINFO: f[F_R1] = sys_sysinfo(f[0]);
        case SYS_CLONE: {
            // fork-style clone only; vfork's CLONE_VM | CLONE_VFORK is a
            // fork too (POSIX allows it: the child gets its own copy-on-write
            // copy, and the parent runs on at once)
            if (f[0] != SIGCHLD && f[0] != SIGCHLD + CLONE_VM + CLONE_VFORK) { f[F_R1] = -EINVAL; }
            else { f[F_R1] = do_fork(f); }
        }
        case SYS_EXECVE: {
            var r: int = do_execve(f);
            if (r < 0) { f[F_R1] = r; }
        }
        case SYS_WAIT4: f[F_R1] = do_wait4(f[0], f[1], f[2]);
        case SYS_NANOSLEEP: f[F_R1] = sys_nanosleep(f[0], f[1]);
        case SYS_RENAMEAT: f[F_R1] = sys_renameat(f[0], f[1], f[2], f[3]);
        case SYS_FCNTL: f[F_R1] = sys_fcntl(f[0], f[1], f[2]);
        case SYS_PPOLL: f[F_R1] = sys_ppoll(f[0], f[1], f[2], f[3]);
        case SYS_MMAP: f[F_R1] = sys_mmap(f[0], f[1], f[2], f[3], f[4], f[5]);
        case SYS_MUNMAP: f[F_R1] = sys_munmap(f[0], f[1]);
        case SYS_FUTEX: f[F_R1] = sys_futex(f[0], f[1], f[2]);
        case SYS_LINKAT: f[F_R1] = sys_linkat(f[0], f[1], f[2], f[3]);
        case SYS_FCHMODAT: f[F_R1] = sys_fchmodat(f[0], f[1], f[2]);
        case SYS_UTIMENSAT: f[F_R1] = sys_utimensat(f[0], f[1], f[2], f[3]);
        case SYS_CLOCK_GETTIME: f[F_R1] = sys_clock_gettime(f[0], f[1]);
        case SYS_CLOCK_SETTIME: f[F_R1] = sys_clock_settime(f[0], f[1]);
        case SYS_UNAME: f[F_R1] = sys_uname(f[0]);
        case SYS_UMASK: f[F_R1] = sys_umask(f[0]);
        case SYS_GETUID: f[F_R1] = sys_getuid();
        case SYS_GETEUID: f[F_R1] = sys_geteuid();
        case SYS_GETGID: f[F_R1] = sys_getgid();
        case SYS_GETEGID: f[F_R1] = sys_getegid();
        case SYS_SETUID: f[F_R1] = sys_setuid(f[0]);
        case SYS_SETGID: f[F_R1] = sys_setgid(f[0]);
        case SYS_SETREUID: f[F_R1] = sys_setreuid(f[0], f[1]);
        case SYS_SETREGID: f[F_R1] = sys_setregid(f[0], f[1]);
        case SYS_SETRESUID: f[F_R1] = sys_setresuid(f[0], f[1], f[2]);
        case SYS_GETRESUID: f[F_R1] = sys_getresuid(f[0], f[1], f[2]);
        case SYS_SETRESGID: f[F_R1] = sys_setresgid(f[0], f[1], f[2]);
        case SYS_GETRESGID: f[F_R1] = sys_getresgid(f[0], f[1], f[2]);
        case SYS_GETGROUPS: f[F_R1] = sys_getgroups(f[0], f[1]);
        case SYS_SETGROUPS: f[F_R1] = sys_setgroups(f[0], f[1]);
        case SYS_FCHOWNAT: f[F_R1] = sys_fchownat(f[0], f[1], f[2], f[3], f[4]);
        case SYS_FCHOWN: f[F_R1] = sys_fchown(f[0], f[1], f[2]);
        case SYS_UMOUNT2: f[F_R1] = sys_umount2(f[0], f[1]);
        case SYS_MOUNT: f[F_R1] = sys_mount(f[0], f[1], f[2], f[3], f[4]);
        case SYS_STATFS: f[F_R1] = sys_statfs(f[0], f[1]);
        case SYS_SYNC: f[F_R1] = sys_sync();
        case SYS_FSYNC: f[F_R1] = sys_fsync(f[0]);
        case SYS_REBOOT: f[F_R1] = sys_reboot(f[0], f[1], f[2]);
        case SYS_KILL: f[F_R1] = sys_kill(f[0], f[1]);
        case SYS_RT_SIGSUSPEND: f[F_R1] = sys_rt_sigsuspend(f[0]);
        case SYS_RT_SIGACTION: f[F_R1] = sys_rt_sigaction(f[0], f[1], f[2]);
        case SYS_RT_SIGPROCMASK: f[F_R1] = sys_rt_sigprocmask(f[0], f[1], f[2]);
        case SYS_RT_SIGPENDING: f[F_R1] = sys_rt_sigpending(f[0]);
        case SYS_RT_SIGRETURN: f[F_R1] = sys_rt_sigreturn(f);
        case SYS_SETPGID: f[F_R1] = sys_setpgid(f[0], f[1]);
        case SYS_GETPGID: f[F_R1] = sys_getpgid(f[0]);
        case SYS_GETSID: f[F_R1] = sys_getsid(f[0]);
        case SYS_SETSID: f[F_R1] = sys_setsid();
        case SYS_SOCKET: f[F_R1] = sys_socket(f[0], f[1], f[2]);
        case SYS_BIND: f[F_R1] = sys_bind(f[0], f[1], f[2]);
        case SYS_LISTEN: f[F_R1] = sys_listen(f[0], f[1]);
        case SYS_ACCEPT: f[F_R1] = sys_accept4(f[0], f[1], f[2], 0);
        case SYS_ACCEPT4: f[F_R1] = sys_accept4(f[0], f[1], f[2], f[3]);
        case SYS_CONNECT: f[F_R1] = sys_connect(f[0], f[1], f[2]);
        case SYS_GETSOCKNAME: f[F_R1] = sys_getsockname(f[0], f[1], f[2]);
        case SYS_GETPEERNAME: f[F_R1] = sys_getpeername(f[0], f[1], f[2]);
        case SYS_SENDTO: f[F_R1] = sys_sendto(f[0], f[1], f[2], f[3], f[4], f[5]);
        case SYS_RECVFROM: f[F_R1] = sys_recvfrom(f[0], f[1], f[2], f[3], f[4], f[5]);
        case SYS_SETSOCKOPT: f[F_R1] = sys_setsockopt(f[0], f[1], f[2], f[3], f[4]);
        case SYS_GETSOCKOPT: f[F_R1] = sys_getsockopt(f[0], f[1], f[2], f[3], f[4]);
        case SYS_SHUTDOWN: f[F_R1] = sys_shutdown(f[0], f[1]);
        case SYS_GETRANDOM: f[F_R1] = sys_getrandom(f[0], f[1], f[2]);
        default: f[F_R1] = -ENOSYS;
    }
}

// ---- interval timers: ITIMER_REAL (setitimer, and tlibc's alarm) ----

const CLONE_VM: int = 256;
const CLONE_VFORK: int = 16384;
const ITIMER_REAL: int = 0;
const USEC_PER_TICK: int = 10000;     // 1000000 / HZ

// On every tick: each task's real timer due now gets SIGALRM, and starts
// again if it repeats.
fn itimer_tick() {
    var i: int = 1;
    while (i < task_top) {
        var t: *Task = &tasks[i];
        if (t.state != TASK_UNUSED && t.state != TASK_ZOMBIE && t.it_at > 0 && jiffies >= t.it_at) {
            t.it_at = t.it_every > 0 ? jiffies + t.it_every : 0;
            send_signal(i, SIGALRM);
        }
        i += 1;
    }
}

// a timeval (seconds, microseconds) as ticks, rounded up; -1 if invalid
fn tv_ticks(tv: *int) -> int {
    if (tv[0] < 0 || tv[1] < 0 || tv[1] > 999999) { return -1; }
    return tv[0] * HZ + (tv[1] + USEC_PER_TICK - 1) / USEC_PER_TICK;
}

fn ticks_tv(n: int, tv: *int) {
    tv[0] = n / HZ;
    tv[1] = n % HZ * USEC_PER_TICK;
}

// struct itimerval { it_interval: timeval; it_value: timeval; }: 4 words
fn itimer_get(t: *Task, out: *int) {
    ticks_tv(t.it_every, out);
    ticks_tv(t.it_at > 0 ? (t.it_at > jiffies ? t.it_at - jiffies : 1) : 0, out + 2);
}

fn sys_getitimer(which: int, cur: int) -> int {
    if (which != ITIMER_REAL) { return -EINVAL; }
    if (!user_range_ok(cur, 12)) { return -EFAULT; }
    itimer_get(current_task(), cur as *int);
    return 0;
}

fn sys_setitimer(which: int, newp: int, oldp: int) -> int {
    if (which != ITIMER_REAL) { return -EINVAL; }
    if (newp == 0 || !user_range_ok(newp, 12)) { return -EFAULT; }
    if (oldp != 0 && !user_range_ok(oldp, 12)) { return -EFAULT; }
    var nv: *int = newp as *int;
    var every: int = tv_ticks(nv);
    var value: int = tv_ticks(nv + 2);
    if (every < 0 || value < 0) { return -EINVAL; }
    var t: *Task = current_task();
    if (oldp != 0) { itimer_get(t, oldp as *int); }
    t.it_every = every;
    t.it_at = value > 0 ? jiffies + value : 0;
    return 0;
}
