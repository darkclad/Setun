// sched: tasks, the round-robin scheduler, and system calls.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "arch.tri";

const NTASKS: int = 27;
const TASK_UNUSED: int = 0;
const TASK_RUNNABLE: int = 1;
const TASK_ZOMBIE: int = 2;

// MODE for a user task: ring -1, interrupts on, paging on.
const USER_MODE: int = -1 + MODE_IE + MODE_PG;

// User address-space layout (docs/KERNEL.md §3.1), as in trine::Options::user().
const USER_BASE: int = -847288609443;         // -3^25: code starts here
const USER_LIMIT: int = -193710245;           // highest user address (L1 slot -1)
const USER_STACK: int = -387420492;           // -3^18 - 3

// Linux errno values
const EBADF: int = 9;
const EFAULT: int = 14;
const ENOSYS: int = 38;

// Linux generic system-call numbers
const SYS_WRITE: int = 64;
const SYS_EXIT: int = 93;
const SYS_EXIT_GROUP: int = 94;
const SYS_SCHED_YIELD: int = 124;
const SYS_GETPID: int = 172;

struct Task {
    kernel_sp: int;                   // must stay first: switch_to saves it at [task]
    pid: int;
    state: int;
    l1: int;                          // centre frame of the L1 page table
    kstack: int;                      // frame holding the kernel stack
    exit_code: int;
    ticks: int;
}

var tasks: [27]Task;
var current: int;                     // index into tasks; 0 is the idle task
var next_pid: int;
var user_tasks_alive: int;

fn current_task() -> *Task { return &tasks[current]; }

fn sched_init() {
    tasks[0].pid = 0;
    tasks[0].state = TASK_RUNNABLE;
    tasks[0].l1 = kernel_l1;
    current = 0;
    next_pid = 1;
}

fn alloc_task() -> int {
    var i: int = 1;
    while (i < NTASKS) {
        if (tasks[i].state == TASK_UNUSED) { return i; }
        i += 1;
    }
    return -1;
}

// Build a new task's kernel stack so that its first switch_to "returns"
// into trap_return, which enters user mode at `entry` with stack `user_sp`.
fn prepare_user_stack(t: *Task, entry: int, user_sp: int) {
    var top: int = frame_centre(t.kstack) + 9840 + 3;   // just above the top word
    var base: int = top - 3 * FRAME_WORDS;
    var frame: *int = base as *int;
    var i: int = 0;
    while (i < FRAME_WORDS) { frame[i] = 0; i += 1; }
    frame[F_EPC] = entry;
    frame[F_EMODE] = USER_MODE;
    frame[F_KSP] = user_sp;
    var sw: *int = (base - 6) as *int;                 // what switch_to pops: fp, lr
    sw[0] = 0;
    sw[1] = &trap_return as int;
    t.kernel_sp = base - 6;
}

// Pick the next runnable user task after `from` (round robin), or idle.
fn pick_next(from: int) -> int {
    var k: int = 1;
    while (k <= NTASKS) {
        var i: int = (from + k) % NTASKS;
        if (i != 0 && tasks[i].state == TASK_RUNNABLE) { return i; }
        k += 1;
    }
    return 0;
}

fn schedule() {
    var prev: int = current;
    var next: int = pick_next(prev);
    if (next == prev) { return; }
    current = next;
    mtc(PTB, frame_centre(tasks[next].l1));
    tlbflush();
    switch_to(&tasks[prev], &tasks[next]);
}

fn scheduler_tick() {
    tasks[current].ticks += 1;
    schedule();
}

fn do_exit(code: int) {
    var t: *Task = current_task();
    t.state = TASK_ZOMBIE;
    t.exit_code = code;
    user_tasks_alive -= 1;
    printk("[pid ");
    pr_int(t.pid);
    pr("] exited with code ");
    pr_int(code);
    pr(" after ");
    pr_int(t.ticks);
    pr(" ticks\n");
    schedule();                                  // never comes back
    panic("a zombie was scheduled");
}

fn user_fault(v: int, epc: int, addr: int, what: *char) {
    printk("[pid ");
    pr_int(current_task().pid);
    pr("] ");
    pr(what);
    pr(" at ");
    pr_int(epc);
    pr(", address ");
    pr_int(addr);
    pr(" - killed\n");
    do_exit(-128 + v);
}

// ---- system calls ---------------------------------------------------------------

fn user_range_ok(addr: int, n: int) -> int {
    return n >= 0 && addr <= USER_LIMIT && addr + n <= USER_LIMIT + 1 && addr >= USER_BASE - 9841;
}

fn sys_write(fd: int, buf: int, n: int) -> int {
    if (fd != 1 && fd != 2) { return -EBADF; }
    if (!user_range_ok(buf, n)) { return -EFAULT; }
    var p: *tryte = buf as *tryte;
    var i: int = 0;
    while (i < n) {
        var c: char = p[i];
        putc(c);
        screen_putc(c);
        i += 1;
    }
    return n;
}

// Arguments are r1..r6 in the frame; the result goes back in r1.
fn do_syscall(f: *int, n: int) {
    switch (n) {
        case SYS_WRITE: f[F_R1] = sys_write(f[0], f[1], f[2]);
        case SYS_EXIT, SYS_EXIT_GROUP: do_exit(f[0]);
        case SYS_GETPID: f[F_R1] = current_task().pid;
        case SYS_SCHED_YIELD: { f[F_R1] = 0; schedule(); }
        default: f[F_R1] = -ENOSYS;
    }
}
