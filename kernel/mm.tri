// mm: the "triddy" page allocator, a buddy allocator in base 3.
//
// A block of order k is 3^k frames centred on a frame number c that is a
// multiple of 3^k: it covers c - (3^k-1)/2 .. c + (3^k-1)/2. Splitting gives
// three children of order k-1 centred at c - 3^(k-1), c, c + 3^(k-1); three
// free siblings merge back into their parent. Balanced ternary makes every
// block centred, like pages and words.
//
// Free blocks are kept on doubly linked lists, one per order. The links live
// in the free block itself (the first two words at its centre frame), which
// the identity-mapped kernel can address directly.

import "params.tri";

const MAX_ORDER: int = 9;             // largest block: 3^9 frames
const NONE: int = -999999;            // end of a list
const MAX_FRAMES: int = 59049;        // block_order covers frames 0..MAX_FRAMES-1

var free_head: [10]int;               // per order: centre frame of the first free block
var block_order: [59049]tryte;        // k+1 if the frame centres a free block of order k
var ram_frames: int;
var free_frames: int;

fn pow3(k: int) -> int {
    var r: int = 1;
    while (k > 0) { r *= 3; k -= 1; }
    return r;
}

// The two link words stored in a free block's centre frame.
fn link(c: int) -> *int { return frame_centre(c) as *int; }

fn list_add(c: int, k: int) {
    var l: *int = link(c);
    l[0] = free_head[k];              // next
    l[1] = NONE;                      // prev
    if (free_head[k] != NONE) { link(free_head[k])[1] = c; }
    free_head[k] = c;
    block_order[c] = (k + 1) as tryte;
    free_frames += pow3(k);
}

fn list_remove(c: int, k: int) {
    var l: *int = link(c);
    var next: int = l[0];
    var prev: int = l[1];
    if (prev != NONE) { link(prev)[0] = next; } else { free_head[k] = next; }
    if (next != NONE) { link(next)[1] = prev; }
    block_order[c] = 0;
    free_frames -= pow3(k);
}

fn is_free_block(c: int, k: int) -> int {
    return c >= 0 && c < ram_frames && c < MAX_FRAMES && block_order[c] == k + 1;
}

// Allocate 3^k contiguous frames; returns the centre frame, or -1.
fn alloc_pages(k: int) -> int {
    var j: int = k;
    while (j <= MAX_ORDER && free_head[j] == NONE) { j += 1; }
    if (j > MAX_ORDER) { return -1; }
    var c: int = free_head[j];
    list_remove(c, j);
    while (j > k) {                   // keep the middle child, free the outer two
        j -= 1;
        var step: int = pow3(j);
        list_add(c - step, j);
        list_add(c + step, j);
    }
    return c;
}

// Free the block of order k centred at frame c, merging with its siblings.
fn free_pages(c: int, k: int) {
    while (k < MAX_ORDER) {
        var size: int = pow3(k);
        var p: int = divr(c, size * 3) * size * 3;     // parent centre (balanced rounding)
        var a: int = p - size;
        var b: int = p + size;
        // The two siblings of c among a, p, b.
        var s1: int = c == a ? p : a;
        var s2: int = c == b ? p : b;
        if (!is_free_block(s1, k) || !is_free_block(s2, k)) { break; }
        list_remove(s1, k);
        list_remove(s2, k);
        c = p;
        k += 1;
    }
    list_add(c, k);
}

// Hand frames first..last (inclusive) to the allocator, as large aligned blocks.
fn add_range(first: int, last: int) {
    var f: int = first;
    while (f <= last) {
        var k: int = MAX_ORDER;
        loop {
            var size: int = pow3(k);
            var c: int = f + (size - 1) / 2;
            if (k == 0 || (c % size == 0 && c + (size - 1) / 2 <= last)) {
                list_add(c, k);
                f += size;
                break;
            }
            k -= 1;
        }
    }
}

fn mm_init(frames: int) {
    ram_frames = frames;
    var k: int = 0;
    while (k <= MAX_ORDER) { free_head[k] = NONE; k += 1; }
    var last: int = frames - 1;
    if (last >= MAX_FRAMES) { last = MAX_FRAMES - 1; }
    add_range(FRAME_FIRST_FREE, last);
}

// Allocate one zeroed frame.
fn alloc_frame_zeroed() -> int {
    var f: int = alloc_pages(0);
    if (f < 0) { return -1; }
    var p: *int = (frame_start(f) + 1) as *int;
    var i: int = 0;
    while (i < 6561) { p[i] = 0; i += 1; }
    return f;
}

// Allocate and zero 3 frames (a page table); returns the centre frame.
fn alloc_table() -> int {
    var c: int = alloc_pages(1);
    if (c < 0) { return -1; }
    var p: *int = (frame_start(c - 1) + 1) as *int;
    var i: int = 0;
    while (i < 3 * 6561) { p[i] = 0; i += 1; }
    return c;
}

// Allocate and free a mix of blocks; everything must come back.
fn mm_self_test() -> int {
    var before: int = free_frames;
    var a: int = alloc_pages(0);
    var b: int = alloc_pages(2);
    var c: int = alloc_pages(0);
    var d: int = alloc_pages(3);
    if (a < 0 || b < 0 || c < 0 || d < 0) { return 0; }
    if (b % 9 != 0 || d % 27 != 0) { return 0; }       // blocks are centred and aligned
    if (free_frames != before - 1 - 9 - 1 - 27) { return 0; }
    free_pages(c, 0);
    free_pages(a, 0);
    free_pages(d, 3);
    free_pages(b, 2);
    return free_frames == before;
}
