// mm: the "triddy" page allocator, a buddy allocator in base 3.
//
// A block of order k is 3^k frames centred on a frame number c that is a
// multiple of 3^k: it covers c - (3^k-1)/2 .. c + (3^k-1)/2. Splitting gives
// three children of order k-1 centred at c - 3^(k-1), c, c + 3^(k-1); three
// free siblings merge back into their parent. Balanced ternary makes every
// block centred, like pages and words.
//
// Free blocks are kept on doubly linked lists, one per order. The links live
// in the free block itself (the first two words at its centre frame), which
// the identity-mapped kernel can address directly.

import "params.tri";

const MAX_ORDER: int = 9;             // largest block: 3^9 frames
const NONE: int = -999999;            // end of a list
const MAX_FRAMES: int = 59049;        // block_order covers frames 0..MAX_FRAMES-1

var free_head: [10]int;               // per order: centre frame of the first free block
var block_order: [59049]tryte;        // k+1 if the frame centres a free block of order k
var ram_frames: int;
var free_frames: int;

fn pow3(k: int) -> int {
    var r: int = 1;
    while (k > 0) { r *= 3; k -= 1; }
    return r;
}

// The two link words stored in a free block's centre frame.
fn link(c: int) -> *int { return frame_centre(c) as *int; }

fn list_add(c: int, k: int) {
    var l: *int = link(c);
    l[0] = free_head[k];              // next
    l[1] = NONE;                      // prev
    if (free_head[k] != NONE) { link(free_head[k])[1] = c; }
    free_head[k] = c;
    block_order[c] = (k + 1) as tryte;
    free_frames += pow3(k);
}

fn list_remove(c: int, k: int) {
    var l: *int = link(c);
    var next: int = l[0];
    var prev: int = l[1];
    if (prev != NONE) { link(prev)[0] = next; } else { free_head[k] = next; }
    if (next != NONE) { link(next)[1] = prev; }
    block_order[c] = 0;
    free_frames -= pow3(k);
}

fn is_free_block(c: int, k: int) -> int {
    return c >= 0 && c < ram_frames && c < MAX_FRAMES && block_order[c] == k + 1;
}

// Allocate 3^k contiguous frames; returns the centre frame, or -1.
// Short of memory, the text cache gives its frames back first.
fn alloc_pages(k: int) -> int {
    var j: int = k;
    while (j <= MAX_ORDER && free_head[j] == NONE) { j += 1; }
    if (j > MAX_ORDER && text_cache_count > 0) {
        text_cache_drop();
        j = k;
        while (j <= MAX_ORDER && free_head[j] == NONE) { j += 1; }
    }
    if (j > MAX_ORDER) { return -1; }
    var c: int = free_head[j];
    list_remove(c, j);
    while (j > k) {                   // keep the middle child, free the outer two
        j -= 1;
        var step: int = pow3(j);
        list_add(c - step, j);
        list_add(c + step, j);
    }
    return c;
}

// Free the block of order k centred at frame c, merging with its siblings.
fn free_pages(c: int, k: int) {
    while (k < MAX_ORDER) {
        var size: int = pow3(k);
        var p: int = divr(c, size * 3) * size * 3;     // parent centre (balanced rounding)
        var a: int = p - size;
        var b: int = p + size;
        // The two siblings of c among a, p, b.
        var s1: int = c == a ? p : a;
        var s2: int = c == b ? p : b;
        if (!is_free_block(s1, k) || !is_free_block(s2, k)) { break; }
        list_remove(s1, k);
        list_remove(s2, k);
        c = p;
        k += 1;
    }
    list_add(c, k);
}

// Hand frames first..last (inclusive) to the allocator, as large aligned blocks.
fn add_range(first: int, last: int) {
    var f: int = first;
    while (f <= last) {
        var k: int = MAX_ORDER;
        loop {
            var size: int = pow3(k);
            var c: int = f + (size - 1) / 2;
            if (k == 0 || (c % size == 0 && c + (size - 1) / 2 <= last)) {
                list_add(c, k);
                f += size;
                break;
            }
            k -= 1;
        }
    }
}

fn mm_init(frames: int) {
    ram_frames = frames;
    var k: int = 0;
    while (k <= MAX_ORDER) { free_head[k] = NONE; k += 1; }
    var last: int = frames - 1;
    if (last >= MAX_FRAMES) { last = MAX_FRAMES - 1; }
    add_range(FRAME_FIRST_FREE, last);
}

// Word loops in assembly: the compiled `p[i] = 0` loop costs ~30
// instructions a word, and zeroing page tables dominated fork and exec.
extern fn zero_words(p: *int, n: int);
extern fn copy_words(dst: *int, src: *int, n: int);
extern fn copy_trytes(dst: *tryte, src: *tryte, n: int);
extern fn zero_trytes(dst: *tryte, n: int);

fn _mm_asm() {
    asm {
        "        b     _mm_asm_end"
        "zero_words:"
        "        cmp   r2, 9"
        "        blt   zero_words_tail"
        "zero_words_9:"
        "        stw   r0, [r1]"
        "        stw   r0, [r1+3]"
        "        stw   r0, [r1+6]"
        "        stw   r0, [r1+9]"
        "        stw   r0, [r1+12]"
        "        stw   r0, [r1+15]"
        "        stw   r0, [r1+18]"
        "        stw   r0, [r1+21]"
        "        stw   r0, [r1+24]"
        "        add   r1, r1, 27"
        "        sub   r2, r2, 9"
        "        cmp   r2, 9"
        "        bge   zero_words_9"
        "zero_words_tail:"
        "        cmp   r2, 0"
        "        ble   zero_words_done"
        "zero_words_loop:"
        "        stw   r0, [r1]"
        "        add   r1, r1, 3"
        "        sub   r2, r2, 1"
        "        bgt   zero_words_loop"
        "zero_words_done:"
        "        ret"
        "copy_words:"
        "        cmp   r3, 9"
        "        blt   copy_words_tail"
        "copy_words_9:"
        "        ldw   r4, [r2]"
        "        stw   r4, [r1]"
        "        ldw   r4, [r2+3]"
        "        stw   r4, [r1+3]"
        "        ldw   r4, [r2+6]"
        "        stw   r4, [r1+6]"
        "        ldw   r4, [r2+9]"
        "        stw   r4, [r1+9]"
        "        ldw   r4, [r2+12]"
        "        stw   r4, [r1+12]"
        "        ldw   r4, [r2+15]"
        "        stw   r4, [r1+15]"
        "        ldw   r4, [r2+18]"
        "        stw   r4, [r1+18]"
        "        ldw   r4, [r2+21]"
        "        stw   r4, [r1+21]"
        "        ldw   r4, [r2+24]"
        "        stw   r4, [r1+24]"
        "        add   r1, r1, 27"
        "        add   r2, r2, 27"
        "        sub   r3, r3, 9"
        "        cmp   r3, 9"
        "        bge   copy_words_9"
        "copy_words_tail:"
        "        cmp   r3, 0"
        "        ble   copy_words_done"
        "copy_words_loop:"
        "        ldw   r4, [r2]"
        "        stw   r4, [r1]"
        "        add   r1, r1, 3"
        "        add   r2, r2, 3"
        "        sub   r3, r3, 1"
        "        bgt   copy_words_loop"
        "copy_words_done:"
        "        ret"
        "copy_trytes:"
        "        sub   r5, r1, r2"
        "        mod   r5, r5, 3"
        "        cmp   r5, 0"
        "        bne   copy_trytes_tail"
        "copy_trytes_head:"
        "        cmp   r3, 0"
        "        ble   copy_trytes_done"
        "        add   r5, r1, 1"
        "        mod   r5, r5, 3"
        "        cmp   r5, 0"
        "        beq   copy_trytes_words"
        "        ldt   r4, [r2]"
        "        stt   r4, [r1]"
        "        add   r1, r1, 1"
        "        add   r2, r2, 1"
        "        sub   r3, r3, 1"
        "        b     copy_trytes_head"
        "copy_trytes_words:"
        "        cmp   r3, 9"
        "        blt   copy_trytes_word1"
        "copy_trytes_w3:"
        "        ldw   r4, [r2+1]"
        "        stw   r4, [r1+1]"
        "        ldw   r4, [r2+4]"
        "        stw   r4, [r1+4]"
        "        ldw   r4, [r2+7]"
        "        stw   r4, [r1+7]"
        "        add   r1, r1, 9"
        "        add   r2, r2, 9"
        "        sub   r3, r3, 9"
        "        cmp   r3, 9"
        "        bge   copy_trytes_w3"
        "copy_trytes_word1:"
        "        cmp   r3, 3"
        "        blt   copy_trytes_tail"
        "        ldw   r4, [r2+1]"
        "        stw   r4, [r1+1]"
        "        add   r1, r1, 3"
        "        add   r2, r2, 3"
        "        sub   r3, r3, 3"
        "        b     copy_trytes_word1"
        "copy_trytes_tail:"
        "        cmp   r3, 0"
        "        ble   copy_trytes_done"
        "copy_trytes_loop:"
        "        ldt   r4, [r2]"
        "        stt   r4, [r1]"
        "        add   r1, r1, 1"
        "        add   r2, r2, 1"
        "        sub   r3, r3, 1"
        "        bgt   copy_trytes_loop"
        "copy_trytes_done:"
        "        ret"
        "zero_trytes:"
        "        cmp   r2, 0"
        "        ble   zero_trytes_done"
        "zero_trytes_loop:"
        "        stt   r0, [r1]"
        "        add   r1, r1, 1"
        "        sub   r2, r2, 1"
        "        cmp   r2, 0"
        "        bgt   zero_trytes_loop"
        "zero_trytes_done:"
        "        ret"
        "_mm_asm_end:"
    }
}

// Allocate one zeroed frame.
fn alloc_frame_zeroed() -> int {
    var f: int = alloc_pages(0);
    if (f < 0) { return -1; }
    zero_words((frame_start(f) + 1) as *int, 6561);
    return f;
}

// Allocate and zero 3 frames (a page table); returns the centre frame.
fn alloc_table() -> int {
    var c: int = alloc_pages(1);
    if (c < 0) { return -1; }
    zero_words((frame_start(c - 1) + 1) as *int, 3 * 6561);
    return c;
}

// ---- user page reference counts (shared after fork, copy on write) ------------

var frame_ref: [59049]tryte;

// A fresh zeroed frame for user memory, with one reference.
fn alloc_user_frame() -> int {
    var f: int = alloc_frame_zeroed();
    if (f >= 0) { frame_ref[f] = 1; }
    return f;
}

fn get_page(f: int) { frame_ref[f] += 1; }

// Drop a reference; the frame is freed when the last one goes.
fn put_page(f: int) {
    frame_ref[f] -= 1;
    if (frame_ref[f] <= 0) {
        frame_ref[f] = 0;
        free_pages(f, 0);
    }
}

// ---- the text cache -----------------------------------------------------------
//
// Frames of executable text stay after the last process using them exits,
// so the next exec of the same file maps them instead of reading it again
// (and code the emulator has compiled for them stays valid). An entry is
// keyed by the file's inode slot, the inode's generation (new whenever the
// slot is filled or the file is written) and the page; a stale entry is
// never matched, and goes when its slot is reused or memory runs short.

const TEXT_CACHE: int = 243;

struct TextPage {
    used: int;
    ino: int;
    gen: int;
    page: int;
    frame: int;
}

var text_cache: [243]TextPage;
var text_cache_count: int;
var text_cache_next: int;             // the slot to reuse next when all are taken

// The cached frame for (ino, gen, page), or -1.
fn text_cache_find(ino: int, gen: int, page: int) -> int {
    var k: int = 0;
    while (k < TEXT_CACHE) {
        var e: *TextPage = &text_cache[k];
        if (e.used && e.page == page && e.ino == ino && e.gen == gen) { return e.frame; }
        k += 1;
    }
    return -1;
}

// Keep `frame` (holding that page) in the cache, with a reference of its own.
fn text_cache_add(ino: int, gen: int, page: int, frame: int) {
    var k: int = 0;
    while (k < TEXT_CACHE && text_cache[k].used) { k += 1; }
    if (k == TEXT_CACHE) {
        k = text_cache_next;
        text_cache_next = (text_cache_next + 1) % TEXT_CACHE;
        put_page(text_cache[k].frame);
        text_cache_count -= 1;
    }
    var e: *TextPage = &text_cache[k];
    e.used = 1;
    e.ino = ino;
    e.gen = gen;
    e.page = page;
    e.frame = frame;
    get_page(frame);
    text_cache_count += 1;
}

// Give every cached frame back (those still mapped stay with their users).
fn text_cache_drop() {
    var k: int = 0;
    while (k < TEXT_CACHE) {
        if (text_cache[k].used) {
            text_cache[k].used = 0;
            put_page(text_cache[k].frame);
        }
        k += 1;
    }
    text_cache_count = 0;
}

// Copy a whole frame (6561 words).
fn copy_frame(dst: int, src: int) {
    copy_words((frame_start(dst) + 1) as *int, (frame_start(src) + 1) as *int, 6561);
}

// Allocate and free a mix of blocks; everything must come back.
fn mm_self_test() -> int {
    var before: int = free_frames;
    var a: int = alloc_pages(0);
    var b: int = alloc_pages(2);
    var c: int = alloc_pages(0);
    var d: int = alloc_pages(3);
    if (a < 0 || b < 0 || c < 0 || d < 0) { return 0; }
    if (b % 9 != 0 || d % 27 != 0) { return 0; }       // blocks are centred and aligned
    if (free_frames != before - 1 - 9 - 1 - 27) { return 0; }
    free_pages(c, 0);
    free_pages(a, 0);
    free_pages(d, 3);
    free_pages(b, 2);
    return free_frames == before;
}
