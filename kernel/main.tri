// Trinux kernel entry: start_kernel(), after Linux's init/main.c.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "arch.tri";
import "sched.tri";
import "initramfs.tri";
import "fs/vfs.tri";
import "fs/devfs.tri";
import "fs/bcache.tri";
import "fs/tfs.tri";
import "fs/procfs.tri";
import "drivers/tty.tri";
import "drivers/tnic.tri";

var boot_disk: int;

fn time_init() {
    out(TPIC_UNMASK, IRQ_TIMER);
    out(TIMER_PERIOD, 1000000 / HZ);
    out(TIMER_CTRL, 1);                       // periodic
    printk("Timer: ");
    pr_int(HZ);
    pr(" Hz (");
    pr_int(1000000 / HZ);
    pr(" us per tick)\n");
}

// The root file system: the tfs volume on the boot disk, or else the
// initramfs unpacked into a ramfs.
fn mount_root() {
    var m: int = mount_add(FS_TFS, -1, -1, "/dev/hda", "/");
    var r: int = tfs_mount(TFS_START, m);
    if (r >= 0) {
        mounts[m].root = r;
        root_ino = r;
        printk("VFS: Mounted root (tfs filesystem): ");
        pr_int(tfs_nblocks);
        pr(" blocks, ");
        pr_int(tfs_free_blocks);
        pr(" free, ");
        pr_int(tfs_free_inodes);
        pr(" inodes free\n");
        return;
    }
    mounts[m].used = 0;
    m = mount_add(FS_RAM, -1, -1, "rootfs", "/");
    root_ino = ram_new_root(m);
    mounts[m].root = root_ino;
    if (!initramfs_init()) {
        printk("Kernel panic - not syncing: VFS: Unable to mount root fs\n");
        panic("no root file system");
    }
    vfs_mkdirs("/dev");
    vfs_mkdirs("/proc");
    vfs_mkdirs("/tmp");
    printk("VFS: Mounted root (ramfs from the initramfs)\n");
}

fn start_kernel(disk: int, frames: int) {
    boot_disk = disk;
    screen_clear();
    printk("Trinux version ");
    pr(TRINUX_VERSION);
    pr(" (trine) on Setun-11̅, balanced ternary\n");
    printk("Booted from disk ");
    pr_int(disk);
    pr(", RAM ");
    pr_int(frames);
    pr(" pages x 3^9 trytes = ");
    pr_int(frames * PAGE);
    pr(" trytes\n");

    traps_init();
    printk("Traps: 243 vectors at ");
    pr_int(mfc(ITB));
    pr_nl();

    mm_init(frames);
    printk("Memory: ");
    pr_int(free_frames);
    pr(" pages free (frames ");
    pr_int(FRAME_FIRST_FREE);
    pr("..");
    pr_int(frames - 1);
    pr("), triddy orders 0..");
    pr_int(MAX_ORDER);
    pr_nl();
    if (!mm_self_test()) { panic("page allocator self-test failed"); }
    printk("mm: triddy self-test OK\n");

    paging_init();
    if (!paging_enabled()) { panic("paging did not turn on"); }

    sched_init();
    vfs_init();
    bcache_init();
    mount_root();
    devfs_init();
    var point: int = path_lookup("/proc", root_ino);
    if (point < 0 || do_mount(FS_PROC, point, "proc", "/proc") < 0) { printk("VFS: cannot mount /proc\n"); }
    point = path_lookup("/tmp", root_ino);
    var tm: int = point < 0 ? -1 : do_mount(FS_RAM, point, "tmpfs", "/tmp");
    if (tm < 0) { printk("VFS: cannot mount /tmp\n"); }
    else { inodes[mounts[tm].root].mode = 1023; }    // 01777: all may write; the sticky bit protects
    tty_init();
    input_init();
    net_init();
    printk("VFS: devfs on /dev, proc on /proc, tmpfs on /tmp, console tty\n");
    {
        var pid: int = spawn_init("/sbin/init");
        if (pid < 0) {
            printk("init: cannot run /sbin/init (error ");
            pr_int(-pid);
            pr(")\n");
        } else {
            printk("init: started /sbin/init as pid ");
            pr_int(pid);
            pr_nl();
        }
    }
    time_init();

    // The idle task: schedule user tasks, sleep until the next interrupt.
    var announced: int = 0;
    var last_flush: int = 0;
    loop {
        local_irq_disable();
        schedule();
        if (jiffies - last_flush >= 5 * HZ && bcache_dirty_count() > 0) {   // like bdflush
            tfs_sync();
            last_flush = jiffies;
        }
        local_irq_enable();
        if (user_tasks_alive == 0 && !announced) {
            printk("Idle: no user processes left (");
            pr_int(jiffies);
            pr(" ticks, ");
            pr_int(free_frames);
            pr(" pages free)\n");
            announced = 1;
        }
        hlt();
    }
}

fn main(disk: int, frames: int) -> int {
    start_kernel(disk, frames);
    return 0;
}
