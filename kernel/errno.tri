// errno: the error numbers system calls return (negated), with Linux's
// values, defined once for the whole kernel.

const EPERM: int = 1;
const ENOENT: int = 2;
const ESRCH: int = 3;
const EINTR: int = 4;
const EIO: int = 5;
const E2BIG: int = 7;
const ENOEXEC: int = 8;
const EBADF: int = 9;
const ECHILD: int = 10;
const EAGAIN: int = 11;
const ENOMEM: int = 12;
const EACCES: int = 13;
const EFAULT: int = 14;
const EBUSY: int = 16;
const EEXIST: int = 17;
const EXDEV: int = 18;
const ENODEV: int = 19;
const ENOTDIR: int = 20;
const EISDIR: int = 21;
const EINVAL: int = 22;
const ENFILE: int = 23;
const EMFILE: int = 24;
const ENOTTY: int = 25;
const ENOSPC: int = 28;
const ESPIPE: int = 29;
const EROFS: int = 30;
const EMLINK: int = 31;
const EPIPE: int = 32;
const ERANGE: int = 34;
const ENAMETOOLONG: int = 36;
const ENOSYS: int = 38;
const ENOTEMPTY: int = 39;
const ELOOP: int = 40;
const EPROTO: int = 71;
const ENOTSOCK: int = 88;
const EDESTADDRREQ: int = 89;
const EMSGSIZE: int = 90;
const ENOPROTOOPT: int = 92;
const EPROTONOSUPPORT: int = 93;
const ESOCKTNOSUPPORT: int = 94;
const EOPNOTSUPP: int = 95;
const EAFNOSUPPORT: int = 97;
const EADDRINUSE: int = 98;
const EADDRNOTAVAIL: int = 99;
const ENETUNREACH: int = 101;
const ECONNABORTED: int = 103;
const ECONNRESET: int = 104;
const ENOBUFS: int = 105;
const EISCONN: int = 106;
const ENOTCONN: int = 107;
const ETIMEDOUT: int = 110;
const ECONNREFUSED: int = 111;
const EHOSTUNREACH: int = 113;
const EALREADY: int = 114;
const EINPROGRESS: int = 115;
const ERESTARTSYS: int = 512;
const ERESTARTNOHAND: int = 514;
const ERESTART_RESTARTBLOCK: int = 516;
