// tl: TL frames, the link layer of TNET (docs/TNET.md §2).
//
// A frame is destination and source station addresses (one word each), a
// type tryte, the payload and two trytes of TCRC-18. Trytes of any value:
// nothing here is an octet.

import "../params.tri";
import "../printk.tri";
import "tnp.tri";
import "tsp.tri";

const TL_HLEN: int = 7;                   // 3 + 3 + 1
const TL_CLEN: int = 2;                   // the check
const TL_MIN: int = 9;
const TL_MAX: int = 2187;                 // the card's longest frame
const TL_MTU: int = 2178;                 // TL_MAX - TL_HLEN - TL_CLEN

const TL_TNP: int = 1;
const TL_ECHO: int = 2;
const TL_ECHO_REPLY: int = 3;

var tl_addr: int;                         // this station (the card's ADDR)
var tl_up: int;

// counters for /proc/net/tlink
var tl_rx_frames: int;
var tl_tx_frames: int;
var tl_rx_trytes: int;
var tl_tx_trytes: int;
var tl_bad_check: int;
var tl_short: int;
var tl_not_ours: int;
var tl_bad_type: int;
var tl_tx_dropped: int;
var tl_echoes: int;

// ---- TCRC-18 ----------------------------------------------------------------------------------

// g(x) = x^18 + x^13 + x - 1, so x^18 = -x^13 - x + 1 modulo g.
const TCRC_FOLD: int = -1594325;          // -3^13 - 3 + 1
const TCRC_TOP: int = 129140163;          // 3^17
const TCRC_INIT: int = 193710244;         // 18 trits of +1: (3^18 - 1) / 2

// a + b in GF(3) trit by trit: only trits where a and b agree and are not
// zero overflow (1 + 1 = -1), and cons() picks out exactly those.
fn gf3_add(a: int, b: int) -> int { return a + b - 3 * cons(a, b); }

// The remainder r (18 trits) after one more trit t of the message.
fn tcrc_trit(r: int, t: int) -> int {
    var top: int = divr(r, TCRC_TOP);     // the trit that leaves (x^17's)
    var low: int = r - top * TCRC_TOP;
    var s: int = gf3_add(low * 3, t);     // low * 3 has a zero last trit: no overflow
    return gf3_add(s, top * TCRC_FOLD);
}

// TCRC-18 of n trytes at p: the 18-trit remainder, balanced.
fn tcrc18(p: *tryte, n: int) -> int {
    var r: int = TCRC_INIT;
    var k: int = 0;
    while (k < n) {
        var v: int = p[k];
        // the tryte's trits, most significant first (trit() takes a constant)
        r = tcrc_trit(r, trit(v, 19));
        r = tcrc_trit(r, trit(v, 20));
        r = tcrc_trit(r, trit(v, 21));
        r = tcrc_trit(r, trit(v, 22));
        r = tcrc_trit(r, trit(v, 23));
        r = tcrc_trit(r, trit(v, 24));
        r = tcrc_trit(r, trit(v, 25));
        r = tcrc_trit(r, trit(v, 26));
        r = tcrc_trit(r, trit(v, 27));
        k += 1;
    }
    // then 18 zero trits: the message times x^18
    var z: int = 0;
    while (z < 18) { r = tcrc_trit(r, 0); z += 1; }
    return r;
}

fn tl_word(p: *tryte, k: int) -> int { return p[k] * 387420489 + p[k + 1] * 19683 + p[k + 2]; }

fn tl_put_word(p: *tryte, k: int, v: int) {
    p[k] = ext(v, 1, 9) as tryte;
    p[k + 1] = ext(v, 10, 9) as tryte;
    p[k + 2] = ext(v, 19, 9) as tryte;
}

// Fill in the header and the check of a frame with n payload trytes at
// f + TL_HLEN; returns its whole length.
fn tl_build(f: *tryte, dst: int, type: int, n: int) -> int {
    tl_put_word(f, 0, dst);
    tl_put_word(f, 3, tl_addr);
    f[6] = type as tryte;
    var len: int = TL_HLEN + n;
    var c: int = tcrc18(f, len);
    f[len] = ext(c, 10, 9) as tryte;      // the 18-trit check: trits 10..27 of the word
    f[len + 1] = ext(c, 19, 9) as tryte;
    return len + TL_CLEN;
}

// Is the frame's check right?
fn tl_check(f: *tryte, len: int) -> int {
    var c: int = tcrc18(f, len - TL_CLEN);
    return f[len - 2] == ext(c, 10, 9) && f[len - 1] == ext(c, 19, 9);
}

// ---- sending and receiving --------------------------------------------------------------------

var tl_txbuf: [2187]tryte;

fn tl_xmit(f: *tryte, len: int) -> int {
    if (!tl_up) { tl_tx_dropped += 1; return -1; }
    if (tlink_xmit(f, len) < 0) { tl_tx_dropped += 1; return -1; }
    tl_tx_frames += 1;
    tl_tx_trytes += len;
    return 0;
}

// Send n payload trytes (already at tl_txbuf + TL_HLEN) to dst.
fn tl_send(dst: int, type: int, n: int) -> int {
    return tl_xmit(&tl_txbuf[0], tl_build(&tl_txbuf[0], dst, type, n));
}

// A frame from the card.
fn tl_input(f: *tryte, len: int) {
    tl_rx_frames += 1;
    tl_rx_trytes += len;
    if (len < TL_MIN) { tl_short += 1; return; }
    if (!tl_check(f, len)) { tl_bad_check += 1; return; }
    var dst: int = tl_word(f, 0);
    if (dst != tl_addr && dst != 0) { tl_not_ours += 1; return; }
    var src: int = tl_word(f, 3);
    var type: int = f[6];
    var n: int = len - TL_HLEN - TL_CLEN;
    if (type == TL_ECHO) {
        // the payload comes back unchanged
        var k: int = 0;
        while (k < n) { tl_txbuf[TL_HLEN + k] = f[TL_HLEN + k]; k += 1; }
        tl_send(src, TL_ECHO_REPLY, n);
        return;
    }
    if (type == TL_ECHO_REPLY) { tl_echoes += 1; return; }
    if (type == TL_TNP) { tnp_input(src, &f[TL_HLEN], n); return; }
    tl_bad_type += 1;
}

// A station address as three trytes, dotted: 0.0.1
fn tl_addr_str(a: int, buf: *char) -> int {
    var n: int = 0;
    var part: [3]int;
    part[0] = ext(a, 1, 9);
    part[1] = ext(a, 10, 9);
    part[2] = ext(a, 19, 9);
    var k: int = 0;
    while (k < 3) {
        var tmp: [12]char;
        var s: *char = itoa(part[k], &tmp[0]);
        var j: int = 0;
        while (s[j] != 0) { buf[n] = s[j]; n += 1; j += 1; }
        if (k < 2) { buf[n] = '.'; n += 1; }
        k += 1;
    }
    buf[n] = 0;
    return n;
}
