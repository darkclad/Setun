// tnp: TNP, the network layer of TNET (docs/TNET.md §3), and TCMP, its
// control messages (§3.1).
//
// A packet is built in tl_txbuf after the TL header: the TNP header at
// TL_HLEN, the transport header at TNP_OFF. tnp_send() fills in the TNP
// header and hands the frame to the link.

import "../params.tri";
import "../printk.tri";
import "tl.tri";

const TNP_HLEN: int = 9;
const TNP_OFF: int = 16;                  // TL_HLEN + TNP_HLEN: where a transport header goes
const TNP_MAXDATA: int = 2169;            // TL_MTU - TNP_HLEN
const TNP_HOPS: int = 27;

const TNP_TSP: int = 1;
const TNP_TDP: int = 2;
const TNP_TCMP: int = 3;

const TCMP_ECHO: int = 1;
const TCMP_ECHO_REPLY: int = 2;
const TCMP_UNREACH: int = 3;
const TCMP_NO_PROTO: int = 1;
const TCMP_NO_PORT: int = 2;

// counters (/proc/net/tlink)
var tnp_rx_packets: int;
var tnp_tx_packets: int;
var tnp_rx_dropped: int;                  // malformed, not ours, or hop limit 0
var tnp_rx_unknown: int;                  // unknown protocol (answered "unreachable")
var tcmp_echoes_answered: int;

// Send the n trytes of transport data at tl_txbuf[TNP_OFF] to dst.
fn tnp_send(proto: int, dst: int, n: int) -> int {
    if (n > TNP_MAXDATA) { return -EMSGSIZE; }
    var h: *tryte = &tl_txbuf[TL_HLEN];
    tl_put_word(h, 0, dst);
    tl_put_word(h, 3, tl_addr);
    h[6] = proto as tryte;
    h[7] = TNP_HOPS as tryte;
    h[8] = n as tryte;
    if (tl_send(dst, TL_TNP, TNP_HLEN + n) < 0) { return -ENOBUFS; }
    tnp_tx_packets += 1;
    return 0;
}

// TCMP: answer echo requests; replies go to raw sockets (tping).
fn tcmp_input(src: int, p: *tryte, n: int, pkt: *tryte, total: int) {
    if (n < 1) { tnp_rx_dropped += 1; return; }
    var type: int = p[0];
    if (type == TCMP_ECHO) {
        if (n < 3) { tnp_rx_dropped += 1; return; }
        var t: *tryte = &tl_txbuf[TNP_OFF];
        var k: int = 0;
        while (k < n) { t[k] = p[k]; k += 1; }
        t[0] = TCMP_ECHO_REPLY;
        tcmp_echoes_answered += 1;
        tnp_send(TNP_TCMP, src, n);
        return;
    }
    // replies and unreachables: whoever listens (raw TCMP sockets)
    tn_raw_deliver(src, p, n);
}

// "Unreachable" back to the sender of the packet at pkt (total trytes).
fn tcmp_unreachable(src: int, code: int, pkt: *tryte, total: int) {
    var t: *tryte = &tl_txbuf[TNP_OFF];
    t[0] = TCMP_UNREACH;
    t[1] = code as tryte;
    t[2] = 0;
    var m: int = total < TNP_HLEN + 27 ? total : TNP_HLEN + 27;
    var k: int = 0;
    while (k < m) { t[3 + k] = pkt[k]; k += 1; }
    tnp_send(TNP_TCMP, src, 3 + m);
}

// A TNP packet from the link (the payload of a TL frame from station src).
fn tnp_input(station: int, pkt: *tryte, total: int) {
    tnp_rx_packets += 1;
    if (total < TNP_HLEN) { tnp_rx_dropped += 1; return; }
    var dst: int = tl_word(pkt, 0);
    var src: int = tl_word(pkt, 3);
    var proto: int = pkt[6];
    var hops: int = pkt[7];
    var n: int = pkt[8];
    if (n < 0 || TNP_HLEN + n > total || hops <= 0 || dst != tl_addr || src == 0) { tnp_rx_dropped += 1; return; }
    var p: *tryte = &pkt[TNP_HLEN];
    if (proto == TNP_TCMP) { tcmp_input(src, p, n, pkt, total); return; }
    if (proto == TNP_TSP) { tsp_input(src, p, n); return; }
    tnp_rx_unknown += 1;
    tcmp_unreachable(src, TCMP_NO_PROTO, pkt, total);
}

// A host address as three trytes, dotted (the same as a station's).
fn tn_ntoa(a: int, buf: *char) -> int { return tl_addr_str(a, buf); }
