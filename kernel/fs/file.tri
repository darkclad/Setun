// file: descriptors, open files and the file-system system calls.
//
// Each task has 27 descriptors; a descriptor names an entry in the global
// open-file table (shared after fork and dup, as in Unix), which names an
// inode. Reads and writes dispatch on the inode type: file data (through
// the VFS), a character device, or a pipe.

import "../params.tri";
import "../printk.tri";
import "../mm.tri";
import "../vm.tri";
import "../exec.tri";
import "vfs.tri";
import "tfs.tri";
import "bcache.tri";
import "pipe.tri";
import "devfs.tri";
import "../drivers/tty.tri";
import "../sched.tri";

const NFDS: int = 27;
const AT_FDCWD: int = -100;
const AT_REMOVEDIR: int = 512;
const O_EXCL: int = 128;
const SEEK_SET: int = 0;
const SEEK_CUR: int = 1;
const SEEK_END: int = 2;

const EACCES: int = 13;
const EMFILE: int = 24;
const ESPIPE: int = 29;
const ERANGE: int = 34;

// struct stat: one word per field (see tlibc).
struct Stat {
    st_dev: int;
    st_ino: int;
    st_mode: int;
    st_nlink: int;
    st_uid: int;
    st_gid: int;
    st_rdev: int;
    st_size: int;
    st_blksize: int;
    st_blocks: int;
    st_atime: int;
    st_mtime: int;
    st_ctime: int;
}

// struct statfs: one word per field, Linux order.
struct Statfs {
    f_type: int;
    f_bsize: int;
    f_blocks: int;
    f_bfree: int;
    f_bavail: int;
    f_files: int;
    f_ffree: int;
    f_fsid: int;
    f_namelen: int;
    f_frsize: int;
    f_flags: int;
}

const TFS_SUPER_MAGIC: int = 29798;           // "tf"
const RAMFS_MAGIC: int = 2240043254;          // Linux's
const PROC_SUPER_MAGIC: int = 40864;          // Linux's

var kpath: [243]char;                 // a path copied in from user space
var kpath2: [243]char;

// ---- open files ------------------------------------------------------------------

fn file_close(f: int) {
    files[f].refs -= 1;
    if (files[f].refs > 0) { return; }
    var i: int = files[f].ino;
    if (inodes[i].type == I_FIFO) { pipe_close(inodes[i].rdev, writable(f)); }
    if (inodes[i].type == I_CHR) { dev_close(inodes[i].rdev, f); }
    inodes[i].opens -= 1;
    inode_release(i);
}

const O_NONBLOCK_: int = 2048;

fn nonblocking(f: int) -> int { return has(files[f].flags, O_NONBLOCK_); }

fn file_read(f: int, buf: *tryte, n: int) -> int {
    if (!readable(f)) { return -EBADF; }
    var i: int = files[f].ino;
    var node: *Inode = &inodes[i];
    switch (node.type) {
        case I_DIR: return -EISDIR;
        case I_FIFO: return pipe_read(node.rdev, buf, n, nonblocking(f));
        case I_CHR: return dev_read(node.rdev, f, buf, n, nonblocking(f));
    }
    var r: int = vfs_read(i, files[f].pos, buf, n);
    if (r > 0) { files[f].pos += r; }
    return r;
}

fn file_write(f: int, buf: *tryte, n: int) -> int {
    if (!writable(f)) { return -EBADF; }
    var i: int = files[f].ino;
    var node: *Inode = &inodes[i];
    switch (node.type) {
        case I_DIR: return -EISDIR;
        case I_FIFO: return pipe_write(node.rdev, buf, n, nonblocking(f));
        case I_CHR: return dev_write(node.rdev, f, buf, n, nonblocking(f));
    }
    if (has(files[f].flags, O_APPEND)) { files[f].pos = node.size; }
    if (n == 0) { return 0; }
    var r: int = vfs_write(i, files[f].pos, buf, n);
    if (r > 0) { files[f].pos += r; }
    return r;
}

// ---- descriptors -------------------------------------------------------------------

// The open file behind `fd`, or -EBADF.
fn fd_file(fd: int) -> int {
    if (fd < 0 || fd >= NFDS) { return -EBADF; }
    var f: int = current_task().fds[fd] - 1;
    if (f < 0) { return -EBADF; }
    touch(files[f].ino);
    return f;
}

// Give file `f` the lowest free descriptor at or above `from`.
fn fd_install(f: int, from: int) -> int {
    var t: *Task = current_task();
    var fd: int = from;
    while (fd < NFDS) {
        if (t.fds[fd] == 0) {
            t.fds[fd] = f + 1;
            t.fd_cloexec[fd] = 0;
            return fd;
        }
        fd += 1;
    }
    return -EMFILE;
}

fn fs_fork(parent: *Task, child: *Task) {
    var fd: int = 0;
    while (fd < NFDS) {
        child.fds[fd] = parent.fds[fd];
        if (child.fds[fd] != 0) { files[child.fds[fd] - 1].refs += 1; }
        fd += 1;
    }
    child.cwd = parent.cwd;
}

fn fs_exit(t: *Task) {
    var fd: int = 0;
    while (fd < NFDS) {
        if (t.fds[fd] != 0) {
            file_close(t.fds[fd] - 1);
            t.fds[fd] = 0;
        }
        fd += 1;
    }
}

// pid 1 starts with /dev/console on descriptors 0, 1 and 2.
fn fs_init_task(t: *Task) {
    t.cwd = root_ino;
    var c: int = path_lookup("/dev/console", root_ino);
    if (c < 0) { printk("init: no /dev/console\n"); return; }
    var f: int = file_alloc(c, O_RDWR);
    if (f < 0) { return; }
    files[f].refs = 3;
    t.fds[0] = f + 1;
    t.fds[1] = f + 1;
    t.fds[2] = f + 1;
}

// ---- system calls ----------------------------------------------------------------------

// Copy a user path into `dst`. Returns 0 or -errno.
fn get_path_into(p: int, dst: *char) -> int {
    if (p == 0) { return -EFAULT; }
    var n: int = copy_user_string(p, dst, 243);
    if (n < 0) { return is_user_address(p) ? -ENAMETOOLONG : -EFAULT; }
    if (n == 0) { return -ENOENT_; }
    return 0;
}

fn get_path(p: int) -> int { return get_path_into(p, &kpath[0]); }

// The directory a relative path starts from.
fn dir_base_for(dirfd: int, path: *char) -> int {
    if (dirfd == AT_FDCWD || path[0] == '/') { return current_task().cwd; }
    var f: int = fd_file(dirfd);
    if (f < 0) { return f; }
    if (inodes[files[f].ino].type != I_DIR) { return -ENOTDIR; }
    return files[f].ino;
}

fn dir_base(dirfd: int) -> int { return dir_base_for(dirfd, &kpath[0]); }

// mode without the bits set in the umask (both octal permission sets).
fn apply_umask(mode: int) -> int {
    var m: int = (mode % 4096 + 4096) % 4096;
    var u: int = current_task().umask;
    var r: int = 0;
    var b: int = 1;
    while (b < 4096) {
        if (m / b % 2 != 0 && u / b % 2 == 0) { r += b; }
        b *= 2;
    }
    return r;
}

const O_CLOEXEC_: int = 524288;

fn sys_openat(dirfd: int, path: int, flags: int, mode: int) -> int {
    var r: int = get_path(path);
    if (r < 0) { return r; }
    var base: int = dir_base(dirfd);
    if (base < 0) { return base; }
    var i: int = path_lookup(&kpath[0], base);
    if (i >= 0 && has(flags, O_CREAT) && has(flags, O_EXCL)) { return -EEXIST; }
    if (i == -ENOENT_ && has(flags, O_CREAT)) {
        i = vfs_create(&kpath[0], base, I_REG, apply_umask(mode % 512));
    }
    if (i < 0) { return i; }
    var acc: int = flags % 4;
    if (inodes[i].type == I_DIR && acc != 0) { return -EISDIR; }
    if (inodes[i].type != I_DIR && has(flags, O_DIRECTORY)) { return -ENOTDIR; }
    if (inodes[i].fs == FS_PROC && acc != 0) { return -EACCES; }
    if (inodes[i].type == I_REG && has(flags, O_TRUNC) && acc != 0) {
        var t: int = vfs_truncate(i);
        if (t < 0) { return t; }
    }
    var f: int = file_alloc(i, flags);
    if (f < 0) { return f; }
    if (inodes[i].type == I_CHR) {
        var d: int = dev_open(inodes[i].rdev, f);
        if (d < 0) {
            files[f].refs = 0;
            inodes[i].opens -= 1;
            return d;
        }
    }
    var fd: int = fd_install(f, 0);
    if (fd < 0) { file_close(f); return fd; }
    current_task().fd_cloexec[fd] = has(flags, O_CLOEXEC_) as tryte;
    return fd;
}

fn sys_close(fd: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    current_task().fds[fd] = 0;
    file_close(f);
    return 0;
}

fn sys_read(fd: int, buf: int, n: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    if (!user_range_ok(buf, n)) { return -EFAULT; }
    return file_read(f, buf as *tryte, n);
}

fn sys_write(fd: int, buf: int, n: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    if (!user_range_ok(buf, n)) { return -EFAULT; }
    return file_write(f, buf as *tryte, n);
}

fn sys_lseek(fd: int, off: int, whence: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    var node: *Inode = &inodes[files[f].ino];
    var is_fb: int = node.type == I_CHR && node.rdev == DEV_FB0;    // fbdev seeks over its pixels
    if (node.type == I_FIFO || (node.type == I_CHR && !is_fb)) { return -ESPIPE; }
    var pos: int;
    switch (whence) {
        case SEEK_SET: pos = off;
        case SEEK_CUR: pos = files[f].pos + off;
        case SEEK_END: pos = (is_fb ? fb_size() : node.size) + off;
        default: return -EINVAL;
    }
    if (pos < 0) { return -EINVAL; }
    files[f].pos = pos;
    return pos;
}

fn sys_dup(fd: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    var nfd: int = fd_install(f, 0);
    if (nfd >= 0) { files[f].refs += 1; }
    return nfd;
}

fn sys_dup3(fd: int, nfd: int, flags: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    if (nfd < 0 || nfd >= NFDS || nfd == fd) { return -EINVAL; }
    var t: *Task = current_task();
    if (t.fds[nfd] != 0) { file_close(t.fds[nfd] - 1); }
    t.fds[nfd] = f + 1;
    t.fd_cloexec[nfd] = has(flags, O_CLOEXEC_) as tryte;
    files[f].refs += 1;
    return nfd;
}

fn sys_pipe2(fds: int, flags: int) -> int {
    if (!user_range_ok(fds - 1, 6)) { return -EFAULT; }
    var i: int = inode_alloc(I_FIFO, 384);              // 0600
    if (i < 0) { return -ENFILE; }
    inodes[i].unlinked = 1;                              // anonymous: freed on last close
    var p: int = pipe_create();
    if (p < 0) { inode_free(i); return -ENFILE; }
    inodes[i].rdev = p;
    var rf: int = file_alloc(i, 0);
    var wf: int = file_alloc(i, O_WRONLY);
    var rfd: int = rf < 0 ? -1 : fd_install(rf, 0);
    var wfd: int = wf < 0 || rfd < 0 ? -1 : fd_install(wf, 0);
    if (wfd < 0) {
        if (rfd >= 0) { current_task().fds[rfd] = 0; }
        if (rf >= 0) { file_close(rf); }
        if (wf >= 0) { file_close(wf); }
        return rf < 0 || wf < 0 ? -ENFILE : -EMFILE;
    }
    var out_fds: *int = fds as *int;
    out_fds[0] = rfd;
    out_fds[1] = wfd;
    current_task().fd_cloexec[rfd] = has(flags, O_CLOEXEC_) as tryte;
    current_task().fd_cloexec[wfd] = has(flags, O_CLOEXEC_) as tryte;
    return 0;
}

fn fill_stat(i: int, buf: int) -> int {
    if (!user_range_ok(buf - 1, sizeof(Stat))) { return -EFAULT; }
    var st: *Stat = buf as *Stat;
    var node: *Inode = &inodes[i];
    st.st_dev = node.mnt + 1;
    st.st_ino = stat_ino(i);
    st.st_mode = st_mode(i);
    st.st_nlink = node.nlink;
    st.st_uid = 0;
    st.st_gid = 0;
    st.st_rdev = node.type == I_CHR ? node.rdev : 0;
    st.st_size = node.type == I_REG || node.type == I_DIR ? node.size : 0;
    st.st_blksize = PAGE;
    st.st_blocks = (st.st_size + PAGE - 1) / PAGE;
    st.st_atime = node.mtime;
    st.st_mtime = node.mtime;
    st.st_ctime = node.mtime;
    return 0;
}

fn sys_fstat(fd: int, buf: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    return fill_stat(files[f].ino, buf);
}

fn sys_newfstatat(dirfd: int, path: int, buf: int, flags: int) -> int {
    var r: int = get_path(path);
    if (r < 0) { return r; }
    var base: int = dir_base(dirfd);
    if (base < 0) { return base; }
    var i: int = path_lookup(&kpath[0], base);
    if (i < 0) { return i; }
    return fill_stat(i, buf);
}

// One linux_dirent64 record: d_ino, d_off, d_reclen (words), d_type
// (tryte), then the NUL-terminated name; records are whole words.
fn put_dirent(at: int, ino: int, off: int, type: int, name: *char, room: int) -> int {
    var len: int = strlen(name);
    var reclen: int = (10 + len + 1 + 2) / 3 * 3;
    if (reclen > room) { return 0; }
    var w: *int = (at + 1) as *int;
    w[0] = ino;
    w[1] = off;
    w[2] = reclen;
    var t: *tryte = at as *tryte;
    t[9] = type as tryte;
    var k: int = 0;
    while (k <= len) { t[10 + k] = name[k]; k += 1; }
    return reclen;
}

fn sys_getdents64(fd: int, buf: int, n: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    var dir: int = files[f].ino;
    if (inodes[dir].type != I_DIR) { return -ENOTDIR; }
    if (!user_range_ok(buf, n)) { return -EFAULT; }
    if ((buf + 1) % 3 != 0) { return -EINVAL; }          // must hold whole words
    var used: int = 0;
    var name: [81]char;
    var info: [2]int;
    loop {
        var pos: int = files[f].pos;
        var next: int = vfs_readdir(dir, pos, &name[0], &info[0]);
        if (next < 0) { return used > 0 ? used : next; }
        if (next == 0) { break; }
        var r: int = put_dirent(buf + used, info[0], next, info[1], &name[0], n - used);
        if (r == 0) {
            if (used == 0) { return -EINVAL; }           // buffer too small for one entry
            break;
        }
        used += r;
        files[f].pos = next;
    }
    return used;
}

fn sys_mkdirat(dirfd: int, path: int, mode: int) -> int {
    var r: int = get_path(path);
    if (r < 0) { return r; }
    var base: int = dir_base(dirfd);
    if (base < 0) { return base; }
    var i: int = vfs_create(&kpath[0], base, I_DIR, apply_umask(mode % 512));
    return i < 0 ? i : 0;
}

fn sys_unlinkat(dirfd: int, path: int, flags: int) -> int {
    var r: int = get_path(path);
    if (r < 0) { return r; }
    var base: int = dir_base(dirfd);
    if (base < 0) { return base; }
    return vfs_unlink(&kpath[0], base, has(flags, AT_REMOVEDIR));
}

fn sys_renameat(olddirfd: int, oldpath: int, newdirfd: int, newpath: int) -> int {
    var r: int = get_path_into(oldpath, &kpath[0]);
    if (r < 0) { return r; }
    r = get_path_into(newpath, &kpath2[0]);
    if (r < 0) { return r; }
    if ((olddirfd != AT_FDCWD && kpath[0] != '/') || (newdirfd != AT_FDCWD && kpath2[0] != '/')) { return -EINVAL; }
    return vfs_rename(&kpath[0], &kpath2[0], current_task().cwd);
}

fn sys_chdir(path: int) -> int {
    var r: int = get_path(path);
    if (r < 0) { return r; }
    var i: int = path_lookup(&kpath[0], current_task().cwd);
    if (i < 0) { return i; }
    if (inodes[i].type != I_DIR) { return -ENOTDIR; }
    current_task().cwd = i;
    return 0;
}

fn sys_getcwd(buf: int, size: int) -> int {
    var n: int = vfs_path_of(current_task().cwd, &kpath[0], 243);
    if (n < 0) { return n; }
    if (size < n + 1) { return -ERANGE; }
    if (!user_range_ok(buf, n + 1)) { return -EFAULT; }
    copy_trytes(buf as *tryte, &kpath[0] as *tryte, n + 1);
    return n + 1;
}

fn sys_ioctl(fd: int, cmd: int, arg: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    var i: int = files[f].ino;
    if (inodes[i].type != I_CHR || !dev_ioctl_known(inodes[i].rdev, f, cmd)) { return -25; }   // ENOTTY
    if (!user_range_ok(arg - 1, sizeof(Termios))) { return -EFAULT; }
    return dev_ioctl(inodes[i].rdev, f, cmd, arg);
}

fn sys_sync() -> int {
    tfs_sync();
    return 0;
}

fn sys_fsync(fd: int) -> int {
    var f: int = fd_file(fd);
    if (f < 0) { return f; }
    if (inodes[files[f].ino].fs == FS_TFS && tfs_sync() < 0) { return -EIO_; }
    return 0;
}

fn sys_statfs(path: int, buf: int) -> int {
    var r: int = get_path(path);
    if (r < 0) { return r; }
    var i: int = path_lookup(&kpath[0], current_task().cwd);
    if (i < 0) { return i; }
    if (!user_range_ok(buf - 1, sizeof(Statfs))) { return -EFAULT; }
    var s: *Statfs = buf as *Statfs;
    var fs: int = inodes[i].fs;
    s.f_bsize = PAGE;
    s.f_frsize = PAGE;
    s.f_fsid = inodes[i].mnt + 1;
    s.f_flags = 0;
    if (fs == FS_TFS) {
        s.f_type = TFS_SUPER_MAGIC;
        s.f_blocks = tfs_nblocks - tfs_data;
        s.f_bfree = tfs_free_blocks;
        s.f_files = tfs_ninodes;
        s.f_ffree = tfs_free_inodes;
        s.f_namelen = TFS_NAME_MAX;
    } else {
        s.f_type = fs == FS_PROC ? PROC_SUPER_MAGIC : RAMFS_MAGIC;
        s.f_blocks = fs == FS_PROC ? 0 : ram_frames;
        s.f_bfree = fs == FS_PROC ? 0 : free_frames;
        s.f_files = NINODES;
        var used: int = 0;
        var k: int = 1;
        while (k < NINODES) { if (inodes[k].type != I_FREE) { used += 1; } k += 1; }
        s.f_ffree = NINODES - used;
        s.f_namelen = RAM_NAME_MAX;
    }
    s.f_bavail = s.f_bfree;
    return 0;
}

// mount(source, target, type, flags, data): ramfs/tmpfs and proc.
fn sys_mount(source: int, target: int, type: int, flags: int, data: int) -> int {
    var tname: [27]char;
    var src: [27]char;
    if (copy_user_string(type, &tname[0], 27) < 0) { return -EFAULT; }
    if (source == 0 || copy_user_string(source, &src[0], 27) < 0) { copy_str(&src[0], "none", 5); }
    var r: int = get_path(target);
    if (r < 0) { return r; }
    var fs: int;
    if (names_equal(&tname[0], "ramfs") || names_equal(&tname[0], "tmpfs")) { fs = FS_RAM; }
    else if (names_equal(&tname[0], "proc")) { fs = FS_PROC; }
    else if (names_equal(&tname[0], "tfs")) { return -EBUSY; }       // the one volume is the root
    else { return -ENODEV; }
    var point: int = path_lookup(&kpath[0], current_task().cwd);
    if (point < 0) { return point; }
    var full: [81]char;
    var n: int = vfs_path_of(point, &full[0], 81);
    if (n < 0 && inodes[point].type == I_DIR) { return n; }
    var m: int = do_mount(fs, point, &src[0], &full[0]);
    return m < 0 ? m : 0;
}

fn sys_umount2(target: int, flags: int) -> int {
    var r: int = get_path(target);
    if (r < 0) { return r; }
    var i: int = path_lookup(&kpath[0], current_task().cwd);
    if (i < 0) { return i; }
    if (i == root_ino) { return -EBUSY; }
    return do_umount(i);
}

const REBOOT_MAGIC1: int = 4276215469;
const REBOOT_MAGIC2: int = 672274793;
const REBOOT_CMD_RESTART: int = 19088743;
const REBOOT_CMD_POWER_OFF: int = 1126301404;
const REBOOT_CMD_HALT: int = 3454992675;

fn sys_reboot(magic1: int, magic2: int, cmd: int) -> int {
    if (magic1 != REBOOT_MAGIC1 || magic2 != REBOOT_MAGIC2) { return -EINVAL; }
    if (cmd != REBOOT_CMD_RESTART && cmd != REBOOT_CMD_POWER_OFF && cmd != REBOOT_CMD_HALT) { return -EINVAL; }
    if (tfs_shutdown() < 0) { printk("reboot: some buffers could not be written\n"); }
    if (cmd == REBOOT_CMD_RESTART) {
        printk("reboot: Restarting system\n");
        out(SYSCTL_POWER, 1);
    } else {
        printk(cmd == REBOOT_CMD_HALT ? "reboot: System halted\n" : "reboot: Power down\n");
        out(SYSCTL_POWER, -1);
    }
    loop { hlt(); }
}

// ---- poll ------------------------------------------------------------------------------

struct Pollfd {
    fd: int;
    events: int;
    revents: int;
}

const POLLIN_: int = 1;
const POLLOUT_: int = 4;
const POLLERR: int = 8;
const POLLHUP_: int = 16;
const POLLNVAL: int = 32;
const MAX_POLL: int = 81;

// The bits common to two small flag sets (Trine's & is tritwise).
fn bits_and(a: int, b: int) -> int {
    var r: int = 0;
    var bit: int = 1;
    while (bit <= 32) {
        if (a / bit % 2 != 0 && b / bit % 2 != 0) { r += bit; }
        bit *= 2;
    }
    return r;
}

fn file_poll(f: int) -> int {
    var i: int = files[f].ino;
    var node: *Inode = &inodes[i];
    if (node.type == I_FIFO) {
        var p: int = node.rdev;
        if (writable(f)) {
            if (pipes[p].readers == 0) { return POLLERR; }
            return pipes[p].count < PIPE_SIZE ? POLLOUT_ : 0;
        }
        var r: int = 0;
        if (pipes[p].count > 0) { r += POLLIN_; }
        if (pipes[p].writers == 0) { r += POLLHUP_; }
        return r;
    }
    if (node.type == I_CHR) { return dev_poll(node.rdev, f); }
    return POLLIN_ + POLLOUT_;                       // files and directories never block
}

// ppoll(fds, nfds, timeout, sigmask): timeout null = wait forever.
fn sys_ppoll(fds: int, nfds: int, tsp: int, sigmask: int) -> int {
    if (nfds < 0 || nfds > MAX_POLL) { return -EINVAL; }
    if (nfds > 0 && !user_range_ok(fds - 1, sizeof(Pollfd) * nfds)) { return -EFAULT; }
    var until: int = -1;
    if (tsp != 0) {
        if (!user_range_ok(tsp - 1, 6)) { return -EFAULT; }
        var ts: *int = tsp as *int;
        if (ts[0] < 0 || ts[1] < 0 || ts[1] > 999999999) { return -EINVAL; }
        until = jiffies + ts[0] * HZ + (ts[1] + 9999999) / 10000000;
    }
    var pf: *Pollfd = fds as *Pollfd;
    loop {
        var count: int = 0;
        var k: int = 0;
        while (k < nfds) {
            var p: *Pollfd = &pf[k];
            p.revents = 0;
            if (p.fd >= 0) {
                var f: int = fd_file(p.fd);
                if (f < 0) {
                    p.revents = POLLNVAL;
                } else {
                    p.revents = bits_and(file_poll(f), p.events + POLLERR + POLLHUP_);
                }
                if (p.revents != 0) { count += 1; }
            }
            k += 1;
        }
        if (count > 0) { return count; }
        if (until >= 0 && jiffies >= until) { return 0; }
        if (sleep_on(POLL_CHAN)) { return -EINTR; }
    }
}
