// vfs: inodes, directories, path lookup, regular-file data, open files.
//
// The root file system is a ramfs. In v1 a directory entry is merged into
// the inode it names (one name per inode: no hard links yet); directories
// keep their children on a sibling list. Regular files hold their data in
// a triddy block that grows on demand; files from the initramfs point into
// the archive until their first write.

import "../params.tri";
import "../printk.tri";
import "../mm.tri";

const NINODES: int = 243;
const NFILES: int = 243;
const NAME_MAX: int = 26;

const I_FREE: int = 0;
const I_REG: int = 1;
const I_DIR: int = 2;
const I_CHR: int = 3;
const I_FIFO: int = 4;

// st_mode file types (Linux values)
const S_IFIFO: int = 4096;
const S_IFCHR: int = 8192;
const S_IFDIR: int = 16384;
const S_IFREG: int = 32768;

// errno (Linux)
const EPERM: int = 1;
const ENOENT_: int = 2;
const EEXIST: int = 17;
const ENOTDIR: int = 20;
const EISDIR: int = 21;
const ENFILE: int = 23;
const ENOSPC: int = 28;
const ENAMETOOLONG: int = 36;
const ENOTEMPTY: int = 39;

struct Inode {
    type: int;
    mode: int;                        // permission bits
    size: int;                        // trytes
    nlink: int;
    parent: int;                      // directory containing it
    child: int;                       // DIR: first child, or -1
    sibling: int;                     // next entry in the parent, or -1
    data: int;                        // REG: first tryte of the contents
    cap: int;                         // REG: capacity in trytes
    block: int;                       // REG: centre frame of the owned block, or -1
    order: int;                       // REG: triddy order of that block
    rdev: int;                        // CHR: device number; FIFO: pipe index
    opens: int;                       // open files referring to it
    unlinked: int;                    // removed from its directory, freed on last close
    name: [27]char;
}

var inodes: [243]Inode;
var root_ino: int;

struct File {
    refs: int;                        // descriptors (in any process) sharing it
    ino: int;
    pos: int;
    flags: int;                       // O_* flags from open
}

var files: [243]File;

// O_* flags (Linux values)
const O_ACCMODE: int = 3;
const O_WRONLY: int = 1;
const O_RDWR: int = 2;
const O_CREAT: int = 64;
const O_TRUNC: int = 512;
const O_APPEND: int = 1024;
const O_DIRECTORY: int = 65536;

fn has(flags: int, bit: int) -> int { return flags / bit % 2 != 0; }

// ---- inodes and directories ------------------------------------------------

fn inode_alloc(type: int, mode: int) -> int {
    var i: int = 1;
    while (i < NINODES) {
        if (inodes[i].type == I_FREE) {
            var n: *Inode = &inodes[i];
            n.type = type;
            n.mode = mode;
            n.size = 0;
            n.nlink = 1;
            n.parent = i;
            n.child = -1;
            n.sibling = -1;
            n.data = 0;
            n.cap = 0;
            n.block = -1;
            n.order = 0;
            n.rdev = 0;
            n.opens = 0;
            n.unlinked = 0;
            n.name[0] = 0;
            return i;
        }
        i += 1;
    }
    return -1;
}

fn inode_free(i: int) {
    var n: *Inode = &inodes[i];
    if (n.block >= 0) { free_pages(n.block, n.order); }
    n.type = I_FREE;
}

fn set_name(i: int, s: *char, len: int) {
    var k: int = 0;
    while (k < len) { inodes[i].name[k] = s[k]; k += 1; }
    inodes[i].name[len] = 0;
}

fn dir_add(dir: int, i: int) {
    inodes[i].parent = dir;
    inodes[i].sibling = inodes[dir].child;
    inodes[dir].child = i;
}

fn dir_remove(dir: int, i: int) {
    var p: *int = &inodes[dir].child;
    while (*p != -1) {
        if (*p == i) { *p = inodes[i].sibling; return; }
        p = &inodes[*p].sibling;
    }
}

// The child of `dir` named s[0..len), or -1.
fn dir_lookup(dir: int, s: *char, len: int) -> int {
    var c: int = inodes[dir].child;
    while (c != -1) {
        var k: int = 0;
        while (k < len && inodes[c].name[k] == s[k]) { k += 1; }
        if (k == len && inodes[c].name[len] == 0) { return c; }
        c = inodes[c].sibling;
    }
    return -1;
}

fn vfs_init() {
    root_ino = inode_alloc(I_DIR, 493);         // 0755
    inodes[root_ino].parent = root_ino;
}

// ---- path lookup ---------------------------------------------------------------

var leaf: [27]char;                          // last component found by path_parent
var leaf_len: int;

// Walk `path` (absolute, or relative to `cwd`). With `want_parent`, stop
// before the last component, leave it in `leaf`, and return its directory.
// Returns an inode or -errno.
fn walk(path: *char, cwd: int, want_parent: int) -> int {
    var cur: int = path[0] == '/' ? root_ino : cwd;
    var i: int = 0;
    loop {
        while (path[i] == '/') { i += 1; }
        if (path[i] == 0) {
            if (want_parent) { return -ENOENT_; }        // no last component ("/")
            return cur;
        }
        var start: int = i;
        while (path[i] != 0 && path[i] != '/') { i += 1; }
        var len: int = i - start;
        if (len > NAME_MAX) { return -ENAMETOOLONG; }
        var last: int = 1;
        var j: int = i;
        while (path[j] == '/') { j += 1; }
        if (path[j] != 0) { last = 0; }
        if (inodes[cur].type != I_DIR) { return -ENOTDIR; }
        if (last && want_parent) {
            var k: int = 0;
            while (k < len) { leaf[k] = path[start + k]; k += 1; }
            leaf[len] = 0;
            leaf_len = len;
            return cur;
        }
        var next: int;
        if (len == 1 && path[start] == '.') { next = cur; }
        else if (len == 2 && path[start] == '.' && path[start + 1] == '.') { next = inodes[cur].parent; }
        else { next = dir_lookup(cur, &path[start], len); }
        if (next < 0) { return -ENOENT_; }
        cur = next;
        if (last) { return cur; }
    }
}

fn path_lookup(path: *char, cwd: int) -> int { return walk(path, cwd, 0); }

// Create a new inode at `path`. Returns it, or -errno.
fn vfs_create(path: *char, cwd: int, type: int, mode: int) -> int {
    var dir: int = walk(path, cwd, 1);
    if (dir < 0) { return dir; }
    if ((leaf_len == 1 && leaf[0] == '.') || (leaf_len == 2 && leaf[0] == '.' && leaf[1] == '.')) { return -EEXIST; }
    if (dir_lookup(dir, &leaf[0], leaf_len) >= 0) { return -EEXIST; }
    var i: int = inode_alloc(type, mode);
    if (i < 0) { return -ENOSPC; }
    set_name(i, &leaf[0], leaf_len);
    dir_add(dir, i);
    return i;
}

// Make every directory along `path` (like mkdir -p); returns the last.
fn vfs_mkdirs(path: *char) -> int {
    var buf: [81]char;
    var i: int = 0;
    var cur: int = root_ino;
    while (path[i] != 0) {
        buf[i] = path[i];
        i += 1;
        if (path[i] == '/' || path[i] == 0) {
            buf[i] = 0;
            var found: int = path_lookup(&buf[0], root_ino);
            if (found < 0) { found = vfs_create(&buf[0], root_ino, I_DIR, 493); }
            if (found < 0) { return found; }
            cur = found;
        }
    }
    return cur;
}

fn vfs_unlink(path: *char, cwd: int, want_dir: int) -> int {
    var i: int = path_lookup(path, cwd);
    if (i < 0) { return i; }
    if (i == root_ino) { return -EPERM; }
    var n: *Inode = &inodes[i];
    if (want_dir) {
        if (n.type != I_DIR) { return -ENOTDIR; }
        if (n.child != -1) { return -ENOTEMPTY; }
    } else if (n.type == I_DIR) { return -EISDIR; }
    dir_remove(n.parent, i);
    n.unlinked = 1;
    if (n.opens == 0) { inode_free(i); }
    return 0;
}

// The absolute path of directory `i` into buf (size max); returns its length.
fn vfs_path_of(i: int, buf: *char, max: int) -> int {
    if (i == root_ino) {
        buf[0] = '/';
        buf[1] = 0;
        return 1;
    }
    var n: int = vfs_path_of(inodes[i].parent, buf, max);
    if (n == 1) { n = 0; }                       // avoid "//"
    buf[n] = '/';
    n += 1;
    var k: int = 0;
    while (inodes[i].name[k] != 0 && n < max - 1) {
        buf[n] = inodes[i].name[k];
        n += 1;
        k += 1;
    }
    buf[n] = 0;
    return n;
}

fn st_mode(i: int) -> int {
    var t: int = inodes[i].type;
    var m: int = inodes[i].mode;
    if (t == I_DIR) { return S_IFDIR + m; }
    if (t == I_CHR) { return S_IFCHR + m; }
    if (t == I_FIFO) { return S_IFIFO + m; }
    return S_IFREG + m;
}

// ---- regular-file data ---------------------------------------------------------

// Make room for `size` trytes, moving the data into an owned block if needed.
fn reg_reserve(i: int, size: int) -> int {
    var n: *Inode = &inodes[i];
    if (size <= n.cap && n.block >= 0) { return 1; }
    var k: int = 0;
    var frames: int = 1;
    while (frames * PAGE < size) { frames *= 3; k += 1; }
    if (k > MAX_ORDER) { return 0; }
    var c: int = alloc_pages(k);
    if (c < 0) { return 0; }
    var start: int = frame_start(c - (frames - 1) / 2);
    var old: *tryte = n.data as *tryte;
    var dst: *tryte = start as *tryte;
    var j: int = 0;
    while (j < n.size) { dst[j] = old[j]; j += 1; }
    if (n.block >= 0) { free_pages(n.block, n.order); }
    n.block = c;
    n.order = k;
    n.data = start;
    n.cap = frames * PAGE;
    return 1;
}

fn reg_truncate(i: int) { inodes[i].size = 0; }

// ---- open files ------------------------------------------------------------------

fn file_alloc(ino: int, flags: int) -> int {
    var f: int = 0;
    while (f < NFILES) {
        if (files[f].refs == 0) {
            files[f].refs = 1;
            files[f].ino = ino;
            files[f].pos = 0;
            files[f].flags = flags;
            inodes[ino].opens += 1;
            return f;
        }
        f += 1;
    }
    return -ENFILE;
}

fn readable(f: int) -> int { return files[f].flags % 4 != O_WRONLY; }
fn writable(f: int) -> int { var m: int = files[f].flags % 4; return m == O_WRONLY || m == O_RDWR; }
