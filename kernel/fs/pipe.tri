// pipe: anonymous pipes, a 3^9-tryte ring buffer each.
//
// Reads block while the pipe is empty and a writer remains (EOF after the
// last writer closes). Writes block while it is full; writing with no
// reader left fails with EPIPE and raises SIGPIPE. PIPE_BUF = 2187.

import "../params.tri";
import "../mm.tri";
import "vfs.tri";
import "../sched.tri";

const NPIPES: int = 27;
const PIPE_SIZE: int = 19683;
const EPIPE: int = 32;

struct Pipe {
    used: int;
    frame: int;
    head: int;                        // next tryte to read
    count: int;                       // trytes buffered
    readers: int;
    writers: int;
}

var pipes: [27]Pipe;

fn pipe_chan(p: int) -> int { return 10000 + p; }

fn pipe_buf(p: int) -> *tryte { return frame_start(pipes[p].frame) as *tryte; }

// A pipe with one reader and one writer; returns its index or -1.
fn pipe_create() -> int {
    var p: int = 0;
    while (p < NPIPES) {
        if (!pipes[p].used) {
            var f: int = alloc_pages(0);
            if (f < 0) { return -1; }
            pipes[p].used = 1;
            pipes[p].frame = f;
            pipes[p].head = 0;
            pipes[p].count = 0;
            pipes[p].readers = 1;
            pipes[p].writers = 1;
            return p;
        }
        p += 1;
    }
    return -1;
}

fn pipe_maybe_free(p: int) {
    if (pipes[p].readers == 0 && pipes[p].writers == 0) {
        free_pages(pipes[p].frame, 0);
        pipes[p].used = 0;
    }
}

fn pipe_close(p: int, writer: int) {
    if (writer) { pipes[p].writers -= 1; } else { pipes[p].readers -= 1; }
    wake_up(pipe_chan(p));
    pipe_maybe_free(p);
}

fn pipe_read(p: int, buf: *tryte, n: int) -> int {
    while (pipes[p].count == 0) {
        if (pipes[p].writers == 0) { return 0; }          // EOF
        if (sleep_on(pipe_chan(p))) { return -ERESTARTSYS; }
    }
    var b: *tryte = pipe_buf(p);
    var k: int = 0;
    while (k < n && pipes[p].count > 0) {
        buf[k] = b[pipes[p].head];
        pipes[p].head = (pipes[p].head + 1) % PIPE_SIZE;
        pipes[p].count -= 1;
        k += 1;
    }
    wake_up(pipe_chan(p));
    return k;
}

fn pipe_write(p: int, buf: *tryte, n: int) -> int {
    var k: int = 0;
    while (k < n) {
        if (pipes[p].readers == 0) {
            if (k > 0) { return k; }
            send_signal(current, SIGPIPE);
            return -EPIPE;
        }
        if (pipes[p].count == PIPE_SIZE) {
            wake_up(pipe_chan(p));
            if (sleep_on(pipe_chan(p))) { return k > 0 ? k : -ERESTARTSYS; }
            continue;
        }
        var b: *tryte = pipe_buf(p);
        b[(pipes[p].head + pipes[p].count) % PIPE_SIZE] = buf[k];
        pipes[p].count += 1;
        k += 1;
    }
    wake_up(pipe_chan(p));
    return k;
}
