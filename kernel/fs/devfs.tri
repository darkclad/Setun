// devfs: /dev and the character devices behind it.
//
// Device numbers follow Linux (major * 256 + minor). Every terminal node is
// the one console tty in K4; virtual consoles come with the window system.

import "../printk.tri";
import "vfs.tri";
import "../drivers/tty.tri";

const DEV_NULL: int = 259;            // 1,3
const DEV_ZERO: int = 261;            // 1,5
const DEV_TTYS0: int = 1088;          // 4,64
const DEV_TTY: int = 1280;            // 5,0
const DEV_CONSOLE: int = 1281;        // 5,1

fn dev_is_tty(rdev: int) -> int { return rdev == DEV_TTY || rdev == DEV_CONSOLE || rdev == DEV_TTYS0; }

fn dev_read(rdev: int, buf: *tryte, n: int) -> int {
    if (rdev == DEV_NULL) { return 0; }
    if (rdev == DEV_ZERO) {
        memset(buf, 0, n);
        return n;
    }
    return tty_read(buf, n);
}

fn dev_write(rdev: int, buf: *tryte, n: int) -> int {
    if (rdev == DEV_NULL || rdev == DEV_ZERO) { return n; }
    return tty_write(buf, n);
}

fn mknod(dir: int, name: *char, rdev: int, mode: int) {
    var i: int = ram_create(dir, name, strlen(name), I_CHR, mode);
    if (i >= 0) { inodes[i].rdev = rdev; }
}

// Mount a devfs (a ramfs instance holding the device nodes) on /dev.
fn devfs_init() -> int {
    var point: int = path_lookup("/dev", root_ino);
    if (point < 0) { printk("devfs: no /dev to mount on\n"); return point; }
    var m: int = do_mount(FS_RAM, point, "devfs", "/dev");
    if (m < 0) { return m; }
    var dir: int = mounts[m].root;
    mknod(dir, "null", DEV_NULL, 438);          // 0666
    mknod(dir, "zero", DEV_ZERO, 438);
    mknod(dir, "tty", DEV_TTY, 438);
    mknod(dir, "console", DEV_CONSOLE, 384);    // 0600
    mknod(dir, "ttyS0", DEV_TTYS0, 432);        // 0660
    return 0;
}
