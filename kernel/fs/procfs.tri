// procfs: /proc, generated from kernel state on every read.
//
//   /proc/meminfo  /proc/uptime  /proc/mounts
//   /proc/<pid>/stat     Linux's field order (the first 24 fields)
//   /proc/<pid>/status   Name, State, Pid, PPid, PGid, Sid
//   /proc/<pid>/cmdline  the arguments, NUL-separated
//   /proc/net/{dev,arp,tcp,udp,stat}  the network (kernel/net/)
//   /proc/net/{if_inet6,neigh6,stat6} IPv6 (kernel/net/ip6.tri)
//
// An inode's ino_no says what it shows: kind + 27 * pid.

import "../params.tri";
import "../printk.tri";
import "../mm.tri";
import "vfs.tri";
import "bcache.tri";
import "../sched.tri";
import "../net/tcp.tri";
import "../net/tl.tri";

const PROC_ROOT: int = 1;
const PROC_MEMINFO: int = 2;
const PROC_UPTIME: int = 3;
const PROC_MOUNTS: int = 4;
const PROC_PID: int = 5;
const PROC_STAT: int = 6;
const PROC_STATUS: int = 7;
const PROC_CMDLINE: int = 8;
const PROC_NET: int = 9;
const PROC_NET_DEV: int = 10;
const PROC_NET_ARP: int = 11;
const PROC_NET_TCP: int = 12;
const PROC_NET_UDP: int = 13;
const PROC_NET_STAT: int = 14;
const PROC_NET_TLINK: int = 15;
const PROC_NET_IF_INET6: int = 16;
const PROC_NET_NEIGH6: int = 17;
const PROC_NET_STAT6: int = 18;
const PROC_NET_TCP6: int = 19;
const PROC_NET_UDP6: int = 20;
const PROC_NET_LAST: int = 20;
const PROC_KINDS: int = 27;


fn proc_kind(i: int) -> int { return inodes[i].ino_no % PROC_KINDS; }
fn proc_pid(i: int) -> int { return inodes[i].ino_no / PROC_KINDS; }

fn proc_root(mnt: int) -> int {
    return iget(FS_PROC, mnt, PROC_ROOT);
}

fn live_task(pid: int) -> int {
    var t: int = find_task(pid);
    if (t < 0 || tasks[t].state == TASK_UNUSED) { return -1; }
    return t;
}

fn proc_iload(i: int) -> int {
    var k: int = proc_kind(i);
    if (k == PROC_ROOT || k == PROC_PID || k == PROC_NET) {
        inodes[i].type = I_DIR;
        inodes[i].mode = 365;                     // 0555
        inodes[i].nlink = 2;
    } else {
        inodes[i].type = I_REG;
        inodes[i].mode = k == PROC_CMDLINE || k == PROC_STAT || k == PROC_STATUS ? 292 : 292;   // 0444
    }
    if (k >= PROC_PID && k <= PROC_CMDLINE && live_task(proc_pid(i)) < 0) { return -ENOENT; }
    return 0;
}

fn proc_name_eq(s: *char, len: int, name: *char) -> int {
    var k: int = 0;
    while (k < len) {
        if (name[k] != s[k]) { return 0; }
        k += 1;
    }
    return name[len] == 0;
}

fn proc_lookup(dir: int, s: *char, len: int) -> int {
    var m: int = inodes[dir].mnt;
    var k: int = proc_kind(dir);
    if (k == PROC_PID) {
        if (len == 2 && s[0] == '.' && s[1] == '.') { return iget(FS_PROC, m, PROC_ROOT); }
        var base: int = PROC_KINDS * proc_pid(dir);
        if (proc_name_eq(s, len, "stat")) { return iget(FS_PROC, m, base + PROC_STAT); }
        if (proc_name_eq(s, len, "status")) { return iget(FS_PROC, m, base + PROC_STATUS); }
        if (proc_name_eq(s, len, "cmdline")) { return iget(FS_PROC, m, base + PROC_CMDLINE); }
        return -ENOENT;
    }
    if (k == PROC_NET) {
        if (len == 2 && s[0] == '.' && s[1] == '.') { return iget(FS_PROC, m, PROC_ROOT); }
        if (proc_name_eq(s, len, "dev")) { return iget(FS_PROC, m, PROC_NET_DEV); }
        if (proc_name_eq(s, len, "arp")) { return iget(FS_PROC, m, PROC_NET_ARP); }
        if (proc_name_eq(s, len, "tcp")) { return iget(FS_PROC, m, PROC_NET_TCP); }
        if (proc_name_eq(s, len, "udp")) { return iget(FS_PROC, m, PROC_NET_UDP); }
        if (proc_name_eq(s, len, "stat")) { return iget(FS_PROC, m, PROC_NET_STAT); }
        if (proc_name_eq(s, len, "tlink")) { return iget(FS_PROC, m, PROC_NET_TLINK); }
        if (proc_name_eq(s, len, "if_inet6")) { return iget(FS_PROC, m, PROC_NET_IF_INET6); }
        if (proc_name_eq(s, len, "neigh6")) { return iget(FS_PROC, m, PROC_NET_NEIGH6); }
        if (proc_name_eq(s, len, "stat6")) { return iget(FS_PROC, m, PROC_NET_STAT6); }
        if (proc_name_eq(s, len, "tcp6")) { return iget(FS_PROC, m, PROC_NET_TCP6); }
        if (proc_name_eq(s, len, "udp6")) { return iget(FS_PROC, m, PROC_NET_UDP6); }
        return -ENOENT;
    }
    if (proc_name_eq(s, len, "net")) { return iget(FS_PROC, m, PROC_NET); }
    if (proc_name_eq(s, len, "meminfo")) { return iget(FS_PROC, m, PROC_MEMINFO); }
    if (proc_name_eq(s, len, "uptime")) { return iget(FS_PROC, m, PROC_UPTIME); }
    if (proc_name_eq(s, len, "mounts")) { return iget(FS_PROC, m, PROC_MOUNTS); }
    var pid: int = 0;
    var j: int = 0;
    while (j < len) {
        if (s[j] < '0' || s[j] > '9' || j > 9) { return -ENOENT; }
        pid = pid * 10 + s[j] - '0';
        j += 1;
    }
    if (len == 0 || live_task(pid) < 0) { return -ENOENT; }
    return iget(FS_PROC, m, PROC_KINDS * pid + PROC_PID);
}

fn proc_name_of(i: int, buf: *char) -> int {
    switch (proc_kind(i)) {
        case PROC_MEMINFO: copy_str(buf, "meminfo", 8);
        case PROC_UPTIME: copy_str(buf, "uptime", 7);
        case PROC_MOUNTS: copy_str(buf, "mounts", 7);
        case PROC_STAT: copy_str(buf, "stat", 5);
        case PROC_STATUS: copy_str(buf, "status", 7);
        case PROC_CMDLINE: copy_str(buf, "cmdline", 8);
        case PROC_NET: copy_str(buf, "net", 4);
        case PROC_NET_DEV: copy_str(buf, "dev", 4);
        case PROC_NET_ARP: copy_str(buf, "arp", 4);
        case PROC_NET_TCP: copy_str(buf, "tcp", 4);
        case PROC_NET_UDP: copy_str(buf, "udp", 4);
        case PROC_NET_STAT: copy_str(buf, "stat", 5);
        case PROC_NET_TLINK: copy_str(buf, "tlink", 6);
        case PROC_NET_IF_INET6: copy_str(buf, "if_inet6", 9);
        case PROC_NET_NEIGH6: copy_str(buf, "neigh6", 7);
        case PROC_NET_STAT6: copy_str(buf, "stat6", 6);
        case PROC_NET_TCP6: copy_str(buf, "tcp6", 5);
        case PROC_NET_UDP6: copy_str(buf, "udp6", 5);
        case PROC_PID: itoa(proc_pid(i), buf);
        default: copy_str(buf, "proc", 5);
    }
    return strlen(buf);
}

// Entries of the root: . .. meminfo uptime mounts, then one per process.
fn proc_readdir(dir: int, pos: int, name: *char, info: *int) -> int {
    var k: int = proc_kind(dir);
    info[1] = DT_REG;
    if (pos == 0) { copy_str(name, ".", 2); info[0] = inodes[dir].ino_no; info[1] = DT_DIR; return 1; }
    if (pos == 1) { copy_str(name, "..", 3); info[0] = PROC_ROOT; info[1] = DT_DIR; return 2; }
    if (k == PROC_NET) {
        // in name order
        if (pos - 2 >= 11) { return 0; }
        info[0] = proc_net_kinds[pos - 2];
        inodes_name_of_kind(info[0], name);
        return pos + 1;
    }
    if (k == PROC_PID) {
        var base: int = PROC_KINDS * proc_pid(dir);
        if (pos == 2) { copy_str(name, "cmdline", 8); info[0] = base + PROC_CMDLINE; return 3; }
        if (pos == 3) { copy_str(name, "stat", 5); info[0] = base + PROC_STAT; return 4; }
        if (pos == 4) { copy_str(name, "status", 7); info[0] = base + PROC_STATUS; return 5; }
        return 0;
    }
    if (pos == 2) { copy_str(name, "meminfo", 8); info[0] = PROC_MEMINFO; return 3; }
    if (pos == 3) { copy_str(name, "mounts", 7); info[0] = PROC_MOUNTS; return 4; }
    if (pos == 4) { copy_str(name, "net", 4); info[0] = PROC_NET; info[1] = DT_DIR; return 5; }
    if (pos == 5) { copy_str(name, "uptime", 7); info[0] = PROC_UPTIME; return 6; }
    var t: int = pos - 5;                          // task slots 1..26
    while (t < NTASKS) {
        if (tasks[t].state != TASK_UNUSED) {
            itoa(tasks[t].pid, name);
            info[0] = PROC_KINDS * tasks[t].pid + PROC_PID;
            info[1] = DT_DIR;
            return t + 6;
        }
        t += 1;
    }
    return 0;
}

// ---- generated text ---------------------------------------------------------------------------

const PBUF_MAX: int = 6560;
var pbuf: [6561]char;
var plen: int;

fn ps(s: *char) {
    var k: int = 0;
    while (s[k] != 0 && plen < PBUF_MAX) { pbuf[plen] = s[k]; plen += 1; k += 1; }
}

fn pi(v: int) {
    var b: [15]char;
    ps(itoa(v, &b[0]));
}

fn pc(c: char) { if (plen < PBUF_MAX) { pbuf[plen] = c; plen += 1; } }

fn pfield(label: *char, v: int, unit: *char) {
    ps(label);
    var b: [15]char;
    var s: *char = itoa(v, &b[0]);
    var pad: int = 16 - strlen(label) - strlen(s);
    while (pad > 0) { pc(' '); pad -= 1; }
    ps(s);
    ps(unit);
    pc('\n');
}

fn state_char(t: *Task) -> char {
    switch (t.state) {
        case TASK_RUNNABLE: return 'R';
        case TASK_SLEEPING: return 'S';
        case TASK_STOPPED: return 'T';
        case TASK_ZOMBIE: return 'Z';
    }
    return '?';
}

fn state_name(t: *Task) -> *char {
    switch (t.state) {
        case TASK_RUNNABLE: return "R (running)";
        case TASK_SLEEPING: return "S (sleeping)";
        case TASK_STOPPED: return "T (stopped)";
        case TASK_ZOMBIE: return "Z (zombie)";
    }
    return "?";
}

fn proc_generate(i: int) -> int {
    plen = 0;
    var k: int = proc_kind(i);
    if (k == PROC_MEMINFO) {
        pfield("MemTotal:", ram_frames * PAGE, " trytes");
        pfield("MemFree:", free_frames * PAGE, " trytes");
        pfield("Buffers:", NBUF * PAGE, " trytes");
        pfield("PageSize:", PAGE, " trytes");
        return 0;
    }
    if (k == PROC_UPTIME) {
        pi(jiffies / HZ);
        pc('.');
        var cs: int = jiffies % HZ;
        if (cs < 10) { pc('0'); }
        pi(cs);
        ps(" 0.00\n");
        return 0;
    }
    if (k == PROC_MOUNTS) {
        var m: int = 0;
        while (m < NMOUNTS) {
            if (mounts[m].used) {
                ps(&mounts[m].source[0]);
                pc(' ');
                ps(&mounts[m].target[0]);
                pc(' ');
                ps(fs_type_name(mounts[m].fs));
                ps(" rw 0 0\n");
            }
            m += 1;
        }
        return 0;
    }
    if (k >= PROC_NET_DEV && k <= PROC_NET_LAST) { proc_net(k); return 0; }
    var ti: int = live_task(proc_pid(i));
    if (ti < 0) { return -ESRCH; }
    var t: *Task = &tasks[ti];
    if (k == PROC_STAT) {
        pi(t.pid); ps(" ("); ps(&t.comm[0]); ps(") "); pc(state_char(t)); pc(' ');
        pi(t.ppid); pc(' '); pi(t.pgid); pc(' '); pi(t.sid); ps(" 1281 "); pi(ttys[0].pgrp);
        ps(" 0 0 0 0 0 "); pi(t.ticks); ps(" 0 0 0 20 0 1 0 "); pi(t.start_time);
        ps(" 0 0\n");
        return 0;
    }
    if (k == PROC_STATUS) {
        ps("Name:\t"); ps(&t.comm[0]); pc('\n');
        ps("State:\t"); ps(state_name(t)); pc('\n');
        ps("Pid:\t"); pi(t.pid); pc('\n');
        ps("PPid:\t"); pi(t.ppid); pc('\n');
        ps("PGid:\t"); pi(t.pgid); pc('\n');
        ps("Sid:\t"); pi(t.sid); pc('\n');
        ps("Uid:\t"); pi(t.uid); pc('\t'); pi(t.euid); pc('\t'); pi(t.suid); pc('\n');
        ps("Gid:\t"); pi(t.gid); pc('\t'); pi(t.egid); pc('\t'); pi(t.sgid); pc('\n');
        ps("WChan:\t"); pi(t.state == TASK_SLEEPING ? t.wchan : 0); pc('\n');
        ps("FPU:\t"); ps(!t.fpu_used ? "unused" : fpu_owner == ti ? "live" : "saved"); pc('\n');
        ps("Vector:\t"); ps(!t.vec_used ? "unused" : vec_owner == ti ? "live" : "saved"); pc('\n');
        return 0;
    }
    // cmdline
    var j: int = 0;
    while (j < t.cmdline_len && plen < PBUF_MAX) { pbuf[plen] = t.cmdline[j]; plen += 1; j += 1; }
    return 0;
}

// ---- /proc/net ------------------------------------------------------------------------------

fn phex(v: int, digits: int) {
    var d: *char = "0123456789ABCDEF";
    var k: int = digits - 1;
    while (k >= 0) {
        var div: int = 1;
        var j: int = 0;
        while (j < k) { div *= 16; j += 1; }
        pc(d[v / div % 16]);
        k -= 1;
    }
}

// Pad the line to column `col` (counted from the last newline).
fn pcol(col: int) {
    var start: int = plen;
    while (start > 0 && pbuf[start - 1] != '\n') { start -= 1; }
    while (plen - start < col) { pc(' '); }
}

// An address the way Linux prints it on a little-endian machine: 10.0.2.15 = 0F02000A.
fn paddr_hex(a: int, port: int) {
    phex(a % 256, 2);
    phex(a / 256 % 256, 2);
    phex(a / 65536 % 256, 2);
    phex(a / 16777216 % 256, 2);
    pc(':');
    phex(port, 4);
}

fn pmac(hi: int, lo: int) {
    var d: *char = "0123456789abcdef";
    var o: int = 0;
    while (o < 6) {
        var v: int = mac_octet(hi, lo, o);
        pc(d[v / 16]);
        pc(d[v % 16]);
        if (o < 5) { pc(':'); }
        o += 1;
    }
}

fn proc_net(k: int) {
    if (k == PROC_NET_DEV) {
        ps("Inter-|   Receive                                                |  Transmit\n");
        ps(" face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed\n");
        var x: int = 0;
        while (x < 2) {
            if (x == NETIF_LO || eth_present) {
                var e: *Netif = &netifs[x];
                pcol(x == NETIF_LO ? 4 : 2);
                ps(netif_name(x));
                ps(": ");
                pi(e.rx_bytes); pc(' '); pi(e.rx_packets); pc(' '); pi(e.rx_errors); pc(' '); pi(e.rx_dropped);
                ps(" 0 0 0 0 ");
                pi(e.tx_bytes); pc(' '); pi(e.tx_packets); pc(' '); pi(e.tx_errors); pc(' '); pi(e.tx_dropped);
                ps(" 0 0 0 0\n");
            }
            x += 1;
        }
        return;
    }
    if (k == PROC_NET_ARP) {
        ps("IP address       HW type     Flags       HW address            Mask     Device\n");
        var a: int = 0;
        while (a < NARP) {
            var e: *ArpEntry = &arp_cache[a];
            if (e.state != ARP_FREE) {
                var buf: [16]char;
                ip_to_str(e.ip, &buf[0]);
                ps(&buf[0]);
                pcol(17);
                ps("0x1");
                pcol(29);
                ps(e.state == ARP_REACHABLE ? "0x2" : "0x0");
                pcol(41);
                if (e.state == ARP_REACHABLE) { pmac(e.mac_hi, e.mac_lo); } else { pmac(0, 0); }
                pcol(63);
                ps("*        eth0\n");
            }
            a += 1;
        }
        return;
    }
    if (k == PROC_NET_TLINK) {
        // the link layer's counters (docs/TNET.md §2), one per line
        var buf: [40]char;
        tl_addr_str(tl_addr, &buf[0]);
        ps("station "); ps(&buf[0]); ps(tl_up ? " up\n" : " down\n");
        ps("rx_frames "); pi(tl_rx_frames); pc('\n');
        ps("rx_trytes "); pi(tl_rx_trytes); pc('\n');
        ps("tx_frames "); pi(tl_tx_frames); pc('\n');
        ps("tx_trytes "); pi(tl_tx_trytes); pc('\n');
        ps("bad_check "); pi(tl_bad_check); pc('\n');
        ps("short "); pi(tl_short); pc('\n');
        ps("not_ours "); pi(tl_not_ours); pc('\n');
        ps("bad_type "); pi(tl_bad_type); pc('\n');
        ps("tx_dropped "); pi(tl_tx_dropped); pc('\n');
        ps("echo_replies "); pi(tl_echoes); pc('\n');
        ps("tnp_rx "); pi(tnp_rx_packets); pc('\n');
        ps("tnp_tx "); pi(tnp_tx_packets); pc('\n');
        ps("tnp_dropped "); pi(tnp_rx_dropped); pc('\n');
        ps("tnp_unknown "); pi(tnp_rx_unknown); pc('\n');
        ps("tcmp_echoes "); pi(tcmp_echoes_answered); pc('\n');
        ps("tsp_bad "); pi(tsp_rx_bad); pc('\n');
        return;
    }
    if (k == PROC_NET_IF_INET6 || k == PROC_NET_NEIGH6 || k == PROC_NET_STAT6) { proc_net6(k); return; }
    if (k == PROC_NET_TCP6 || k == PROC_NET_UDP6) { proc_sock6(k); return; }
    if (k == PROC_NET_STAT) {
        var n: int = 0;
        while (n < NSTATS) {
            ps(net_stat_name(n));
            pc(' ');
            pi(net_stats[n]);
            pc('\n');
            n += 1;
        }
        return;
    }
    // tcp, udp: Linux's first columns, then the owner's uid
    ps("  sl  local_address rem_address   st tx_queue rx_queue uid\n");
    var want: int = k == PROC_NET_TCP ? SOCK_STREAM : SOCK_DGRAM;
    // (IPv6 sockets are not listed here)
    var sl: int = 0;
    var s: int = 0;
    while (s < NSOCKS) {
        var q: *Socket = &socks[s];
        if (q.used && q.type == want && q.family != AF_INET6) {
            pcol(2);
            if (sl < 10) { pc(' '); }
            pi(sl);
            ps(": ");
            paddr_hex(q.laddr, q.lport);
            pc(' ');
            paddr_hex(q.raddr, q.rport);
            pc(' ');
            phex(k == PROC_NET_TCP ? q.state : (q.raddr != 0 ? TCP_ESTABLISHED : TCP_CLOSE), 2);
            pc(' ');
            phex(k == PROC_NET_TCP ? q.tx_count : 0, 8);
            pc(':');
            phex(q.rx_count, 8);
            pc(' ');
            pi(q.uid);
            pc('\n');
            sl += 1;
        }
        s += 1;
    }
}

fn proc_read(i: int, pos: int, buf: *tryte, n: int) -> int {
    if (inodes[i].type == I_DIR) { return -EISDIR; }
    var r: int = proc_generate(i);
    if (r < 0) { return r; }
    if (pos >= plen) { return 0; }
    if (n > plen - pos) { n = plen - pos; }
    copy_trytes(buf, &pbuf[pos] as *tryte, n);
    return n;
}

var proc_net_kinds: [11]int = { PROC_NET_ARP, PROC_NET_DEV, PROC_NET_IF_INET6, PROC_NET_NEIGH6, PROC_NET_STAT,
                                PROC_NET_STAT6, PROC_NET_TCP, PROC_NET_TCP6, PROC_NET_TLINK, PROC_NET_UDP, PROC_NET_UDP6 };

// The name of a /proc/net file kind.
fn inodes_name_of_kind(k: int, name: *char) {
    switch (k) {
        case PROC_NET_ARP: copy_str(name, "arp", 4);
        case PROC_NET_DEV: copy_str(name, "dev", 4);
        case PROC_NET_IF_INET6: copy_str(name, "if_inet6", 9);
        case PROC_NET_NEIGH6: copy_str(name, "neigh6", 7);
        case PROC_NET_STAT: copy_str(name, "stat", 5);
        case PROC_NET_STAT6: copy_str(name, "stat6", 6);
        case PROC_NET_TCP: copy_str(name, "tcp", 4);
        case PROC_NET_TCP6: copy_str(name, "tcp6", 5);
        case PROC_NET_TLINK: copy_str(name, "tlink", 6);
        case PROC_NET_UDP6: copy_str(name, "udp6", 5);
        default: copy_str(name, "udp", 4);
    }
}

// Two lowercase hex digits, as Linux writes /proc/net/if_inet6.
fn phx2(v: int) {
    var d: *char = "0123456789abcdef";
    pc(d[v / 16 % 16]);
    pc(d[v % 16]);
}

// 32 hex digits of an address.
fn pa6hex(a: *tryte) {
    var k: int = 0;
    while (k < 16) { phx2(a[k]); k += 1; }
}

// /proc/net/if_inet6 (Linux's columns: address, interface index, prefix
// length, scope, flags, name), /proc/net/neigh6 and /proc/net/stat6.
fn proc_net6(k: int) {
    if (k == PROC_NET_IF_INET6) {
        pa6hex(a6(lo6_h));
        ps(" 01 80 10 80       lo\n");
        var i: int = 0;
        while (i < NIF6) {
            var f: *If6 = &if6[i];
            if (f.state != A6_FREE) {
                pa6hex(a6(f.h));
                ps(" 02 40 ");
                ps(i == 0 ? "20 " : "00 ");
                // IFA_F_PERMANENT 80 for the link-local one, TENTATIVE 40, DEPRECATED 20, DADFAILED 08
                var fl: int = i == 0 ? 128 : 0;
                if (f.state == A6_TENTATIVE) { fl += 64; }
                if (f.state == A6_DEPRECATED) { fl += 32; }
                if (f.state == A6_DADFAILED) { fl += 8 + 64; }
                phx2(fl);
                ps("     eth0\n");
            }
            i += 1;
        }
        return;
    }
    if (k == PROC_NET_NEIGH6) {
        ps("address                                  lladdr            state      router\n");
        var j: int = 0;
        while (j < NNEIGH) {
            var e: *Neigh = &nc[j];
            if (e.state != NC_FREE) {
                var buf: [40]char;
                in6_to_str(a6(e.h), &buf[0]);
                ps(&buf[0]);
                pcol(41);
                pmac(e.mac_hi, e.mac_lo);
                pcol(59);
                switch (e.state) {
                    case NC_INCOMPLETE: ps("INCOMPLETE");
                    case NC_REACHABLE: ps("REACHABLE");
                    case NC_STALE: ps("STALE");
                    case NC_DELAY: ps("DELAY");
                    default: ps("PROBE");
                }
                pcol(70);
                ps(e.router ? "yes" : "no");
                if (router_h == e.h) { ps(" default"); }
                pc('\n');
            }
            j += 1;
        }
        return;
    }
    var n: int = 0;
    while (n < NSTATS6) {
        ps(ip6_stat_name(n));
        pc(' ');
        pi(ip6_stats[n]);
        pc('\n');
        n += 1;
    }
    if (rdnss_until != 0) {
        var b: [40]char;
        in6_to_str(&rdnss[0], &b[0]);
        ps("rdnss ");
        ps(&b[0]);
        pc('\n');
    }
    ps("mtu ");
    pi(link_mtu6);
    pc('\n');
}

// /proc/net/tcp6 and udp6: as tcp and udp, with 32 hex digits of address
// in Linux's order (four 32-bit words, each little-endian, as tcp's is).
fn pa6linux(a: *tryte) {
    var w: int = 0;
    while (w < 4) {
        var j: int = 3;
        while (j >= 0) { phex(a[4 * w + j], 2); j -= 1; }
        w += 1;
    }
}

fn proc_sock6(k: int) {
    ps("  sl  local_address                         remote_address                        st tx_queue rx_queue uid\n");
    var want: int = k == PROC_NET_TCP6 ? SOCK_STREAM : SOCK_DGRAM;
    var sl: int = 0;
    var s: int = 0;
    while (s < NSOCKS) {
        var q: *Socket = &socks[s];
        if (q.used && q.type == want && q.family == AF_INET6) {
            pcol(2);
            if (sl < 10) { pc(' '); }
            pi(sl);
            ps(": ");
            pa6linux(a6(q.laddr));
            pc(':');
            phex(q.lport, 4);
            pc(' ');
            pa6linux(a6(q.raddr));
            pc(':');
            phex(q.rport, 4);
            pc(' ');
            phex(k == PROC_NET_TCP6 ? q.state : (q.raddr != 0 ? TCP_ESTABLISHED : TCP_CLOSE), 2);
            pc(' ');
            phex(k == PROC_NET_TCP6 ? q.tx_count : 0, 8);
            pc(':');
            phex(q.rx_count, 8);
            pc(' ');
            pi(q.uid);
            pc('\n');
            sl += 1;
        }
        s += 1;
    }
}
