// exec: load TEF executables (docs/KERNEL.md §9) and build the user stack.
//
// TEF v1 header (6 words): magic, entry, text start (first tryte), text
// size (trytes), bss start (first tryte), bss size. The text follows the
// header. Text pages are read-only + execute; the bss and heap are
// demand-zero from the bss start up to brk.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "vm.tri";
import "fs/vfs.tri";

const TEF_MAGIC: int = 31857270901;
const MAX_ARGS: int = 32;
const ARG_BYTES: int = 2187;

const E2BIG: int = 7;
const ENOENT: int = 2;
const ENOEXEC: int = 8;
const ENOMEM: int = 12;

// Arguments, copied into the kernel before the old address space goes.
var exec_path: [81]char;
var exec_buf: [2187]char;
var exec_arg: [32]int;                // offsets into exec_buf
var exec_argc: int;
var exec_cwd: int;                    // where a relative path starts

// Result of a successful load.
var load_l1: int;
var load_entry: int;
var load_sp: int;
var load_argv: int;
var load_heap: int;
var load_brk: int;

fn word_at(addr_first_tryte: int, j: int) -> int { return *((addr_first_tryte + 1 + 3 * j) as *int); }

// Copy one tryte into the new address space (the page must be mapped).
fn poke(l1: int, va: int, v: tryte) {
    var pa: int = uva_to_phys(l1, va);
    *(pa as *tryte) = v;
}

fn poke_word(l1: int, va: int, v: int) {
    var pa: int = uva_to_phys(l1, va);
    *(pa as *int) = v;
}

// Load `exec_path` with the arguments in exec_buf/exec_arg into a fresh
// address space. Returns 0 or -errno.
fn exec_load() -> int {
    var file: int = path_lookup(&exec_path[0], exec_cwd);
    if (file < 0) { return file; }
    if (inodes[file].type != I_REG) { return -13; }                 // EACCES
    if (inodes[file].mode / 64 % 2 == 0) { return -13; }            // no owner execute bit
    var d: int = inodes[file].data;
    var fsize: int = inodes[file].size;
    if (fsize < 18 || word_at(d, 0) != TEF_MAGIC) { return -ENOEXEC; }
    var entry: int = word_at(d, 1);
    var text: int = word_at(d, 2);
    var text_size: int = word_at(d, 3);
    var bss: int = word_at(d, 4);
    var bss_size: int = word_at(d, 5);
    if (!is_user_address(text) || !is_user_address(text + text_size) || text_size + 18 > fsize) {
        return -ENOEXEC;
    }
    var l1: int = new_address_space();
    if (l1 < 0) { return -ENOMEM; }

    // Text: map each page read-only + execute, then copy a word at a time.
    // The text and the file data both start on a word, and pages hold whole
    // words, so no word straddles a page; a partial last word reads past the
    // end of the text, into the file or its zero padding.
    if ((text + 1) % 3 != 0) { free_address_space(l1); return -ENOEXEC; }
    var src: *int = (d + 19) as *int;
    var i: int = 0;
    var page: int = divr(text, 19683) - 1;
    var phys: int = 0;
    while (i < text_size) {
        var va: int = text + i;
        var p: int = divr(va, 19683);
        if (p != page) {
            var f: int = alloc_user_frame();
            if (f < 0 || !map_page(l1, va, f, 0, 1)) { free_address_space(l1); return -ENOMEM; }
            page = p;
            phys = f * 19683 - p * 19683;          // phys = phys_base + va
        }
        *((phys + va + 1) as *int) = src[i / 3];
        i += 3;
    }

    // Stack: the top page now, the rest on demand.
    var f: int = alloc_user_frame();
    if (f < 0 || !map_page(l1, USER_STACK, f, 1, 0)) { free_address_space(l1); return -ENOMEM; }
    // Strings just below the top, then argv[], NULL, envp NULL.
    var total: int = 0;
    var k: int = 0;
    while (k < exec_argc) {
        total += strlen(&exec_buf[exec_arg[k]]) + 1;
        k += 1;
    }
    var strings: int = USER_STACK - 3 - total;
    var argv: int = (strings - 3 * (exec_argc + 3)) / 3 * 3;
    var at: int = strings;
    k = 0;
    while (k < exec_argc) {
        poke_word(l1, argv + 3 * k, at);
        var s: *char = &exec_buf[exec_arg[k]];
        var j: int = 0;
        loop {
            poke(l1, at, s[j]);
            at += 1;
            if (s[j] == 0) { break; }
            j += 1;
        }
        k += 1;
    }
    poke_word(l1, argv + 3 * exec_argc, 0);           // argv[argc] = NULL
    poke_word(l1, argv + 3 * (exec_argc + 1), 0);     // envp[0] = NULL

    load_l1 = l1;
    load_entry = entry;
    load_sp = argv - 3;
    load_argv = argv;
    load_heap = bss;
    load_brk = bss + bss_size;
    return 0;
}

// Copy a user string into `dst` (at most max-1 characters). Returns its
// length, or -1 if it is too long or not in user space.
fn copy_user_string(src: int, dst: *char, max: int) -> int {
    if (!is_user_address(src)) { return -1; }
    var p: *char = src as *char;
    var i: int = 0;
    while (i < max) {
        dst[i] = p[i];
        if (p[i] == 0) { return i; }
        i += 1;
    }
    return -1;
}

// Gather execve's path and argv from user space. Returns 0 or -errno.
fn collect_exec_args(path: int, argv: int) -> int {
    if (copy_user_string(path, &exec_path[0], 81) < 0) { return -ENOENT; }
    exec_argc = 0;
    var used: int = 0;
    if (argv == 0) { return 0; }
    if (!is_user_address(argv)) { return -14; }
    var vec: *int = argv as *int;
    loop {
        var s: int = vec[exec_argc];
        if (s == 0) { break; }
        if (exec_argc == MAX_ARGS) { return -E2BIG; }
        var n: int = copy_user_string(s, &exec_buf[used], ARG_BYTES - used);
        if (n < 0) { return -E2BIG; }
        exec_arg[exec_argc] = used;
        used += n + 1;
        exec_argc += 1;
    }
    return 0;
}

// For the kernel itself (starting init): argv = { path }.
fn set_kernel_exec(path: *char) {
    var i: int = 0;
    while (path[i] != 0) {
        exec_path[i] = path[i];
        exec_buf[i] = path[i];
        i += 1;
    }
    exec_path[i] = 0;
    exec_buf[i] = 0;
    exec_arg[0] = 0;
    exec_argc = 1;
}
