// exec: load TEF executables (docs/KERNEL.md §9) and build the user stack.
//
// TEF v1 header (6 words): magic, entry, text start (first tryte), text
// size (trytes), bss start (first tryte), bss size. The text follows the
// header. Text pages are read-only + execute; the bss and heap are
// demand-zero from the bss start up to brk.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "vm.tri";
import "fs/vfs.tri";

const TEF_MAGIC: int = 0zB007AB15;
const MAX_ARGS: int = 81;             // argv and envp strings together
const ARG_BYTES: int = 2187;

const E2BIG: int = 7;
const ENOENT: int = 2;
const ENOEXEC: int = 8;
const ENOMEM: int = 12;

// Arguments, copied into the kernel before the old address space goes.
var exec_path: [81]char;
var exec_buf: [2187]char;
var exec_arg: [81]int;                // offsets into exec_buf: argv, then envp
var exec_argc: int;
var exec_envc: int;
var exec_cwd: int;                    // where a relative path starts
var exec_hdr: [6]int;

// Result of a successful load.
var load_l1: int;
var load_entry: int;
var load_sp: int;
var load_argv: int;
var load_envp: int;
var load_heap: int;
var load_brk: int;


// Copy one tryte into the new address space (the page must be mapped).
fn poke(l1: int, va: int, v: tryte) {
    var pa: int = uva_to_phys(l1, va);
    *(pa as *tryte) = v;
}

fn poke_word(l1: int, va: int, v: int) {
    var pa: int = uva_to_phys(l1, va);
    *(pa as *int) = v;
}

// Load `exec_path` with the arguments in exec_buf/exec_arg into a fresh
// address space. Returns 0 or -errno.
fn exec_load() -> int {
    var file: int = path_lookup(&exec_path[0], exec_cwd);
    if (file < 0) { return file; }
    if (inodes[file].type != I_REG) { return -13; }                 // EACCES
    var x: int = inode_permission(file, MAY_EXEC);
    if (x < 0) { return x; }
    var fsize: int = inodes[file].size;
    if (fsize < 18) { return -ENOEXEC; }
    var r: int = vfs_read(file, 0, bytes(&exec_hdr[0]), 18);
    if (r != 18) { return r < 0 ? r : -ENOEXEC; }
    if (exec_hdr[0] != TEF_MAGIC) { return -ENOEXEC; }
    var entry: int = exec_hdr[1];
    var text: int = exec_hdr[2];
    var text_size: int = exec_hdr[3];
    var bss: int = exec_hdr[4];
    var bss_size: int = exec_hdr[5];
    if (!is_user_address(text) || !is_user_address(text + text_size) || text_size < 0 || text_size + 18 > fsize) {
        return -ENOEXEC;
    }
    var l1: int = new_address_space();
    if (l1 < 0) { return -ENOMEM; }

    // Text: map each page read-only + execute and read the file into it.
    var i: int = 0;
    while (i < text_size) {
        var va: int = text + i;
        var p: int = divr(va, 19683);
        var page_end: int = p * 19683 + 9842;          // first tryte of the next page
        var chunk: int = page_end - va;
        if (chunk > text_size - i) { chunk = text_size - i; }
        var f: int = alloc_user_frame();
        if (f < 0 || !map_page(l1, va, f, 0, 1)) { free_address_space(l1); return -ENOMEM; }
        var phys: int = f * 19683 - p * 19683 + va;     // the frame's copy of va
        r = vfs_read(file, 18 + i, phys as *tryte, chunk);
        if (r != chunk) { free_address_space(l1); return r < 0 ? r : -ENOEXEC; }
        i += chunk;
    }

    // Stack: the top page now, the rest on demand.
    var f: int = alloc_user_frame();
    if (f < 0 || !map_page(l1, USER_STACK, f, 1, 0)) { free_address_space(l1); return -ENOMEM; }
    // Strings just below the top, then argv[], NULL, envp[], NULL (as on Linux).
    var nstr: int = exec_argc + exec_envc;
    var total: int = 0;
    var k: int = 0;
    while (k < nstr) {
        total += strlen(&exec_buf[exec_arg[k]]) + 1;
        k += 1;
    }
    var strings: int = USER_STACK - 3 - total;
    var argv: int = (strings - 3 * (nstr + 3)) / 3 * 3;
    var envp: int = argv + 3 * (exec_argc + 1);
    var at: int = strings;
    k = 0;
    while (k < nstr) {
        var slot: int = k < exec_argc ? argv + 3 * k : envp + 3 * (k - exec_argc);
        poke_word(l1, slot, at);
        var s: *char = &exec_buf[exec_arg[k]];
        var j: int = 0;
        loop {
            poke(l1, at, s[j]);
            at += 1;
            if (s[j] == 0) { break; }
            j += 1;
        }
        k += 1;
    }
    poke_word(l1, argv + 3 * exec_argc, 0);           // argv[argc] = NULL
    poke_word(l1, envp + 3 * exec_envc, 0);           // envp[envc] = NULL

    load_l1 = l1;
    load_entry = entry;
    load_sp = argv - 3;
    load_argv = argv;
    load_envp = envp;
    load_heap = bss;
    load_brk = bss + bss_size;
    creds_exec(file);                                 // set-user-ID and set-group-ID programs
    return 0;
}

// Copy a user string into `dst` (at most max-1 characters). Returns its
// length, or -1 if it is too long or not in user space.
fn copy_user_string(src: int, dst: *char, max: int) -> int {
    if (!is_user_address(src)) { return -1; }
    var p: *char = src as *char;
    var i: int = 0;
    while (i < max) {
        dst[i] = p[i];
        if (p[i] == 0) { return i; }
        i += 1;
    }
    return -1;
}

var exec_used: int;

// Append the strings of a user vector (argv or envp) to exec_buf. Returns
// how many, or -errno.
fn collect_vector(vecp: int, first: int) -> int {
    if (vecp == 0) { return 0; }
    if (!is_user_address(vecp)) { return -14; }
    var vec: *int = vecp as *int;
    var n: int = 0;
    loop {
        if (!is_user_address(vecp + 3 * n)) { return -14; }
        var s: int = vec[n];
        if (s == 0) { return n; }
        if (first + n == MAX_ARGS) { return -E2BIG; }
        if (!is_user_address(s)) { return -14; }
        var len: int = copy_user_string(s, &exec_buf[exec_used], ARG_BYTES - exec_used);
        if (len < 0) { return -E2BIG; }
        exec_arg[first + n] = exec_used;
        exec_used += len + 1;
        n += 1;
    }
}

// Gather execve's path, argv and envp from user space. Returns 0 or -errno.
fn collect_exec_args(path: int, argv: int, envp: int) -> int {
    if (path == 0 || !is_user_address(path)) { return -14; }
    var pl: int = copy_user_string(path, &exec_path[0], 81);
    if (pl < 0) { return -36; }                       // ENAMETOOLONG
    if (pl == 0) { return -ENOENT; }
    exec_used = 0;
    exec_argc = 0;
    exec_envc = 0;
    var n: int = collect_vector(argv, 0);
    if (n < 0) { return n; }
    exec_argc = n;
    n = collect_vector(envp, exec_argc);
    if (n < 0) { return n; }
    exec_envc = n;
    return 0;
}

// For the kernel itself (starting init): argv = { path }.
fn set_kernel_exec(path: *char) {
    var i: int = 0;
    while (path[i] != 0) {
        exec_path[i] = path[i];
        exec_buf[i] = path[i];
        i += 1;
    }
    exec_path[i] = 0;
    exec_buf[i] = 0;
    exec_arg[0] = 0;
    exec_argc = 1;
    // Linux gives init HOME=/ and TERM=linux.
    exec_used = i + 1;
    exec_envc = 0;
    add_kernel_env("HOME=/");
    add_kernel_env("TERM=linux");
}

fn add_kernel_env(s: *char) {
    exec_arg[exec_argc + exec_envc] = exec_used;
    var k: int = 0;
    loop {
        exec_buf[exec_used] = s[k];
        exec_used += 1;
        if (s[k] == 0) { break; }
        k += 1;
    }
    exec_envc += 1;
}
