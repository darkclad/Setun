// module: start the user programs mkdisk placed on the boot disk.
//
// Sector 28 holds a table of words: magic, count, then per program
// (first sector, sector count, first page). Each program sector is the
// exact contents of one user page, starting at its first page.

import "params.tri";
import "printk.tri";
import "mm.tri";
import "vm.tri";
import "sched.tri";
import "drivers/disk.tri";

const MODULE_TABLE_SECTOR: int = 28;
const MODULE_MAGIC: int = 31857270900;        // 0zCAFEBABE + 1
const USER_DATA_PAGES: int = 3;               // globals at USER_BASE + 9 pages
const USER_STACK_PAGES: int = 3;

fn spawn_module(first_sector: int, sectors: int, first_page: int) -> int {
    var slot: int = alloc_task();
    if (slot < 0) { return -1; }
    var l1: int = new_address_space();
    if (l1 < 0) { return -1; }
    var k: int = 0;
    while (k < sectors) {
        var f: int = alloc_pages(0);
        if (f < 0 || disk_read(first_sector + k, 1, f) != 0) { return -1; }
        if (!map_user_page(l1, first_page + k, f)) { return -1; }
        k += 1;
    }
    var data_page: int = first_page + 9;
    var stack_page: int = divr(USER_STACK, PAGE);
    if (!map_zeroed(l1, data_page, USER_DATA_PAGES)) { return -1; }
    if (!map_zeroed(l1, stack_page - USER_STACK_PAGES + 1, USER_STACK_PAGES)) { return -1; }
    var t: *Task = &tasks[slot];
    t.l1 = l1;
    t.kstack = alloc_pages(0);
    if (t.kstack < 0) { return -1; }
    t.pid = next_pid;
    next_pid += 1;
    t.ticks = 0;
    t.exit_code = 0;
    prepare_user_stack(t, USER_BASE, USER_STACK);
    t.state = TASK_RUNNABLE;
    user_tasks_alive += 1;
    return t.pid;
}

fn word_at(frame: int, j: int) -> int {
    return *((frame_start(frame) + 1 + 3 * j) as *int);
}

fn load_modules() {
    var tf: int = alloc_pages(0);
    if (disk_read(MODULE_TABLE_SECTOR, 1, tf) != 0 || word_at(tf, 0) != MODULE_MAGIC) {
        printk("init: no user programs on the boot disk\n");
        free_pages(tf, 0);
        return;
    }
    var n: int = word_at(tf, 1);
    var m: int = 0;
    while (m < n) {
        var pid: int = spawn_module(word_at(tf, 2 + 3 * m), word_at(tf, 3 + 3 * m), word_at(tf, 4 + 3 * m));
        printk("init: started user program ");
        pr_int(m);
        if (pid < 0) { pr(" - FAILED (out of memory or disk error)\n"); }
        else { pr(" as pid "); pr_int(pid); pr_nl(); }
        m += 1;
    }
    free_pages(tf, 0);
}
