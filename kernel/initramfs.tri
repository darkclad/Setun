// initramfs: the root file system mkdisk packs onto the boot disk.
//
// Sector 28 is a header of words: magic, file count, data sectors, then per
// file 11 words: the path (27 trytes, NUL-padded), size, offset (trytes from
// the start of the data). The data follows from sector 29 and is loaded into
// one contiguous triddy block, and every file becomes a ramfs inode that
// points into it (copied out on its first write).

import "params.tri";
import "printk.tri";
import "mm.tri";
import "drivers/disk.tri";
import "fs/vfs.tri";

const INITRAMFS_SECTOR: int = 28;
const INITRAMFS_MAGIC: int = 31857270902;

var ramfs_header: int;                // frame holding the header
var ramfs_data: int;                  // first tryte of the file data
var ramfs_files: int;

fn header_word(j: int) -> int { return *((frame_start(ramfs_header) + 1 + 3 * j) as *int); }

fn ramfs_name(i: int) -> *char { return (frame_start(ramfs_header) + 3 * (3 + 11 * i)) as *char; }
fn ramfs_size(i: int) -> int { return header_word(3 + 11 * i + 9); }
fn ramfs_data_at(i: int) -> int { return ramfs_data + header_word(3 + 11 * i + 10); }

fn initramfs_init() -> int {
    ramfs_header = alloc_pages(0);
    if (disk_read(INITRAMFS_SECTOR, 1, ramfs_header) != 0 || header_word(0) != INITRAMFS_MAGIC) {
        printk("initramfs: none on the boot disk\n");
        return 0;
    }
    ramfs_files = header_word(1);
    var sectors: int = header_word(2);
    var k: int = 0;
    var size: int = 1;
    while (size < sectors) { size *= 3; k += 1; }
    var c: int = alloc_pages(k);
    if (c < 0) { panic("no memory for the initramfs"); }
    var first: int = c - (size - 1) / 2;
    if (disk_read(INITRAMFS_SECTOR + 1, sectors, first) != 0) { panic("cannot read the initramfs"); }
    ramfs_data = frame_start(first);
    var i: int = 0;
    while (i < ramfs_files) {
        if (vfs_install(ramfs_name(i), ramfs_data_at(i), ramfs_size(i)) < 0) {
            printk("initramfs: cannot install ");
            pr(ramfs_name(i));
            pr_nl();
        }
        i += 1;
    }
    printk("initramfs: ");
    pr_int(ramfs_files);
    pr(" files, ");
    pr_int(sectors);
    pr(" sector(s)\n");
    return 1;
}

// Put an archive file at `path`, making its directories. Returns the inode.
fn vfs_install(path: *char, data: int, size: int) -> int {
    var dir: [27]char;
    var slash: int = 0;
    var k: int = 0;
    while (path[k] != 0) {
        if (path[k] == '/') { slash = k; }
        dir[k] = path[k];
        k += 1;
    }
    dir[slash] = 0;
    if (slash > 0 && vfs_mkdirs(&dir[0]) < 0) { return -1; }
    var ino: int = vfs_create(path, root_ino, I_REG, 493);
    if (ino < 0) { return ino; }
    inodes[ino].data = data;
    inodes[ino].size = size;
    inodes[ino].cap = size;
    return ino;
}
