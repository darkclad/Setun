// tty: terminals, after Linux's n_tty line discipline, and pseudo-terminals.
//
// Ten terminals share the code: tty 0 is the console (keyboard and serial
// in; serial and the text screen out), ttys 1..9 are pseudo-terminals (the
// slave side, /dev/pts/N, is a terminal like the console; whatever it
// outputs is read from the master side, /dev/ptmx, and what the master
// writes is typed into it).
//
// The line discipline: in canonical mode (ICANON) characters are collected
// into a line with erase (^H, DEL), kill (^U) and end of file (^D); a read
// returns at most one line. With ICANON off every character passes as it
// arrives. With ISIG, ^C, ^\ and ^Z send SIGINT, SIGQUIT and SIGTSTP to the
// terminal's foreground process group (and flush the input); a read from
// another group of the same session gets SIGTTIN.
//
// Console input comes from IRQs, and the timer tick and every read also
// poll the devices, so input queued before the IRQs were enabled is kept.
// While /dev/kbd is open the keyboard goes there instead (raw events).

import "../params.tri";
import "../printk.tri";
import "../sched.tri";
import "../signal.tri";
import "input.tri";
import "keymap.tri";

// termios, one word per flag field (Linux field order and bit values)
struct Termios {
    c_iflag: int;
    c_oflag: int;
    c_cflag: int;
    c_lflag: int;
    c_line: tryte;
    c_cc: [19]tryte;
}

struct Winsize {
    ws_row: int;
    ws_col: int;
    ws_xpixel: int;
    ws_ypixel: int;
}

const ICRNL: int = 256;               // c_iflag
const OPOST: int = 1;                 // c_oflag
const ONLCR: int = 4;
const ISIG: int = 1;                  // c_lflag
const ICANON: int = 2;
const ECHO: int = 8;
const ECHOE: int = 16;
const ECHOK: int = 32;

const VINTR: int = 0;
const VQUIT: int = 1;
const VERASE: int = 2;
const VKILL: int = 3;
const VEOF: int = 4;
const VTIME: int = 5;
const VMIN: int = 6;
const VSUSP: int = 10;

const TCGETS: int = 21505;
const TCSETS: int = 21506;
const TCSETSW: int = 21507;
const TCSETSF: int = 21508;
const TIOCGPGRP: int = 21519;
const TIOCSPGRP: int = 21520;
const TIOCGWINSZ: int = 21523;
const TIOCSWINSZ: int = 21524;
const TIOCGPTN: int = 2147767344;
const TIOCSPTLCK: int = 1074025521;

const NTTY: int = 10;                 // 0 = console, 1..9 = pseudo-terminals
const TTY_CHAN: int = 20000;          // + tty: slave readers
const PTM_CHAN: int = 20100;          // + tty: the master side
const TTY_BUF: int = 2187;
const LINE_MAX: int = 243;
const EOF_MARK: int = -1;             // in the ready queue: ^D on an empty line

struct Tty {
    used: int;                        // pty allocated (the console always is)
    iflag: int;
    oflag: int;
    cflag: int;
    lflag: int;
    cline: tryte;
    cc: [19]tryte;
    ready: [2187]tryte;               // characters a read may take
    ready_head: int;
    ready_count: int;
    line: [243]char;                  // the line being edited (canonical mode)
    line_len: int;
    pgrp: int;                        // foreground process group (0 = none yet)
    rows: int;
    cols: int;
    xpixel: int;                      // the size in pixels, as TIOCSWINSZ set it
    ypixel: int;
    out: [2187]tryte;                 // pty: output waiting for the master
    out_head: int;
    out_count: int;
    master_open: int;
    slave_opens: int;
    slave_seen: int;                  // the slave has been opened at least once
}

var ttys: [10]Tty;

fn tty_reset(t: int) {
    var y: *Tty = &ttys[t];
    y.iflag = ICRNL;
    y.oflag = OPOST + ONLCR;
    y.cflag = 0;
    y.lflag = ISIG + ICANON + ECHO + ECHOE + ECHOK;
    y.cline = 0;
    var k: int = 0;
    while (k < 19) { y.cc[k] = 0; k += 1; }
    y.cc[VINTR] = 3;
    y.cc[VQUIT] = 28;
    y.cc[VERASE] = 127;
    y.cc[VKILL] = 21;
    y.cc[VEOF] = 4;
    y.cc[VMIN] = 1;
    y.cc[VSUSP] = 26;
    y.ready_head = 0;
    y.ready_count = 0;
    y.line_len = 0;
    y.pgrp = 0;
    y.rows = 24;
    y.cols = 80;
    y.xpixel = 0;                     // unknown, as on Linux, until TIOCSWINSZ
    y.ypixel = 0;
    y.out_head = 0;
    y.out_count = 0;
    y.master_open = 0;
    y.slave_opens = 0;
    y.slave_seen = 0;
}

fn tty_init() {
    tty_reset(0);
    ttys[0].used = 1;
    ttys[0].pgrp = 1;
    ttys[0].rows = con_rows;
    ttys[0].cols = con_cols;
    ttys[0].xpixel = con_cols * 8;    // text mode: 8 x 16 pixel cells
    ttys[0].ypixel = con_rows * 16;
    out(KBD_CTRL, 1);
    out(SERIAL_CTRL, 1);
    out(TPIC_UNMASK, IRQ_KEYBOARD);
    out(TPIC_UNMASK, IRQ_SERIAL);
}

fn lflag(t: int, bit: int) -> int { return ttys[t].lflag / bit % 2 != 0; }

// ---- a VT100 subset on the text screen ------------------------------------------
//
// ESC [ row;col H (or f), ESC [ J / 2J, ESC [ K, ESC [ n A/B/C/D, and
// ESC [ ... m with 0, 30-37 and 40-47. The serial port gets the bytes as
// they are: a real terminal on the other end interprets them itself.

var esc_state: int;                   // 0 text, 1 after ESC, 2 inside ESC [
var esc_param: [9]int;
var esc_count: int;
var esc_fg: int = 7;
var esc_bg: int = 0;

fn colour_trit(c: int, bit: int) -> trit { return (c / bit % 2 != 0 ? 1 : -1) as trit; }

fn screen_set_cursor(row: int, col: int) {
    if (row < 0) { row = 0; }
    if (row > con_rows - 1) { row = con_rows - 1; }
    if (col < 0) { col = 0; }
    if (col > con_cols - 1) { col = con_cols - 1; }
    screen_row = row;
    screen_col = col;
    out(DISPLAY_CURSOR, row * con_cols + col);
}

fn screen_blank(from: int, to: int) {
    var i: int = from;
    while (i < to) {
        var p: *tryte = cell(i);
        p[0] = ' ';
        p[1] = screen_attr;
        i += 1;
    }
}

fn csi(final: char) {
    var p0: int = esc_param[0];
    var n: int = p0 == 0 ? 1 : p0;
    switch (final) {
        case 'H', 'f': screen_set_cursor(n - 1, (esc_count > 1 && esc_param[1] > 0 ? esc_param[1] : 1) - 1);
        case 'A': screen_set_cursor(screen_row - n, screen_col);
        case 'B': screen_set_cursor(screen_row + n, screen_col);
        case 'C': screen_set_cursor(screen_row, screen_col + n);
        case 'D': screen_set_cursor(screen_row, screen_col - n);
        case 'J': {
            if (p0 == 2) { screen_blank(0, con_cols * con_rows); }
            else { screen_blank(screen_row * con_cols + screen_col, con_cols * con_rows); }
        }
        case 'K': screen_blank(screen_row * con_cols + screen_col, (screen_row + 1) * con_cols);
        case 'm': {
            var k: int = 0;
            while (k < esc_count) {
                var v: int = esc_param[k];
                if (v == 0) { esc_fg = 7; esc_bg = 0; }
                else if (v >= 30 && v <= 37) { esc_fg = v - 30; }
                else if (v >= 40 && v <= 47) { esc_bg = v - 40; }
                k += 1;
            }
            screen_attr = attr(colour_trit(esc_fg, 1), colour_trit(esc_fg, 2), colour_trit(esc_fg, 4),
                colour_trit(esc_bg, 1), colour_trit(esc_bg, 2), colour_trit(esc_bg, 4));
        }
    }
}

// The screen's half of the output: escape sequences, else a character.
fn screen_output(c: char) -> int {
    if (esc_state == 1) {
        esc_state = c == '[' ? 2 : 0;
        esc_count = 1;
        esc_param[0] = 0;
        return 1;
    }
    if (esc_state == 2) {
        if (c >= '0' && c <= '9') { esc_param[esc_count - 1] = esc_param[esc_count - 1] * 10 + c - '0'; return 1; }
        if (c == ';') {
            if (esc_count < 9) { esc_param[esc_count] = 0; esc_count += 1; }
            return 1;
        }
        esc_state = 0;
        csi(c);
        return 1;
    }
    if (c == 27) { esc_state = 1; return 1; }
    return 0;
}

// The text screen is shown only in text mode (fb.tri switches it).
var screen_owned_by_fb: int;

fn console_output(c: char) {
    putc(c);
    if (screen_owned_by_fb) { return; }
    if (screen_output(c)) { return; }
    if (c == 8) {                                   // backspace: the screen cursor steps back
        if (screen_col > 0) {
            screen_col -= 1;
            out(DISPLAY_CURSOR, screen_row * con_cols + screen_col);
        }
        return;
    }
    screen_putc(c);
}

// One character of output from terminal t. For a pty it waits for the
// master; returns 0 if it had to be dropped (the master is gone or full).
fn tty_output(t: int, c: char) -> int {
    if (t == 0) { console_output(c); return 1; }
    var y: *Tty = &ttys[t];
    if (!y.master_open || y.out_count == TTY_BUF) { return 0; }
    y.out[(y.out_head + y.out_count) % TTY_BUF] = c as tryte;
    y.out_count += 1;
    wake_up(PTM_CHAN + t);
    return 1;
}

fn tty_echo(t: int, c: char) {
    if (!lflag(t, ECHO)) { return; }
    if (c >= 0 && c < 32 && c != '\n' && c != '\t') {   // control characters echo as ^X
        tty_output(t, '^');
        tty_output(t, (c + 64) as char);
        return;
    }
    tty_output(t, c);
}

fn erase_one(t: int) {
    var y: *Tty = &ttys[t];
    if (y.line_len == 0) { return; }
    var n: int = y.line_len;
    // a character above U+2671 (a lead -2 or -3, two trailing trytes) goes whole
    if (n >= 3 && (y.line[n - 3] == -2 || y.line[n - 3] == -3) && y.line[n - 2] < -32 && y.line[n - 1] < -32) {
        y.line_len -= 3;
    } else {
        y.line_len -= 1;
    }
    if (lflag(t, ECHO) && lflag(t, ECHOE)) {
        tty_output(t, 8 as char);
        tty_output(t, ' ');
        tty_output(t, 8 as char);
    }
}

fn ready_put(t: int, c: int) -> int {
    var y: *Tty = &ttys[t];
    if (y.ready_count == TTY_BUF) { return 0; }
    y.ready[(y.ready_head + y.ready_count) % TTY_BUF] = c as tryte;
    y.ready_count += 1;
    return 1;
}

fn commit_line(t: int) {
    var y: *Tty = &ttys[t];
    var i: int = 0;
    while (i < y.line_len) { ready_put(t, y.line[i]); i += 1; }
    y.line_len = 0;
    wake_up(TTY_CHAN + t);
}

// One character through terminal t's line discipline.
fn tty_receive(t: int, c: char) {
    var y: *Tty = &ttys[t];
    if (c == '\r' && y.iflag / ICRNL % 2 != 0) { c = '\n'; }
    if (lflag(t, ISIG) && c != 0) {
        var sig: int = 0;
        if (c == y.cc[VINTR]) { sig = SIGINT; }
        else if (c == y.cc[VQUIT]) { sig = SIGQUIT; }
        else if (c == y.cc[VSUSP]) { sig = SIGTSTP; }
        if (sig != 0) {
            tty_echo(t, c);                                 // "^C"
            y.line_len = 0;                                 // flush, as without NOFLSH
            y.ready_count = 0;
            if (y.pgrp > 0) { send_signal_pgrp(y.pgrp, sig); }
            return;
        }
    }
    if (!lflag(t, ICANON)) {
        if (ready_put(t, c)) { tty_echo(t, c); }
        wake_up(TTY_CHAN + t);
        return;
    }
    if (c == y.cc[VERASE] || c == 8) { erase_one(t); return; }
    if (c == y.cc[VKILL]) {
        while (y.line_len > 0) { erase_one(t); }
        return;
    }
    if (c == y.cc[VEOF]) {
        if (y.line_len == 0) { ready_put(t, EOF_MARK); wake_up(TTY_CHAN + t); }
        else { commit_line(t); }
        return;
    }
    if (c == '\n') {
        tty_echo(t, c);
        y.line[y.line_len] = c;
        y.line_len += 1;
        commit_line(t);
        return;
    }
    if (y.line_len < LINE_MAX - 1) {
        y.line[y.line_len] = c;
        y.line_len += 1;
        tty_echo(t, c);
    }
}

fn kbd_event(ev: int) {
    if (kbd_raw_event(ev)) { return; }               // /dev/kbd is open: raw events go there
    var c: int = keymap_event(ev);                    // US or Russian, Alt+Shift switches
    if (c != 0) { tty_receive(0, c as char); }
    else if (km_seq != null) {                        // arrows and the like: an escape sequence
        var k: int = 0;
        while (km_seq[k] != 0) { tty_receive(0, km_seq[k]); k += 1; }
    }
}

// Drain the console's input devices into its line discipline.
fn tty_poll() {
    while (in(KBD_COUNT) > 0) { kbd_event(in(KBD_DATA)); }
    while (in(SERIAL_RX_COUNT) > 0) { tty_receive(0, in(SERIAL_DATA) as char); }
}

fn hung_up(t: int) -> int { return t != 0 && !ttys[t].master_open; }

// Is there something a read can return now (or end of file)?
fn tty_can_read(t: int) -> int {
    if (t == 0) { tty_poll(); }
    return ttys[t].ready_count > 0 || hung_up(t);
}

fn ready_take(t: int) -> int {
    var y: *Tty = &ttys[t];
    var c: int = y.ready[y.ready_head];
    y.ready_head = (y.ready_head + 1) % TTY_BUF;
    y.ready_count -= 1;
    return c;
}

// Read from terminal t into `buf`. Blocks until input is available.
fn tty_read(t: int, buf: *tryte, n: int, nonblock: int) -> int {
    var me: *Task = current_task();
    var y: *Tty = &ttys[t];
    if (y.pgrp > 0 && me.pgid != y.pgrp && group_exists(y.pgrp, me.sid)) {   // a background read
        if (sig_ignored(me, SIGTTIN) || sigset_has(me.sig_blocked, SIGTTIN)) { return -EIO; }
        send_signal_pgrp(me.pgid, SIGTTIN);
        return -ERESTARTSYS;                                    // read again once in the foreground
    }
    if (n == 0) { return 0; }
    while (!tty_can_read(t)) {
        if (nonblock) { return -EAGAIN; }
        if (sleep_on(TTY_CHAN + t)) { return -ERESTARTSYS; }
    }
    var k: int = 0;
    while (k < n && y.ready_count > 0) {
        if (y.ready[y.ready_head] == EOF_MARK) {
            if (k == 0) { ready_take(t); }          // ^D: this read returns 0
            break;
        }
        var c: int = ready_take(t);
        buf[k] = c as tryte;
        k += 1;
        if (c == '\n' && lflag(t, ICANON)) { break; }   // one line per read
    }
    return k;                                        // 0 after a hangup: end of file
}

fn tty_write(t: int, buf: *tryte, n: int, nonblock: int) -> int {
    var i: int = 0;
    while (i < n) {
        if (hung_up(t)) { return i > 0 ? i : -EIO; }
        if (!tty_output(t, buf[i] as char)) {
            if (nonblock) { return i > 0 ? i : -EAGAIN; }
            if (sleep_on(PTM_CHAN + t)) { return i > 0 ? i : -ERESTARTSYS; }   // wait for the master
            continue;
        }
        i += 1;
    }
    return n;
}

// ioctl on terminal t; `arg` has been checked to be a user address.
fn tty_ioctl(t: int, cmd: int, arg: int) -> int {
    var y: *Tty = &ttys[t];
    switch (cmd) {
        case TCGETS: {
            var u: *Termios = arg as *Termios;
            u.c_iflag = y.iflag;
            u.c_oflag = y.oflag;
            u.c_cflag = y.cflag;
            u.c_lflag = y.lflag;
            u.c_line = y.cline;
            var k: int = 0;
            while (k < 19) { u.c_cc[k] = y.cc[k]; k += 1; }
            return 0;
        }
        case TCSETS, TCSETSW, TCSETSF: {
            var u2: *Termios = arg as *Termios;
            y.iflag = u2.c_iflag;
            y.oflag = u2.c_oflag;
            y.cflag = u2.c_cflag;
            y.lflag = u2.c_lflag;
            y.cline = u2.c_line;
            var k2: int = 0;
            while (k2 < 19) { y.cc[k2] = u2.c_cc[k2]; k2 += 1; }
            if (cmd == TCSETSF) { y.ready_count = 0; y.line_len = 0; }
            if (!lflag(t, ICANON)) { commit_line(t); }  // a half-typed line becomes input
            return 0;
        }
        case TIOCGPGRP: {
            *(arg as *int) = y.pgrp;
            return 0;
        }
        case TIOCSPGRP: {
            var g: int = *(arg as *int);
            if (g <= 0) { return -EINVAL; }
            if (!group_exists(g, current_task().sid)) { return -EPERM; }
            y.pgrp = g;
            return 0;
        }
        case TIOCGWINSZ: {
            var w: *Winsize = arg as *Winsize;
            w.ws_row = y.rows;
            w.ws_col = y.cols;
            w.ws_xpixel = y.xpixel;
            w.ws_ypixel = y.ypixel;
            return 0;
        }
        case TIOCSWINSZ: {
            var w2: *Winsize = arg as *Winsize;
            if (w2.ws_row <= 0 || w2.ws_col <= 0 || w2.ws_xpixel < 0 || w2.ws_ypixel < 0) { return -EINVAL; }
            var changed: int = y.rows != w2.ws_row || y.cols != w2.ws_col || y.xpixel != w2.ws_xpixel || y.ypixel != w2.ws_ypixel;
            y.rows = w2.ws_row;
            y.cols = w2.ws_col;
            y.xpixel = w2.ws_xpixel;
            y.ypixel = w2.ws_ypixel;
            // the foreground group hears of a new size (Linux: SIGWINCH)
            if (changed && y.pgrp > 0) { send_signal_pgrp(y.pgrp, SIGWINCH); }
            return 0;
        }
    }
    return -25;                                         // ENOTTY
}

// ---- the master side (/dev/ptmx) ------------------------------------------------------

// A free pseudo-terminal: its number, or -EAGAIN.
fn pty_alloc() -> int {
    var t: int = 1;
    while (t < NTTY) {
        if (!ttys[t].used) {
            tty_reset(t);
            ttys[t].used = 1;
            ttys[t].master_open = 1;
            return t;
        }
        t += 1;
    }
    return -EAGAIN;
}

fn pty_release_if_done(t: int) {
    if (ttys[t].used && !ttys[t].master_open && ttys[t].slave_opens == 0) {
        ttys[t].used = 0;
        devfs_pts_remove(t);
    }
}

// The master went away: hang up the slave (SIGHUP to its group, reads see EOF).
fn pty_master_close(t: int) {
    var y: *Tty = &ttys[t];
    y.master_open = 0;
    if (y.pgrp > 0) {
        send_signal_pgrp(y.pgrp, SIGHUP);
        send_signal_pgrp(y.pgrp, SIGCONT);
    }
    wake_up(TTY_CHAN + t);
    wake_up(PTM_CHAN + t);
    pty_release_if_done(t);
}

fn pty_master_read(t: int, buf: *tryte, n: int, nonblock: int) -> int {
    var y: *Tty = &ttys[t];
    while (y.out_count == 0) {
        if (y.slave_seen && y.slave_opens == 0) { return -EIO; }      // as on Linux
        if (nonblock) { return -EAGAIN; }
        if (sleep_on(PTM_CHAN + t)) { return -ERESTARTSYS; }
    }
    var k: int = 0;
    while (k < n && y.out_count > 0) {
        buf[k] = y.out[y.out_head];
        y.out_head = (y.out_head + 1) % TTY_BUF;
        y.out_count -= 1;
        k += 1;
    }
    wake_up(PTM_CHAN + t);                           // a writer waiting for room
    return k;
}

// What the master writes is typed into the slave.
fn pty_master_write(t: int, buf: *tryte, n: int) -> int {
    var i: int = 0;
    while (i < n) {
        tty_receive(t, buf[i] as char);
        i += 1;
    }
    return n;
}

