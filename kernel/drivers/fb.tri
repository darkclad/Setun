// fb: /dev/fb0, the framebuffer device (after Linux's fbdev).
//
// One process may have it open (EBUSY otherwise): the display server.
//   ioctl FBIOGET_VSCREENINFO  { xres, yres, pitch, mode }  (one word each;
//                              in a text mode, xres and yres count cells)
//   ioctl FBIOPUT_VSCREENINFO  set `mode`: -1 text, 0 = 640x480, 1 = 800x600,
//                              2 = 1024x768, 3 = 1280x1024, 4 = 1600x1200,
//                              5 = 1920x1080, 6 = 1920x1200 (EINVAL otherwise)
//   ioctl FBIO_CURSOR          { x, y, enable }: the hardware mouse cursor
//   ioctl FBIOGET_PREFERRED    *arg = the monitor's size as a graphics mode
//                              (0..6), the size the console's text mode fills
//   read/write                 pixels at the file position (tryte = pixel)
//   mmap                       the pixels, shared (see sys_mmap)
// Mode -1 asks for the console's text mode, whichever size that is. While
// a graphics mode is on, console output still reaches the serial port but
// not the screen. When the owner closes it (or dies), the text console
// comes back.

import "../params.tri";
import "../printk.tri";
import "tty.tri";

const FBIOGET_VSCREENINFO: int = 17920;
const FBIOPUT_VSCREENINFO: int = 17921;
const FBIO_CURSOR: int = 17928;
const FBIOGET_PREFERRED: int = 18144;     // 0x46E0: Trinux's own
const FB_FIRST_FRAME: int = -324;     // FB_BASE is the first tryte of frame -324
const FB_MAX_FRAMES: int = 118;       // 1920 x 1200 trytes fit in 118 frames
const FB_MAX_MODE: int = 6;

struct FbInfo {
    xres: int;
    yres: int;
    pitch: int;
    mode: int;
}

struct FbCursor {
    x: int;
    y: int;
    enable: int;
}

var fb_open: int;

fn fb_mode() -> int { return in(DISPLAY_MODE); }

// Trytes the framebuffer has in the current mode (a text cell is three).
fn fb_size() -> int {
    return in(DISPLAY_PITCH) * in(DISPLAY_HEIGHT);
}

fn fb_set_mode(m: int) {
    if (m < 0) {
        out(DISPLAY_HWC_ON, 0);
        screen_owned_by_fb = 0;
        screen_clear();                               // the console's mode, on a fresh screen
    } else {
        out(DISPLAY_MODE, m);
        screen_owned_by_fb = 1;
        var p: *tryte = FB_BASE as *tryte;
        zero_trytes(p, fb_size());                    // black
    }
}

fn fb_dev_open() -> int {
    if (fb_open) { return -EBUSY; }
    fb_open = 1;
    return 0;
}

fn fb_dev_close() {
    fb_open = 0;
    if (fb_mode() >= 0) { fb_set_mode(-1); }
}

fn fb_dev_ioctl(cmd: int, arg: int) -> int {
    switch (cmd) {
        case FBIOGET_VSCREENINFO: {
            var i: *FbInfo = arg as *FbInfo;
            var m: int = fb_mode();
            i.mode = m;
            i.xres = in(DISPLAY_WIDTH);
            i.yres = in(DISPLAY_HEIGHT);
            i.pitch = in(DISPLAY_PITCH);
            return 0;
        }
        case FBIOPUT_VSCREENINFO: {
            var j: *FbInfo = arg as *FbInfo;
            if (j.mode < -1 || j.mode > FB_MAX_MODE) { return -EINVAL; }
            var want: int = j.mode == -1 ? con_mode : j.mode;
            if (want != fb_mode()) { fb_set_mode(j.mode); }
            return 0;
        }
        case FBIOGET_PREFERRED: {
            *(arg as *int) = -con_mode - 1;
            return 0;
        }
        case FBIO_CURSOR: {
            var c: *FbCursor = arg as *FbCursor;
            out(DISPLAY_HWC_X, c.x);
            out(DISPLAY_HWC_Y, c.y);
            out(DISPLAY_HWC_ON, c.enable != 0);
            return 0;
        }
    }
    return -ENOTTY;
}

fn fb_dev_read(pos: int, buf: *tryte, n: int) -> int {
    var size: int = fb_size();
    if (pos >= size) { return 0; }
    if (n > size - pos) { n = size - pos; }
    copy_trytes(buf, (FB_BASE + pos) as *tryte, n);
    return n;
}

fn fb_dev_write(pos: int, buf: *tryte, n: int) -> int {
    var size: int = fb_size();
    if (pos >= size) { return -28; }                  // ENOSPC, as Linux's fbdev
    if (n > size - pos) { n = size - pos; }
    copy_trytes((FB_BASE + pos) as *tryte, buf, n);
    return n;
}
