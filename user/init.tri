// /sbin/init: run /bin/login on the console, start it again whenever the
// session ends, and reap orphans. If login cannot be run at all, fall back
// to a root shell, so a broken disk can still be repaired.

import "lib/tlibc.tri";
import "lib/socket.tri";

fn spawn(path: *char, name: *char) -> int {
    var pid: int = fork();
    if (pid == 0) {
        var args: [2]*char = { name, null };
        execve(path, &args[0], environ);              // HOME=/ TERM=linux from the kernel
        perror2("init", path);
        _exit(127);
    }
    return pid;
}

// A daemon, with its messages in a log file rather than on the console.
fn spawn_logged(path: *char, name: *char, log: *char) -> int {
    var pid: int = fork();
    if (pid == 0) {
        var fd: int = open(log, O_WRONLY + O_CREAT + O_APPEND, 384);       // 0600
        if (fd >= 0) {
            dup2(fd, 1);
            dup2(fd, 2);
            if (fd > 2) { close(fd); }
        }
        var args: [2]*char = { name, null };
        execve(path, &args[0], environ);
        perror2("init", path);
        _exit(127);
    }
    return pid;
}

// Is the ternary link up? The first line of /proc/net/tlink says.
fn tl0_up() -> int {
    var fd: int = open("/proc/net/tlink", O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var buf: [81]char;
    var n: int = read(fd, &buf[0], 80);
    close(fd);
    if (n <= 0) { return 0; }
    buf[n] = 0;
    var k: int = 0;
    while (k < n && buf[k] != '\n') { k += 1; }
    return k >= 3 && buf[k - 3] == ' ' && buf[k - 2] == 'u' && buf[k - 1] == 'p';
}

// With a network attached, logins over telnet are served too.
fn eth0_up() -> int {
    var s: int = socket(AF_INET, SOCK_DGRAM, 0);
    if (s < 0) { return 0; }
    var r: ifreq;
    r.ifr_name[0] = 'e'; r.ifr_name[1] = 't'; r.ifr_name[2] = 'h'; r.ifr_name[3] = '0'; r.ifr_name[4] = 0;
    var up: int = ioctl(s, SIOCGIFFLAGS, &r as int) == 0 && r.ifr_value % 2 == 1;
    close(s);
    return up;
}

fn main(argc: int, argv: **char) -> int {
    puts("init: pid ");
    put_int(getpid());
    puts(", starting /bin/login\n");
    var pid: int = spawn("/bin/login", "login");
    if (eth0_up()) {
        puts("init: eth0 is up, starting /sbin/telnetd, /sbin/sshd and /sbin/httpd (logs in /var/log)\n");
        spawn_logged("/sbin/telnetd", "telnetd", "/var/log/telnetd.log");
        spawn_logged("/sbin/sshd", "sshd", "/var/log/sshd.log");
        spawn_logged("/sbin/httpd", "httpd", "/var/log/httpd.log");
    } else if (tl0_up()) {
        puts("init: tl0 is up, starting /sbin/sshd (logs in /var/log)\n");
        spawn_logged("/sbin/sshd", "sshd", "/var/log/sshd.log");
    }
    var quick_failures: int = 0;
    loop {
        var status: int = 0;
        var w: int = wait(&status);
        if (w < 0) { return 1; }
        if (w != pid) { continue; }                     // an orphan
        var code: int = WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
        puts("init: login session exited with ");
        put_int(code);
        puts("\n");
        if (code == 127) { quick_failures += 1; } else { quick_failures = 0; }
        if (quick_failures >= 3) {
            puts("init: /bin/login does not run; starting a root shell\n");
            pid = spawn("/bin/sh", "sh");
            quick_failures = 0;
            continue;
        }
        pid = spawn("/bin/login", "login");
    }
}
