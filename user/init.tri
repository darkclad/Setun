// /sbin/init: run /bin/sh on the console, reap orphans, and exit with the
// shell's status when it exits (which the kernel reports as Linux does:
// "Attempted to kill init!"). Runlevels and respawning come later.

import "lib/tlibc.tri";

fn main(argc: int, argv: **char) -> int {
    puts("init: pid ");
    put_int(getpid());
    puts(", starting /bin/sh\n");
    var pid: int = fork();
    if (pid == 0) {
        var args: [2]*char = { "sh", null };
        execve("/bin/sh", &args[0], null);
        perror2("init", "/bin/sh");
        _exit(127);
    }
    loop {
        var status: int = 0;
        var w: int = wait(&status);
        if (w < 0) { return 1; }
        if (w == pid) {
            var code: int = WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
            puts("init: /bin/sh exited with ");
            put_int(code);
            puts("\n");
            return code;
        }
    }
}
