// sftp [-P PORT] [-i KEY] [-b BATCHFILE] [USER@]HOST: browse and copy
// files on another machine over SSH. Commands, one per line:
//
//   ls [path]   cd path   pwd   get remote [local]   put local [remote]
//   mkdir path  rmdir path  rm path  rename old new
//   lcd path    lpwd      lls [path]    help    bye / quit / exit
//
// With -b the commands come from a file, and the first failure ends the
// session with status 1 (a command written "-cmd" may fail), as OpenSSH's
// sftp does it.

import "../lib/tlibc.tri";
import "../lib/stdlib.tri";
import "../lib/string.tri";
import "../lib/getopt.tri";
import "../lib/sftpclient.tri";

var cwd: [243]char;                       // the remote directory
var line: [729]char;
var batch: int;

fn print_line(s: *char) {
    puts(s);
    puts("\n");
}

// A path against the remote directory, into out.
fn remote_path(p: *char, out: *char) {
    if (p[0] == '/') { strncpy(out, p, 240); out[240] = 0; return; }
    strcpy(out, &cwd[0]);
    if (!streq(&cwd[0], "/")) { strcat(out, "/"); }
    strncat(out, p, 240 - strlen(out));
}

fn base_name(p: *char) -> *char {
    var b: *char = strrchr(p, '/');
    return b == null ? p : &b[1];
}

// The words of a line (at most 3), in place.
var words: [3]*char;

fn split(s: *char) -> int {
    var n: int = 0;
    var k: int = 0;
    while (s[k] != 0 && n < 3) {
        while (s[k] == ' ' || s[k] == '\t') { k += 1; }
        if (s[k] == 0) { break; }
        words[n] = &s[k];
        n += 1;
        while (s[k] != 0 && s[k] != ' ' && s[k] != '\t') { k += 1; }
        if (s[k] != 0) { s[k] = 0; k += 1; }
    }
    return n;
}

fn report(what: *char, r: int) -> int {
    if (r >= 0) { return 0; }
    fputs(STDERR_FILENO, what);
    fputs(STDERR_FILENO, ": ");
    fputs(STDERR_FILENO, sftp_error(r));
    fputs(STDERR_FILENO, "\n");
    return 1;
}

// One command: 0 done, 1 failed, 2 the end.
fn command(s: *char) -> int {
    var n: int = split(s);
    if (n == 0) { return 0; }
    var w: *char = words[0];
    var a: [500]char;
    var b: [500]char;
    if (streq(w, "bye") || streq(w, "quit") || streq(w, "exit")) { return 2; }
    if (streq(w, "help") || streq(w, "?")) {
        print_line("ls [path]  cd path  pwd  get remote [local]  put local [remote]");
        print_line("mkdir path  rmdir path  rm path  rename old new  lcd path  lpwd  lls [path]  bye");
        return 0;
    }
    if (streq(w, "pwd")) {
        puts("Remote working directory: ");
        print_line(&cwd[0]);
        return 0;
    }
    if (streq(w, "lpwd")) {
        getcwd(&a[0], 243);
        puts("Local working directory: ");
        print_line(&a[0]);
        return 0;
    }
    if (streq(w, "cd")) {
        if (n < 2) { return report("cd", -SFX_FAILURE); }
        remote_path(words[1], &a[0]);
        var r: int = sftp_realpath(&a[0], &b[0]);
        if (r < 0) { return report(words[1], r); }
        if (!sftp_is_dir(&b[0])) { fputs(STDERR_FILENO, "cd: not a directory\n"); return 1; }
        strcpy(&cwd[0], &b[0]);
        return 0;
    }
    if (streq(w, "lcd")) {
        if (n < 2 || chdir(words[1]) < 0) { perror2("lcd", n < 2 ? "" : words[1]); return 1; }
        return 0;
    }
    if (streq(w, "ls")) {
        remote_path(n > 1 ? words[1] : ".", &a[0]);
        return report(&a[0], sftp_list(&a[0], &print_line));
    }
    if (streq(w, "lls")) {
        var pid: int = fork();
        if (pid == 0) {
            var args: [4]*char = { "ls", "-l", n > 1 ? words[1] : ".", null };
            execv("/bin/ls", &args[0]);
            _exit(127);
        }
        var st: int = 0;
        waitpid(pid, &st, 0);
        return 0;
    }
    if (streq(w, "get")) {
        if (n < 2) { return report("get", -SFX_FAILURE); }
        remote_path(words[1], &a[0]);
        strcpy(&b[0], n > 2 ? words[2] : base_name(words[1]));
        puts("Fetching ");
        puts(&a[0]);
        puts(" to ");
        print_line(&b[0]);
        return report(&a[0], sftp_get(&a[0], &b[0]));
    }
    if (streq(w, "put")) {
        if (n < 2) { return report("put", -SFX_FAILURE); }
        remote_path(n > 2 ? words[2] : base_name(words[1]), &a[0]);
        if (sftp_is_dir(&a[0])) {
            strcat(&a[0], "/");
            strncat(&a[0], base_name(words[1]), 200);
        }
        puts("Uploading ");
        puts(words[1]);
        puts(" to ");
        print_line(&a[0]);
        return report(words[1], sftp_put(words[1], &a[0]));
    }
    if (streq(w, "mkdir") || streq(w, "rmdir") || streq(w, "rm")) {
        if (n < 2) { return report(w, -SFX_FAILURE); }
        remote_path(words[1], &a[0]);
        var r: int = streq(w, "mkdir") ? sftp_mkdir(&a[0]) : streq(w, "rmdir") ? sftp_rmdir(&a[0]) : sftp_remove(&a[0]);
        if (r < 0) {
            fputs(STDERR_FILENO, "Couldn't ");
            fputs(STDERR_FILENO, streq(w, "mkdir") ? "create directory" : streq(w, "rmdir") ? "remove directory" : "delete file");
            fputs(STDERR_FILENO, ": ");
            fputs(STDERR_FILENO, sftp_error(r));
            fputs(STDERR_FILENO, "\n");
            return 1;
        }
        return 0;
    }
    if (streq(w, "rename")) {
        if (n < 3) { return report("rename", -SFX_FAILURE); }
        remote_path(words[1], &a[0]);
        remote_path(words[2], &b[0]);
        return report(&a[0], sftp_rename(&a[0], &b[0]));
    }
    fputs(STDERR_FILENO, "Invalid command: ");
    fputs(STDERR_FILENO, w);
    fputs(STDERR_FILENO, "\n");
    return 1;
}

// A line from fd (without its newline): its length, or -1 at the end.
fn read_line(fd: int) -> int {
    var n: int = 0;
    var got: int = 0;
    loop {
        var c: [1]char;
        var r: int = read(fd, &c[0], 1);
        if (r <= 0) { break; }
        got = 1;
        if (c[0] == '\n') { break; }
        if (n < 728) { line[n] = c[0]; n += 1; }
    }
    line[n] = 0;
    return got ? n : -1;
}

fn main(argc: int, argv: **char) -> int {
    var identity: [300]char;
    identity[0] = 0;
    var batchfile: *char = null;
    ssh_prog = "sftp";
    var c: int = getopt(argc, argv, "P:i:b:");
    while (c != -1) {
        switch (c) {
            case 'P': port = atoi(optarg);
            case 'i': { strncpy(&identity[0], optarg, 290); identity[290] = 0; }
            case 'b': batchfile = optarg;
            default: {
                fputs(STDERR_FILENO, "usage: sftp [-P port] [-i key] [-b batchfile] [user@]host\n");
                return 1;
            }
        }
        c = getopt(argc, argv, "P:i:b:");
    }
    if (optind != argc - 1) {
        fputs(STDERR_FILENO, "usage: sftp [-P port] [-i key] [-b batchfile] [user@]host\n");
        return 1;
    }
    var in: int = STDIN_FILENO;
    if (batchfile != null) {
        in = open(batchfile, O_RDONLY, 0);
        if (in < 0) { perror2("sftp", batchfile); return 1; }
        batch = 1;
    }
    client_target(argv[optind]);
    client_connect(&identity[0]);
    sftp_start();
    if (sftp_realpath(".", &cwd[0]) < 0) { strcpy(&cwd[0], "/"); }
    if (!batch) {
        puts("Connected to ");
        puts(&host[0]);
        puts(".\n");
    }
    loop {
        if (!batch) { puts("sftp> "); }
        if (read_line(in) < 0) { return 0; }
        if (batch) {
            puts("sftp> ");
            print_line(&line[0]);                 // as written, "-" and all
        }
        var cmd: *char = &line[0];
        var may_fail: int = 0;
        if (cmd[0] == '-') { may_fail = 1; cmd = &cmd[1]; }
        var r: int = command(cmd);
        if (r == 2) { return 0; }
        if (r == 1 && batch && !may_fail) { return 1; }
    }
}
