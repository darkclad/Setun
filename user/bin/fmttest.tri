// /bin/fmttest: the ternary data formats' libraries (docs/FORMATS.md):
// tvarint, TTV and TIM round trips, and the malformed inputs each must
// refuse.

import "../lib/tlibc.tri";
import "../lib/string.tri";
import "../lib/stdlib.tri";
import "../lib/tvarint.tri";
import "../lib/ttv.tri";
import "../lib/tim.tri";
import "../lib/flags.tri";              // its tv_ names live beside tvar_

var failures: int;

fn ok(what: *char, cond: int) {
    puts("fmttest: ");
    puts(what);
    if (cond) { puts(" ok\n"); } else { puts(" FAILED\n"); failures += 1; }
}

// encode v, decode it back: the same value and the given length
fn tvar_round(v: int, len: int) -> int {
    var b: [8]tryte;
    var n: int = tvar_put(&b[0], v);
    var w: int;
    return n == len && tvar_get(&b[0], n, &w) == n && w == v;
}

fn tvar_round_long(v: long, len: int) -> int {
    var b: [16]tryte;
    var n: int = tvar_put_long(&b[0], v);
    var w: long;
    return n == len && tvar_get_long(&b[0], n, &w) == n && w == v;
}

fn tvarints() {
    ok("beside flags.tri", tv_get(tv_set(0, 5, true), 5) == true && tvar_round(5, 1));
    ok("tvarint 0, 1, -1", tvar_round(0, 1) && tvar_round(1, 1) && tvar_round(-1, 1));
    ok("tvarint at a tryte's edge", tvar_round(3280, 1) && tvar_round(-3280, 1) && tvar_round(3281, 2) && tvar_round(-3281, 2));
    ok("tvarint at two trytes' edge", tvar_round(21523360, 2) && tvar_round(21523361, 3) && tvar_round(-21523361, 3));
    ok("tvarint of a whole word", tvar_round(3812798742493, 4) && tvar_round(-3812798742493, 4));
    var b: [16]tryte;
    tvar_put(&b[0], 3281);
    ok("tvarint 3281 is 3281, 1", b[0] == 3281 && b[1] == 1);
    tvar_put(&b[0], -10000);
    ok("tvarint -10000 is 9683, -2", b[0] == 9683 && b[1] == -2);
    var k: int = -200;
    var all: int = 1;
    while (k <= 200) {
        var v: int = k * 19041013007;
        var n: int = tvar_put(&b[0], v);
        var w: int;
        if (tvar_get(&b[0], n, &w) != n || w != v) { all = 0; }
        k += 1;
    }
    ok("tvarint round trips", all);
    var lmax: long = 0t111111111111111111111111111111111111111111111111111111111111111111111111111111111;
    ok("tvarint of a long", tvar_round_long(lmax, 11) && tvar_round_long(-lmax, 11) && tvar_round_long(123456789012345678901234567890, 8));
    var w: int;
    var l: long;
    b[0] = 6561;
    b[1] = 0;
    ok("refused: not canonical (a zero last group)", tvar_get(&b[0], 2, &w) < 0);
    b[0] = -5000;
    ok("refused: a control trit of -1", tvar_get(&b[0], 1, &w) < 0);
    b[0] = 6562;
    ok("refused: cut short", tvar_get(&b[0], 1, &w) < 0);
    k = 0;
    while (k < 4) { b[k] = 6561 + 5; k += 1; }
    b[4] = 1;
    ok("refused: five trytes for an int", tvar_get(&b[0], 5, &w) < 0);
    tvar_put_long(&b[0], 3812798742494);
    ok("refused: past a word for an int", tvar_get(&b[0], 4, &w) < 0 && tvar_get_long(&b[0], 4, &l) == 4 && l == 3812798742494);
    k = 0;
    while (k < 10) { b[k] = 6561; k += 1; }
    b[10] = 2;
    ok("refused: past 81 trits", tvar_get_long(&b[0], 11, &l) < 0);
    k = 0;
    while (k < 11) { b[k] = 6561 + 1; k += 1; }
    b[11] = 1;
    ok("refused: twelve trytes", tvar_get_long(&b[0], 12, &l) < 0);
}

fn ttvs() {
    var b: TtvBuf;
    ttv_init(&b);
    ttv_map(&b, 3);
    ttv_text(&b, "name");
    ttv_text(&b, "Сетунь 日本");                  // a 3-tryte character
    ttv_text(&b, "seen");
    ttv_list(&b, 4);
    ttv_truth(&b, true);
    ttv_truth(&b, unknown);
    ttv_truth(&b, false);
    ttv_null(&b);
    ttv_long(&b, -123456789012345678901234567890);
    ttv_list(&b, 2);
    ttv_real(&b, 2.5);
    var oc: [3]tryte;
    oc[0] = 0;
    oc[1] = 255;
    oc[2] = 10;
    ttv_octets(&b, &oc[0], 3);
    var r: TtvReader;
    ttv_reader(&r, b.p, b.n);
    ok("a map of 3", ttv_read_count(&r, TTV_MAP) == 3);
    var s: [81]char;
    ok("its texts", ttv_read_text(&r, &s[0], 80) == 4 && streq(&s[0], "name") && ttv_read_text(&r, &s[0], 80) > 0 && streq(&s[0], "Сетунь 日本"));
    ok("a list of truths and null", ttv_read_text(&r, &s[0], 80) == 4 && ttv_read_count(&r, TTV_LIST) == 4
        && ttv_read_truth(&r) == 1 && ttv_read_truth(&r) == 0 && ttv_read_truth(&r) == -1 && ttv_read_null(&r) == 0);
    var l: long;
    ok("a long key", ttv_read_long(&r, &l) == 0 && l == -123456789012345678901234567890);
    var x: real;
    var got: [3]tryte;
    ok("a real and octets", ttv_read_count(&r, TTV_LIST) == 2 && ttv_read_real(&r, &x) == 0 && x == 2.5
        && ttv_read_octets(&r, &got[0], 3) == 3 && got[1] == 255);
    ok("then the end", ttv_at_end(&r));
    ttv_reader(&r, b.p, b.n);
    ok("ttv_skip skips it all", ttv_skip(&r) == 0 && ttv_at_end(&r));
    // malformed
    var bad: [8]tryte;
    bad[0] = 9;
    ttv_reader(&r, &bad[0], 1);
    ok("refused: an unknown tag", ttv_skip(&r) < 0);
    bad[0] = TTV_TRUTH;
    bad[1] = 2;
    ttv_reader(&r, &bad[0], 2);
    ok("refused: a truth of 2", ttv_read_truth(&r) == -2 && r.err);
    bad[0] = TTV_TEXT;
    bad[1] = 5;
    bad[2] = 'a';
    ttv_reader(&r, &bad[0], 3);
    ok("refused: a text longer than the data", ttv_read_text(&r, &s[0], 80) < 0);
    bad[0] = TTV_LIST;
    bad[1] = 50;
    ttv_reader(&r, &bad[0], 2);
    ok("refused: a count past the data", ttv_skip(&r) < 0);
    bad[0] = TTV_INT;
    bad[1] = 6561;
    ttv_reader(&r, &bad[0], 2);
    var v: int;
    ok("refused: a cut tvarint", ttv_read_int(&r, &v) < 0);
    bad[0] = TTV_REAL;
    ttv_reader(&r, &bad[0], 5);
    ok("refused: a real cut short", ttv_read_real(&r, &x) < 0);
    bad[0] = TTV_NULL;
    ttv_reader(&r, &bad[0], 1);
    ok("refused: a value of the wrong type", ttv_read_int(&r, &v) < 0);
}

var seed: int = 12345;
fn rnd(m: int) -> int {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    if (seed < 0) { seed += 2147483648; }
    return seed % m;
}

fn same_tim(a: *Tim, b: *Tim) -> int {
    if (a.w != b.w || a.h != b.h || a.ch != b.ch || a.depth != b.depth) { return 0; }
    var k: int = 0;
    while (k < a.w * a.h * a.ch) { if (a.s[k] != b.s[k]) { return 0; } k += 1; }
    return 1;
}

fn tims() {
    // a picture with flat areas, an edge and noise
    var t: Tim;
    tim_alloc(&t, 40, 30, 3, 6);
    var y: int = 0;
    while (y < 30) {
        var x: int = 0;
        while (x < 40) {
            var c: int = 0;
            while (c < 3) {
                var v: int = x < 20 ? 0 : 100 + c;
                if (y > 20) { v = rnd(729) - 364; }
                t.s[(y * 40 + x) * 3 + c] = v as tryte;
                c += 1;
            }
            x += 1;
        }
        y += 1;
    }
    var raw: TtvBuf;
    ttv_init(&raw);
    tim_write(&t, TIM_RAW, &raw);
    var pr: TtvBuf;
    ttv_init(&pr);
    tim_write(&t, TIM_PREDICTED, &pr);
    var u: Tim;
    ok("TIM raw round trip", raw.n == TIM_HEADER + 3600 && tim_read(raw.p, raw.n, &u) == 0 && same_tim(&t, &u));
    ok("TIM predicted round trip", tim_read(pr.p, pr.n, &u) == 0 && same_tim(&t, &u));
    ok("predicted is smaller", pr.n < raw.n);
    var flat: Tim;
    tim_alloc(&flat, 100, 100, 1, 3);
    var k: int = 0;
    while (k < 10000) { flat.s[k] = 0; k += 1; }
    var fb: TtvBuf;
    ttv_init(&fb);
    tim_write(&flat, TIM_PREDICTED, &fb);
    ok("a flat picture is runs (4 trytes)", fb.n == TIM_HEADER + 4 && tim_read(fb.p, fb.n, &u) == 0 && same_tim(&flat, &u));
    // a known answer: 25 20 5 / 30 0 7 predicts 0 25 20 / 25 25 0 (every
    // branch of the median edge predictor), so the residuals are these
    var small: Tim;
    tim_alloc(&small, 3, 2, 1, 6);
    small.s[0] = 25; small.s[1] = 20; small.s[2] = 5;
    small.s[3] = 30; small.s[4] = 0; small.s[5] = 7;
    var sb: TtvBuf;
    ttv_init(&sb);
    tim_write(&small, TIM_PREDICTED, &sb);
    var q: *tryte = sb.p + TIM_HEADER;
    ok("the residuals of a known picture", sb.n == TIM_HEADER + 6 && q[0] == 25 && q[1] == -5 && q[2] == -15
        && q[3] == 5 && q[4] == -25 && q[5] == 7);
    q[1] = 0;
    ok("refused: a zero residual (always a run)", tim_read(sb.p, sb.n, &u) < 0);
    // malformed
    pr.p[0] = 0;
    ok("refused: a bad magic", tim_read(pr.p, pr.n, &u) < 0);
    tw_put(pr.p, TIM_MAGIC);
    ok("refused: a trailing tryte", tim_read(pr.p, pr.n + 1, &u) < 0 || pr.n + 1 > pr.cap);
    ok("refused: cut short", tim_read(pr.p, pr.n - 1, &u) < 0);
    tw_put(pr.p + 15, 10);
    ok("refused: depth 10", tim_read(pr.p, pr.n, &u) < 0);
    tw_put(pr.p + 15, 6);
    tw_put(pr.p + 15, 2);                         // depth 2: the samples are out of range
    ok("refused: a sample past its depth", tim_read(pr.p, pr.n, &u) < 0);
    tw_put(fb.p + 18, 7);
    ok("refused: an unknown coding", tim_read(fb.p, fb.n, &u) < 0);
    tw_put(fb.p + 18, TIM_PREDICTED);
    fb.p[TIM_HEADER] = -6561;                     // a run of 0
    ok("refused: an empty run", tim_read(fb.p, fb.n, &u) < 0);
}

fn main(argc: int, argv: **char) -> int {
    tvarints();
    ttvs();
    tims();
    puts(failures == 0 ? "fmttest: all passed\n" : "fmttest: some checks FAILED\n");
    return failures != 0;
}
