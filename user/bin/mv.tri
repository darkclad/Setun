// mv source target: rename a file or directory (within one file system).

import "../lib/tlibc.tri";

fn main(argc: int, argv: **char) -> int {
    if (argc != 3) { fputs(STDERR_FILENO, "usage: mv source target\n"); return 2; }
    if (rename(argv[1], argv[2]) < 0) { perror2("mv", argv[1]); return 1; }
    return 0;
}
