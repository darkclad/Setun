// ntpdate [-q] [-p PORT] SERVER: ask an NTP server the time (SNTP v4,
// RFC 4330) and set the clock to it (root only), or with -q just report
// it. Through setun-net's NAT, any NTP server on the network will answer.
// Exit status: 0, 1 no usable answer, 2 usage or the clock was not set.

import "../lib/tlibc.tri";
import "../lib/stdlib.tri";
import "../lib/getopt.tri";
import "../lib/socket.tri";
import "../lib/time.tri";

const NTP_TO_UNIX: int = 2208988800;      // seconds from 1900 to 1970

fn be32_of(p: *tryte) -> int { return ((p[0] * 256 + p[1]) * 256 + p[2]) * 256 + p[3]; }

fn show_time(t: int) {
    var when: tm;
    gmtime_r(t, &when);
    var buf: [64]char;
    strftime(&buf[0], 64, "%Y-%m-%d %H:%M:%S UTC", &when);
    puts(&buf[0]);
}

fn usage() -> int {
    fputs(STDERR_FILENO, "usage: ntpdate [-q] [-p port] server\n");
    return 2;
}

fn main(argc: int, argv: **char) -> int {
    var query: int = 0;
    var port: int = 123;
    var c: int = getopt(argc, argv, "qp:");
    while (c != -1) {
        if (c == 'q') { query = 1; }
        else if (c == 'p') { port = atoi(optarg); if (port <= 0 || port > 65535) { return usage(); } }
        else { return usage(); }
        c = getopt(argc, argv, "qp:");
    }
    if (optind != argc - 1) { return usage(); }
    var server: int = 0;
    if (!resolve_host(argv[optind], &server)) {
        fputs(STDERR_FILENO, "ntpdate: ");
        fputs(STDERR_FILENO, argv[optind]);
        fputs(STDERR_FILENO, ": Name or service not known\n");
        return 1;
    }
    var s: int = socket(AF_INET, SOCK_DGRAM, 0);
    if (s < 0) { perror2("ntpdate", "socket"); return 1; }
    var to: sockaddr_in;
    sockaddr_set(&to, server, port);
    if (connect(s, &to, sizeof(sockaddr_in)) < 0) { perror2("ntpdate", "connect"); return 1; }
    var req: [48]tryte;
    var k: int = 0;
    while (k < 48) { req[k] = 0; k += 1; }
    req[0] = 35;                                  // LI 0, version 4, mode 3 (client)
    // our transmit time, which the server echoes as "originate"
    var now: timespec;
    clock_gettime(0, &now);
    var ours: int = now.tv_sec + NTP_TO_UNIX;
    req[40] = (ours / 16777216 % 256) as tryte;
    req[41] = (ours / 65536 % 256) as tryte;
    req[42] = (ours / 256 % 256) as tryte;
    req[43] = (ours % 256) as tryte;
    getrandom(&req[44], 4, 0);                    // the fraction: a nonce
    var reply: [100]tryte;
    var tries: int = 0;
    while (tries < 3) {
        tries += 1;
        if (send(s, &req[0], 48, 0) < 0) { perror2("ntpdate", "send"); return 1; }
        var p: pollfd;
        p.fd = s;
        p.events = POLLIN;
        if (poll(&p, 1, 2000) <= 0) { continue; }
        var n: int = recv(s, &reply[0], 100, 0);
        if (n < 48) { continue; }
        var mode: int = reply[0] % 8;
        var version: int = reply[0] / 8 % 8;
        var stratum: int = reply[1];
        // a server's answer to this request
        if (mode != 4 || version < 3) { continue; }
        k = 0;
        var same: int = 1;
        while (k < 8) { if (reply[24 + k] != req[40 + k]) { same = 0; } k += 1; }
        if (!same) { continue; }
        if (stratum == 0) {
            fputs(STDERR_FILENO, "ntpdate: the server is not synchronised (kiss-o'-death)\n");
            return 1;
        }
        var t: int = be32_of(&reply[40]) - NTP_TO_UNIX;
        if (t < 0) { fputs(STDERR_FILENO, "ntpdate: a time before 1970\n"); return 1; }
        clock_gettime(0, &now);
        var offset: int = t - now.tv_sec;
        puts("server ");
        puts(inet_ntoa(server));
        puts(", stratum ");
        put_int(stratum);
        puts(", offset ");
        put_int(offset);
        puts(" s: ");
        show_time(t);
        puts("\n");
        if (query) { return 0; }
        var ts: timespec;
        ts.tv_sec = t;
        ts.tv_nsec = 0;
        if (clock_settime(0, &ts) < 0) { perror2("ntpdate", "cannot set the clock"); return 2; }
        puts("ntpdate: the clock is set\n");
        return 0;
    }
    fputs(STDERR_FILENO, "ntpdate: no server suitable for synchronization found\n");
    return 1;
}
