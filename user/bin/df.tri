// df [path ...]: free space, in blocks of 3^9 trytes (default: / and /tmp).

import "../lib/tlibc.tri";

fn pad_int(v: int, width: int) {
    var b: [15]char;
    var s: *char = itoa(v, &b[0]);
    var n: int = strlen(s);
    while (n < width) { puts(" "); n += 1; }
    puts(s);
}

fn show(path: *char) -> int {
    var s: statfs_t;
    if (statfs(path, &s) < 0) { perror2("df", path); return 1; }
    pad_int(s.f_blocks, 8);
    pad_int(s.f_blocks - s.f_bfree, 8);
    pad_int(s.f_bfree, 8);
    pad_int(s.f_files, 8);
    pad_int(s.f_ffree, 8);
    puts(" ");
    puts(path);
    puts("\n");
    return 0;
}

fn main(argc: int, argv: **char) -> int {
    puts(" Blocks    Used   Avail  Inodes   IFree Mounted on\n");
    if (argc == 1) { return show("/") | show("/tmp"); }
    var status: int = 0;
    var i: int = 1;
    while (i < argc) { if (show(argv[i]) != 0) { status = 1; } i += 1; }
    return status;
}
