// tric/real.tri: real constants, converted as the host's setun_real does
// (crates/real: from_decimal, from_i64, neg, to_words): the exact value
// as a big rational, rounded once to a 72-trit significand, ties to even.
//
// A real is held as its exponent and the three balanced parts of its
// significand M = hi·3^54 + mid·3^27 + lo; its words are e·3^18 + hi,
// mid, lo.

const E_MAX: int = 9841;
const E_MIN: int = -9841;
const BB: int = 19683;                   // a limb: 3^9

// ---- big naturals: base-3^9 limbs, least significant first ----------------------------------

struct big {
    p: *int;
    n: int;                              // limbs in use (0: zero)
    cap: int;
}

fn bg_init(b: *big) {
    b.p = null;
    b.n = 0;
    b.cap = 0;
}

fn bg_free(b: *big) {
    if (b.p != null) { free(b.p as *tryte); }
    bg_init(b);
}

fn bg_reserve(b: *big, n: int) {
    if (n <= b.cap) { return; }
    var cap: int = n + b.cap + 9;
    var q: *int = malloc(cap * 3) as *int;
    if (q == null) { oom(); }
    var k: int = 0;
    while (k < b.n) { q[k] = b.p[k]; k += 1; }
    if (b.p != null) { free(b.p as *tryte); }
    b.p = q;
    b.cap = cap;
}

fn bg_push(b: *big, v: int) {
    bg_reserve(b, b.n + 1);
    b.p[b.n] = v;
    b.n += 1;
}

fn bg_set(b: *big, v: int) {
    b.n = 0;
    while (v > 0) { bg_push(b, v % BB); v /= BB; }
}

fn bg_copy(d: *big, s: *big) {
    bg_reserve(d, s.n);
    var k: int = 0;
    while (k < s.n) { d.p[k] = s.p[k]; k += 1; }
    d.n = s.n;
}

// b *= m (0 < m <= 3^9)
fn bg_mul_small(b: *big, m: int) {
    var carry: int = 0;
    var k: int = 0;
    while (k < b.n) {
        var x: int = b.p[k] * m + carry;
        b.p[k] = x % BB;
        carry = x / BB;
        k += 1;
    }
    while (carry > 0) { bg_push(b, carry % BB); carry /= BB; }
}

fn bg_add_small(b: *big, v: int) {
    var k: int = 0;
    while (v > 0) {
        if (k == b.n) { bg_push(b, 0); }
        var x: int = b.p[k] + v;
        b.p[k] = x % BB;
        v = x / BB;
        k += 1;
    }
}

// b *= 3^k
fn bg_mul_pow3(b: *big, k: int) {
    while (k >= 9) { bg_mul_small(b, BB); k -= 9; }
    var m: int = 1;
    while (k > 0) { m *= 3; k -= 1; }
    if (m > 1) { bg_mul_small(b, m); }
}

fn bg_cmp(a: *big, b: *big) -> int {
    if (a.n != b.n) { return a.n < b.n ? -1 : 1; }
    var k: int = a.n - 1;
    while (k >= 0) {
        if (a.p[k] != b.p[k]) { return a.p[k] < b.p[k] ? -1 : 1; }
        k -= 1;
    }
    return 0;
}

// a -= b (a >= b)
fn bg_sub(a: *big, b: *big) {
    var borrow: int = 0;
    var k: int = 0;
    while (k < a.n) {
        var x: int = a.p[k] - borrow - (k < b.n ? b.p[k] : 0);
        borrow = 0;
        if (x < 0) { x += BB; borrow = 1; }
        a.p[k] = x;
        k += 1;
    }
    while (a.n > 0 && a.p[a.n - 1] == 0) { a.n -= 1; }
}

// base-3 digits of b (0 for zero)
fn bg_trits(b: *big) -> int {
    if (b.n == 0) { return 0; }
    var t: int = (b.n - 1) * 9;
    var top: int = b.p[b.n - 1];
    while (top > 0) { t += 1; top /= 3; }
    return t;
}

// the trit_len of the host: the smallest t with (3^t - 1)/2 >= |v|,
// which is the number of base-3 digits of 2v
fn trit_len(b: *big) -> int {
    var t: big;
    bg_init(&t);
    bg_copy(&t, b);
    bg_mul_small(&t, 2);
    var n: int = bg_trits(&t);
    bg_free(&t);
    return n;
}

fn bg_trit(b: *big, i: int) -> int {
    var limb: int = b.p[i / 9];
    var k: int = i % 9;
    while (k > 0) { limb /= 3; k -= 1; }
    return limb % 3;
}

// q, r := a / d, a % d (d > 0), a trit at a time
fn bg_divmod(a: *big, d: *big, q: *big, r: *big) {
    q.n = 0;
    r.n = 0;
    var i: int = bg_trits(a) - 1;
    while (i >= 0) {
        bg_mul_small(r, 3);
        bg_add_small(r, bg_trit(a, i));
        bg_mul_small(q, 3);
        var digit: int = 0;
        while (bg_cmp(r, d) >= 0) { bg_sub(r, d); digit += 1; }
        bg_add_small(q, digit);
        i -= 1;
    }
}

// ---- reals -----------------------------------------------------------------------------------

// the result of a conversion
var r_e: int;
var r_hi: int;
var r_mid: int;
var r_lo: int;

fn r_zero() { r_e = 0; r_hi = 0; r_mid = 0; r_lo = 0; }

// 2a·3^-e <= den: does |num|/den fit below 3^e / 2 (the host's `fits`)?
fn fits(a: *big, den: *big, e: int) -> int {
    var x: big;
    bg_init(&x);
    bg_copy(&x, a);
    bg_mul_small(&x, 2);
    var c: int = 0;
    if (e <= 0) {
        bg_mul_pow3(&x, -e);
        c = bg_cmp(&x, den);
    } else {
        var y: big;
        bg_init(&y);
        bg_copy(&y, den);
        bg_mul_pow3(&y, e);
        c = bg_cmp(&x, &y);
        bg_free(&y);
    }
    bg_free(&x);
    return c <= 0;
}

// r_* := num/den (num >= 0, den > 0) rounded to 72 trits, negated if `neg`
// (the host's round81 with p = 0 and no sticky bit)
fn round81(num: *big, den: *big, neg: int) {
    if (num.n == 0) { r_zero(); return; }
    var e: int = trit_len(num) - trit_len(den) + 1;
    while (!fits(num, den, e)) { e += 1; }
    while (e > E_MIN && fits(num, den, e - 1)) { e -= 1; }
    if (e >= E_MAX) {
        // ±∞: M = ±3^71
        r_e = E_MAX;
        r_hi = neg ? -129140163 : 129140163;
        r_mid = 0;
        r_lo = 0;
        return;
    }
    if (e < E_MIN) { e = E_MIN; }
    // M = round(num/den · 3^(72 - e)), ties to even
    var k: int = 72 - e;
    var a: big;
    var d: big;
    var q: big;
    var r: big;
    bg_init(&a);
    bg_init(&d);
    bg_init(&q);
    bg_init(&r);
    bg_copy(&a, num);
    bg_copy(&d, den);
    if (k >= 0) { bg_mul_pow3(&a, k); } else { bg_mul_pow3(&d, -k); }
    bg_divmod(&a, &d, &q, &r);
    bg_mul_small(&r, 2);
    var c: int = bg_cmp(&r, &d);
    var odd: int = 0;
    var j: int = 0;
    while (j < q.n) { odd += q.p[j]; j += 1; }   // 3^9 is odd: q's parity is its limbs'
    if (c > 0 || (c == 0 && odd % 2 == 1)) { bg_add_small(&q, 1); }
    // balanced limbs; above (3^72 - 1)/2 it stays at the top (the tie there)
    var b: [9]int;
    var carry: int = 0;
    j = 0;
    while (j < 9) {
        var v: int = (j < q.n ? q.p[j] : 0) + carry;
        carry = 0;
        if (v > 9841) { v -= BB; carry = 1; }
        b[j] = v;
        j += 1;
    }
    if (q.n > 9 || b[8] != 0) {
        j = 0;
        while (j < 8) { b[j] = 9841; j += 1; }
    }
    bg_free(&a);
    bg_free(&d);
    bg_free(&q);
    bg_free(&r);
    var m_zero: int = 1;
    j = 0;
    while (j < 8) { if (b[j] != 0) { m_zero = 0; } j += 1; }
    if (m_zero) { r_zero(); return; }
    r_e = e;
    r_lo = b[0] + b[1] * BB + b[2] * BB * BB;
    r_mid = b[3] + b[4] * BB + b[5] * BB * BB;
    r_hi = b[6] + b[7] * BB;
    if (neg) { r_hi = -r_hi; r_mid = -r_mid; r_lo = -r_lo; }
}

// Integers are exact.
fn real_from_int(v: int) {
    var num: big;
    var den: big;
    bg_init(&num);
    bg_init(&den);
    bg_set(&num, v < 0 ? -v : v);
    bg_set(&den, 1);
    round81(&num, &den, v < 0);
    bg_free(&num);
    bg_free(&den);
}

// r_* := -r_*; zero stays zero (there is no −0)
fn real_neg() {
    if (r_e != E_MAX && r_hi == 0 && r_mid == 0 && r_lo == 0) { r_zero(); return; }
    r_hi = -r_hi;
    r_mid = -r_mid;
    r_lo = -r_lo;
}

fn is_digit_c(c: int) -> int { return c >= '0' && c <= '9'; }

// Parse a decimal literal (no `_`, no sign: the lexer's): r_* := its value.
// 0 if it is not a number (then r_* is NaN).
fn real_from_decimal(s: *char, n: int) -> int {
    r_e = E_MAX;                         // NaN
    r_hi = 0;
    r_mid = 0;
    r_lo = 0;
    var k: int = 0;
    var mant_end: int = n;
    while (k < n) { if (s[k] == 'e' || s[k] == 'E') { mant_end = k; break; } k += 1; }
    // the exponent: [+-]digits
    var exp10: int = 0;
    if (mant_end < n) {
        var j: int = mant_end + 1;
        var eneg: int = 0;
        if (j < n && (s[j] == '+' || s[j] == '-')) { eneg = s[j] == '-'; j += 1; }
        if (j >= n || n - j > 15) { return 0; }
        while (j < n) {
            if (!is_digit_c(s[j])) { return 0; }
            exp10 = exp10 * 10 + s[j] - '0';
            j += 1;
        }
        if (eneg) { exp10 = -exp10; }
    }
    // the mantissa: digits[.digits]
    var dot: int = -1;
    k = 0;
    while (k < mant_end) {
        if (s[k] == '.') {
            if (dot >= 0) { return 0; }
            dot = k;
        } else if (!is_digit_c(s[k])) {
            return 0;
        }
        k += 1;
    }
    var digits: int = dot >= 0 ? mant_end - 1 : mant_end;
    if (digits == 0) { return 0; }
    var frac: int = dot >= 0 ? mant_end - dot - 1 : 0;
    var num: big;
    var den: big;
    bg_init(&num);
    bg_init(&den);
    k = 0;
    while (k < mant_end) {
        if (s[k] != '.') { bg_mul_small(&num, 10); bg_add_small(&num, s[k] - '0'); }
        k += 1;
    }
    var e10: int = exp10 - frac;
    if (e10 > 20000 || e10 < -20000) {
        // beyond any real: overflow or underflow
        if (num.n == 0 || e10 < 0) { r_zero(); }
        else { r_e = E_MAX; r_hi = 129140163; r_mid = 0; r_lo = 0; }
    } else {
        bg_set(&den, 1);
        var p: int = e10 < 0 ? -e10 : e10;
        var t: *big = e10 >= 0 ? &num : &den;
        while (p >= 4) { bg_mul_small(t, 10000); p -= 4; }
        while (p > 0) { bg_mul_small(t, 10); p -= 1; }
        round81(&num, &den, 0);
    }
    bg_free(&num);
    bg_free(&den);
    return 1;
}

fn real_word0() -> int { return r_e * 387420489 + r_hi; }
fn real_is_zero() -> int { return r_e == 0 && r_hi == 0 && r_mid == 0 && r_lo == 0; }
