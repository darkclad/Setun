// /bin/fstest: the K6 file-system scenarios, one line per check.
//
//   fstest          everything but filling the disk (works in /home/fst)
//   fstest enospc   fill the root volume, check ENOSPC, then free it all

import "../lib/tlibc.tri";

var failures: int;
var buf: [19683]char;
var big: [19683]char;

fn ok(what: *char, cond: int) {
    puts("fstest: ");
    puts(what);
    if (cond) { puts(" ok\n"); } else { puts(" FAILED\n"); failures += 1; }
}

// The call failed with exactly this errno.
fn fails(r: int, e: int) -> int { return r == -1 && errno == e; }

fn write_str(path: *char, s: *char, flags: int) -> int {
    var fd: int = open(path, O_WRONLY + O_CREAT + flags, 420);
    if (fd < 0) { return -1; }
    var n: int = write(fd, s, strlen(s));
    close(fd);
    return n;
}

// The whole file into buf (NUL-terminated); its length or -1.
fn read_all(path: *char) -> int {
    var fd: int = open(path, O_RDONLY, 0);
    if (fd < 0) { return -1; }
    var n: int = 0;
    loop {
        var r: int = read(fd, &buf[n], 19682 - n);
        if (r <= 0) { break; }
        n += r;
    }
    close(fd);
    buf[n] = 0;
    return n;
}

fn free_blocks(path: *char) -> int {
    var s: statfs_t;
    if (statfs(path, &s) < 0) { return -1; }
    return s.f_bfree;
}

fn free_inodes(path: *char) -> int {
    var s: statfs_t;
    if (statfs(path, &s) < 0) { return -1; }
    return s.f_ffree;
}

fn cwd_is(want: *char) -> int {
    var b: [243]char;
    if (getcwd(&b[0], 243) == null) { return 0; }
    return streq(&b[0], want);
}

fn positive() {
    mkdir("/home/fst", 493);
    ok("chdir into tfs", chdir("/home/fst") == 0 && cwd_is("/home/fst"));
    var blocks0: int = free_blocks("/");
    var inodes0: int = free_inodes("/");

    // small files, append, truncate
    ok("create and write", write_str("a.txt", "hello, ternary\n", O_TRUNC) == 15);
    ok("read back", read_all("a.txt") == 15 && streq(&buf[0], "hello, ternary\n"));
    write_str("a.txt", "more\n", O_APPEND);
    ok("O_APPEND", read_all("a.txt") == 20);
    write_str("a.txt", "new\n", O_TRUNC);
    ok("O_TRUNC", read_all("a.txt") == 4 && streq(&buf[0], "new\n"));
    var st: stat_t;
    ok("stat size and mode", stat("a.txt", &st) == 0 && st.st_size == 4 && S_ISREG(st.st_mode) && st.st_nlink == 1);

    // 16 blocks: past the 15 direct pointers
    var fd: int = open("big", O_RDWR + O_CREAT + O_TRUNC, 420);
    var i: int = 0;
    var wrote: int = 0;
    while (i < 16) {
        big[0] = ('A' + i) as char;
        big[19682] = ('a' + i) as char;
        wrote += write(fd, &big[0], 19683);
        i += 1;
    }
    ok("write 16 blocks", wrote == 16 * 19683);
    var good: int = 1;
    i = 0;
    while (i < 16) {
        lseek(fd, i * 19683, SEEK_SET);
        if (read(fd, &buf[0], 19683) != 19683 || buf[0] != 'A' + i || buf[19682] != 'a' + i) { good = 0; }
        i += 1;
    }
    ok("read 16 blocks back (indirect block)", good);
    close(fd);
    ok("blocks were taken", free_blocks("/") <= blocks0 - 17);
    ok("unlink big", unlink("big") == 0);
    ok("its blocks came back", free_blocks("/") == blocks0 - 1);   // a.txt keeps one

    // a sparse file
    fd = open("sparse", O_RDWR + O_CREAT + O_TRUNC, 420);
    lseek(fd, 50000, SEEK_SET);
    write(fd, "x", 1);
    lseek(fd, 100, SEEK_SET);
    buf[0] = 'q';
    ok("a hole reads as zeros", read(fd, &buf[0], 10) == 10 && buf[0] == 0 && buf[9] == 0);
    ok("sparse size", fstat(fd, &st) == 0 && st.st_size == 50001);
    close(fd);
    unlink("sparse");

    // directories, rename, getcwd across renames
    mkdir("d1", 493);
    mkdir("d2", 493);
    write_str("d1/f", "f\n", 0);
    ok("rename a file", rename("a.txt", "b.txt") == 0 && read_all("b.txt") == 4 && fails(open("a.txt", O_RDONLY, 0), ENOENT));
    ok("rename a directory into another", rename("d1", "d2/d1") == 0 && read_all("d2/d1/f") == 2);
    ok("dir link counts", stat("d2", &st) == 0 && st.st_nlink == 3 && stat(".", &st) == 0 && st.st_nlink == 3);
    chdir("d2/d1");
    ok("getcwd after the move", cwd_is("/home/fst/d2/d1"));
    chdir("..");
    ok("'..' follows the moved directory", cwd_is("/home/fst/d2"));
    chdir("/home/fst");
    ok("rename replaces a file", write_str("c.txt", "c\n", 0) == 2 && rename("c.txt", "b.txt") == 0 && read_all("b.txt") == 2);
    ok("a name of 77 characters", write_str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "x", 0) == 1);
    unlink("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");

    // unlink while open: the data lives until the last close
    write_str("ghost", "boo\n", O_TRUNC);
    var inodes1: int = free_inodes("/");
    fd = open("ghost", O_RDONLY, 0);
    unlink("ghost");
    ok("unlinked file still readable", read(fd, &buf[0], 10) == 4);
    ok("inode held while open", free_inodes("/") == inodes1);
    close(fd);
    ok("inode freed on close", free_inodes("/") == inodes1 + 1);

    // mounts, /proc, getcwd through mount points
    ok("mount tmpfs on /mnt", mount("none", "/mnt", "tmpfs", 0, null) == 0);
    write_str("/mnt/t", "t\n", 0);
    ok("file on the new tmpfs", read_all("/mnt/t") == 2);
    ok("umount /mnt", umount("/mnt") == 0);
    ok("its files are gone", fails(open("/mnt/t", O_RDONLY, 0), ENOENT));
    chdir("/proc/1");
    ok("getcwd inside /proc", cwd_is("/proc/1"));
    chdir("/home/fst");
    ok("/proc/<pid>/status", read_all("/proc/1/status") > 0 && buf[0] == 'N' && buf[6] == 'i');
    ok("/proc/mounts lists the root", read_all("/proc/mounts") > 0 && buf[0] == '/' && buf[9] == '/');

    // tidy up and account for every block and inode
    unlink("b.txt");
    unlink("d2/d1/f");
    rmdir("d2/d1");
    rmdir("d2");
    chdir("/");
    rmdir("/home/fst");
    ok("no blocks leaked", free_blocks("/") == blocks0 + 1);        // fst's own block came back too
    ok("no inodes leaked", free_inodes("/") == inodes0 + 1);
}

fn negative() {
    mkdir("/home/neg", 493);
    chdir("/home/neg");
    write_str("file", "data\n", O_TRUNC);
    mkdir("dir", 493);
    write_str("dir/x", "x", 0);

    ok("ENOENT: missing file", fails(open("nope", O_RDONLY, 0), ENOENT));
    ok("ENOENT: missing directory on the way", fails(open("nope/x", O_RDONLY, 0), ENOENT));
    ok("ENOENT: empty path", fails(open("", O_RDONLY, 0), ENOENT));
    ok("ENOTDIR: a file used as a directory", fails(open("file/x", O_RDONLY, 0), ENOTDIR));
    ok("EEXIST: mkdir over a file", fails(mkdir("file", 493), EEXIST));
    ok("EEXIST: O_CREAT|O_EXCL", fails(open("file", O_WRONLY + O_CREAT + O_EXCL, 420), EEXIST));
    ok("EISDIR: open a directory for writing", fails(open("dir", O_WRONLY, 0), EISDIR));
    ok("EISDIR: unlink a directory", fails(unlink("dir"), EISDIR));
    ok("ENOTDIR: rmdir a file", fails(rmdir("file"), ENOTDIR));
    ok("ENOTEMPTY: rmdir a full directory", fails(rmdir("dir"), ENOTEMPTY));
    ok("EINVAL: rmdir .", fails(rmdir("."), EINVAL));
    ok("EBUSY: rmdir a mount point", fails(rmdir("/tmp"), EBUSY));
    ok("ENOTDIR: O_DIRECTORY on a file", fails(open("file", O_RDONLY + O_DIRECTORY, 0), ENOTDIR));
    ok("ENAMETOOLONG: 78 characters on tfs",
        fails(open("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", O_WRONLY + O_CREAT, 420), ENAMETOOLONG));
    ok("ENAMETOOLONG: 27 characters on tmpfs", fails(open("/tmp/aaaaaaaaaaaaaaaaaaaaaaaaaaa", O_WRONLY + O_CREAT, 420), ENAMETOOLONG));

    var fd: int = open("file", O_RDONLY, 0);
    ok("EBADF: write to a read-only descriptor", fails(write(fd, "x", 1), EBADF));
    ok("EFAULT: read into the kernel", fails(read(fd, 1000 as *char, 5), EFAULT));
    ok("EINVAL: lseek before the start", fails(lseek(fd, -1, SEEK_SET), EINVAL));
    ok("EINVAL: lseek whence", fails(lseek(fd, 0, 7), EINVAL));
    var dents: [81]tryte;
    ok("ENOTDIR: getdents on a file", fails(getdents64(fd, &dents[0], 81), ENOTDIR));
    close(fd);
    ok("EBADF: read a closed descriptor", fails(read(fd, &buf[0], 1), EBADF));
    ok("EBADF: descriptor out of range", fails(close(99), EBADF));
    fd = open("dir", O_RDONLY, 0);
    ok("EISDIR: read a directory", fails(read(fd, &buf[0], 5), EISDIR));
    ok("EINVAL: getdents into a misaligned buffer", fails(getdents64(fd, &dents[1], 27), EINVAL));
    close(fd);
    var st: stat_t;
    ok("EFAULT: stat into the kernel", fails(stat("file", 1000 as *stat_t), EFAULT));
    ok("EFAULT: path in the kernel", fails(open(1000 as *char, O_RDONLY, 0), EFAULT));

    var p: [2]int;
    pipe(&p[0]);
    ok("ESPIPE: lseek on a pipe", fails(lseek(p[0], 0, SEEK_SET), ESPIPE));
    close(p[0]);
    close(p[1]);

    var fds: [27]int;
    var n: int = 0;
    loop {
        var f: int = open("file", O_RDONLY, 0);
        if (f < 0) { break; }
        fds[n] = f;
        n += 1;
    }
    ok("EMFILE: 27 descriptors per process", errno == EMFILE && n == 24);
    while (n > 0) { n -= 1; close(fds[n]); }

    ok("EACCES: exec without the execute bit", fails(execve("file", null, null), EACCES));
    write_str("script", "not a program\n", O_TRUNC);
    fd = open("x.sh", O_WRONLY + O_CREAT + O_TRUNC, 493);
    write(fd, "echo hi\n", 8);
    close(fd);
    ok("ENOEXEC: exec a text file", fails(execve("x.sh", null, null), ENOEXEC));
    ok("ENOENT: exec a missing file", fails(execve("nope", null, null), ENOENT));

    ok("EINVAL: move a directory into itself", fails(rename("dir", "dir/sub"), EINVAL));
    ok("EXDEV: rename across file systems", write_str("/tmp/t", "t", 0) == 1 && fails(rename("/tmp/t", "/home/neg/t"), EXDEV));
    ok("a mount stacks over /tmp", mount("x", "/tmp", "tmpfs", 0, null) == 0 && fails(open("/tmp/t", O_RDONLY, 0), ENOENT));
    ok("umount uncovers the old /tmp", umount("/tmp") == 0 && read_all("/tmp/t") == 1);
    ok("ENOENT: rename a missing file", fails(rename("nope", "nope2"), ENOENT));
    ok("ENOTDIR: rename a directory over a file", fails(rename("dir", "file"), ENOTDIR));
    ok("EISDIR: rename a file over a directory", fails(rename("file", "dir"), EISDIR));
    mkdir("empty", 493);
    ok("ENOTEMPTY: rename over a full directory", fails(rename("empty", "dir"), ENOTEMPTY));

    ok("ENODEV: mount an unknown type", fails(mount("x", "/mnt", "ext4", 0, null), ENODEV));
    ok("ENOTDIR: mount on a file", fails(mount("x", "file", "tmpfs", 0, null), ENOTDIR));
    ok("ENOENT: mount on a missing directory", fails(mount("x", "nope", "tmpfs", 0, null), ENOENT));
    ok("EBUSY: a second proc", fails(mount("x", "/mnt", "proc", 0, null), EBUSY));
    ok("EBUSY: umount /", fails(umount("/"), EBUSY));
    ok("EINVAL: umount a plain directory", fails(umount("dir"), EINVAL));
    mount("none", "/mnt", "tmpfs", 0, null);
    chdir("/mnt");
    ok("EBUSY: umount with a working directory inside", fails(umount("/mnt"), EBUSY));
    chdir("/home/neg");
    var hold: int = open("/mnt", O_RDONLY, 0);
    ok("EBUSY: umount with an open file inside", fails(umount("/mnt"), EBUSY));
    close(hold);
    ok("umount once idle", umount("/mnt") == 0);

    ok("EACCES: write to /proc", fails(open("/proc/uptime", O_WRONLY, 0), EACCES));
    ok("EACCES: create in /proc", fails(mkdir("/proc/x", 493), EACCES));
    ok("ENOENT: a process that does not exist", fails(open("/proc/99999/stat", O_RDONLY, 0), ENOENT));
    ok("ENOENT: a bad /proc name", fails(open("/proc/12x", O_RDONLY, 0), ENOENT));
    ok("EINVAL: reboot without the magic", fails(_ret(syscall(142, 1, 2, 3, 0)), EINVAL));
    ok("EINVAL: reboot with a bad command", fails(_ret(syscall(142, 4276215469, 672274793, 5, 0)), EINVAL));

    // clean up
    unlink("file");
    unlink("script");
    unlink("x.sh");
    unlink("dir/x");
    rmdir("dir");
    rmdir("empty");
    unlink("/tmp/t");
    chdir("/");
    ok("cleanup", rmdir("/home/neg") == 0);
}

// Fill the root volume: ENOSPC, nothing half-written, everything freed again.
fn enospc() {
    var before: int = free_blocks("/");
    var fd: int = open("/home/fill", O_WRONLY + O_CREAT + O_TRUNC, 420);
    var total: int = 0;
    var r: int = 0;
    loop {
        r = write(fd, &big[0], 19683);
        if (r < 19683) { break; }
        total += r;
    }
    ok("ENOSPC when the volume is full", r == -1 && errno == ENOSPC && free_blocks("/") == 0);
    ok("ENOSPC: mkdir on a full volume", fails(mkdir("/home/more", 493), ENOSPC));
    close(fd);
    var st: stat_t;
    ok("the file holds what was written", stat("/home/fill", &st) == 0 && st.st_size == total);
    unlink("/home/fill");
    ok("every block comes back", free_blocks("/") == before);
    // and the inode table: create empty files until it runs out
    var n: int = 0;
    var name: [27]char;
    loop {
        var b: [15]char;
        var s: *char = itoa(n, &b[0]);
        var pre: *char = "/home/i";
        var k: int = 0;
        while (pre[k] != 0) { name[k] = pre[k]; k += 1; }
        var j: int = 0;
        while (s[j] != 0) { name[k] = s[j]; k += 1; j += 1; }
        name[k] = 0;
        var f: int = open(&name[0], O_WRONLY + O_CREAT, 420);
        if (f < 0) { break; }
        close(f);
        n += 1;
        if (n > 1000) { break; }
    }
    ok("ENOSPC when the inode table is full", errno == ENOSPC && free_inodes("/") == 0);
    while (n > 0) {
        n -= 1;
        var b2: [15]char;
        var s2: *char = itoa(n, &b2[0]);
        var pre2: *char = "/home/i";
        var k2: int = 0;
        while (pre2[k2] != 0) { name[k2] = pre2[k2]; k2 += 1; }
        var j2: int = 0;
        while (s2[j2] != 0) { name[k2] = s2[j2]; k2 += 1; j2 += 1; }
        name[k2] = 0;
        unlink(&name[0]);
    }
    ok("every inode comes back", free_inodes("/") > 0 && free_blocks("/") == before);
}

fn main(argc: int, argv: **char) -> int {
    if (argc > 1 && streq(argv[1], "enospc")) {
        enospc();
    } else {
        positive();
        negative();
    }
    puts(failures == 0 ? "fstest: all passed\n" : "fstest: some checks FAILED\n");
    return failures != 0;
}
