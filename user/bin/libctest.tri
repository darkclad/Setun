// /bin/libctest: the K7 C-library and system-call checks, one line each.

import "../lib/tlibc.tri";
import "../lib/string.tri";
import "../lib/ctype.tri";
import "../lib/stdlib.tri";
import "../lib/stdio.tri";
import "../lib/getopt.tri";
import "../lib/time.tri";
import "../lib/crypt.tri";
import "../lib/pwd.tri";

var failures: int;

fn ok(what: *char, cond: int) {
    puts("libctest: ");
    puts(what);
    if (cond) { puts(" ok\n"); } else { puts(" FAILED\n"); failures += 1; }
}

fn fails(r: int, e: int) -> int { return r == -1 && errno == e; }

fn cmp_int(a: int, b: int) -> int { return a < b ? -1 : (a > b ? 1 : 0); }
fn cmp_str(a: int, b: int) -> int { return strcmp(a as *char, b as *char); }

fn strings() {
    var b: [81]char;
    strcpy(&b[0], "tern");
    strcat(&b[0], "ary");
    ok("strcpy/strcat", streq(&b[0], "ternary"));
    ok("strncmp", strncmp("abcx", "abcy", 3) == 0 && strncmp("abcx", "abcy", 4) < 0 && strncmp("b", "a", 5) > 0);
    ok("strchr/strrchr", strchr("a/b/c", '/')[1] == 'b' && strrchr("/usr/bin", '/')[1] == 'b' && strchr("abc", 'z') == null);
    ok("strstr", streq(strstr("balanced ternary", "tern"), "ternary") && strstr("abc", "x") == null && strstr("abc", "") != null);
    strncpy(&b[0], "xy", 5);
    ok("strncpy pads with NULs", b[0] == 'x' && b[2] == 0 && b[4] == 0);
    ok("strspn/strcspn", strspn("aaab", "a") == 3 && strcspn("abc,d", ",") == 3);
    var m: [9]tryte;
    var k: int = 0;
    while (k < 9) { m[k] = k as tryte; k += 1; }
    memmove(&m[2], &m[0], 5);
    ok("memmove overlapping", m[2] == 0 && m[6] == 4 && m[0] == 0);
    ok("memcmp", memcmp(&m[0], &m[0], 9) == 0);
    word_wise_memory();
    ok("ctype", isdigit('7') && !isdigit('x') && isalpha('Q') && isspace('\t') && toupper('a') == 'A' && tolower('Z') == 'z' && ispunct('!'));
    ok("ctype overlined", isprint('1̅') && '1̅' == -'1' && !ispunct('1̅') && ispunct('!̅') && !isprint(-' ') && !isprint(-31));
}

// memcpy, memset, memmove and memcmp go by words where they can: against
// tryte-by-tryte copies at every offset in the word and length up to 22,
// overlapping both ways, with negative trytes; memcmp at every difference.
var mw_a: [60]tryte;
var mw_b: [60]tryte;
var mw_r: [60]tryte;

fn mw_fill(seed: int) {
    var k: int = 0;
    while (k < 60) {
        mw_a[k] = ((k * 7919 + seed * 31) % 19683 - 9841) as tryte;
        mw_b[k] = ((k * 104729 + seed) % 19683 - 9841) as tryte;
        k += 1;
    }
}

fn mw_same(x: *tryte) -> int {
    var k: int = 0;
    while (k < 60) { if (x[k] != mw_r[k]) { return 0; } k += 1; }
    return 1;
}

fn word_wise_memory() {
    var good: [4]int = { 1, 1, 1, 1 };
    var d: int = 0;
    while (d < 6) {
        var s: int = 0;
        while (s < 6) {
            var n: int = 0;
            while (n <= 22) {
                var k: int;
                // memcpy, b into a
                mw_fill(d + 7 * s + 49 * n);
                k = 0; while (k < 60) { mw_r[k] = mw_a[k]; k += 1; }
                k = 0; while (k < n) { mw_r[d + 3 + k] = mw_b[s + 3 + k]; k += 1; }
                memcpy(&mw_a[d + 3], &mw_b[s + 3], n);
                good[0] = good[0] && mw_same(&mw_a[0]);
                // memset
                mw_fill(n);
                k = 0; while (k < 60) { mw_r[k] = mw_a[k]; k += 1; }
                var v: tryte = (s * 3000 - 7000 + n) as tryte;
                k = 0; while (k < n) { mw_r[d + 3 + k] = v; k += 1; }
                memset(&mw_a[d + 3], v, n);
                good[1] = good[1] && mw_same(&mw_a[0]);
                // memmove within a, up and down by d - s (+ a word)
                var to: int = d + 20;
                var from: int = s + 20 + (n % 2 == 0 ? 3 : -3);
                mw_fill(s + n);
                k = 0; while (k < 60) { mw_r[k] = mw_a[k]; k += 1; }
                var t: [60]tryte;
                k = 0; while (k < n) { t[k] = mw_a[from + k]; k += 1; }
                k = 0; while (k < n) { mw_r[to + k] = t[k]; k += 1; }
                memmove(&mw_a[to], &mw_a[from], n);
                good[2] = good[2] && mw_same(&mw_a[0]);
                // memcmp: equal, then one tryte different at each place
                mw_fill(d);
                k = 0; while (k < 60) { mw_b[k] = mw_a[k]; k += 1; }
                var eq: int = memcmp(&mw_a[d + 3], &mw_b[d + 3], n) == 0;
                var at: int = 0;
                while (at < n) {
                    mw_b[d + 3 + at] = (mw_a[d + 3 + at] + (at % 2 == 0 ? 1 : -1)) as tryte;
                    var want: int = at % 2 == 0 ? -1 : 1;
                    eq = eq && memcmp(&mw_a[d + 3], &mw_b[d + 3], n) == want;
                    mw_b[d + 3 + at] = mw_a[d + 3 + at];
                    at += 1;
                }
                good[3] = good[3] && eq;
                n += 1;
            }
            s += 1;
        }
        d += 1;
    }
    ok("memcpy by words", good[0]);
    ok("memset by words", good[1]);
    ok("memmove by words", good[2]);
    ok("memcmp by words", good[3]);
}

fn numbers() {
    var end: *char;
    ok("strtol decimal", strtol("  -42xyz", &end, 10) == -42 && end[0] == 'x');
    ok("strtol hex and octal", strtol("0x1F", null, 0) == 31 && strtol("017", null, 0) == 15 && strtol("z", null, 36) == 35);
    errno = 0;
    ok("strtol clamps with ERANGE", strtol("99999999999999999999", null, 10) == LONG_MAX && errno == ERANGE);
    errno = 0;
    ok("strtol negative overflow", strtol("-99999999999999999999", null, 10) == LONG_MIN && errno == ERANGE);
    ok("strtol: no digits leaves end at the start", strtol("abc", &end, 10) == 0 && end[0] == 'a');
    errno = 0;
    ok("strtol: bad base is EINVAL", strtol("1", null, 1) == 0 && errno == EINVAL);
    ok("atoi", atoi("123") == 123 && atoi("-7") == -7 && atoi("x") == 0);
    var a: [9]int = { 5, -3, 9, 0, 9, -8, 1, 2, 4 };
    qsort(&a[0], 9, &cmp_int);
    ok("qsort ints", a[0] == -8 && a[1] == -3 && a[8] == 9 && a[7] == 9 && a[4] == 2);
    var big: [100]int;
    var i: int = 0;
    while (i < 100) { big[i] = (i * 37) % 101; i += 1; }
    qsort(&big[0], 100, &cmp_int);
    var sorted: int = 1;
    i = 1;
    while (i < 100) { if (big[i - 1] > big[i]) { sorted = 0; } i += 1; }
    ok("qsort 100 ints (quicksort path)", sorted);
    var s: [4]*char = { "pear", "apple", "fig", "date" };
    qsort(&s[0] as *int, 4, &cmp_str);
    ok("qsort strings", streq(s[0], "apple") && streq(s[3], "pear"));
}

fn heap() {
    var p: [27]*char;
    var i: int = 0;
    while (i < 27) {
        p[i] = malloc(100 + i * 50) as *char;
        if (p[i] != null) { memset(p[i] as *tryte, ('a' + i % 26) as tryte, 100 + i * 50); }
        i += 1;
    }
    var good: int = 1;
    i = 0;
    while (i < 27) {
        if (p[i] == null || p[i][0] != 'a' + i % 26 || p[i][99 + i * 50] != 'a' + i % 26) { good = 0; }
        i += 1;
    }
    ok("malloc 27 blocks, no overlap", good);
    i = 0;
    while (i < 27) { if (i % 2 == 0) { free(p[i] as *tryte); } i += 1; }
    var q: *char = malloc(120) as *char;
    ok("free blocks are reused", q != null && ((q as int) <= (p[26] as int)));
    var r: *char = realloc(q as *tryte, 5000) as *char;
    ok("realloc grows", r != null && malloc_usable_size(r as *tryte) >= 5000);
    var z: *tryte = calloc(10, 30);
    var zero: int = 1;
    i = 0;
    while (i < 300) { if (z[i] != 0) { zero = 0; } i += 1; }
    ok("calloc zeroes", zero);
    // larger than a step of the heap's growth (once always refused)
    var big: *tryte = malloc(600000);
    var bigok: int = big != null;
    if (bigok) {
        big[0] = 1;
        big[599999] = 2;
        bigok = big[0] == 1 && big[599999] == 2;
        free(big);
    }
    ok("malloc 600000 trytes", bigok);
    // realloc keeps a word array whole (its first word starts a tryte
    // below the pointer: once that tryte was lost)
    var wa: *int = malloc(9) as *int;
    wa[0] = -3812798742493;
    wa[1] = 1234567;
    wa[2] = 3812798742493;
    var wb: *int = realloc(wa as *tryte, 3000) as *int;
    ok("realloc keeps words", wb != null && wb[0] == -3812798742493 && wb[1] == 1234567 && wb[2] == 3812798742493);
    free(wb as *tryte);
    var huge: *tryte = malloc(100000000);
    ok("malloc too much is ENOMEM", huge == null && errno == ENOMEM);
    ok("malloc(-1) is null", malloc(-1) == null);
    var d: *char = strdup("dup me");
    ok("strdup", streq(d, "dup me") && strndup("abcdef", 3)[3] == 0);
    free(null);
    ok("free(null) is harmless", 1);
    // many small blocks after frees still work
    i = 0;
    var all: int = 1;
    while (i < 500) {
        var t: *char = malloc(30) as *char;
        if (t == null) { all = 0; }
        free(t as *tryte);
        i += 1;
    }
    ok("500 malloc/free cycles", all);
}

fn environment() {
    ok("getenv from the kernel's envp", getenv("HOME") != null);
    ok("getenv missing", getenv("NO_SUCH_VARIABLE") == null);
    ok("setenv new", setenv("TRIT", "+1", 1) == 0 && streq(getenv("TRIT"), "+1"));
    ok("setenv no overwrite", setenv("TRIT", "-1", 0) == 0 && streq(getenv("TRIT"), "+1"));
    ok("setenv overwrite", setenv("TRIT", "0", 1) == 0 && streq(getenv("TRIT"), "0"));
    ok("unsetenv", unsetenv("TRIT") == 0 && getenv("TRIT") == null);
    ok("EINVAL: setenv with '=' in the name", fails(setenv("A=B", "x", 1), EINVAL));
    ok("EINVAL: setenv with an empty name", fails(setenv("", "x", 1), EINVAL));
    ok("EINVAL: unsetenv(null)", fails(unsetenv(null), EINVAL));
    // environment is passed across exec
    setenv("PASSED", "yes", 1);
    var pid: int = fork();
    if (pid == 0) {
        var argv: [4]*char = { "sh", "-c", "test \"$PASSED\" = yes", null };
        execvp("sh", &argv[0]);
        _exit(127);
    }
    var st: int;
    waitpid(pid, &st, 0);
    ok("execvp passes the environment", WIFEXITED(st) && WEXITSTATUS(st) == 0);
    pid = fork();
    if (pid == 0) {
        var argv2: [2]*char = { "nonexistent-cmd", null };
        execvp("nonexistent-cmd", &argv2[0]);
        _exit(errno == ENOENT ? 3 : 4);
    }
    waitpid(pid, &st, 0);
    ok("ENOENT: execvp of an unknown command", WEXITSTATUS(st) == 3);
}

fn files() {
    var f: *FILE = fopen("/tmp/lc.txt", "w");
    ok("fopen for writing", f != null);
    var i: int = 0;
    while (i < 1000) { fputs_f("line ", f); fput_int(i, f); fputc('\n', f); i += 1; }
    ok("fclose flushes", fclose(f) == 0);
    f = fopen("/tmp/lc.txt", "r");
    var line: [81]char;
    var n: int = 0;
    var last: [81]char;
    while (fgets(&line[0], 81, f) != null) { n += 1; strcpy(&last[0], &line[0]); }
    ok("fgets reads every line", n == 1000 && streq(&last[0], "line 999\n"));
    ok("feof after the end", feof(f) && fgetc(f) == EOF);
    fclose(f);
    f = fopen("/tmp/lc.txt", "r");
    var small: [5]char;
    fgets(&small[0], 5, f);
    ok("fgets stops at n-1", streq(&small[0], "line"));
    ok("ungetc", ungetc('Q', f) == 'Q' && fgetc(f) == 'Q' && fgetc(f) == ' ');
    fclose(f);
    ok("ENOENT: fopen a missing file", fopen("/tmp/none/x", "r") == null && errno == ENOENT);
    ok("EINVAL: fopen with a bad mode", fopen("/tmp/lc.txt", "q") == null && errno == EINVAL);
    unlink("/tmp/lc.txt");
}

fn options() {
    var argv: [7]*char = { "prog", "-ab", "-c", "val", "-dval2", "file", null };
    optind = 1;
    var seen: [5]int;
    var c: int = getopt(6, &argv[0], "abc:d:");
    var arg_c: *char = null;
    var arg_d: *char = null;
    var count: int = 0;
    while (c != -1) {
        if (c == 'c') { arg_c = optarg; }
        if (c == 'd') { arg_d = optarg; }
        count += 1;
        c = getopt(6, &argv[0], "abc:d:");
    }
    ok("getopt clusters and arguments", count == 4 && streq(arg_c, "val") && streq(arg_d, "val2") && optind == 5);
    var bad: [3]*char = { "prog", "-x", null };
    optind = 1;
    opterr = 0;
    ok("getopt: unknown option is '?'", getopt(2, &bad[0], "ab") == '?' && optopt == 'x');
    var miss: [3]*char = { "prog", "-c", null };
    optind = 1;
    ok("getopt: missing argument is ':' with a leading colon", getopt(2, &miss[0], ":c:") == ':' && optopt == 'c');
    var dash: [4]*char = { "prog", "--", "-a", null };
    optind = 1;
    ok("getopt: -- ends the options", getopt(3, &dash[0], "a") == -1 && optind == 2);
}

fn system_calls() {
    var u: utsname;
    ok("uname", uname(&u) == 0 && streq(&u.sysname[0], "Trinux") && streq(&u.machine[0], "setun26"));
    ok("EFAULT: uname into the kernel", fails(uname(1000 as *utsname), EFAULT));
    var ts: timespec;
    ok("clock_gettime realtime", clock_gettime(CLOCK_REALTIME, &ts) == 0 && ts.tv_sec > 1700000000);
    ok("clock_gettime monotonic", clock_gettime(CLOCK_MONOTONIC, &ts) == 0 && ts.tv_sec >= 0);
    ok("EINVAL: unknown clock", fails(clock_gettime(7, &ts), EINVAL));
    var t: tm;
    gmtime_r(0, &t);
    var b: [81]char;
    strftime(&b[0], 81, "%Y-%m-%d %H:%M:%S %a %b %j", &t);
    ok("gmtime(0)", streq(&b[0], "1970-01-01 00:00:00 Thu Jan 001"));
    gmtime_r(1709210096, &t);                          // 2024-02-29 12:34:56 UTC
    strftime(&b[0], 81, "%Y-%m-%d %H:%M:%S %a %e", &t);
    ok("gmtime on a leap day", streq(&b[0], "2024-02-29 12:34:56 Thu 29"));
    ok("getuid is root", getuid() == 0 && geteuid() == 0 && getgid() == 0);
    var old: int = umask(63);                          // 077
    var fd: int = open("/home/um", O_WRONLY + O_CREAT + O_TRUNC, 438);
    close(fd);
    var st: stat_t;
    stat("/home/um", &st);
    ok("umask applies to new files", old == 18 && st.st_mode % 512 == 384);
    umask(18);
    ok("chmod", chmod("/home/um", 493) == 0 && stat("/home/um", &st) == 0 && st.st_mode % 512 == 493);
    ok("ENOENT: chmod a missing file", fails(chmod("/home/none", 420), ENOENT));
    ok("EPERM: chmod in /proc", fails(chmod("/proc/uptime", 420), EPERM));
    ok("link", link("/home/um", "/home/um2") == 0 && stat("/home/um", &st) == 0 && st.st_nlink == 2);
    ok("EEXIST: link over a file", fails(link("/home/um", "/home/um2"), EEXIST));
    ok("EPERM: link a directory", fails(link("/home", "/home/h2"), EPERM));
    ok("EXDEV: link across file systems", fails(link("/home/um", "/tmp/um"), EXDEV));
    ok("ENOENT: link a missing file", fails(link("/home/none", "/home/n2"), ENOENT));
    unlink("/home/um");
    ok("a link keeps the file", stat("/home/um2", &st) == 0 && st.st_nlink == 1);
    unlink("/home/um2");
    fd = open("/etc/motd", O_RDONLY, 0);
    ok("fcntl F_GETFD defaults to 0", fcntl(fd, F_GETFD, 0) == 0);
    ok("fcntl F_SETFD", fcntl(fd, F_SETFD, FD_CLOEXEC) == 0 && fcntl(fd, F_GETFD, 0) == FD_CLOEXEC);
    var d2: int = fcntl(fd, F_DUPFD, 10);
    ok("fcntl F_DUPFD at or above 10", d2 >= 10 && fcntl(d2, F_GETFD, 0) == 0);
    ok("EINVAL: fcntl bad command", fails(fcntl(fd, 999, 0), EINVAL));
    ok("EBADF: fcntl on a closed descriptor", fails(fcntl(26, F_GETFD, 0), EBADF));
    ok("EINVAL: F_DUPFD out of range", fails(fcntl(fd, F_DUPFD, 99), EINVAL));
    // close-on-exec: the child shell cannot see fd but sees d2
    var pid: int = fork();
    if (pid == 0) {
        var argv: [2]*char = { "fdcheck", null };
        execvp("fdcheck", &argv[0]);              // fdcheck exits with how many of fds 3..26 are open
        _exit(99);
    }
    var ws: int;
    waitpid(pid, &ws, 0);
    ok("close-on-exec closes only marked descriptors", WIFEXITED(ws) && WEXITSTATUS(ws) == 1);
    close(fd);
    close(d2);
    // E2BIG: too many arguments
    var many: [90]*char;
    var i: int = 0;
    while (i < 89) { many[i] = "x"; i += 1; }
    many[89] = null;
    ok("E2BIG: execve with 89 arguments", fails(execve("/bin/true", &many[0], null), E2BIG));
    var badv: [2]*char = { 1000 as *char, null };
    ok("EFAULT: execve with a bad argv string", fails(execve("/bin/true", &badv[0], null), EFAULT));
    ok("EFAULT: execve with a bad envp", fails(execve("/bin/true", null, 1000 as **char), EFAULT));
    ok("EFAULT: execve with a bad path", fails(execve(1000 as *char, null, null), EFAULT));
}

// gmtime, timegm, strftime and dates; precise time as a long; the three
// inode times
fn times_and_dates() {
    var t: tm;
    var b: [81]char;
    gmtime_r(-1, &t);
    strftime(&b[0], 81, "%F %T", &t);
    ok("gmtime before 1970", streq(&b[0], "1969-12-31 23:59:59"));
    gmtime_r(-62135596800, &t);                         // the first day of year 1
    strftime(&b[0], 81, "%Y-%m-%d %a", &t);
    ok("gmtime of year 1", streq(&b[0], "1-01-01 Mon"));
    gmtime_r(3786825600000, &t);                        // a hundred thousand years on
    ok("gmtime far ahead", t.tm_year + 1900 == 121969 && timegm(&t) == 3786825600000);
    gmtime_r(951782400, &t);                            // 2000-02-29
    ok("gmtime of 2000-02-29", t.tm_mon == 1 && t.tm_mday == 29 && t.tm_yday == 59 && t.tm_wday == 2);
    var k: int = -100000;
    var round: int = 1;
    while (k < 100000) {
        var v: int = k * 7777777;
        gmtime_r(v, &t);
        if (timegm(&t) != v) { round = 0; }
        k += 1111;
    }
    ok("timegm undoes gmtime", round);
    t.tm_year = 126;
    t.tm_mon = 13;                                      // February 2027
    t.tm_mday = 0;                                      // the last of January
    t.tm_hour = 25;
    t.tm_min = 0;
    t.tm_sec = 0;
    gmtime_r(timegm(&t), &t);
    strftime(&b[0], 81, "%F %T", &t);
    ok("timegm normalizes", streq(&b[0], "2027-02-01 01:00:00"));
    gmtime_r(1728400000, &t);
    strftime(&b[0], 81, "%A %B %y %I%p %u %w %s %D %R %Z %C", &t);
    ok("strftime conversions", streq(&b[0], "Tuesday October 24 03PM 2 2 1728400000 10/08/24 15:06 UTC 20"));
    // precise time
    var ts: timespec;
    ts.tv_sec = 1728400000;
    ts.tv_nsec = 123456789;
    var l: long = ltime_from_ts(&ts);
    ltime_text(l, 9, &b[0]);
    ok("a timespec as a long", streq(&b[0], "1728400000.123456789") && ltime_seconds(l) == 1728400000);
    var back: timespec;
    ltime_to_ts(l, &back);
    ok("and back", back.tv_sec == 1728400000 && back.tv_nsec == 123456789);
    ltime_text(ltime_parse("-0.25", null), 3, &b[0]);
    ok("negative time", streq(&b[0], "-0.250"));
    ltime_to_ts(ltime_parse("-0.25", null), &back);
    ok("negative time as a timespec", back.tv_sec == -1 && back.tv_nsec == 750000000);
    ltime_text(ltime_parse("2.9999999", null), 3, &b[0]);
    ok("rounding carries into the seconds", streq(&b[0], "3.000"));
    ltime_text(LTIME_SECOND / 3, 6, &b[0]);
    ok("a third of a second", streq(&b[0], "0.333333"));
    ok("the top word holds the seconds", ((l >> 54) as int) == 1728400000);
    ok("subtraction gives durations", ltime_parse("10.5", null) - ltime_parse("8.5", null) == ltime_parse("2", null) && ltime_parse("10.5", null) - ltime_parse("8.25", null) - ltime_parse("2.25", null) <= 1);
    // dates
    ok("parse_date @", parse_date("@1728400000.5", &ts) == 0 && ts.tv_sec == 1728400000 && ts.tv_nsec == 500000000);
    ok("parse_date YYYY-MM-DD HH:MM:SS", parse_date("2024-10-08 15:06:40", &ts) == 0 && ts.tv_sec == 1728400000);
    ok("parse_date T and a fraction", parse_date("2024-10-08T15:06:40.25", &ts) == 0 && ts.tv_sec == 1728400000 && ts.tv_nsec == 250000000);
    ok("parse_date before 1970", parse_date("1969-07-20 20:17", &ts) == 0 && ts.tv_sec == -14182980);
    ok("parse_date refuses February 30", parse_date("2024-02-30", &ts) < 0);
    ok("parse_date refuses 24:00", parse_date("2024-02-03 24:00", &ts) < 0);
    ok("parse_date refuses junk", parse_date("2024-02-03x", &ts) < 0 && parse_date("@", &ts) < 0 && parse_date("@1x", &ts) < 0);
    // the inode's times
    var fd: int = open("/home/tm", O_WRONLY + O_CREAT + O_TRUNC, 420);
    close(fd);
    var tv: [2]timespec;
    tv[0].tv_sec = 1000000000;
    tv[0].tv_nsec = 0;
    tv[1].tv_sec = 1100000000;
    tv[1].tv_nsec = 0;
    var st: stat_t;
    ok("utimensat sets both", utimensat(AT_FDCWD, "/home/tm", &tv[0], 0) == 0 && stat("/home/tm", &st) == 0 && st.st_atime == 1000000000 && st.st_mtime == 1100000000);
    var now: int = time(null);
    ok("utimensat changes ctime to now", st.st_ctime >= now - 2 && st.st_ctime <= now);
    tv[0].tv_nsec = UTIME_OMIT;
    tv[1].tv_sec = 1200000000;
    ok("UTIME_OMIT keeps one", utimensat(AT_FDCWD, "/home/tm", &tv[0], 0) == 0 && stat("/home/tm", &st) == 0 && st.st_atime == 1000000000 && st.st_mtime == 1200000000);
    tv[0].tv_nsec = UTIME_NOW;
    tv[1].tv_nsec = UTIME_OMIT;
    ok("UTIME_NOW", utimensat(AT_FDCWD, "/home/tm", &tv[0], 0) == 0 && stat("/home/tm", &st) == 0 && st.st_atime >= now - 2 && st.st_mtime == 1200000000);
    tv[1].tv_nsec = 1000000000;
    ok("EINVAL: utimensat a billion nanoseconds", fails(utimensat(AT_FDCWD, "/home/tm", &tv[0], 0), EINVAL));
    ok("ENOENT: utimensat a missing file", fails(utimensat(AT_FDCWD, "/home/none", null, 0), ENOENT));
    ok("EPERM: utimensat in /proc", fails(utimensat(AT_FDCWD, "/proc/uptime", null, 0), EPERM));
    ok("EFAULT: utimensat bad times", fails(utimensat(AT_FDCWD, "/home/tm", 1000 as *timespec, 0), EFAULT));
    tv[0].tv_sec = 1000000000;
    tv[0].tv_nsec = 0;
    tv[1].tv_sec = 1000000000;
    tv[1].tv_nsec = 0;
    fd = open("/home/tm", O_RDWR, 0);
    futimens(fd, &tv[0]);
    write(fd, "x" as *tryte, 1);
    fstat(fd, &st);
    ok("a write sets mtime and ctime", st.st_mtime >= now - 2 && st.st_ctime >= now - 2 && st.st_atime == 1000000000);
    futimens(fd, &tv[0]);
    chmod("/home/tm", 384);
    fstat(fd, &st);
    ok("chmod sets ctime only", st.st_mtime == 1000000000 && st.st_ctime >= now - 2);
    lseek(fd, 0, SEEK_SET);
    var c: [1]char;
    read(fd, &c[0] as *tryte, 1);
    fstat(fd, &st);
    ok("a read sets atime (it was older than mtime)", st.st_atime >= now - 2);
    close(fd);
    unlink("/home/tm");
}

var alarms: int;
fn on_alarm(sig: int) { alarms += 1; }

// pread/pwrite, alarm and setitimer, vfork
fn timers_and_offsets() {
    var fd: int = open("/home/pio", O_RDWR + O_CREAT + O_TRUNC, 420);
    write(fd, "0123456789" as *tryte, 10);
    lseek(fd, 3, SEEK_SET);
    var b: [11]char;
    var n: int = pread(fd, &b[0] as *tryte, 4, 5);
    b[4] = 0;
    ok("pread at an offset", n == 4 && streq(&b[0], "5678"));
    ok("pread leaves the position", lseek(fd, 0, SEEK_CUR) == 3);
    ok("pwrite at an offset", pwrite(fd, "AB" as *tryte, 2, 8) == 2 && lseek(fd, 0, SEEK_CUR) == 3);
    n = pread(fd, &b[0] as *tryte, 10, 0);
    b[10] = 0;
    ok("pwrite wrote there", n == 10 && streq(&b[0], "01234567AB"));
    ok("pread past the end reads 0", pread(fd, &b[0] as *tryte, 4, 50) == 0);
    ok("EINVAL: pread at a negative offset", fails(pread(fd, &b[0] as *tryte, 4, -1), EINVAL));
    ok("EBADF: pwrite on a closed descriptor", fails(pwrite(25, &b[0] as *tryte, 1, 0), EBADF));
    close(fd);
    unlink("/home/pio");
    var p: [2]int;
    pipe(&p[0]);
    ok("ESPIPE: pread on a pipe", fails(pread(p[0], &b[0] as *tryte, 1, 0), ESPIPE));
    close(p[0]);
    close(p[1]);
    // alarm: SIGALRM after the seconds, pause until it; alarm(0) cancels
    signal(SIGALRM, &on_alarm as int);
    alarms = 0;
    ok("alarm returns 0 with none set", alarm(1) == 0);
    pause();
    ok("alarm delivered SIGALRM", alarms == 1);
    alarm(5);
    ok("alarm returns the seconds left", alarm(0) == 5);
    var it: itimerval;
    getitimer(ITIMER_REAL, &it);
    ok("alarm(0) cancels", it.it_value.tv_sec == 0 && it.it_value.tv_usec == 0);
    // a repeating timer: three times every 0.05 s
    it.it_interval.tv_sec = 0;
    it.it_interval.tv_usec = 50000;
    it.it_value.tv_sec = 0;
    it.it_value.tv_usec = 50000;
    alarms = 0;
    setitimer(ITIMER_REAL, &it, null);
    while (alarms < 3) { pause(); }
    var cur: itimerval;
    getitimer(ITIMER_REAL, &cur);
    ok("setitimer repeats", alarms == 3 && cur.it_interval.tv_usec == 50000 && cur.it_value.tv_usec > 0);
    it.it_value.tv_usec = 0;
    it.it_interval.tv_usec = 0;
    setitimer(ITIMER_REAL, &it, &cur);
    ok("setitimer returns the old timer", cur.it_interval.tv_usec == 50000);
    ok("EINVAL: ITIMER_VIRTUAL", fails(setitimer(1, &it, null), EINVAL));
    it.it_value.tv_usec = 1000000;
    ok("EINVAL: a million microseconds", fails(setitimer(ITIMER_REAL, &it, null), EINVAL));
    ok("EFAULT: setitimer from the kernel", fails(setitimer(ITIMER_REAL, 1000 as *itimerval, null), EFAULT));
    signal(SIGALRM, SIG_DFL);
    // a child does not inherit the timer, nor find the one of the process
    // whose slot it takes (the first child sets one and exits)
    var pid: int = fork();
    if (pid == 0) {
        alarm(200);
        _exit(0);
    }
    var ws0: int;
    waitpid(pid, &ws0, 0);
    alarm(100);
    pid = fork();
    if (pid == 0) {
        var ct: itimerval;
        getitimer(ITIMER_REAL, &ct);
        _exit(ct.it_value.tv_sec == 0 ? 0 : 1);
    }
    var ws: int;
    waitpid(pid, &ws, 0);
    alarm(0);
    ok("fork clears the child's timer", WIFEXITED(ws) && WEXITSTATUS(ws) == 0);
    // vfork: a fork here
    pid = vfork();
    if (pid == 0) { _exit(42); }
    waitpid(pid, &ws, 0);
    ok("vfork", pid > 0 && WIFEXITED(ws) && WEXITSTATUS(ws) == 42);
}

// Password hashing (crypt.tri) and the account databases (pwd.tri).
fn passwords() {
    var h: *char = crypt("root", "$md5$Tr1nux.r");
    ok("crypt md5 matches the stored root hash", h != null && streq(h, "$md5$Tr1nux.r$f54b3f8dbabf84cf37b28c5bc7159ab8"));
    ok("crypt_verify", crypt_verify("root", "$md5$Tr1nux.r$f54b3f8dbabf84cf37b28c5bc7159ab8")
        && !crypt_verify("Root", "$md5$Tr1nux.r$f54b3f8dbabf84cf37b28c5bc7159ab8"));
    ok("crypt: an unknown scheme gives null", crypt("x", "$sha512$salt") == null && !crypt_verify("x", "$sha512$salt$abc"));
    ok("crypt: bad settings give null", crypt("x", "md5$salt") == null && crypt("x", "$md5$") == null
        && crypt("x", "$md5$bad:salt") == null && crypt("x", "$md5") == null);
    ok("crypt_verify: locked and empty entries match nothing", !crypt_verify("", "!") && !crypt_verify("", "*") && !crypt_verify("", ""));
    var a: [81]char;
    strcpy(&a[0], crypt_new("pw"));
    var b: [81]char;                                    // crypt's result is a static buffer: copy it
    strcpy(&b[0], crypt_new("pw"));
    ok("crypt_new: $md5$, an 8-character salt, 32 hex digits", strncmp(&a[0], "$md5$", 5) == 0 && a[13] == '$' && strlen(&a[0]) == 46);
    ok("crypt_new verifies and salts differently", crypt_verify("pw", &a[0]) && crypt_verify("pw", &b[0]) && !streq(&a[0], &b[0]));
    ok("crypt_verify of crypt's own buffer", crypt_verify("pw", crypt("pw", &a[0])) && !crypt_verify("px", crypt("pw", &a[0])));
    var p: *passwd = getpwnam("user");
    ok("getpwnam", p != null && p.pw_uid == 1000 && p.pw_gid == 1000 && streq(p.pw_dir, "/home/user") && streq(p.pw_shell, "/bin/sh"));
    p = getpwuid(0);
    ok("getpwuid", p != null && streq(p.pw_name, "root"));
    ok("getpwnam: no such user", getpwnam("nobody-here") == null && getpwuid(4242) == null);
    var g: *group = getgrnam("wheel");
    ok("getgrnam with members", g != null && g.gr_gid == 10 && streq(g.gr_mem[0], "root") && streq(g.gr_mem[1], "user") && g.gr_mem[2] == null);
    var gs: [9]int;
    ok("user_groups", user_groups("user", 1000, &gs[0], 9) == 2 && gs[0] == 1000 && gs[1] == 10);
    var sp: *spwd = getspnam("root");
    ok("getspnam (as root)", sp != null && strncmp(sp.sp_pwdp, "$md5$", 5) == 0);
}

fn main(argc: int, argv: **char) -> int {
    passwords();
    strings();
    numbers();
    heap();
    environment();
    files();
    options();
    system_calls();
    timers_and_offsets();
    times_and_dates();
    puts(failures == 0 ? "libctest: all passed\n" : "libctest: some checks FAILED\n");
    return failures != 0;
}
