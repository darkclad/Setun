    "db4252337900d8ab7f609d170135d459a6798945d5a574d4a9db7b623c754d078fb2239762994969a1f372801817bb304f5b549a6bb5cb7c69950c5f439caf19",
    "43a0b197b976835b9874524272a43a8ecbf2891579772b66e9c32f767014a6d00b03c51dfb29e7799dc45dcce3b7bbf5e0bb3e5a986eb99f4af45599894ba90f",
    "c5492c4e150f073fa316ab32f6752abf52914ee2a4207f09e35586b7205948df80ce444e94a78fb65907e0a741c2b1a6d1ab798de0b1afad83a9bee1b8c8f76e",
    "f4771493e402a8aa4fc0251ee80b3f142481417b3dd942dcf72d96e26f75ad6a08db744812ddc576111fe99dc5bda94fa058af1cb5991da49bef07a4c5522ff7",
    "8bae34cf4fcbba9c49fd2245431d94598e5596243104c0ec61ea3000cec0720882b8072183b1e65b2222cddca59757eabc6313d1d7a73bc110e4a5cee0106e9f",
    "0213fc98352f009fafdf8ee1ea36391485a85aa6f6c07a5cd81266d21eb17f9af3e3a6aa4a5e03793be3a4da4ba01c438b689164fc6bebb290eb372bfecd569d",
    "c00f43811e5b4a38e14e3c06d8a5ce34115a19cd604ce5bac6c3823b76046d5c6b149f173bef3089dbfe66774f9723bc344ecbaa7e9674df4ceb8558811423c5",
    "3c983983487bcbe74feba53b35bb1e05812379cb4116d9761f78d2ce3177866edc88e750bfaf43bd31ccd052078d97406fbfca21145c09c8d9bd1e81cd443e31",
    "89a2450c9785e8a01d1baca6b7023479d3a0de33c757a9a584ec84714894c3b774b2960a6ae3a2f5f6e277b9b01f5b1a3ec0499d93b7d76d0b856e0d53fc1ad0",
    "8e824d0df5f99be40bd0c4ee530e2b409a7c7713aba1ee96c56fb7f35729504e05dc6f8adb84b7e89d9b7de9c8e87f491c4c35e7d16173e4a986d26992d9c196",
    "e76eaecce9983b4be8a8b9cd8b5a457e9b6995449ad142af68a83a0e171e52bb638feadda7d5732e1596f07e6a05e58b8668c23733ebf58ae88f783f6bbef4eb",
    "685d9873233fd4c7ce4bb15d7b947c9841f0e5cc18847a4ef07769ccb13022be75ab878b1c49a037276714755b87c8e553c98b24721f93b444598fb0d5826391",
};
var mlkem_cases: [16]*char = {
    "11", "41", "71", "e5a86d2164b46374361d03cdb4e7df787084a71aa6c7bbc0c6524e8a9e69e55b",
    "ef4d82935741bc9e10ed3319960fdd434176cfbbb7055bde88e5f8b106fc1651", "07625c3768bc9ef5b91b50215c1f9aac72cf82d309e48dea38915c9a7adee6ee",
    "19fd49488d6cc1b3433fddc74c616cee6b4d5e357a1e77bd477d8604afa9849c", "a20bacadbc9c7d3d46f7881e257e59f71e51fdd80a3cfd99770cff845b3c44d9",
    "12", "42", "72", "cc0d5b8326816e14ac38f6782c338d84d33f46a3944b20fb7a74d171ed646ce8",
    "07651a40cd5367192fa651819c6599d8939f6856c050d3ababf20841c2269d11", "654f41a315e6386e436d86f908c93236720362008c3137ee047aee67400cd495",
    "5c4a6f830f25f93ed6cfa90e4d9c0b79679c5f459eb94dc7de21a7702f623f8a", "94b5553860f59c46797022d0d1181c3bcb3525604d50cec22c671385143c5b97",
};
var sntrup_pk0: [1]*char = { "" };
var sntrup_ginv0: [1]*char = { "" };
var sntrup_cases: [18]*char = {
    "",
    "",
    "",
    "",
    "f6a3d16df63fab133a2dfac5e7a44df57984c4fecb04013414e17d6caeaa3ed8",
    "a4b69ff35613159dc9d2241e7743fbd63c8d1908d0739cc1ef717e067c345384",
    "d06835600116e4c598040f6d8775b65fd7a8636f1a4c5a970664211964f9b10d",
    "b40259f7b22aaf1479abea18c7e52e392a887dfe76509325e145c5d2f940805e",
    "9b1cf215c4a031ca5d79c1a9d23d26e9584d1d7436f7de15ea401932a9a9ce3d",
    "",
    "",
    "",
    "",
    "fce26529e0326571bae114c83f723d0ef8b49acf2a226f9a4a6dc7614e911e0c",
    "a77d979285211f551e32436539eb2a02f5e7d6aa0774b7ca777b0dc35be47863",
    "4b5f2590f8886974f117878e1b672f52cc737965b8e9453470ad451abd49a6aa",
    "4fb4c936711dc91366219404db3ef08dfd18beeb438d9808896d79530d702117",
    "60492b383bd8c9fc633fbf643dcd60f067034763343fdf757b4d40d2051eed75",
};
// ---- end of vectors ----


var m: [300]tryte;
var dgst: [200]tryte;
var d: [32]tryte;
var z: [32]tryte;
var mm: [32]tryte;
var ek: [1184]tryte;
var dk: [2400]tryte;
var ct: [1088]tryte;
var key: [32]tryte;
var key2: [32]tryte;
var hh: [32]tryte;
var sbuf: [191]tryte;
var srho: [191]tryte;
var sg: [761]int;
var sf: [761]int;
var sr: [761]int;
var spk: [1158]tryte;
var ssk: [1763]tryte;
var sct: [1039]tryte;

fn hexval(ch: int) -> int { return ch <= '9' ? ch - '0' : ch - 'a' + 10; }

fn unhex(s: *char, p: *tryte) -> int {
    var n: int = 0;
    while (s[2 * n] != 0) {
        p[n] = (hexval(s[2 * n]) * 16 + hexval(s[2 * n + 1])) as tryte;
        n += 1;
    }
    return n;
}

fn main(argc: int, argv: **char) -> int {
    t0 = ms();
    var all: int = 1;
    var i: int = 0;
    while (i < 13) {
        msg(&m[0], sha3_lens[i], 3);
        sha3_256(&m[0], sha3_lens[i], &dgst[0]);
        if (!is_hex(&dgst[0], 32, sha3_256_want[i])) { all = 0; }
        i += 1;
    }
    ok("SHA3-256 at every block edge", all);
    all = 1;
    i = 0;
    while (i < 13) {
        msg(&m[0], sha3_lens[i], 3);
        sha3_512(&m[0], sha3_lens[i], &dgst[0]);
        if (!is_hex(&dgst[0], 64, sha3_512_want[i])) { all = 0; }
        i += 1;
    }
    ok("SHA3-512 at every block edge", all);
    all = 1;
    i = 0;
    while (i < 13) {
        msg(&m[0], sha3_lens[i], 3);
        shake128(&m[0], sha3_lens[i], &dgst[0], 200);
        if (!is_hex(&dgst[0], 200, shake128_want[i])) { all = 0; }
        i += 1;
    }
    ok("SHAKE128, 200 octets out (two blocks)", all);
    all = 1;
    i = 0;
    while (i < 13) {
        msg(&m[0], sha3_lens[i], 3);
        shake256(&m[0], sha3_lens[i], &dgst[0], 64);
        if (!is_hex(&dgst[0], 64, shake256_want[i])) { all = 0; }
        i += 1;
    }
    ok("SHAKE256", all);
    var c: int = 0;
    while (c < 2) {
        var row: **char = &mlkem_cases[8 * c];
        msg(&d[0], 32, atoi(row[0]));
        msg(&z[0], 32, atoi(row[1]));
        msg(&mm[0], 32, atoi(row[2]));
        mlkem_keygen(&d[0], &z[0], &ek[0], &dk[0]);
        sha3_256(&ek[0], 1184, &hh[0]);
        var good: int = is_hex(&hh[0], 32, row[3]);
        sha3_256(&dk[0], 2400, &hh[0]);
        ok("ML-KEM-768 key generation from (d, z)", good && is_hex(&hh[0], 32, row[4]));
        mlkem_encaps(&ek[0], &mm[0], &key[0], &ct[0]);
        sha3_256(&ct[0], 1088, &hh[0]);
        ok("ML-KEM-768 encapsulation", is_hex(&hh[0], 32, row[5]) && is_hex(&key[0], 32, row[6]));
        mlkem_decaps(&dk[0], &ct[0], &key2[0]);
        ok("ML-KEM-768 decapsulation gives the same key", is_hex(&key2[0], 32, row[6]));
        ct[100] = (ct[100] / 8 * 8 + (ct[100] % 8 + 4) % 8) as tryte;     // flip bit 2
        mlkem_decaps(&dk[0], &ct[0], &key2[0]);
        ok("ML-KEM-768 rejects a changed ciphertext (implicitly)", is_hex(&key2[0], 32, row[7]));
        c += 1;
    }
    // the encapsulation-key check (FIPS 203 §7.2): a 12-bit value of q or more
    var good: int = mlkem_ek_ok(&ek[0]);
    ek[0] = 1;                                  // first value: 3329 = 0x0d01
    ek[1] = (ek[1] / 16 * 16 + 13) as tryte;
    var bad1: int = mlkem_ek_ok(&ek[0]);
    ek[0] = 255;                                // 4095
    ek[1] = (ek[1] / 16 * 16 + 15) as tryte;
    var bad2: int = mlkem_ek_ok(&ek[0]);
    ek[0] = 0;                                  // 3328 = 0xd00
    ek[1] = (ek[1] / 16 * 16 + 13) as tryte;
    ek[0] = 0;
    var edge: int = mlkem_ek_ok(&ek[0]);
    ok("ML-KEM-768 encapsulation key check: q and above refused, q - 1 taken", good && !bad1 && !bad2 && edge);
    ek[0] = 0;
    ek[1] = (ek[1] / 16 * 16 + 13) as tryte;
    ek[1150] = 255;                             // the last value, in the high 12 bits of its 3 octets
    ek[1151] = 255;
    ok("ML-KEM-768 encapsulation key check reaches the last value", !mlkem_ek_ok(&ek[0]));
    // sntrup761: the pieces apart, then the whole
    var npk: int = unhex(sntrup_pk0[0], &spk[0]);
    _snrq_decode(&spk[0], &sg[0]);
    _snrq_encode(&sg[0], &sct[0]);
    var rq_same: int = npk == 1158;
    var q: int = 0;
    while (q < 1158) { if (sct[q] != spk[q]) { rq_same = 0; } q += 1; }
    ok("sntrup761 Rq decoding and encoding of the reference's key", rq_same);
    unhex(sntrup_cases[0], &sbuf[0]);
    _snsmall_decode(&sbuf[0], &sg[0]);
    _snrecip(&sf[0], &sg[0], 1);
    _snsmall_encode(&sf[0], &sbuf[0]);
    ok("sntrup761 1/g modulo 3", is_hex(&sbuf[0], 191, sntrup_ginv0[0]));
    unhex(sntrup_cases[3], &sbuf[0]);
    _snsmall_decode(&sbuf[0], &sr[0]);
    sntrup_encaps_with(&spk[0], &sr[0], &key[0], &sct[0]);
    sha3_256(&sct[0], 1039, &hh[0]);
    ok("sntrup761 encapsulation with the reference's key", is_hex(&hh[0], 32, sntrup_cases[6]) && is_hex(&key[0], 32, sntrup_cases[7]));
    c = 0;
    while (c < 2) {
        var srow: **char = &sntrup_cases[9 * c];
        unhex(srow[0], &sbuf[0]);
        _snsmall_decode(&sbuf[0], &sg[0]);
        unhex(srow[1], &sbuf[0]);
        _snsmall_decode(&sbuf[0], &sf[0]);
        unhex(srow[2], &srho[0]);
        unhex(srow[3], &sbuf[0]);
        _snsmall_decode(&sbuf[0], &sr[0]);
        var made: int = sntrup_keygen_from(&sg[0], &sf[0], &srho[0], &spk[0], &ssk[0]);
        sha3_256(&spk[0], 1158, &hh[0]);
        var pk_ok: int = is_hex(&hh[0], 32, srow[4]);
        sha3_256(&ssk[0], 1763, &hh[0]);
        ok("sntrup761 key generation (1/g mod 3, 1/(3f) mod q)", made == 0 && pk_ok && is_hex(&hh[0], 32, srow[5]));
        sntrup_encaps_with(&spk[0], &sr[0], &key[0], &sct[0]);
        sha3_256(&sct[0], 1039, &hh[0]);
        ok("sntrup761 encapsulation", is_hex(&hh[0], 32, srow[6]) && is_hex(&key[0], 32, srow[7]));
        sntrup_decaps(&ssk[0], &sct[0], &key2[0]);
        ok("sntrup761 decapsulation gives the same key", is_hex(&key2[0], 32, srow[7]));
        sct[200] = (sct[200] / 32 * 32 + (sct[200] % 32 + 16) % 32) as tryte;     // flip bit 4
        sntrup_decaps(&ssk[0], &sct[0], &key2[0]);
        ok("sntrup761 rejects a changed ciphertext (implicitly)", is_hex(&key2[0], 32, srow[8]));
        c += 1;
    }
    // a g with no inverse modulo 3: 1 + x is a factor of nothing here, but g = 0 has none
    var zero: [761]int;
    var zi: int = 0;
    while (zi < 761) { zero[zi] = 0; zi += 1; }
    ok("sntrup761 refuses a g with no inverse modulo 3", sntrup_keygen_from(&zero[0], &sf[0], &srho[0], &spk[0], &ssk[0]) < 0);
    puts(failures == 0 ? "pqtest: all passed\n" : "pqtest: some checks FAILED\n");
    return failures != 0;
}
