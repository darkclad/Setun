// /bin/pqtest: SHA-3, SHAKE and ML-KEM-768 against vectors from Python's
// hashlib and tools/mlkem.py (itself checked against OpenSSL by
// tools/check_mlkem.py), one line per check, with the time each took.

import "../lib/tlibc.tri";
import "../lib/sha3.tri";
import "../lib/mlkem.tri";
import "../lib/sntrup.tri";

var failures: int;
var t0: int;

fn ms() -> int {
    var ts: timespec;
    clock_gettime(1, &ts);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

fn ok(what: *char, cond: int) {
    puts("pqtest: ");
    puts(what);
    puts(cond ? " ok" : " FAILED");
    puts(" (");
    put_int(ms() - t0);
    puts(" ms)\n");
    if (!cond) { failures += 1; }
    t0 = ms();
}

fn hexdigit(v: int) -> char { return (v < 10 ? '0' + v : 'a' + v - 10) as char; }

// Do n octets at p print as the hex string s?
fn is_hex(p: *tryte, n: int, s: *char) -> int {
    var k: int = 0;
    while (k < n) {
        if (s[2 * k] != hexdigit(p[k] / 16) || s[2 * k + 1] != hexdigit(p[k] % 16)) { return 0; }
        k += 1;
    }
    return s[2 * n] == 0;
}

fn msg(p: *tryte, n: int, seed: int) {
    var k: int = 0;
    while (k < n) { p[k] = ((k * 7 + seed) % 256) as tryte; k += 1; }
}

// ---- vectors (tools/gen_pqvectors.py) ----
