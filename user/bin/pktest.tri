// /bin/pktest: the public-key and TLS crypto against published vectors
// (RFC 4231, RFC 5869, RFC 8439, FIPS 180-4) and signatures made by
// another implementation (pkvectors.inc.tri, from Python's cryptography),
// one line per check with its time.

import "../lib/tlibc.tri";
import "../lib/ecdsa.tri";
import "../lib/rsa.tri";
import "../lib/hmac.tri";
import "../lib/chacha.tri";
import "../lib/aes.tri";
import "pkvectors.inc.tri";
import "aesvectors.inc.tri";
import "../lib/ctype.tri";

var failures: int;
var t0: int;

fn ms() -> int {
    var ts: timespec;
    clock_gettime(1, &ts);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

fn ok(what: *char, cond: int) {
    puts("pktest: ");
    puts(what);
    puts(cond ? " ok" : " FAILED");
    puts(" (");
    put_int(ms() - t0);
    puts(" ms)\n");
    if (!cond) { failures += 1; }
    t0 = ms();
}

fn unhex(s: *char, p: *tryte) -> int {
    var n: int = 0;
    while (s[2 * n] != 0) {
        p[n] = (xdigit_val(s[2 * n]) * 16 + xdigit_val(s[2 * n + 1])) as tryte;
        n += 1;
    }
    return n;
}

fn is_hex(p: *tryte, s: *char) -> int {
    var want: [600]tryte;
    var n: int = unhex(s, &want[0]);
    return octets_equal(p, &want[0], n);
}

var a: [600]tryte;
var b: [600]tryte;
var c: [600]tryte;
var d: [600]tryte;
var out: [600]tryte;

fn ecdsa_case(curve: int, pub: *char, h: *char, r: *char, s: *char) -> int {
    var pl: int = unhex(pub, &a[0]);
    var hl: int = unhex(h, &b[0]);
    var rl: int = unhex(r, &c[0]);
    var sl: int = unhex(s, &d[0]);
    return ecdsa_verify(curve, &a[0], pl, &b[0], hl, &c[0], rl, &d[0], sl);
}

var e65537: [3]tryte;

fn rsa_case(scheme: int, id: int, n: *char, sig: *char, h: *char) -> int {
    var nl: int = unhex(n, &a[0]);
    var sl: int = unhex(sig, &b[0]);
    unhex(h, &c[0]);
    return rsa_verify(scheme, id, &a[0], nl, &e65537[0], 3, &b[0], sl, &c[0]);
}

var gc: gcm;

// GCM case: seal must give ct; open must give msg back; a changed octet
// of the tag, the ciphertext or the associated data must be refused.
fn gcm_case(key: *char, nonce: *char, aad: *char, msg: *char, ct: *char) -> int {
    var kl: int = unhex(key, &a[0]);
    gcm_setkey(&gc, &a[0], kl);
    var nonce12: [12]tryte;
    unhex(nonce, &nonce12[0]);
    var al: int = unhex(aad, &b[0]);
    var ml: int = unhex(msg, &c[0]);
    gcm_seal(&gc, &nonce12[0], &b[0], al, &c[0], ml);
    var good: int = is_hex(&c[0], ct);
    good = good && gcm_open(&gc, &nonce12[0], &b[0], al, &c[0], ml) && is_hex(&c[0], msg);
    gcm_seal(&gc, &nonce12[0], &b[0], al, &c[0], ml);
    c[ml + 15] = xor8(c[ml + 15], 1) as tryte;                       // the tag
    good = good && !gcm_open(&gc, &nonce12[0], &b[0], al, &c[0], ml);
    c[ml + 15] = xor8(c[ml + 15], 1) as tryte;
    if (ml > 0) {
        c[ml - 1] = xor8(c[ml - 1], 128) as tryte;                   // the ciphertext
        good = good && !gcm_open(&gc, &nonce12[0], &b[0], al, &c[0], ml);
        c[ml - 1] = xor8(c[ml - 1], 128) as tryte;
    }
    if (al > 0) {
        b[0] = xor8(b[0], 2) as tryte;                                 // the associated data
        good = good && !gcm_open(&gc, &nonce12[0], &b[0], al, &c[0], ml);
        b[0] = xor8(b[0], 2) as tryte;
    }
    nonce12[11] = xor8(nonce12[11], 4) as tryte;                     // another nonce
    good = good && !gcm_open(&gc, &nonce12[0], &b[0], al, &c[0], ml);
    return good;
}

fn ecdh_pub(id: int, priv: *char, pub: *char) -> int {
    unhex(priv, &a[0]);
    return ec_pubkey(id, &a[0], &out[0]) && is_hex(&out[0], pub);
}

fn ecdh_both(id: int, pa: *char, pb: *char, apub: *char, bpub: *char, shared: *char) -> int {
    unhex(pa, &a[0]);
    var bl: int = unhex(bpub, &b[0]);
    var good: int = ecdh(id, &a[0], &b[0], bl, &out[0]) && is_hex(&out[0], shared);
    unhex(pb, &a[0]);
    var al: int = unhex(apub, &b[0]);
    return good && ecdh(id, &a[0], &b[0], al, &out[0]) && is_hex(&out[0], shared);
}

fn ecdh_refusals() -> int {
    unhex(XP256_A, &a[0]);
    var bl: int = unhex(XP256_BPUB, &b[0]);
    b[bl - 1] = xor8(b[bl - 1], 1) as tryte;                         // y changed: off the curve
    var bad: int = ecdh(CURVE_P256, &a[0], &b[0], bl, &out[0]);
    b[bl - 1] = xor8(b[bl - 1], 1) as tryte;
    bad = bad || ecdh(CURVE_P256, &a[0], &b[0], bl - 1, &out[0]);   // short
    b[0] = 2;                                                          // compressed form
    bad = bad || ecdh(CURVE_P256, &a[0], &b[0], bl, &out[0]);
    b[0] = 4;
    var k: int = 1;
    while (k <= 32) { b[k] = 255; k += 1; }                            // x = 2^256 - 1 >= p
    bad = bad || ecdh(CURVE_P256, &a[0], &b[0], bl, &out[0]);
    return !bad;
}

fn ecdh_fresh() -> int {
    var pa: [32]tryte;
    var pb: [32]tryte;
    var qa: [65]tryte;
    var qb: [65]tryte;
    var sa: [32]tryte;
    var sb: [32]tryte;
    if (!ec_keygen(CURVE_P256, &pa[0], &qa[0]) || !ec_keygen(CURVE_P256, &pb[0], &qb[0])) { return 0; }
    if (!ecdh(CURVE_P256, &pa[0], &qb[0], 65, &sa[0]) || !ecdh(CURVE_P256, &pb[0], &qa[0], 65, &sb[0])) { return 0; }
    return octets_equal(&sa[0], &sb[0], 32) && !octets_equal(&pa[0], &pb[0], 32);
}

// Sign msg (hex) with the fixed key; r and s must be exactly the expected
// ones (RFC 6979 makes them deterministic), and verify.
fn sign_case(cid: int, hid: int, dhex: *char, pub: *char, msg: *char, r: *char, s: *char) -> int {
    var dk: [48]tryte;
    unhex(dhex, &dk[0]);
    var ml: int = unhex(msg, &a[0]);
    var hl: int = hash_len(hid);
    hash_octets(hid, &a[0], ml, &b[0]);
    var ob: int = cid == CURVE_P256 ? 32 : 48;
    if (!ecdsa_sign(cid, hid, &dk[0], &b[0], hl, &c[0], &d[0])) { return 0; }
    var pl: int = unhex(pub, &out[0]);
    return is_hex(&c[0], r) && is_hex(&d[0], s) && ecdsa_verify(cid, &out[0], pl, &b[0], hl, &c[0], ob, &d[0], ob);
}

fn sign_refusals() -> int {
    var dk: [32]tryte;
    var k: int = 0;
    while (k < 32) { dk[k] = 0; k += 1; }
    b[0] = 1;
    var bad: int = ecdsa_sign(CURVE_P256, HASH_SHA256, &dk[0], &b[0], 32, &c[0], &d[0]);      // d = 0
    unhex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551", &dk[0]);          // d = n
    bad = bad || ecdsa_sign(CURVE_P256, HASH_SHA256, &dk[0], &b[0], 32, &c[0], &d[0]);
    return !bad;
}

fn main(argc: int, argv: **char) -> int {
    t0 = ms();
    e65537[0] = 1; e65537[1] = 0; e65537[2] = 1;
    bin32_init();
    var n: int = 0;
    a[0] = 'a'; a[1] = 'b'; a[2] = 'c';
    sha384(&a[0], 3, &out[0]);
    ok("SHA-384 abc", is_hex(&out[0], "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"));
    // RFC 4231 test 1
    var k: int = 0;
    while (k < 20) { a[k] = 11; k += 1; }
    var hi: *char = "Hi There";
    k = 0;
    while (k < 8) { b[k] = hi[k] as tryte; k += 1; }
    hmac(HASH_SHA256, &a[0], 20, &b[0], 8, &out[0]);
    ok("HMAC-SHA256 RFC 4231 1", is_hex(&out[0], "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"));
    hmac(HASH_SHA384, &a[0], 20, &b[0], 8, &out[0]);
    ok("HMAC-SHA384 RFC 4231 1", is_hex(&out[0], "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6"));
    // RFC 5869 test 1
    k = 0;
    while (k < 22) { a[k] = 11; k += 1; }
    unhex("000102030405060708090a0b0c", &b[0]);
    unhex("f0f1f2f3f4f5f6f7f8f9", &c[0]);
    var prk: [64]tryte;
    hkdf_extract(HASH_SHA256, &b[0], 13, &a[0], 22, &prk[0]);
    hkdf_expand(HASH_SHA256, &prk[0], &c[0], 10, &out[0], 42);
    ok("HKDF RFC 5869 1", is_hex(&prk[0], "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
        && is_hex(&out[0], "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"));
    // RFC 8439 2.8.2
    var key: [32]tryte;
    k = 0;
    while (k < 32) { key[k] = (128 + k) as tryte; k += 1; }
    var nonce: [12]tryte;
    unhex("070000004041424344454647", &nonce[0]);
    var aad: [12]tryte;
    unhex("50515253c0c1c2c3c4c5c6c7", &aad[0]);
    var pt: *char = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    n = strlen(pt);
    k = 0;
    while (k < n) { out[k] = pt[k] as tryte; k += 1; }
    aead_seal(&key[0], &nonce[0], &aad[0], 12, &out[0], n);
    ok("ChaCha20-Poly1305 seal (RFC 8439 2.8.2)", is_hex(&out[0], V_AEAD_CT));
    ok("ChaCha20-Poly1305 open", aead_open(&key[0], &nonce[0], &aad[0], 12, &out[0], n) && out[0] == 'L' && out[n - 1] == '.');
    aead_seal(&key[0], &nonce[0], &aad[0], 12, &out[0], n);
    out[5] = xor8(out[5], 1) as tryte;
    ok("ChaCha20-Poly1305 refuses a changed ciphertext", !aead_open(&key[0], &nonce[0], &aad[0], 12, &out[0], n));
    aead_seal(&key[0], &nonce[0], &aad[0], 12, &out[0], n);
    aad[0] = 0;
    ok("ChaCha20-Poly1305 refuses changed associated data", !aead_open(&key[0], &nonce[0], &aad[0], 12, &out[0], n));

    // FIPS 197 appendix C.1 and C.3
    var ak: aes;
    unhex("000102030405060708090a0b0c0d0e0f", &a[0]);
    aes_setkey(&ak, &a[0], 16);
    unhex("00112233445566778899aabbccddeeff", &b[0]);
    aes_encrypt(&ak, &b[0], &out[0]);
    ok("AES-128 FIPS 197 C.1", is_hex(&out[0], "69c4e0d86a7b0430d8cdb78070b4c55a"));
    unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", &a[0]);
    aes_setkey(&ak, &a[0], 32);
    aes_encrypt(&ak, &b[0], &out[0]);
    ok("AES-256 FIPS 197 C.3", is_hex(&out[0], "8ea2b7ca516745bfeafc49904b496089"));
    ok("AES-128-GCM, empty", gcm_case(G0_KEY, G0_NONCE, G0_AAD, G0_MSG, G0_CT));
    ok("AES-128-GCM, 13 + 16", gcm_case(G1_KEY, G1_NONCE, G1_AAD, G1_MSG, G1_CT));
    ok("AES-128-GCM, 20 + 60", gcm_case(G2_KEY, G2_NONCE, G2_AAD, G2_MSG, G2_CT));
    ok("AES-256-GCM, 0 + 17", gcm_case(G3_KEY, G3_NONCE, G3_AAD, G3_MSG, G3_CT));
    ok("AES-256-GCM, 12 + 64", gcm_case(G4_KEY, G4_NONCE, G4_AAD, G4_MSG, G4_CT));
    ok("AES-128-GCM, 300 octets", gcm_case(G5_KEY, G5_NONCE, G5_AAD, G5_MSG, G5_CT));

    ok("ECDH P-256: public key", ecdh_pub(CURVE_P256, XP256_A, XP256_APUB));
    ok("ECDH P-256: shared secret both ways", ecdh_both(CURVE_P256, XP256_A, XP256_B, XP256_APUB, XP256_BPUB, XP256_SHARED));
    ok("ECDH P-384: shared secret both ways", ecdh_both(CURVE_P384, XP384_A, XP384_B, XP384_APUB, XP384_BPUB, XP384_SHARED));
    ok("ECDH refuses a point off the curve, a short key, a compressed one, x >= p", ecdh_refusals());
    ok("ECDH P-256: two new key pairs agree", ecdh_fresh());

    ok("ECDSA P-256 sign, RFC 6979 \"sample\"", sign_case(CURVE_P256, HASH_SHA256, SP256_D, SP256_PUB, SP256_M0, SP256_R0, SP256_S0));
    ok("ECDSA P-256 sign, \"test\"", sign_case(CURVE_P256, HASH_SHA256, SP256_D, SP256_PUB, SP256_M1, SP256_R1, SP256_S1));
    ok("ECDSA P-256 sign, 300 octets", sign_case(CURVE_P256, HASH_SHA256, SP256_D, SP256_PUB, SP256_M2, SP256_R2, SP256_S2));
    ok("ECDSA P-384 sign, RFC 6979 \"sample\"", sign_case(CURVE_P384, HASH_SHA384, SP384_D, SP384_PUB, SP384_M0, SP384_R0, SP384_S0));
    ok("ECDSA P-384 sign, \"test\"", sign_case(CURVE_P384, HASH_SHA384, SP384_D, SP384_PUB, SP384_M1, SP384_R1, SP384_S1));
    ok("ECDSA P-384 sign, 300 octets", sign_case(CURVE_P384, HASH_SHA384, SP384_D, SP384_PUB, SP384_M2, SP384_R2, SP384_S2));
    ok("ECDSA sign refuses a key of 0 or n", sign_refusals());

    ok("ECDSA P-256 SHA-256", ecdsa_case(CURVE_P256, V_P256_PUB, V_P256_H, V_P256_R, V_P256_S));
    ok("ECDSA P-384 SHA-384", ecdsa_case(CURVE_P384, V_P384_PUB, V_P384_H, V_P384_R, V_P384_S));
    ok("ECDSA P-256 with SHA-384 (the hash cut)", ecdsa_case(CURVE_P256, V_P256X_PUB, V_P256X_H, V_P256X_R, V_P256X_S));
    ok("ECDSA refuses another hash", !ecdsa_case(CURVE_P256, V_P256_PUB, V_H384, V_P256_R, V_P256_S));
    ok("ECDSA refuses swapped r and s", !ecdsa_case(CURVE_P256, V_P256_PUB, V_P256_H, V_P256_S, V_P256_R));
    ok("ECDSA refuses the other curve's key", !ecdsa_case(CURVE_P384, V_P256_PUB, V_P256_H, V_P256_R, V_P256_S));
    // a public key moved off the curve
    var pl: int = unhex(V_P256_PUB, &a[0]);
    a[pl - 1] = xor8(a[pl - 1], 1) as tryte;
    unhex(V_P256_H, &b[0]);
    unhex(V_P256_R, &c[0]);
    unhex(V_P256_S, &d[0]);
    ok("ECDSA refuses a point not on the curve", !ecdsa_verify(CURVE_P256, &a[0], pl, &b[0], 32, &c[0], 32, &d[0], 32));
    ok("ECDSA refuses r = 0", !ecdsa_case(CURVE_P256, V_P256_PUB, V_P256_H, "00", V_P256_S));

    ok("RSA-2048 PKCS#1 v1.5 SHA-256", rsa_case(RSA_PKCS1, HASH_SHA256, V_R2048_N, V_R2048_PKCS1_256, V_H256));
    ok("RSA-2048 PSS SHA-256", rsa_case(RSA_PSS, HASH_SHA256, V_R2048_N, V_R2048_PSS_256, V_H256));
    ok("RSA-2048 PKCS#1 v1.5 SHA-384", rsa_case(RSA_PKCS1, HASH_SHA384, V_R2048_N, V_R2048_PKCS1_384, V_H384));
    ok("RSA-2048 PSS SHA-384", rsa_case(RSA_PSS, HASH_SHA384, V_R2048_N, V_R2048_PSS_384, V_H384));
    ok("RSA-4096 PKCS#1 v1.5 SHA-256", rsa_case(RSA_PKCS1, HASH_SHA256, V_R4096_N, V_R4096_PKCS1_256, V_H256));
    ok("RSA-4096 PSS SHA-384", rsa_case(RSA_PSS, HASH_SHA384, V_R4096_N, V_R4096_PSS_384, V_H384));
    ok("RSA refuses another hash", !rsa_case(RSA_PKCS1, HASH_SHA256, V_R2048_N, V_R2048_PKCS1_256, V_H384));
    ok("RSA refuses PKCS#1 read as PSS", !rsa_case(RSA_PSS, HASH_SHA256, V_R2048_N, V_R2048_PKCS1_256, V_H256));
    ok("RSA refuses another key", !rsa_case(RSA_PKCS1, HASH_SHA256, V_R4096_N, V_R2048_PKCS1_256, V_H256));
    var nl: int = unhex(V_R2048_N, &a[0]);
    var sl: int = unhex(V_R2048_PSS_256, &b[0]);
    b[100] = xor8(b[100], 4) as tryte;
    unhex(V_H256, &c[0]);
    ok("RSA refuses a changed signature", !rsa_verify(RSA_PSS, HASH_SHA256, &a[0], nl, &e65537[0], 3, &b[0], sl, &c[0]));
    puts(failures == 0 ? "pktest: all passed\n" : "pktest: some checks FAILED\n");
    return failures != 0;
}
