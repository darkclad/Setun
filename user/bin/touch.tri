// touch [-acm] [-r file | -d date | -t [[CC]YY]MMDDhhmm[.SS]] file ...:
// set files' access and modification times (now, unless given), making
// the files that do not exist (not with -c). -a and -m set only that time.
// A date is "@SECONDS[.FRACTION]" or "YYYY-MM-DD[ HH:MM[:SS]]" (UTC).

import "../lib/tlibc.tri";
import "../lib/getopt.tri";
import "../lib/time.tri";

fn usage() -> int {
    fputs(STDERR_FILENO, "usage: touch [-acm] [-r file | -d date | -t [[CC]YY]MMDDhhmm[.SS]] file ...\n");
    return 2;
}

fn bad_time(s: *char) -> int {
    fputs(STDERR_FILENO, "touch: invalid date: ");
    fputs(STDERR_FILENO, s);
    fputs(STDERR_FILENO, "\n");
    return 1;
}

fn two(s: *char) -> int { return (s[0] - '0') * 10 + s[1] - '0'; }

// -t [[CC]YY]MMDDhhmm[.SS] (UTC; YY 69..99 is 19YY, 00..68 is 20YY; no
// year: this year): 0 and ts, or -1
fn parse_stamp(s: *char, ts: *timespec) -> int {
    var n: int = 0;
    while (s[n] >= '0' && s[n] <= '9') { n += 1; }
    if (n != 8 && n != 10 && n != 12) { return -1; }
    var sec: int = 0;
    if (s[n] == '.') {
        if (s[n + 1] < '0' || s[n + 1] > '9' || s[n + 2] < '0' || s[n + 2] > '9' || s[n + 3] != 0) { return -1; }
        sec = two(s + n + 1);
        if (sec > 60) { return -1; }
    } else if (s[n] != 0) {
        return -1;
    }
    var now: tm;
    gmtime_r(time(null), &now);
    var y: int = now.tm_year + 1900;
    var at: int = 0;
    if (n == 12) { y = two(s) * 100 + two(s + 2); at = 4; }
    else if (n == 10) { var yy: int = two(s); y = yy >= 69 ? 1900 + yy : 2000 + yy; at = 2; }
    var mo: int = two(s + at);
    var d: int = two(s + at + 2);
    var h: int = two(s + at + 4);
    var mi: int = two(s + at + 6);
    if (mo < 1 || mo > 12 || d < 1 || d > days_in_month(mo - 1, y) || h > 23 || mi > 59) { return -1; }
    ts.tv_sec = ((time_days(y, mo, d) * 24 + h) * 60 + mi) * 60 + sec;
    ts.tv_nsec = 0;
    return 0;
}

fn main(argc: int, argv: **char) -> int {
    var only_a: int = 0;
    var only_m: int = 0;
    var no_create: int = 0;
    var times: [2]timespec;
    times[0].tv_sec = 0;
    times[0].tv_nsec = UTIME_NOW;
    times[1].tv_sec = 0;
    times[1].tv_nsec = UTIME_NOW;
    var c: int = getopt(argc, argv, "acmr:d:t:");
    while (c != -1) {
        if (c == 'a') { only_a = 1; }
        else if (c == 'm') { only_m = 1; }
        else if (c == 'c') { no_create = 1; }
        else if (c == 'r') {
            var st: stat_t;
            if (stat(optarg, &st) < 0) { perror2("touch", optarg); return 1; }
            times[0].tv_sec = st.st_atime;
            times[0].tv_nsec = 0;
            times[1].tv_sec = st.st_mtime;
            times[1].tv_nsec = 0;
        } else if (c == 'd') {
            if (parse_date(optarg, &times[0]) < 0) { return bad_time(optarg); }
            times[1].tv_sec = times[0].tv_sec;
            times[1].tv_nsec = times[0].tv_nsec;
        } else if (c == 't') {
            if (parse_stamp(optarg, &times[0]) < 0) { return bad_time(optarg); }
            times[1].tv_sec = times[0].tv_sec;
            times[1].tv_nsec = times[0].tv_nsec;
        } else {
            return usage();
        }
        c = getopt(argc, argv, "acmr:d:t:");
    }
    if (optind >= argc) { return usage(); }
    // -a alone leaves the modification time, -m alone the access time
    if (only_a && !only_m) { times[1].tv_nsec = UTIME_OMIT; }
    if (only_m && !only_a) { times[0].tv_nsec = UTIME_OMIT; }
    var status: int = 0;
    var i: int = optind;
    while (i < argc) {
        var st2: stat_t;
        if (stat(argv[i], &st2) < 0) {
            if (no_create) { i += 1; continue; }
            var fd: int = open(argv[i], O_WRONLY + O_CREAT, 438);
            if (fd < 0) { perror2("touch", argv[i]); status = 1; i += 1; continue; }
            close(fd);
        }
        if (utimensat(AT_FDCWD, argv[i], &times[0], 0) < 0) { perror2("touch", argv[i]); status = 1; }
        i += 1;
    }
    return status;
}
