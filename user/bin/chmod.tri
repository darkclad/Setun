// chmod mode file ...: set permissions (octal, or u/g/o/a [+-=] rwx).

import "../lib/tlibc.tri";

// The new mode from `spec`, or -1 if it is not a mode.
fn parse_mode(spec: *char, old: int) -> int {
    if (spec[0] >= '0' && spec[0] <= '7') {
        var v: int = 0;
        var k: int = 0;
        while (spec[k] >= '0' && spec[k] <= '7') { v = v * 8 + spec[k] - '0'; k += 1; }
        if (spec[k] != 0 || v > 4095) { return -1; }
        return v;
    }
    var mode: int = old;
    var i: int = 0;
    loop {
        var who: int = 0;
        while (spec[i] == 'u' || spec[i] == 'g' || spec[i] == 'o' || spec[i] == 'a') {
            if (spec[i] == 'u') { who = mask_or(who, 448); }
            if (spec[i] == 'g') { who = mask_or(who, 56); }
            if (spec[i] == 'o') { who = mask_or(who, 7); }
            if (spec[i] == 'a') { who = 511; }
            i += 1;
        }
        if (who == 0) { who = 511; }
        var op: char = spec[i];
        if (op != '+' && op != '-' && op != '=') { return -1; }
        i += 1;
        var bits: int = 0;
        while (spec[i] == 'r' || spec[i] == 'w' || spec[i] == 'x') {
            if (spec[i] == 'r') { bits = mask_or(bits, 292); }
            if (spec[i] == 'w') { bits = mask_or(bits, 146); }
            if (spec[i] == 'x') { bits = mask_or(bits, 73); }
            i += 1;
        }
        bits = mask_and(bits, who);
        if (op == '+') { mode = mask_or(mode, bits); }
        else if (op == '-') { mode = mask_clear(mode, bits); }
        else { mode = mask_or(mask_clear(mode, who), bits); }
        if (spec[i] == ',') { i += 1; continue; }
        if (spec[i] != 0) { return -1; }
        return mode;
    }
}

// Bitwise operations on permission sets. Trine's & and | are tritwise min
// and max, not binary AND and OR, so permission bits need these.
fn mask_and(a: int, b: int) -> int {
    var r: int = 0;
    var bit: int = 1;
    while (bit < 4096) { if (a / bit % 2 != 0 && b / bit % 2 != 0) { r += bit; } bit *= 2; }
    return r;
}

fn mask_or(a: int, b: int) -> int {
    var r: int = 0;
    var bit: int = 1;
    while (bit < 4096) { if (a / bit % 2 != 0 || b / bit % 2 != 0) { r += bit; } bit *= 2; }
    return r;
}

fn mask_clear(a: int, b: int) -> int {
    var r: int = 0;
    var bit: int = 1;
    while (bit < 4096) { if (a / bit % 2 != 0 && b / bit % 2 == 0) { r += bit; } bit *= 2; }
    return r;
}

fn main(argc: int, argv: **char) -> int {
    if (argc < 3) { fputs(STDERR_FILENO, "usage: chmod mode file ...\n"); return 1; }
    var status: int = 0;
    var i: int = 2;
    while (i < argc) {
        var st: stat_t;
        if (stat(argv[i], &st) < 0) { perror2("chmod", argv[i]); status = 1; i += 1; continue; }
        var mode: int = parse_mode(argv[1], st.st_mode % 4096);
        if (mode < 0) {
            fputs(STDERR_FILENO, "chmod: invalid mode: '");
            fputs(STDERR_FILENO, argv[1]);
            fputs(STDERR_FILENO, "'\n");
            return 1;
        }
        if (chmod(argv[i], mode) < 0) { perror2("chmod", argv[i]); status = 1; }
        i += 1;
    }
    return status;
}
