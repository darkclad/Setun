// /bin/sh: a POSIX-style shell with job control.
//
//   sh                     interactive on standard input (PS1, PS2 on a tty)
//   sh -c 'cmds' [name args]
//   sh script [args]
//
// Language: simple commands, pipelines (| !), lists (; & && || newline),
// if/elif/else, while, until, for, case, ( subshells ), { groups },
// functions (name() compound-command), here-documents (<< <<- with a quoted
// or unquoted delimiter),
// redirections (< > >> <& >& n>... on any command), quoting ('' "" \),
// parameters ($name ${name} ${name:-w} ${name-w} ${name:+w} ${name:=w}
// ${name:?w} ${#name} $? $$ $! $# $@ $* $- $0..$9), $(command substitution),
// $((arithmetic)), ~, field splitting and globbing (* ? [...]).
// Variables and export; prefix assignments (VAR=x cmd).
// Builtins: : true false echo cd pwd exit export unset set shift read
// test [ break continue jobs fg bg kill wait exec umask type eval . return
// local alias unalias history. At a terminal, lines are edited with the
// arrows, history and Tab completion (see "line editing").
//
// Function bodies, eval text and . files are lexed and parsed into the tail
// of src and the token and node arrays, run, and then that tail is dropped
// (eval_text), so a function is kept as its source text.

import "../lib/tlibc.tri";
import "../lib/string.tri";
import "../lib/ctype.tri";
import "../lib/stdlib.tri";
import "../lib/testexpr.tri";
import "../lib/fnmatch.tri";

// ---- tokens ---------------------------------------------------------------------------

const T_WORD: int = 0;
const T_NEWLINE: int = 1;
const T_SEMI: int = 2;
const T_AMP: int = 3;
const T_PIPE: int = 4;
const T_AND: int = 5;
const T_OR: int = 6;
const T_LPAREN: int = 7;
const T_RPAREN: int = 8;
const T_DSEMI: int = 9;
const T_REDIR: int = 10;
const T_EOF: int = 11;

const R_IN: int = 0;                  // n<file
const R_OUT: int = 1;                 // n>file
const R_APPEND: int = 2;              // n>>file
const R_DUPOUT: int = 3;              // n>&m
const R_DUPIN: int = 4;               // n<&m
const R_HEREDOC: int = 5;             // n<<word, n<<-word

const SRC_MAX: int = 19683;
const MAXTOK: int = 2187;
const MAXNODE: int = 2187;

var src: [19684]char;
var src_len: int;
var tkind: [2187]int;
var tstart: [2187]int;
var tend: [2187]int;
var tfd: [2187]int;
var tmode: [2187]int;
var hd_a: [2187]int;                  // a here-document's body: src[hd_a..hd_b)
var hd_b: [2187]int;
var hd_quoted: [2187]int;             // the delimiter was quoted: no expansion
var hd_strip: [2187]int;              // <<-: leading tabs go
var ntok: int;
var lex_incomplete: int;              // 1: inside a quote, 2: inside a here-document
var hd_pending: [27]int;              // here-document operators waiting for their body
var nhd_pending: int;

fn err(a: *char, b: *char) {
    fputs(STDERR_FILENO, "sh: ");
    fputs(STDERR_FILENO, a);
    if (b != null) { fputs(STDERR_FILENO, b); }
    fputs(STDERR_FILENO, "\n");
}

fn is_name_start(c: int) -> int { return isalpha(c) || c == '_'; }
fn is_name_char(c: int) -> int { return isalnum(c) || c == '_'; }

fn ends_word(c: char) -> int {
    return c == 0 || c == ' ' || c == '\t' || c == '\n' || c == ';' || c == '&' || c == '|' || c == '<' || c == '>' || c == '(' || c == ')';
}

// Scanners return the index after the construct, or -1 if the text ends first.
fn scan_squote(i: int) -> int {
    while (i < src_len && src[i] != '\'') { i += 1; }
    if (i >= src_len) { return -1; }
    return i + 1;
}

fn scan_dquote(i: int) -> int {
    while (i < src_len && src[i] != '"') {
        if (src[i] == '\\') { i += 2; continue; }
        if (src[i] == '$' && src[i + 1] == '(') { i = scan_paren(i + 2); if (i < 0) { return -1; } continue; }
        if (src[i] == '$' && src[i + 1] == '{') { i = scan_brace(i + 2); if (i < 0) { return -1; } continue; }
        i += 1;
    }
    if (i >= src_len) { return -1; }
    return i + 1;
}

fn scan_paren(i: int) -> int {
    var depth: int = 1;
    while (depth > 0) {
        if (i >= src_len) { return -1; }
        var c: char = src[i];
        if (c == '\\') { i += 2; continue; }
        if (c == '\'') { i = scan_squote(i + 1); if (i < 0) { return -1; } continue; }
        if (c == '"') { i = scan_dquote(i + 1); if (i < 0) { return -1; } continue; }
        if (c == '(') { depth += 1; }
        if (c == ')') { depth -= 1; }
        i += 1;
    }
    return i;
}

fn scan_brace(i: int) -> int {
    while (i < src_len && src[i] != '}') {
        if (src[i] == '\'') { i = scan_squote(i + 1); if (i < 0) { return -1; } continue; }
        if (src[i] == '"') { i = scan_dquote(i + 1); if (i < 0) { return -1; } continue; }
        if (src[i] == '\\') { i += 2; continue; }
        i += 1;
    }
    if (i >= src_len) { return -1; }
    return i + 1;
}

fn scan_word(i: int) -> int {
    while (i < src_len && !ends_word(src[i])) {
        var c: char = src[i];
        if (c == '\\') {
            if (i + 1 >= src_len) { return -1; }
            i += 2;
        } else if (c == '\'') {
            i = scan_squote(i + 1);
        } else if (c == '"') {
            i = scan_dquote(i + 1);
        } else if (c == '$' && src[i + 1] == '(') {
            i = scan_paren(i + 2);
        } else if (c == '$' && src[i + 1] == '{') {
            i = scan_brace(i + 2);
        } else {
            i += 1;
        }
        if (i < 0) { return -1; }
    }
    return i;
}

fn add_tok(kind: int, a: int, b: int) -> int {
    if (ntok >= MAXTOK - 1) { err("too many words", null); return 0; }
    tkind[ntok] = kind;
    tstart[ntok] = a;
    tend[ntok] = b;
    ntok += 1;
    return 1;
}

// The delimiter of the here-document operator at token r (the word after
// it) with its quotes removed, into d. 1 if any part of it was quoted.
fn hd_delim(r: int, d: *char) -> int {
    var w: int = r + 1;
    var quoted: int = 0;
    var k: int = 0;
    var i: int = tstart[w];
    while (i < tend[w] && k < 241) {
        var c: char = src[i];
        if (c == '\'' || c == '"') { quoted = 1; i += 1; continue; }
        if (c == '\\' && i + 1 < tend[w]) { quoted = 1; i += 1; c = src[i]; }
        d[k] = c;
        k += 1;
        i += 1;
    }
    d[k] = 0;
    return quoted;
}

// At the newline src[i], take the bodies of the pending here-documents, in
// order. Returns the index after the last delimiter line, or -1 if the text
// ends first.
fn read_heredocs(i: int) -> int {
    var pos: int = i + 1;
    var h: int = 0;
    while (h < nhd_pending) {
        var r: int = hd_pending[h];
        h += 1;
        if (tkind[r + 1] != T_WORD) { continue; }       // the parser reports it
        var d: [243]char;
        hd_quoted[r] = hd_delim(r, &d[0]);
        var dl: int = strlen(&d[0]);
        hd_a[r] = pos;
        loop {
            if (pos >= src_len) { return -1; }
            var ls: int = pos;
            var le: int = pos;
            while (le < src_len && src[le] != '\n') { le += 1; }
            var cs: int = ls;
            if (hd_strip[r]) { while (cs < le && src[cs] == '\t') { cs += 1; } }
            var same: int = le - cs == dl;
            var k: int = 0;
            while (same && k < dl) { if (src[cs + k] != d[k]) { same = 0; } k += 1; }
            if (same) {
                hd_b[r] = ls;
                pos = le < src_len ? le + 1 : le;
                break;
            }
            if (le >= src_len) { return -1; }
            pos = le + 1;
        }
    }
    return pos;
}

// Tokenize all of src.
fn lex() -> int {
    ntok = 0;
    return lex_range(0);
}

// Tokenize src[i..src_len), appending to the tokens. 0 = fine, 1 = the text
// ends inside a quote or a here-document (lex_incomplete says which), 2 =
// too long.
fn lex_range(i: int) -> int {
    lex_incomplete = 0;
    nhd_pending = 0;
    src[src_len] = 0;
    while (i < src_len) {
        var c: char = src[i];
        if (c == ' ' || c == '\t') { i += 1; continue; }
        if (c == '\\' && src[i + 1] == '\n') { i += 2; continue; }       // line continuation
        if (c == '#') {
            while (i < src_len && src[i] != '\n') { i += 1; }
            continue;
        }
        var a: int = i;
        if (c == '\n') {
            if (!add_tok(T_NEWLINE, a, a + 1)) { return 2; }
            i += 1;
            if (nhd_pending > 0) {
                i = read_heredocs(a);
                if (i < 0) { lex_incomplete = 2; return 1; }
                nhd_pending = 0;
            }
            continue;
        }
        if (c == ';') {
            if (src[i + 1] == ';') { add_tok(T_DSEMI, a, a + 2); i += 2; } else { add_tok(T_SEMI, a, a + 1); i += 1; }
            continue;
        }
        if (c == '&') {
            if (src[i + 1] == '&') { add_tok(T_AND, a, a + 2); i += 2; } else { add_tok(T_AMP, a, a + 1); i += 1; }
            continue;
        }
        if (c == '|') {
            if (src[i + 1] == '|') { add_tok(T_OR, a, a + 2); i += 2; } else { add_tok(T_PIPE, a, a + 1); i += 1; }
            continue;
        }
        if (c == '(') { add_tok(T_LPAREN, a, a + 1); i += 1; continue; }
        if (c == ')') { add_tok(T_RPAREN, a, a + 1); i += 1; continue; }
        if (c == '<' || c == '>' || (isdigit(c) && (src[i + 1] == '<' || src[i + 1] == '>'))) {
            var fd: int = -1;
            if (isdigit(c)) { fd = c - '0'; i += 1; }
            var mode: int;
            var strip: int = 0;
            if (src[i] == '<') {
                i += 1;
                mode = R_IN;
                if (src[i] == '&') { mode = R_DUPIN; i += 1; }
                else if (src[i] == '<') {
                    mode = R_HEREDOC;
                    i += 1;
                    if (src[i] == '-') { strip = 1; i += 1; }
                }
                if (fd < 0) { fd = 0; }
            } else {
                i += 1;
                mode = R_OUT;
                if (src[i] == '>') { mode = R_APPEND; i += 1; }
                else if (src[i] == '&') { mode = R_DUPOUT; i += 1; }
                else if (src[i] == '|') { i += 1; }
                if (fd < 0) { fd = 1; }
            }
            if (!add_tok(T_REDIR, a, i)) { return 2; }
            tfd[ntok - 1] = fd;
            tmode[ntok - 1] = mode;
            hd_strip[ntok - 1] = strip;
            if (mode == R_HEREDOC) {
                if (nhd_pending == 27) { err("too many here-documents on one line", null); return 2; }
                hd_pending[nhd_pending] = ntok - 1;
                nhd_pending += 1;
            }
            continue;
        }
        var e: int = scan_word(i);
        if (e < 0) { lex_incomplete = 1; return 1; }
        if (!add_tok(T_WORD, a, e)) { return 2; }
        i = e;
    }
    if (nhd_pending > 0) { lex_incomplete = 2; return 1; }
    if (!add_tok(T_EOF, src_len, src_len)) { return 2; }
    return 0;
}

fn lex_error_message() -> *char {
    return lex_incomplete == 2 ? "syntax error: unterminated here-document" : "syntax error: unterminated quote";
}

fn tok_is(t: int, s: *char) -> int {
    if (tkind[t] != T_WORD) { return 0; }
    var n: int = tend[t] - tstart[t];
    var k: int = 0;
    while (k < n) {
        if (src[tstart[t] + k] != s[k]) { return 0; }
        k += 1;
    }
    return s[n] == 0;
}

// ---- the syntax tree ----------------------------------------------------------------------

const N_CMD: int = 1;                 // a: first token, b: end token
const N_PIPELINE: int = 2;            // a: first element (linked by next), d: negated
const N_AND: int = 3;                 // a, b
const N_OR: int = 4;
const N_LIST: int = 5;                // a: first item (linked by next; bg flag on items)
const N_IF: int = 6;                  // a: condition, b: then, c: else (or -1)
const N_WHILE: int = 7;               // a: condition, b: body, d: 1 for until
const N_FOR: int = 8;                 // a: name token, b..c: word tokens (b = -1: "$@"), d: body
const N_CASE: int = 9;                // a: word token, b: first item
const N_CASEITEM: int = 10;           // a..b: pattern tokens ('|' between), c: body
const N_SUBSHELL: int = 11;           // a: list
const N_GROUP: int = 12;              // a: list
const N_FUNC: int = 13;               // a: name token, b: body (a compound command)

var nkind: [729]int;
var na: [729]int;
var nb: [729]int;
var nc: [729]int;
var nd: [729]int;
var nnext: [729]int;
var nbg: [729]int;
var nra: [729]int;                    // redirections after a compound command: tokens nra..nrb
var nrb: [729]int;
var nsa: [729]int;                    // source text span
var nsb: [729]int;
var nnodes: int;

var tp: int;                          // parser position
var parse_error: int;
var parse_incomplete: int;

fn new_node(kind: int, first_tok: int) -> int {
    if (nnodes >= MAXNODE) { err("program too large", null); parse_error = 1; return 0; }
    var n: int = nnodes;
    nnodes += 1;
    nkind[n] = kind;
    na[n] = -1;
    nb[n] = -1;
    nc[n] = -1;
    nd[n] = 0;
    nnext[n] = -1;
    nbg[n] = 0;
    nra[n] = 0;
    nrb[n] = 0;
    nsa[n] = tstart[first_tok];
    nsb[n] = tstart[first_tok];
    return n;
}

fn end_node(n: int) -> int {
    if (tp > 0) { nsb[n] = tend[tp - 1]; }
    return n;
}

fn syntax(t: int) -> int {
    if (parse_error) { return -1; }
    if (tkind[t] == T_EOF) {
        parse_incomplete = 1;
    } else {
        var b: [81]char;
        var n: int = tend[t] - tstart[t];
        if (n > 79) { n = 79; }
        var k: int = 0;
        while (k < n) { b[k] = src[tstart[t] + k]; k += 1; }
        b[n] = 0;
        if (tkind[t] == T_NEWLINE) { strcpy(&b[0], "newline"); }
        fputs(STDERR_FILENO, "sh: syntax error near unexpected token `");
        fputs(STDERR_FILENO, &b[0]);
        fputs(STDERR_FILENO, "'\n");
    }
    parse_error = 1;
    return -1;
}

fn skip_newlines() { while (tkind[tp] == T_NEWLINE) { tp += 1; } }

fn list_ends() -> int {
    var k: int = tkind[tp];
    if (k == T_EOF || k == T_RPAREN || k == T_DSEMI) { return 1; }
    return tok_is(tp, "then") || tok_is(tp, "else") || tok_is(tp, "elif") || tok_is(tp, "fi") || tok_is(tp, "do")
        || tok_is(tp, "done") || tok_is(tp, "esac") || tok_is(tp, "}");
}

fn expect_word(s: *char) -> int {
    if (!tok_is(tp, s)) { return syntax(tp); }
    tp += 1;
    return 0;
}

fn parse_list() -> int {
    var n: int = new_node(N_LIST, tp);
    var last: int = -1;
    skip_newlines();
    while (!list_ends()) {
        var item: int = parse_and_or();
        if (item < 0) { return -1; }
        if (last < 0) { na[n] = item; } else { nnext[last] = item; }
        last = item;
        var k: int = tkind[tp];
        if (k == T_SEMI || k == T_NEWLINE) { tp += 1; }
        else if (k == T_AMP) { nbg[item] = 1; tp += 1; }
        else { break; }
        skip_newlines();
    }
    return end_node(n);
}

fn parse_and_or() -> int {
    var left: int = parse_pipeline();
    if (left < 0) { return -1; }
    while (tkind[tp] == T_AND || tkind[tp] == T_OR) {
        var kind: int = tkind[tp] == T_AND ? N_AND : N_OR;
        var start: int = nsa[left];
        tp += 1;
        skip_newlines();
        var right: int = parse_pipeline();
        if (right < 0) { return -1; }
        var n: int = new_node(kind, tp);
        na[n] = left;
        nb[n] = right;
        nsa[n] = start;
        nsb[n] = nsb[right];
        left = n;
    }
    return left;
}

fn parse_pipeline() -> int {
    var n: int = new_node(N_PIPELINE, tp);
    if (tok_is(tp, "!")) { nd[n] = 1; tp += 1; }
    var first: int = parse_command();
    if (first < 0) { return -1; }
    na[n] = first;
    var last: int = first;
    while (tkind[tp] == T_PIPE) {
        tp += 1;
        skip_newlines();
        var e: int = parse_command();
        if (e < 0) { return -1; }
        nnext[last] = e;
        last = e;
    }
    return end_node(n);
}

// Redirections after a compound command.
fn parse_redirs(n: int) -> int {
    nra[n] = tp;
    while (tkind[tp] == T_REDIR) {
        if (tkind[tp + 1] != T_WORD) { return syntax(tp + 1); }
        tp += 2;
    }
    nrb[n] = tp;
    return end_node(n);
}

fn parse_command() -> int {
    if (tok_is(tp, "if")) { return parse_if(); }
    if (tok_is(tp, "while") || tok_is(tp, "until")) { return parse_while(); }
    if (tok_is(tp, "for")) { return parse_for(); }
    if (tok_is(tp, "case")) { return parse_case(); }
    if (tok_is(tp, "{")) {
        var g: int = new_node(N_GROUP, tp);
        tp += 1;
        na[g] = parse_list();
        if (na[g] < 0 || expect_word("}") < 0) { return -1; }
        return parse_redirs(g);
    }
    if (tkind[tp] == T_LPAREN) {
        var s: int = new_node(N_SUBSHELL, tp);
        tp += 1;
        na[s] = parse_list();
        if (na[s] < 0) { return -1; }
        if (tkind[tp] != T_RPAREN) { return syntax(tp); }
        tp += 1;
        return parse_redirs(s);
    }
    if (tkind[tp] == T_WORD && tkind[tp + 1] == T_LPAREN && tkind[tp + 2] == T_RPAREN) { return parse_funcdef(); }
    var n: int = new_node(N_CMD, tp);
    na[n] = tp;
    while (tkind[tp] == T_WORD || tkind[tp] == T_REDIR) {
        if (tkind[tp] == T_REDIR) {
            if (tkind[tp + 1] != T_WORD) { return syntax(tp + 1); }
            tp += 1;
        }
        tp += 1;
    }
    if (tp == na[n]) { return syntax(tp); }
    nb[n] = tp;
    return end_node(n);
}

// name ( ) [newlines] compound-command [redirections]
fn parse_funcdef() -> int {
    var n: int = new_node(N_FUNC, tp);
    na[n] = tp;
    tp += 3;
    skip_newlines();
    if (!(tok_is(tp, "{") || tkind[tp] == T_LPAREN || tok_is(tp, "if") || tok_is(tp, "while") || tok_is(tp, "until")
        || tok_is(tp, "for") || tok_is(tp, "case"))) {
        return syntax(tp);
    }
    nb[n] = parse_command();
    if (nb[n] < 0) { return -1; }
    return end_node(n);
}

fn parse_if() -> int {
    var n: int = new_node(N_IF, tp);
    tp += 1;                                            // if / elif
    na[n] = parse_list();
    if (na[n] < 0 || expect_word("then") < 0) { return -1; }
    nb[n] = parse_list();
    if (nb[n] < 0) { return -1; }
    if (tok_is(tp, "elif")) {
        nc[n] = parse_if();                             // consumes up to and including fi
        if (nc[n] < 0) { return -1; }
        return end_node(n);
    }
    if (tok_is(tp, "else")) {
        tp += 1;
        nc[n] = parse_list();
        if (nc[n] < 0) { return -1; }
    }
    if (expect_word("fi") < 0) { return -1; }
    return parse_redirs(n);
}

fn parse_while() -> int {
    var n: int = new_node(N_WHILE, tp);
    nd[n] = tok_is(tp, "until");
    tp += 1;
    na[n] = parse_list();
    if (na[n] < 0 || expect_word("do") < 0) { return -1; }
    nb[n] = parse_list();
    if (nb[n] < 0 || expect_word("done") < 0) { return -1; }
    return parse_redirs(n);
}

fn parse_for() -> int {
    var n: int = new_node(N_FOR, tp);
    tp += 1;
    if (tkind[tp] != T_WORD) { return syntax(tp); }
    na[n] = tp;
    tp += 1;
    skip_newlines();
    if (tok_is(tp, "in")) {
        tp += 1;
        nb[n] = tp;
        while (tkind[tp] == T_WORD) { tp += 1; }
        nc[n] = tp;
        if (tkind[tp] != T_SEMI && tkind[tp] != T_NEWLINE) { return syntax(tp); }
        tp += 1;
    } else if (tkind[tp] == T_SEMI) {
        tp += 1;
    }
    skip_newlines();
    if (expect_word("do") < 0) { return -1; }
    nd[n] = parse_list();
    if (nd[n] < 0 || expect_word("done") < 0) { return -1; }
    return parse_redirs(n);
}

fn parse_case() -> int {
    var n: int = new_node(N_CASE, tp);
    tp += 1;
    if (tkind[tp] != T_WORD) { return syntax(tp); }
    na[n] = tp;
    tp += 1;
    skip_newlines();
    if (expect_word("in") < 0) { return -1; }
    skip_newlines();
    var last: int = -1;
    while (!tok_is(tp, "esac")) {
        if (tkind[tp] == T_EOF) { return syntax(tp); }
        var it: int = new_node(N_CASEITEM, tp);
        if (tkind[tp] == T_LPAREN) { tp += 1; }
        na[it] = tp;
        loop {
            if (tkind[tp] != T_WORD) { return syntax(tp); }
            tp += 1;
            if (tkind[tp] == T_PIPE) { tp += 1; continue; }
            break;
        }
        nb[it] = tp;
        if (tkind[tp] != T_RPAREN) { return syntax(tp); }
        tp += 1;
        nc[it] = parse_list();
        if (nc[it] < 0) { return -1; }
        if (tkind[tp] == T_DSEMI) { tp += 1; }
        else if (!tok_is(tp, "esac")) { return syntax(tp); }
        skip_newlines();
        if (last < 0) { nb[n] = it; } else { nnext[last] = it; }
        last = it;
    }
    tp += 1;
    return parse_redirs(n);
}

// Parse the tokens: the program's list, or -1 (parse_incomplete says whether
// more input could finish it).
fn parse() -> int {
    nnodes = 0;
    return parse_from(0);
}

// Parse from token t, appending to the nodes.
fn parse_from(t: int) -> int {
    tp = t;
    parse_error = 0;
    parse_incomplete = 0;
    var n: int = parse_list();
    if (n < 0) { return -1; }
    if (tkind[tp] != T_EOF) { return syntax(tp); }
    return n;
}

// ---- variables ---------------------------------------------------------------------------------

const NVARS: int = 243;

var vname: [243]*char;
var vval: [243]*char;
var vexported: [243]int;
var nvars: int;

var pos_args: [81]*char;              // $1..
var npos: int;
var arg0: *char;

var last_status: int;
var last_bg: int;
var opt_errexit: int;
var opt_xtrace: int;
var in_condition: int;

fn var_find(name: *char) -> int {
    var i: int = 0;
    while (i < nvars) {
        if (vname[i] != null && streq(vname[i], name)) { return i; }
        i += 1;
    }
    return -1;
}

fn var_get(name: *char) -> *char {
    var i: int = var_find(name);
    return i < 0 ? null : vval[i];
}

fn is_exported(name: *char) -> int {
    var i: int = var_find(name);
    return i >= 0 && vexported[i];
}

fn valid_name(s: *char) -> int {
    if (!is_name_start(s[0])) { return 0; }
    var k: int = 1;
    while (s[k] != 0) { if (!is_name_char(s[k])) { return 0; } k += 1; }
    return 1;
}

fn var_set(name: *char, value: *char, export: int) -> int {
    var i: int = var_find(name);
    if (i < 0) {
        i = 0;
        while (i < nvars && vname[i] != null) { i += 1; }
        if (i == nvars) {
            if (nvars == NVARS) { err("too many variables", null); return -1; }
            nvars += 1;
        }
        vname[i] = strdup(name);
        vval[i] = null;
        vexported[i] = 0;
    }
    var v: *char = strdup(value);
    if (vval[i] != null) { free(vval[i] as *tryte); }
    vval[i] = v;
    if (export) { vexported[i] = 1; }
    return 0;
}

fn var_unset(name: *char) {
    var i: int = var_find(name);
    if (i < 0) { return; }
    free(vname[i] as *tryte);
    free(vval[i] as *tryte);
    vname[i] = null;
    vval[i] = null;
    vexported[i] = 0;
}

// ---- functions --------------------------------------------------------------------------------
//
// A function is kept as the source text of its body.

const NFUNCS: int = 81;
const FUNC_DEPTH_MAX: int = 81;

var fname: [81]*char;
var fbody: [81]*char;
var nfuncs: int;
var func_depth: int;                  // function calls running
var dot_depth: int;                   // . files running
var return_pending: int;              // `return` ran: unwind to the call

fn func_find(name: *char) -> int {
    var i: int = 0;
    while (i < nfuncs) {
        if (fname[i] != null && streq(fname[i], name)) { return i; }
        i += 1;
    }
    return -1;
}

// Define (or redefine) name with the body src[a..b).
fn func_set(name: *char, a: int, b: int) -> int {
    var i: int = func_find(name);
    if (i < 0) {
        i = 0;
        while (i < nfuncs && fname[i] != null) { i += 1; }
        if (i == nfuncs) {
            if (nfuncs == NFUNCS) { err("too many functions", null); return 1; }
            nfuncs += 1;
        }
        fname[i] = strdup(name);
        fbody[i] = null;
    }
    var text: *char = malloc(b - a + 1) as *char;
    if (text == null) { err("out of memory", null); return 1; }
    var k: int = 0;
    while (k < b - a) { text[k] = src[a + k]; k += 1; }
    text[k] = 0;
    if (fbody[i] != null) { free(fbody[i] as *tryte); }
    fbody[i] = text;
    return 0;
}

fn func_unset(name: *char) {
    var i: int = func_find(name);
    if (i < 0) { return; }
    free(fname[i] as *tryte);
    free(fbody[i] as *tryte);
    fname[i] = null;
    fbody[i] = null;
}

// ---- local variables ---------------------------------------------------------------------------
//
// `local name` in a function saves the variable on this stack; the call
// puts every variable saved since it started back when it returns. Scope
// is dynamic, as in dash: functions called from there see the local.

const LOCAL_MAX: int = 243;

var lname: [243]*char;
var lold: [243]*char;                 // null: it was unset
var lexported: [243]int;
var nlocal: int;
var local_base: int;                  // the running call's first entry

fn local_restore(base: int) {
    while (nlocal > base) {
        nlocal -= 1;
        if (lold[nlocal] == null) {
            var_unset(lname[nlocal]);
        } else {
            var_set(lname[nlocal], lold[nlocal], 0);
            vexported[var_find(lname[nlocal])] = lexported[nlocal];
            free(lold[nlocal] as *tryte);
        }
        free(lname[nlocal] as *tryte);
    }
}

// local name[=value] ...: without a value the variable keeps its value.
fn builtin_local(argc: int, argv: **char) -> int {
    if (func_depth == 0) { err("local: not in a function", null); return 1; }
    var status: int = 0;
    var k: int = 1;
    while (k < argc) {
        var a: *char = argv[k];
        k += 1;
        var name: [81]char;
        var n: int = 0;
        while (a[n] != 0 && a[n] != '=' && n < 80) { name[n] = a[n]; n += 1; }
        name[n] = 0;
        if (!valid_name(&name[0])) {
            fputs(STDERR_FILENO, "sh: local: `");
            fputs(STDERR_FILENO, a);
            fputs(STDERR_FILENO, "': not a valid identifier\n");
            status = 1;
            continue;
        }
        var seen: int = 0;
        var i: int = local_base;
        while (i < nlocal) { if (streq(lname[i], &name[0])) { seen = 1; } i += 1; }
        if (!seen) {
            if (nlocal == LOCAL_MAX) { err("local: too many local variables", null); status = 1; continue; }
            var old: *char = var_get(&name[0]);
            lname[nlocal] = strdup(&name[0]);
            lold[nlocal] = old == null ? null : strdup(old);
            lexported[nlocal] = is_exported(&name[0]);
            nlocal += 1;
        }
        if (a[n] == '=') { var_set(&name[0], &a[n + 1], 0); }
    }
    return status;
}

// ---- aliases -----------------------------------------------------------------------------------
//
// An alias is replaced when its command runs: an unquoted command word that
// names one is swapped for the value (and, while a value ends in a blank,
// the next word too) and the command is run again as text (run_alias). An
// alias being expanded is not expanded again inside itself.

const NALIASES: int = 81;

var aname: [81]*char;
var aval: [81]*char;
var aactive: [81]int;
var naliases: int;

fn is_alias_char(c: int) -> int {
    return isalnum(c) || c == '_' || c == '!' || c == '%' || c == ',' || c == '@' || c == '-' || c == '.';
}

fn alias_find(name: *char) -> int {
    var i: int = 0;
    while (i < naliases) {
        if (aname[i] != null && streq(aname[i], name)) { return i; }
        i += 1;
    }
    return -1;
}

// The alias that token t names as written (no quoting), or -1.
fn alias_of(t: int) -> int {
    if (naliases == 0 || tkind[t] != T_WORD) { return -1; }
    var len: int = tend[t] - tstart[t];
    if (len > 80) { return -1; }
    var name: [81]char;
    var k: int = 0;
    while (k < len) {
        var c: char = src[tstart[t] + k];
        if (!is_alias_char(c)) { return -1; }
        name[k] = c;
        k += 1;
    }
    name[k] = 0;
    var i: int = alias_find(&name[0]);
    if (i < 0 || aactive[i]) { return -1; }
    return i;
}

fn alias_set(name: *char, value: *char) -> int {
    var i: int = alias_find(name);
    if (i < 0) {
        i = 0;
        while (i < naliases && aname[i] != null) { i += 1; }
        if (i == naliases) {
            if (naliases == NALIASES) { err("too many aliases", null); return 1; }
            naliases += 1;
        }
        aname[i] = strdup(name);
        aval[i] = null;
        aactive[i] = 0;
    }
    if (aval[i] != null) { free(aval[i] as *tryte); }
    aval[i] = strdup(value);
    return 0;
}

fn alias_unset(i: int) {
    free(aname[i] as *tryte);
    free(aval[i] as *tryte);
    aname[i] = null;
    aval[i] = null;
}

// alias name='value' with the value in single quotes (' as '\'').
fn alias_print(i: int) {
    puts("alias ");
    puts(aname[i]);
    puts("='");
    var v: *char = aval[i];
    var k: int = 0;
    while (v[k] != 0) {
        if (v[k] == '\'') { puts("'\\''"); }
        else { var c: [2]char; c[0] = v[k]; c[1] = 0; puts(&c[0]); }
        k += 1;
    }
    puts("'\n");
}

fn builtin_alias(argc: int, argv: **char) -> int {
    if (argc == 1) {
        var i: int = 0;
        while (i < naliases) { if (aname[i] != null) { alias_print(i); } i += 1; }
        return 0;
    }
    var status: int = 0;
    var k: int = 1;
    while (k < argc) {
        var a: *char = argv[k];
        k += 1;
        var name: [81]char;
        var n: int = 0;
        while (a[n] != 0 && a[n] != '=' && n < 80) { name[n] = a[n]; n += 1; }
        name[n] = 0;
        var ok: int = n > 0 && (a[n] == 0 || a[n] == '=');
        var j: int = 0;
        while (j < n) { if (!is_alias_char(name[j])) { ok = 0; } j += 1; }
        if (!ok) {
            fputs(STDERR_FILENO, "sh: alias: `");
            fputs(STDERR_FILENO, a);
            fputs(STDERR_FILENO, "': invalid alias name\n");
            status = 1;
        } else if (a[n] == '=') {
            if (alias_set(&name[0], &a[n + 1]) != 0) { status = 1; }
        } else {
            var i2: int = alias_find(&name[0]);
            if (i2 < 0) {
                fputs(STDERR_FILENO, "sh: alias: ");
                fputs(STDERR_FILENO, a);
                fputs(STDERR_FILENO, ": not found\n");
                status = 1;
            }
            else { alias_print(i2); }
        }
    }
    return status;
}

fn builtin_unalias(argc: int, argv: **char) -> int {
    if (argc < 2) { err("unalias: usage: unalias [-a] name ...", null); return 2; }
    if (streq(argv[1], "-a")) {
        var i: int = 0;
        while (i < naliases) { if (aname[i] != null) { alias_unset(i); } i += 1; }
        return 0;
    }
    var status: int = 0;
    var k: int = 1;
    while (k < argc) {
        var i2: int = alias_find(argv[k]);
        if (i2 < 0) {
            fputs(STDERR_FILENO, "sh: unalias: ");
            fputs(STDERR_FILENO, argv[k]);
            fputs(STDERR_FILENO, ": not found\n");
            status = 1;
        } else {
            alias_unset(i2);
        }
        k += 1;
    }
    return status;
}

fn append(dst: *char, len: int, s: *char, n: int) -> int {
    var k: int = 0;
    while (k < n) { dst[len + k] = s[k]; k += 1; }
    return len + n;
}

// Run simple command n with the alias al standing for its command word fw.
fn run_alias(n: int, fw: int, al: int) -> int {
    var a: int = na[n];
    var b: int = nb[n];
    // the chain of replaced words: a value ending in a blank expands the next
    var ctok: [27]int;
    var cal: [27]int;
    var nc: int = 0;
    var t: int = fw;
    var cur: int = al;
    var size: int = tend[b - 1] - tstart[a] + 3;
    loop {
        ctok[nc] = t;
        cal[nc] = cur;
        nc += 1;
        var v: *char = aval[cur];
        var vl: int = strlen(v);
        size += vl;
        if (vl == 0 || (v[vl - 1] != ' ' && v[vl - 1] != '\t') || t + 1 >= b || nc == 27) { break; }
        var nxt: int = alias_of(t + 1);
        var dup: int = 0;
        var j: int = 0;
        while (j < nc) { if (cal[j] == nxt) { dup = 1; } j += 1; }
        if (nxt < 0 || dup) { break; }
        t += 1;
        cur = nxt;
    }
    // here-document bodies are re-attached after the command
    t = a;
    while (t < b) {
        if (tkind[t] == T_REDIR && tmode[t] == R_HEREDOC) { size += hd_b[t] - hd_a[t] + 245; }
        t += 1;
    }
    var text: *char = malloc(size) as *char;
    if (text == null) { err("out of memory", null); return 1; }
    var len: int = append(text, 0, &src[tstart[a]], tstart[fw] - tstart[a]);
    var i: int = 0;
    while (i < nc) { len = append(text, len, aval[cal[i]], strlen(aval[cal[i]])); i += 1; }
    var last: int = ctok[nc - 1];
    len = append(text, len, &src[tend[last]], tend[b - 1] - tend[last]);
    var nl: int = 0;
    t = a;
    while (t < b) {
        if (tkind[t] == T_REDIR && tmode[t] == R_HEREDOC) {
            if (!nl) { text[len] = '\n'; len += 1; nl = 1; }
            len = append(text, len, &src[hd_a[t]], hd_b[t] - hd_a[t]);
            var d: [243]char;
            hd_delim(t, &d[0]);
            len = append(text, len, &d[0], strlen(&d[0]));
            text[len] = '\n';
            len += 1;
        }
        t += 1;
    }
    i = 0;
    while (i < nc) { aactive[cal[i]] = 1; i += 1; }
    var status: int = eval_text(text, len);
    i = 0;
    while (i < nc) { aactive[cal[i]] = 0; i += 1; }
    free(text as *tryte);
    return status;
}

fn import_environ() {
    if (environ == null) { return; }
    var i: int = 0;
    while (environ[i] != null) {
        var e: *char = environ[i];
        var name: [81]char;
        var k: int = 0;
        while (e[k] != 0 && e[k] != '=' && k < 80) { name[k] = e[k]; k += 1; }
        name[k] = 0;
        if (e[k] == '=' && valid_name(&name[0])) { var_set(&name[0], &e[k + 1], 1); }
        i += 1;
    }
}

// The exported variables as an envp vector (malloc'd; used right before exec).
fn build_envp() -> **char {
    var n: int = 0;
    var i: int = 0;
    while (i < nvars) { if (vname[i] != null && vexported[i]) { n += 1; } i += 1; }
    var v: **char = malloc(3 * (n + 1)) as **char;
    var k: int = 0;
    i = 0;
    while (i < nvars) {
        if (vname[i] != null && vexported[i]) {
            var nl: int = strlen(vname[i]);
            var e: *char = malloc(nl + strlen(vval[i]) + 2) as *char;
            strcpy(e, vname[i]);
            e[nl] = '=';
            strcpy(&e[nl + 1], vval[i]);
            v[k] = e;
            k += 1;
        }
        i += 1;
    }
    v[k] = null;
    return v;
}

// ---- expansion ------------------------------------------------------------------------------------
//
// Words expand into fields in the pool `ex`, pointed to by `fields`; both
// grow like stacks, and every consumer puts them back.

var ex: [19683]char;
var exp: int;
var fields: [729]*char;
var nfields: int;
var fstart: int;                      // where the field being built starts in ex
var fstarted: int;                    // the field exists even if empty ("")
var fglob: int;                       // it has unquoted glob characters
var fsuppress: int;                   // "$@" with no parameters: no field
var split_mode: int;                  // field splitting and globbing on
var expand_error: int;
var in_heredoc: int;                  // expanding a here-document body: \" stays as is

fn put(c: char) {
    if (exp < SRC_MAX - 2) { ex[exp] = c; exp += 1; }
    else if (!expand_error) { err("expansion too long", null); expand_error = 1; }
}

fn put_str(s: *char, quoted: int) {
    var k: int = 0;
    while (s[k] != 0) {
        var c: char = s[k];
        if (!quoted && split_mode && (c == ' ' || c == '\t' || c == '\n')) {
            if (fstarted) { finish_field(); }
        } else {
            put(c);
            fstarted = 1;
        }
        k += 1;
    }
}

fn push_field(p: *char) {
    if (nfields < 728) { fields[nfields] = p; nfields += 1; }
    else if (!expand_error) { err("too many words", null); expand_error = 1; }
}

fn finish_field() {
    if (!fstarted || (fsuppress && exp == fstart)) {
        exp = fstart;
        fstarted = 0;
        fglob = 0;
        fsuppress = 0;
        return;
    }
    put(0);
    var p: *char = &ex[fstart];
    if (fglob && split_mode) {
        var before: int = nfields;
        glob_into(p);
        if (nfields == before) { push_field(p); }
    } else {
        push_field(p);
    }
    fstart = exp;
    fstarted = 0;
    fglob = 0;
    fsuppress = 0;
}

fn special_var(c: char, buf: *char) -> *char {
    switch (c) {
        case '?': return itoa(last_status, buf);
        case '$': return itoa(getpid(), buf);
        case '!': return itoa(last_bg, buf);
        case '#': return itoa(npos, buf);
        case '-': {
            var k: int = 0;
            if (opt_errexit) { buf[k] = 'e'; k += 1; }
            if (opt_xtrace) { buf[k] = 'x'; k += 1; }
            buf[k] = 0;
            return buf;
        }
        case '0': return arg0;
    }
    if (c >= '1' && c <= '9') { return c - '0' <= npos ? pos_args[c - '1'] : ""; }
    return "";
}

// $@ and $*: quoted "$@" gives one field per parameter.
fn put_params(quoted: int, at: int) {
    if (npos == 0 && quoted && at) { fsuppress = 1; return; }
    var k: int = 0;
    while (k < npos) {
        if (k > 0) {
            if (quoted && at) { finish_field(); fstarted = 1; }
            else if (quoted) { put(' '); }
            else { if (fstarted) { finish_field(); } }
        }
        put_str(pos_args[k], quoted);
        if (quoted) { fstarted = 1; }
        k += 1;
    }
}

// Expand src[a..b) as one string, appended at ex[exp] (no splitting).
fn expand_quoted_into(a: int, b: int) -> int {
    var m: int = exp;
    var save_split: int = split_mode;
    var save_fs: int = fstart;
    var save_started: int = fstarted;
    var save_glob: int = fglob;
    split_mode = 0;
    fstart = exp;
    expand_span(a, b, 1);
    put(0);
    split_mode = save_split;
    fstart = save_fs;
    fstarted = save_started;
    fglob = save_glob;
    return m;
}

// A ${...} expression in src[a..b) (without the braces).
fn expand_braced(a: int, b: int, quoted: int) {
    var name: [81]char;
    var buf: [15]char;
    var length: int = 0;
    var i: int = a;
    if (src[i] == '#' && i + 1 < b) { length = 1; i += 1; }
    var k: int = 0;
    if (i >= b) { err("bad substitution", null); expand_error = 1; return; }
    var c0: char = src[i];
    if (is_name_start(c0)) {
        while (i < b && is_name_char(src[i]) && k < 80) { name[k] = src[i]; k += 1; i += 1; }
    } else if (isdigit(c0)) {
        while (i < b && isdigit(src[i]) && k < 80) { name[k] = src[i]; k += 1; i += 1; }
    } else if (c0 == '?' || c0 == '#' || c0 == '$' || c0 == '!' || c0 == '@' || c0 == '*' || c0 == '-') {
        name[0] = c0;
        k = 1;
        i += 1;
    } else {
        err("bad substitution", null);
        expand_error = 1;
        return;
    }
    name[k] = 0;
    var val: *char = null;
    if (is_name_start(name[0])) {
        val = var_get(&name[0]);
    } else if (isdigit(name[0])) {
        var n: int = atoi(&name[0]);
        val = n == 0 ? arg0 : (n <= npos ? pos_args[n - 1] : null);
    } else {
        if ((name[0] == '@' || name[0] == '*') && !length && i == b) { put_params(quoted, name[0] == '@'); return; }
        if ((name[0] == '@' || name[0] == '*') && length) { put_str(itoa(npos, &buf[0]), 1); fstarted = 1; return; }
        val = special_var(name[0], &buf[0]);
    }
    if (length) {
        if (i != b) { err("bad substitution", null); expand_error = 1; return; }
        put_str(itoa(val == null ? 0 : strlen(val), &buf[0]), 1);
        fstarted = 1;
        return;
    }
    if (i == b) {
        if (val != null) { put_str(val, quoted); }
        if (quoted) { fstarted = 1; }
        return;
    }
    var colon: int = 0;
    if (src[i] == ':') { colon = 1; i += 1; }
    var op: char = src[i];
    i += 1;
    var unset: int = val == null || (colon && val[0] == 0);
    if (op == '-') {
        if (unset) { expand_span(i, b, quoted); } else { put_str(val, quoted); }
    } else if (op == '=') {
        if (unset) {
            if (!is_name_start(name[0])) { err(&name[0], ": cannot assign in this way"); expand_error = 1; return; }
            var m: int = expand_quoted_into(i, b);
            var_set(&name[0], &ex[m], 0);
            exp = m;
            put_str(var_get(&name[0]), quoted);
        } else {
            put_str(val, quoted);
        }
    } else if (op == '+') {
        if (!unset) { expand_span(i, b, quoted); }
    } else if (op == '?') {
        if (unset) {
            var m2: int = expand_quoted_into(i, b);
            fputs(STDERR_FILENO, "sh: ");
            fputs(STDERR_FILENO, &name[0]);
            fputs(STDERR_FILENO, ": ");
            fputs(STDERR_FILENO, ex[m2] != 0 ? &ex[m2] : "parameter null or not set");
            fputs(STDERR_FILENO, "\n");
            exp = m2;
            expand_error = 1;
            if (!interactive) { _exit(1); }
        } else {
            put_str(val, quoted);
        }
    } else {
        err("bad substitution", null);
        expand_error = 1;
        return;
    }
    if (quoted) { fstarted = 1; }
}

// $... at src[i]. Returns the index after it.
fn expand_dollar(i: int, quoted: int) -> int {
    var c: char = src[i + 1];
    var buf: [15]char;
    if (c == '(' && src[i + 2] == '(') {
        var e: int = scan_paren(i + 2);                 // just past the closing ))
        if (e < 0 || src[e - 1] != ')' || src[e - 2] != ')') { err("bad arithmetic", null); expand_error = 1; return src_len; }
        var v: int = arith_span(i + 3, e - 2);
        put_str(itoa(v, &buf[0]), 1);
        fstarted = 1;
        return e;
    }
    if (c == '(') {
        var e2: int = scan_paren(i + 2);
        if (e2 < 0) { return src_len; }
        command_substitution(i + 2, e2 - 1, quoted);
        return e2;
    }
    if (c == '{') {
        var e3: int = scan_brace(i + 2);
        if (e3 < 0) { return src_len; }
        expand_braced(i + 2, e3 - 1, quoted);
        return e3;
    }
    if (c == '@' || c == '*') { put_params(quoted, c == '@'); return i + 2; }
    if (c == '?' || c == '$' || c == '!' || c == '#' || c == '-' || isdigit(c)) {
        put_str(special_var(c, &buf[0]), quoted);
        if (quoted) { fstarted = 1; }
        return i + 2;
    }
    if (is_name_start(c)) {
        var name: [81]char;
        var k: int = 0;
        var j: int = i + 1;
        while (is_name_char(src[j]) && k < 80) { name[k] = src[j]; k += 1; j += 1; }
        name[k] = 0;
        var v: *char = var_get(&name[0]);
        if (v != null) { put_str(v, quoted); }
        if (quoted) { fstarted = 1; }
        return j;
    }
    put('$');
    fstarted = 1;
    return i + 1;
}

// Expand src[a..b) into the current field (quoted: no splitting).
fn expand_span(a: int, b: int, quoted: int) {
    var i: int = a;
    while (i < b && !expand_error) {
        var c: char = src[i];
        if (c == '\\') {
            if (quoted) {
                var n: char = src[i + 1];
                if (n == '$' || (n == '"' && !in_heredoc) || n == '\\' || n == '`') { put(n); i += 2; }
                else if (n == '\n') { i += 2; }
                else { put('\\'); i += 1; }
            } else {
                if (i + 1 < b) { put(src[i + 1]); }
                i += 2;
            }
            fstarted = 1;
        } else if (c == '\'' && !quoted) {
            i += 1;
            while (i < b && src[i] != '\'') { put(src[i]); i += 1; }
            i += 1;
            fstarted = 1;
        } else if (c == '"' && !quoted) {
            var e: int = scan_dquote(i + 1);
            if (e < 0) { e = b + 1; }
            expand_span(i + 1, e - 1, 1);
            fstarted = 1;
            i = e;
        } else if (c == '$') {
            i = expand_dollar(i, quoted);
        } else if (c == '~' && !quoted && i == a && (i + 1 == b || src[i + 1] == '/')) {
            var h: *char = var_get("HOME");
            put_str(h == null ? "/" : h, 1);
            fstarted = 1;
            i += 1;
        } else {
            if (!quoted && (c == '*' || c == '?' || c == '[')) { fglob = 1; }
            put(c);
            fstarted = 1;
            i += 1;
        }
    }
}

// Expand token t into fields (split = field splitting and globbing).
fn expand_word(t: int, split: int) {
    split_mode = split;
    fstart = exp;
    fstarted = 0;
    fglob = 0;
    fsuppress = 0;
    expand_span(tstart[t], tend[t], 0);
    finish_field();
}

// One string for token t from src index `from`, no splitting (assignments,
// redirection targets, case words and patterns).
fn expand_one(t: int, from: int) -> *char {
    split_mode = 0;
    fstart = exp;
    fstarted = 1;
    fglob = 0;
    fsuppress = 0;
    var m: int = exp;
    expand_span(from, tend[t], 0);
    put(0);
    fstart = exp;
    return &ex[m];
}

// ---- globbing ---------------------------------------------------------------------------------------

fn cmp_fields(a: int, b: int) -> int { return strcmp(a as *char, b as *char); }

// Matches of pattern p (a wildcard in the last component only), sorted.
fn glob_into(p: *char) {
    var slash: int = -1;
    var k: int = 0;
    while (p[k] != 0) { if (p[k] == '/') { slash = k; } k += 1; }
    var dir: [243]char;
    var pat: *char = p;
    if (slash >= 0) {
        k = 0;
        while (k < slash && k < 242) { dir[k] = p[k]; k += 1; }
        dir[k] = 0;
        if (slash == 0) { strcpy(&dir[0], "/"); }
        pat = &p[slash + 1];
    } else {
        strcpy(&dir[0], ".");
    }
    var d: *DIR = opendir(&dir[0]);
    if (d == null) { return; }
    var first: int = nfields;
    loop {
        var e: *dirent = readdir(d);
        if (e == null) { break; }
        if (e.d_name[0] == '.' && pat[0] != '.') { continue; }
        if (!fnmatch(pat, &e.d_name[0])) { continue; }
        var start: int = exp;
        if (slash >= 0) {
            var j: int = 0;
            while (j <= slash) { put(p[j]); j += 1; }
        }
        var m: int = 0;
        while (e.d_name[m] != 0) { put(e.d_name[m]); m += 1; }
        put(0);
        push_field(&ex[start]);
    }
    closedir(d);
    qsort((&fields[first]) as *int, nfields - first, &cmp_fields);
}

// ---- arithmetic -----------------------------------------------------------------------------------------
//
// $(( )): + - * / % ( ), unary - + !, comparisons, == !=, && ||, names.

var ar: *char;
var ar_pos: int;
var ar_error: int;

fn ar_fail(msg: *char) -> int {
    if (!ar_error) { err("arithmetic: ", msg); }
    ar_error = 1;
    return 0;
}

fn ar_space() { while (ar[ar_pos] == ' ' || ar[ar_pos] == '\t' || ar[ar_pos] == '\n') { ar_pos += 1; } }

fn ar_primary() -> int {
    ar_space();
    var c: char = ar[ar_pos];
    if (c == '(') {
        ar_pos += 1;
        var v: int = ar_or();
        ar_space();
        if (ar[ar_pos] != ')') { return ar_fail("missing )"); }
        ar_pos += 1;
        return v;
    }
    if (c == '-') { ar_pos += 1; return -ar_primary(); }
    if (c == '+') { ar_pos += 1; return ar_primary(); }
    if (c == '!') { ar_pos += 1; return !ar_primary(); }
    if (isdigit(c)) {
        var v2: int = 0;
        while (isdigit(ar[ar_pos])) { v2 = v2 * 10 + ar[ar_pos] - '0'; ar_pos += 1; }
        return v2;
    }
    if (is_name_start(c)) {
        var name: [81]char;
        var k: int = 0;
        while (is_name_char(ar[ar_pos]) && k < 80) { name[k] = ar[ar_pos]; k += 1; ar_pos += 1; }
        name[k] = 0;
        var s: *char = var_get(&name[0]);
        if (s == null || s[0] == 0) { return 0; }
        var end: *char;
        var v3: int = strtol(s, &end, 10);
        if (end[0] != 0) { return ar_fail("not a number"); }
        return v3;
    }
    return ar_fail("syntax error");
}

fn ar_mul() -> int {
    var v: int = ar_primary();
    loop {
        ar_space();
        var c: char = ar[ar_pos];
        if (c != '*' && c != '/' && c != '%') { return v; }
        ar_pos += 1;
        var w: int = ar_primary();
        if (c == '*') { v = v * w; }
        else if (w == 0) { return ar_fail("division by zero"); }
        else if (c == '/') { v = v / w; }
        else { v = v % w; }
    }
}

fn ar_add() -> int {
    var v: int = ar_mul();
    loop {
        ar_space();
        var c: char = ar[ar_pos];
        if (c != '+' && c != '-') { return v; }
        ar_pos += 1;
        var w: int = ar_mul();
        v = c == '+' ? v + w : v - w;
    }
}

fn ar_cmp() -> int {
    var v: int = ar_add();
    loop {
        ar_space();
        var c: char = ar[ar_pos];
        var d: char = ar[ar_pos + 1];
        if (c == '<' && d == '=') { ar_pos += 2; v = v <= ar_add(); }
        else if (c == '>' && d == '=') { ar_pos += 2; v = v >= ar_add(); }
        else if (c == '<') { ar_pos += 1; v = v < ar_add(); }
        else if (c == '>') { ar_pos += 1; v = v > ar_add(); }
        else if (c == '=' && d == '=') { ar_pos += 2; v = v == ar_add(); }
        else if (c == '!' && d == '=') { ar_pos += 2; v = v != ar_add(); }
        else { return v; }
    }
}

fn ar_and() -> int {
    var v: int = ar_cmp();
    loop {
        ar_space();
        if (ar[ar_pos] != '&' || ar[ar_pos + 1] != '&') { return v; }
        ar_pos += 2;
        var w: int = ar_cmp();
        v = v && w;
    }
}

fn ar_or() -> int {
    var v: int = ar_and();
    loop {
        ar_space();
        if (ar[ar_pos] != '|' || ar[ar_pos + 1] != '|') { return v; }
        ar_pos += 2;
        var w: int = ar_and();
        v = v || w;
    }
}

fn arith_span(a: int, b: int) -> int {
    var m: int = expand_quoted_into(a, b);              // $ inside first, then evaluate
    ar = &ex[m];
    ar_pos = 0;
    ar_error = 0;
    var v: int = ar_or();
    ar_space();
    if (!ar_error && ar[ar_pos] != 0) { ar_fail("syntax error"); }
    if (ar_error) { expand_error = 1; }
    exp = m;
    return v;
}

// ---- command substitution -----------------------------------------------------------------------------

var job_control: int;
var interactive: int;

fn command_substitution(a: int, b: int, quoted: int) {
    var p: [2]int;
    if (pipe(&p[0]) < 0) { err("pipe failed", null); expand_error = 1; return; }
    var pid: int = fork();
    if (pid < 0) { err("fork failed", null); expand_error = 1; return; }
    if (pid == 0) {
        close(p[0]);
        dup2(p[1], 1);
        close(p[1]);
        job_control = 0;
        interactive = 0;
        in_heredoc = 0;
        var n: int = b - a;
        memmove(&src[0] as *tryte, &src[a] as *tryte, n);
        src_len = n;
        exp = 0;
        nfields = 0;
        _exit(run_source());
    }
    close(p[1]);
    var start: int = exp;
    var buf: [729]char;
    loop {
        var r: int = read(p[0], &buf[0], 729);
        if (r < 0 && errno == EINTR) { continue; }
        if (r <= 0) { break; }
        var k: int = 0;
        while (k < r) { if (exp < SRC_MAX - 2) { ex[exp] = buf[k]; exp += 1; } k += 1; }
    }
    close(p[0]);
    var st: int = 0;
    while (waitpid(pid, &st, 0) < 0 && errno == EINTR) {}
    last_status = status_of(st);
    while (exp > start && ex[exp - 1] == '\n') { exp -= 1; }       // trailing newlines go
    // Re-insert the output as text, splitting it when unquoted.
    var len: int = exp - start;
    var tmp: *char = malloc(len + 1) as *char;
    if (tmp == null) { expand_error = 1; return; }
    var j: int = 0;
    while (j < len) { tmp[j] = ex[start + j]; j += 1; }
    tmp[len] = 0;
    exp = start;
    put_str(tmp, quoted);
    if (quoted) { fstarted = 1; }
    free(tmp as *tryte);
}

// ---- jobs ------------------------------------------------------------------------------------------------

const MAX_JOBS: int = 9;
var shell_pgid: int;

struct Job {
    used: int;
    pgid: int;
    npids: int;
    pids: [27]int;                    // 0 once reaped
    alive: int;
    stopped: int;
    stop_sig: int;
    status: int;                      // wait status of the last process
    cmd: [81]char;
}

var jobs: [9]Job;

fn status_of(st: int) -> int {
    if (WIFEXITED(st)) { return WEXITSTATUS(st); }
    if (WIFSTOPPED(st)) { return 128 + WSTOPSIG(st); }
    return 128 + WTERMSIG(st);
}

fn new_job(node: int) -> int {
    var j: int = 0;
    while (j < MAX_JOBS) {
        if (!jobs[j].used) {
            var jb: *Job = &jobs[j];
            jb.used = 1;
            jb.pgid = 0;
            jb.npids = 0;
            jb.alive = 0;
            jb.stopped = 0;
            jb.status = 0;
            var n: int = 0;
            var k: int = nsa[node];
            while (k < nsb[node] && n < 80) { jb.cmd[n] = src[k] == '\n' ? ' ' : src[k]; n += 1; k += 1; }
            jb.cmd[n] = 0;
            return j;
        }
        j += 1;
    }
    return -1;
}

fn put_job_line(j: int, state: *char, amp: int) {
    puts("[");
    put_int(j + 1);
    puts("]  ");
    puts(state);
    var n: int = strlen(state);
    while (n < 24) { puts(" "); n += 1; }
    puts(&jobs[j].cmd[0]);
    if (amp) { puts(" &"); }
    puts("\n");
}

fn job_update(pid: int, st: int) -> int {
    var j: int = 0;
    while (j < MAX_JOBS) {
        if (jobs[j].used) {
            var jb: *Job = &jobs[j];
            var i: int = 0;
            while (i < jb.npids) {
                if (jb.pids[i] == pid) {
                    if (WIFSTOPPED(st)) {
                        jb.stopped = 1;
                        jb.stop_sig = WSTOPSIG(st);
                    } else {
                        jb.pids[i] = 0;
                        jb.alive -= 1;
                        if (i == jb.npids - 1) { jb.status = st; }
                    }
                    return j;
                }
                i += 1;
            }
        }
        j += 1;
    }
    return -1;
}

fn add_pid(j: int, pid: int) {
    var jb: *Job = &jobs[j];
    if (jb.npids < 27) {
        jb.pids[jb.npids] = pid;
        jb.npids += 1;
        jb.alive += 1;
    }
}

fn wait_fg(j: int) -> int {
    var jb: *Job = &jobs[j];
    var i: int = 0;
    while (i < jb.npids && !jb.stopped) {
        var pid: int = jb.pids[i];
        if (pid == 0) { i += 1; continue; }
        var st: int = 0;
        var r: int = waitpid(pid, &st, job_control ? WUNTRACED : 0);
        if (r < 0) {
            if (errno == EINTR) { continue; }
            jb.pids[i] = 0;
            jb.alive -= 1;
            i += 1;
            continue;
        }
        job_update(pid, st);
        if (!jb.stopped) { i += 1; }
    }
    if (job_control) { tcsetpgrp(STDIN_FILENO, shell_pgid); }
    if (jb.stopped) {
        puts("\n");
        put_job_line(j, "Stopped", 0);
        return 128 + jb.stop_sig;
    }
    var st: int = jb.status;
    jb.used = 0;
    if (WIFSIGNALED(st)) {
        if (WTERMSIG(st) == SIGINT) { if (interactive) { puts("\n"); } }
        else if (WTERMSIG(st) != SIGPIPE) { fputs(STDERR_FILENO, strsignal(WTERMSIG(st))); fputs(STDERR_FILENO, "\n"); }
    }
    return status_of(st);
}

fn reap_jobs() {
    loop {
        var st: int = 0;
        var pid: int = waitpid(-1, &st, WNOHANG + (job_control ? WUNTRACED : 0));
        if (pid <= 0) { break; }
        var j: int = job_update(pid, st);
        if (j >= 0 && WIFSTOPPED(st) && interactive) { put_job_line(j, "Stopped", 0); }
    }
    var j: int = 0;
    while (j < MAX_JOBS) {
        if (jobs[j].used && jobs[j].alive == 0) {
            if (interactive) {
                var s: int = jobs[j].status;
                put_job_line(j, WIFSIGNALED(s) ? strsignal(WTERMSIG(s)) : (WEXITSTATUS(s) == 0 ? "Done" : "Exit"), 0);
            }
            jobs[j].used = 0;
        }
        j += 1;
    }
}

fn find_job(argc: int, argv: **char, who: *char) -> int {
    var j: int = -1;
    if (argc > 1) {
        var a: *char = argv[1];
        if (a[0] != '%') { return -1; }
        var n: int = atoi(&a[1]);
        if (n >= 1 && n <= MAX_JOBS && jobs[n - 1].used) { j = n - 1; }
    } else {
        var k: int = MAX_JOBS - 1;
        while (k >= 0 && j < 0) { if (jobs[k].used) { j = k; } k -= 1; }
    }
    if (j < 0) { err(who, ": no such job"); }
    return j;
}

// ---- redirections ----------------------------------------------------------------------------------------

var saved_fd: [10]int;                // copies made while a builtin or compound runs

// Apply the redirections among tokens [a, b). With save, remember the old
// descriptors first (in saved_fd). Returns 0, or -1 after a message.
fn redirect(a: int, b: int, save: int) -> int {
    var t: int = a;
    while (t < b) {
        if (tkind[t] == T_REDIR && tmode[t] == R_HEREDOC) {
            var hw: int = tfd[t];
            if (save && hw < 10 && saved_fd[hw] == -2) {
                saved_fd[hw] = fcntl(hw, F_DUPFD_CLOEXEC, 10);
                if (saved_fd[hw] < 0) { saved_fd[hw] = -1; }
            }
            if (heredoc_to(t, hw) < 0) { return -1; }
            t += 2;
            continue;
        }
        if (tkind[t] == T_REDIR) {
            var mark: int = exp;
            var target: *char = expand_one(t + 1, tstart[t + 1]);
            if (expand_error) { exp = mark; return -1; }
            var want: int = tfd[t];
            if (save && want < 10 && saved_fd[want] == -2) {
                saved_fd[want] = fcntl(want, F_DUPFD_CLOEXEC, 10);
                if (saved_fd[want] < 0) { saved_fd[want] = -1; }
            }
            var fd: int;
            var mode: int = tmode[t];
            if (mode == R_DUPOUT || mode == R_DUPIN) {
                if (streq(target, "-")) {
                    close(want);
                } else {
                    if (!isdigit(target[0]) || target[1] != 0) { err("bad descriptor: ", target); exp = mark; return -1; }
                    fd = target[0] - '0';
                    if (fd != want && dup2(fd, want) < 0) { err(target, ": bad file descriptor"); exp = mark; return -1; }
                }
                exp = mark;
                t += 2;
                continue;
            }
            if (mode == R_IN) { fd = open(target, O_RDONLY, 0); }
            else if (mode == R_OUT) { fd = open(target, O_WRONLY + O_CREAT + O_TRUNC, 438); }
            else { fd = open(target, O_WRONLY + O_CREAT + O_APPEND, 438); }
            if (fd < 0) {
                perror2("sh", target);
                exp = mark;
                return -1;
            }
            if (fd != want) {
                dup2(fd, want);
                close(fd);
            }
            exp = mark;
            t += 1;
        }
        t += 1;
    }
    return 0;
}

// Here-document bodies: copied as they are when the delimiter was quoted,
// otherwise expanded like a double-quoted string (but " is ordinary).
fn heredoc_span(t: int, a: int, b: int) {
    if (hd_quoted[t]) {
        var k: int = a;
        while (k < b) { put(src[k]); k += 1; }
    } else {
        expand_span(a, b, 1);
    }
}

// The text of the here-document at token t, at ex[result] (NUL-terminated).
fn heredoc_text(t: int) -> int {
    var m: int = exp;
    var save_split: int = split_mode;
    var save_fs: int = fstart;
    var save_started: int = fstarted;
    var save_glob: int = fglob;
    split_mode = 0;
    fstart = exp;
    in_heredoc = 1;
    if (!hd_strip[t]) {
        heredoc_span(t, hd_a[t], hd_b[t]);
    } else {
        var i: int = hd_a[t];
        while (i < hd_b[t] && !expand_error) {
            while (i < hd_b[t] && src[i] == '\t') { i += 1; }
            var e: int = i;
            while (e < hd_b[t] && src[e] != '\n') { e += 1; }
            if (e < hd_b[t]) { e += 1; }
            heredoc_span(t, i, e);
            i = e;
        }
    }
    in_heredoc = 0;
    put(0);
    split_mode = save_split;
    fstart = save_fs;
    fstarted = save_started;
    fglob = save_glob;
    return m;
}

// Put the here-document at token t on descriptor want, through a pipe. The
// whole text fits in the pipe (both are 3^9 trytes), so no writer process.
fn heredoc_to(t: int, want: int) -> int {
    var mark: int = exp;
    expand_error = 0;
    var m: int = heredoc_text(t);
    if (expand_error) { exp = mark; return -1; }
    var len: int = exp - m - 1;
    var p: [2]int;
    if (pipe(&p[0]) < 0) { perror2("sh", "here-document"); exp = mark; return -1; }
    var off: int = 0;
    while (off < len) {
        var w: int = write(p[1], &ex[m + off], len - off);
        if (w < 0 && errno == EINTR) { continue; }
        if (w <= 0) { break; }
        off += w;
    }
    close(p[1]);
    if (p[0] != want) {
        dup2(p[0], want);
        close(p[0]);
    }
    exp = mark;
    return 0;
}

fn save_begin() {
    var k: int = 0;
    while (k < 10) { saved_fd[k] = -2; k += 1; }
}

fn save_restore() {
    var k: int = 0;
    while (k < 10) {
        if (saved_fd[k] >= 0) { dup2(saved_fd[k], k); close(saved_fd[k]); }
        else if (saved_fd[k] == -1) { close(k); }       // it was closed before
        saved_fd[k] = -2;
        k += 1;
    }
}

// ---- builtins -----------------------------------------------------------------------------------------------

var break_count: int;
var continue_count: int;
var loop_depth: int;

fn is_builtin(name: *char) -> int {
    var list: [32]*char = { ":", "true", "false", "echo", "cd", "pwd", "exit", "export", "unset", "set", "shift", "read",
        "test", "[", "break", "continue", "jobs", "fg", "bg", "kill", "wait", "umask", "exec", "type", "eval", ".",
        "return", "local", "alias", "unalias", "history", null };
    var k: int = 0;
    while (list[k] != null) {
        if (streq(list[k], name)) { return 1; }
        k += 1;
    }
    return 0;
}

// POSIX special builtins: found before functions.
fn is_special(name: *char) -> int {
    var list: [13]*char = { ":", "break", "continue", "eval", "exec", "exit", "export", "return", "set", "shift",
        "unset", ".", null };
    var k: int = 0;
    while (list[k] != null) {
        if (streq(list[k], name)) { return 1; }
        k += 1;
    }
    return 0;
}

// eval [arg ...]: the arguments joined by spaces, run as shell text.
fn builtin_eval(argc: int, argv: **char) -> int {
    var n: int = 0;
    var k: int = 1;
    while (k < argc) { n += strlen(argv[k]) + 1; k += 1; }
    if (n == 0) { return 0; }
    var text: *char = malloc(n) as *char;
    if (text == null) { err("eval: out of memory", null); return 1; }
    var len: int = 0;
    k = 1;
    while (k < argc) {
        if (k > 1) { text[len] = ' '; len += 1; }
        strcpy(&text[len], argv[k]);
        len += strlen(argv[k]);
        k += 1;
    }
    var status: int = eval_text(text, len);
    free(text as *tryte);
    return status;
}

// . file: run the file's commands in this shell (a name without / is looked
// up in PATH).
fn builtin_dot(argc: int, argv: **char) -> int {
    if (argc < 2) { err(".: filename argument required", null); return 2; }
    var path: [243]char;
    var file: *char = argv[1];
    if (strchr(file, '/') == null) {
        if (!find_in_path(file, &path[0])) { err(file, ": not found"); return 1; }
        file = &path[0];
    }
    var fd: int = open(file, O_RDONLY, 0);
    if (fd < 0) { perror2("sh: .", file); return 1; }
    var text: *char = malloc(SRC_MAX) as *char;
    if (text == null) { close(fd); err(".: out of memory", null); return 1; }
    var len: int = 0;
    loop {
        var r: int = read(fd, &text[len], SRC_MAX - 1 - len);
        if (r < 0 && errno == EINTR) { continue; }
        if (r <= 0) { break; }
        len += r;
        if (len >= SRC_MAX - 1) { break; }
    }
    close(fd);
    dot_depth += 1;
    var status: int = eval_text(text, len);
    dot_depth -= 1;
    return_pending = 0;                                 // return in a . file ends the file
    free(text as *tryte);
    return status;
}

fn builtin_return(argc: int, argv: **char) -> int {
    if (func_depth == 0 && dot_depth == 0) { err("return: not in a function or . file", null); return 1; }
    var code: int = last_status;
    if (argc > 1) {
        var end: *char;
        code = strtol(argv[1], &end, 10);
        if (end == argv[1] || end[0] != 0) { err("return: numeric argument required: ", argv[1]); code = 2; }
    }
    return_pending = 1;
    return code;
}

fn builtin_echo(argc: int, argv: **char) -> int {
    var i: int = 1;
    var nl: int = 1;
    while (i < argc && streq(argv[i], "-n")) { nl = 0; i += 1; }
    var first: int = 1;
    while (i < argc) {
        if (!first) { puts(" "); }
        puts(argv[i]);
        first = 0;
        i += 1;
    }
    if (nl) { puts("\n"); }
    return 0;
}

fn builtin_cd(argc: int, argv: **char) -> int {
    var dir: *char = argc > 1 ? argv[1] : var_get("HOME");
    if (dir == null) { dir = "/"; }
    if (argc > 1 && streq(dir, "-")) {
        dir = var_get("OLDPWD");
        if (dir == null) { err("cd: OLDPWD not set", null); return 1; }
    }
    var old: [243]char;
    if (getcwd(&old[0], 243) == null) { old[0] = 0; }
    if (chdir(dir) < 0) { perror2("sh: cd", dir); return 1; }
    var now: [243]char;
    if (getcwd(&now[0], 243) != null) { var_set("PWD", &now[0], is_exported("PWD")); }
    var_set("OLDPWD", &old[0], is_exported("OLDPWD"));
    return 0;
}

fn builtin_export(argc: int, argv: **char, unexport: int) -> int {
    if (argc == 1 && !unexport) {
        var i: int = 0;
        while (i < nvars) {
            if (vname[i] != null && vexported[i]) {
                puts("export ");
                puts(vname[i]);
                puts("=\"");
                puts(vval[i]);
                puts("\"\n");
            }
            i += 1;
        }
        return 0;
    }
    var status: int = 0;
    var k: int = 1;
    while (k < argc) {
        var a: *char = argv[k];
        var name: [81]char;
        var n: int = 0;
        while (a[n] != 0 && a[n] != '=' && n < 80) { name[n] = a[n]; n += 1; }
        name[n] = 0;
        if (!valid_name(&name[0]) || (unexport && a[n] == '=')) {
            fputs(STDERR_FILENO, unexport ? "sh: unset: `" : "sh: export: `");
            fputs(STDERR_FILENO, a);
            fputs(STDERR_FILENO, "': not a valid identifier\n");
            status = 1;
        } else if (unexport) {
            var_unset(&name[0]);
        } else if (a[n] == '=') {
            var_set(&name[0], &a[n + 1], 1);
        } else {
            var i2: int = var_find(&name[0]);
            if (i2 < 0) { var_set(&name[0], "", 1); } else { vexported[i2] = 1; }
        }
        k += 1;
    }
    return status;
}

fn set_positional(argc: int, argv: **char) {
    var k: int = 0;
    while (k < npos) { free(pos_args[k] as *tryte); k += 1; }
    npos = 0;
    while (npos < argc && npos < 81) {
        pos_args[npos] = strdup(argv[npos]);
        npos += 1;
    }
}

fn builtin_set(argc: int, argv: **char) -> int {
    if (argc == 1) {
        var i: int = 0;
        while (i < nvars) {
            if (vname[i] != null) { puts(vname[i]); puts("="); puts(vval[i]); puts("\n"); }
            i += 1;
        }
        return 0;
    }
    var k: int = 1;
    while (k < argc && (argv[k][0] == '-' || argv[k][0] == '+')) {
        if (streq(argv[k], "--")) { k += 1; set_positional(argc - k, &argv[k]); return 0; }
        var on: int = argv[k][0] == '-';
        var j: int = 1;
        while (argv[k][j] != 0) {
            if (argv[k][j] == 'e') { opt_errexit = on; }
            else if (argv[k][j] == 'x') { opt_xtrace = on; }
            else { err("set: bad option: ", argv[k]); return 2; }
            j += 1;
        }
        k += 1;
    }
    if (k < argc) { set_positional(argc - k, &argv[k]); }
    return 0;
}

fn builtin_shift(argc: int, argv: **char) -> int {
    var n: int = argc > 1 ? atoi(argv[1]) : 1;
    if (n < 0 || n > npos) { err("shift: can't shift that many", null); return 1; }
    var k: int = 0;
    while (k < n) { free(pos_args[k] as *tryte); k += 1; }
    k = 0;
    while (k + n < npos) { pos_args[k] = pos_args[k + n]; k += 1; }
    npos -= n;
    return 0;
}

// read [-r] [name ...]: one line from standard input, a character at a time
// (so the rest stays for the next reader), split on blanks.
fn builtin_read(argc: int, argv: **char) -> int {
    var raw: int = 0;
    var k: int = 1;
    if (k < argc && streq(argv[k], "-r")) { raw = 1; k += 1; }
    var j: int = k;
    while (j < argc) {
        if (!valid_name(argv[j])) {
            fputs(STDERR_FILENO, "sh: read: `");
            fputs(STDERR_FILENO, argv[j]);
            fputs(STDERR_FILENO, "': not a valid identifier\n");
            return 2;
        }
        j += 1;
    }
    var line: [2187]char;
    var n: int = 0;
    var got_eof: int = 0;
    loop {
        var c: [1]char;
        var r: int = read(STDIN_FILENO, &c[0], 1);
        if (r < 0 && errno == EINTR) { return 130; }
        if (r <= 0) { got_eof = 1; break; }
        if (c[0] == '\\' && !raw) {
            r = read(STDIN_FILENO, &c[0], 1);
            if (r <= 0) { got_eof = 1; break; }
            if (c[0] == '\n') { continue; }
        } else if (c[0] == '\n') {
            break;
        }
        if (n < 2186) { line[n] = c[0]; n += 1; }
    }
    line[n] = 0;
    if (k == argc) { var_set("REPLY", &line[0], 0); return got_eof; }
    var i: int = 0;
    while (k < argc) {
        while (line[i] == ' ' || line[i] == '\t') { i += 1; }
        var start: int = i;
        if (k == argc - 1) {
            var e: int = n;
            while (e > start && (line[e - 1] == ' ' || line[e - 1] == '\t')) { e -= 1; }
            line[e] = 0;
        } else {
            while (line[i] != 0 && line[i] != ' ' && line[i] != '\t') { i += 1; }
            if (line[i] != 0) { line[i] = 0; i += 1; }
        }
        var_set(argv[k], &line[start], is_exported(argv[k]));
        k += 1;
    }
    return got_eof;
}

fn parse_signal(s: *char) -> int {
    if (isdigit(s[0])) { var n: int = atoi(s); return n < NSIG ? n : -1; }
    if (s[0] == 'S' && s[1] == 'I' && s[2] == 'G') { s = &s[3]; }
    var sig: int = 1;
    while (sig < NSIG) {
        if (streq(s, signame(sig))) { return sig; }
        sig += 1;
    }
    return -1;
}

fn builtin_kill(argc: int, argv: **char) -> int {
    var sig: int = SIGTERM;
    var i: int = 1;
    if (argc > 1 && streq(argv[1], "-l")) {
        var s: int = 1;
        while (s < NSIG) {
            if (signame(s)[0] != 0) { put_int(s); puts(") SIG"); puts(signame(s)); puts("\n"); }
            s += 1;
        }
        return 0;
    }
    if (argc > 2 && streq(argv[1], "-s")) { sig = parse_signal(argv[2]); i = 3; }
    else if (argc > 2 && argv[1][0] == '-') { sig = parse_signal(&argv[1][1]); i = 2; }
    if (sig < 0) { err("kill: bad signal", null); return 1; }
    if (i == argc) { err("usage: kill [-s sig | -sig] pid | %job ...", null); return 2; }
    var status: int = 0;
    while (i < argc) {
        var pid: int;
        if (argv[i][0] == '%') {
            var jargv: [2]*char = { "kill", argv[i] };
            var j: int = find_job(2, &jargv[0], "kill");
            if (j < 0) { status = 1; i += 1; continue; }
            pid = -jobs[j].pgid;
            if (sig == SIGCONT || sig == SIGKILL || sig == SIGTERM) { jobs[j].stopped = 0; }
        } else {
            var end: *char;
            pid = strtol(argv[i], &end, 10);
            if (end == argv[i] || end[0] != 0) {
                err("kill: bad pid: ", argv[i]);
                status = 1;
                i += 1;
                continue;
            }
        }
        if (kill(pid, sig) < 0) { perror2("sh: kill", argv[i]); status = 1; }
        else if (pid < 0 && sig != SIGCONT && sig != 0) { kill(pid, SIGCONT); }
        i += 1;
    }
    return status;
}

fn builtin_wait(argc: int, argv: **char) -> int {
    var status: int = 0;
    if (argc > 1) {
        if (argv[1][0] == '%') {
            var j: int = find_job(argc, argv, "wait");
            if (j < 0) { return 127; }
            while (jobs[j].used && jobs[j].alive > 0) {
                var st2: int;
                var r: int = waitpid(-1, &st2, 0);
                if (r < 0) { if (errno == EINTR) { return 130; } break; }
                job_update(r, st2);
            }
            status = status_of(jobs[j].status);
            jobs[j].used = 0;
            return status;
        }
        var pid: int = atoi(argv[1]);
        var st: int;
        if (pid > 0 && waitpid(pid, &st, 0) == pid) {
            var jj0: int = job_update(pid, st);
            if (jj0 >= 0 && jobs[jj0].alive == 0) { jobs[jj0].used = 0; }
            return status_of(st);
        }
        err("wait: no such child: ", argv[1]);
        return 127;
    }
    loop {
        var st3: int;
        var r2: int = waitpid(-1, &st3, 0);
        if (r2 < 0) {
            if (errno == EINTR) { return 130; }
            break;
        }
        var jj: int = job_update(r2, st3);
        if (jj >= 0 && jobs[jj].alive == 0) { jobs[jj].used = 0; }
    }
    return status;
}

fn builtin(argc: int, argv: **char) -> int {
    var name: *char = argv[0];
    if (streq(name, ":") || streq(name, "true")) { return 0; }
    if (streq(name, "false")) { return 1; }
    if (streq(name, "echo")) { return builtin_echo(argc, argv); }
    if (streq(name, "cd")) { return builtin_cd(argc, argv); }
    if (streq(name, "pwd")) {
        var buf: [243]char;
        if (getcwd(&buf[0], 243) == null) { perror2("sh", "pwd"); return 1; }
        puts(&buf[0]);
        puts("\n");
        return 0;
    }
    if (streq(name, "export")) { return builtin_export(argc, argv, 0); }
    if (streq(name, "unset")) {
        if (argc > 1 && streq(argv[1], "-f")) {
            var f: int = 2;
            while (f < argc) { func_unset(argv[f]); f += 1; }
            return 0;
        }
        if (argc > 1 && streq(argv[1], "-v")) { argv[1] = argv[0]; return builtin_export(argc - 1, &argv[1], 1); }
        return builtin_export(argc, argv, 1);
    }
    if (streq(name, "eval")) { return builtin_eval(argc, argv); }
    if (streq(name, ".")) { return builtin_dot(argc, argv); }
    if (streq(name, "return")) { return builtin_return(argc, argv); }
    if (streq(name, "local")) { return builtin_local(argc, argv); }
    if (streq(name, "history")) {
        var h: int = 0;
        while (h < nhist) {
            var nb: [15]char;
            var num: *char = itoa(h + 1, &nb[0]);
            var pad: int = strlen(num);
            while (pad < 5) { puts(" "); pad += 1; }
            puts(num);
            puts("  ");
            puts(hist[h]);
            puts("\n");
            h += 1;
        }
        return 0;
    }
    if (streq(name, "alias")) { return builtin_alias(argc, argv); }
    if (streq(name, "unalias")) { return builtin_unalias(argc, argv); }
    if (streq(name, "set")) { return builtin_set(argc, argv); }
    if (streq(name, "shift")) { return builtin_shift(argc, argv); }
    if (streq(name, "read")) { return builtin_read(argc, argv); }
    if (streq(name, "test") || streq(name, "[")) { return test_eval(argc, argv); }
    if (streq(name, "break") || streq(name, "continue")) {
        var n: int = argc > 1 ? atoi(argv[1]) : 1;
        if (n < 1) { err(name, ": loop count must be positive"); return 1; }
        if (loop_depth == 0) { return 0; }
        if (n > loop_depth) { n = loop_depth; }
        if (streq(name, "break")) { break_count = n; } else { continue_count = n; }
        return 0;
    }
    if (streq(name, "jobs")) {
        var j: int = 0;
        while (j < MAX_JOBS) {
            if (jobs[j].used) { put_job_line(j, jobs[j].stopped ? "Stopped" : "Running", !jobs[j].stopped); }
            j += 1;
        }
        return 0;
    }
    if (streq(name, "fg") || streq(name, "bg")) {
        if (!job_control) { err(name, ": no job control"); return 1; }
        var j2: int = find_job(argc, argv, name);
        if (j2 < 0) { return 1; }
        var jb: *Job = &jobs[j2];
        if (streq(name, "bg")) {
            jb.stopped = 0;
            kill(-jb.pgid, SIGCONT);
            puts("[");
            put_int(j2 + 1);
            puts("] ");
            puts(&jb.cmd[0]);
            puts(" &\n");
            return 0;
        }
        puts(&jb.cmd[0]);
        puts("\n");
        tcsetpgrp(STDIN_FILENO, jb.pgid);
        jb.stopped = 0;
        kill(-jb.pgid, SIGCONT);
        return wait_fg(j2);
    }
    if (streq(name, "kill")) { return builtin_kill(argc, argv); }
    if (streq(name, "wait")) { return builtin_wait(argc, argv); }
    if (streq(name, "umask")) {
        if (argc == 1) {
            var m: int = umask(0);
            umask(m);
            var o: [5]char;
            o[0] = '0';
            o[1] = ('0' + m / 64 % 8) as char;
            o[2] = ('0' + m / 8 % 8) as char;
            o[3] = ('0' + m % 8) as char;
            o[4] = 0;
            puts(&o[0]);
            puts("\n");
            return 0;
        }
        var v: int = 0;
        var k: int = 0;
        while (argv[1][k] >= '0' && argv[1][k] <= '7') { v = v * 8 + argv[1][k] - '0'; k += 1; }
        if (k == 0 || argv[1][k] != 0) { err("umask: bad mask: ", argv[1]); return 1; }
        umask(v);
        return 0;
    }
    if (streq(name, "type")) {
        var st: int = 0;
        var i: int = 1;
        while (i < argc) {
            puts(argv[i]);
            var ai: int = alias_find(argv[i]);
            if (ai >= 0) { puts(" is aliased to `"); puts(aval[ai]); puts("'\n"); }
            else if (is_special(argv[i])) { puts(" is a special shell builtin\n"); }
            else if (func_find(argv[i]) >= 0) { puts(" is a function\n"); }
            else if (is_builtin(argv[i])) { puts(" is a shell builtin\n"); }
            else {
                var path: [243]char;
                if (find_in_path(argv[i], &path[0])) { puts(" is "); puts(&path[0]); puts("\n"); }
                else { puts(": not found\n"); st = 1; }
            }
            i += 1;
        }
        return st;
    }
    // exit [n]
    var code: int = last_status;
    if (argc > 1) {
        var end: *char;
        code = strtol(argv[1], &end, 10);
        if (end == argv[1] || end[0] != 0) { err("exit: numeric argument required: ", argv[1]); code = 2; }
    }
    if (interactive) { fputs(STDERR_FILENO, "exit\n"); }
    _exit(code);
    return code;
}

// ---- running commands ----------------------------------------------------------------------------------------

fn find_in_path(name: *char, out: *char) -> int {
    var path: *char = var_get("PATH");
    if (path == null) { path = "/bin:/sbin"; }
    var i: int = 0;
    loop {
        var n: int = 0;
        while (path[i] != 0 && path[i] != ':' && n < 200) { out[n] = path[i]; n += 1; i += 1; }
        if (n == 0) { out[n] = '.'; n += 1; }
        out[n] = '/';
        n += 1;
        var j: int = 0;
        while (name[j] != 0 && n < 242) { out[n] = name[j]; n += 1; j += 1; }
        out[n] = 0;
        var st: stat_t;
        if (stat(out, &st) == 0 && S_ISREG(st.st_mode)) { return 1; }
        if (path[i] == 0) { return 0; }
        i += 1;
    }
}

// In a child (or for exec): run argv; never returns.
fn exec_external(argc: int, argv: **char) {
    var envp: **char = build_envp();
    if (strchr(argv[0], '/') != null) {
        execve(argv[0], argv, envp);
    } else {
        var path: [243]char;
        if (find_in_path(argv[0], &path[0])) { execve(&path[0], argv, envp); }
        else { errno = ENOENT; }
    }
    if (errno == ENOENT) {
        err(argv[0], ": not found");
        _exit(127);
    }
    perror2("sh", argv[0]);
    _exit(126);
}

fn default_signals() {
    signal(SIGINT, SIG_DFL);
    signal(SIGQUIT, SIG_DFL);
    signal(SIGTSTP, SIG_DFL);
    signal(SIGTTIN, SIG_DFL);
    signal(SIGTTOU, SIG_DFL);
}

// After fork, in a child of job j.
fn child_setup(j: int, bg: int) {
    if (job_control) {
        setpgid(0, jobs[j].pgid);
        if (!bg) { tcsetpgrp(STDIN_FILENO, getpgrp()); }
        default_signals();
    } else if (bg) {
        signal(SIGINT, SIG_IGN);                        // POSIX: async lists ignore SIGINT/SIGQUIT
        signal(SIGQUIT, SIG_IGN);
    }
    job_control = 0;                                    // a child does no job control itself
    interactive = 0;
}

fn parent_track(j: int, pid: int, bg: int) {
    if (jobs[j].pgid == 0) { jobs[j].pgid = job_control ? pid : shell_pgid; }
    if (job_control) {
        setpgid(pid, jobs[j].pgid);
        if (!bg) { tcsetpgrp(STDIN_FILENO, jobs[j].pgid); }
    }
    add_pid(j, pid);
}

fn xtrace(argc: int, argv: **char) {
    fputs(STDERR_FILENO, "+");
    var k: int = 0;
    while (k < argc) { fputs(STDERR_FILENO, " "); fputs(STDERR_FILENO, argv[k]); k += 1; }
    fputs(STDERR_FILENO, "\n");
}

// Is token t an assignment word (NAME=...)? The index of its '=', or -1.
fn assignment_eq(t: int) -> int {
    if (tkind[t] != T_WORD) { return -1; }
    var i: int = tstart[t];
    if (!is_name_start(src[i])) { return -1; }
    while (i < tend[t] && is_name_char(src[i])) { i += 1; }
    return i < tend[t] && src[i] == '=' ? i : -1;
}

fn assignment_name(t: int, eq: int, name: *char) {
    var k: int = 0;
    while (k < eq - tstart[t] && k < 80) { name[k] = src[tstart[t] + k]; k += 1; }
    name[k] = 0;
}

// VAR=value before a command: exported to that command only (we are its child).
fn apply_prefix_assignments(a: int, first_word: int) {
    var t: int = a;
    while (t < first_word) {
        if (tkind[t] == T_REDIR) { t += 2; continue; }
        var eq: int = assignment_eq(t);
        var value: *char = expand_one(t, eq + 1);
        var name: [81]char;
        assignment_name(t, eq, &name[0]);
        var_set(&name[0], value, 1);
        t += 1;
    }
}

// Call function f with argv as its positional parameters. Prefix
// assignments (tokens a..first_word) are exported for the call only, and
// redirections (among a..b) apply to the whole body.
fn call_function(f: int, a: int, b: int, first_word: int, argc: int, argv: **char) -> int {
    if (func_depth >= FUNC_DEPTH_MAX) { err(argv[0], ": function nesting too deep"); return 2; }
    // the prefix assignments, remembering what they replace
    var pname: [27]*char;
    var pold: [27]*char;
    var pexp: [27]int;
    var np: int = 0;
    var t: int = a;
    while (t < first_word && np < 27) {
        if (tkind[t] == T_REDIR) { t += 2; continue; }
        var eq: int = assignment_eq(t);
        var name: [81]char;
        assignment_name(t, eq, &name[0]);
        var old: *char = var_get(&name[0]);
        pname[np] = strdup(&name[0]);
        pold[np] = old == null ? null : strdup(old);
        pexp[np] = is_exported(&name[0]);
        np += 1;
        var m: int = exp;
        var value: *char = expand_one(t, eq + 1);
        var_set(&name[0], value, 1);
        exp = m;
        t += 1;
    }
    // new positional parameters
    var save_args: [81]*char;
    var save_npos: int = npos;
    var k: int = 0;
    while (k < npos) { save_args[k] = pos_args[k]; k += 1; }
    npos = 0;
    while (npos < argc - 1 && npos < 81) {
        pos_args[npos] = strdup(argv[npos + 1]);
        npos += 1;
    }
    var save_loops: int = loop_depth;
    loop_depth = 0;                                     // break/continue stay inside
    var save_local_base: int = local_base;
    local_base = nlocal;
    var status: int = 1;
    save_begin();
    if (redirect(a, b, 1) == 0) {
        var mine: [10]int;
        var i: int = 0;
        while (i < 10) { mine[i] = saved_fd[i]; saved_fd[i] = -2; i += 1; }
        func_depth += 1;
        status = eval_text(fbody[f], strlen(fbody[f]));   // copied first: redefining f is safe
        func_depth -= 1;
        return_pending = 0;
        i = 0;
        while (i < 10) { saved_fd[i] = mine[i]; i += 1; }
    }
    save_restore();
    loop_depth = save_loops;
    local_restore(local_base);
    local_base = save_local_base;
    k = 0;
    while (k < npos) { free(pos_args[k] as *tryte); k += 1; }
    npos = save_npos;
    k = 0;
    while (k < npos) { pos_args[k] = save_args[k]; k += 1; }
    k = 0;
    while (k < np) {
        if (pold[k] == null) {
            var_unset(pname[k]);
        } else {
            var_set(pname[k], pold[k], 0);
            vexported[var_find(pname[k])] = pexp[k];
            free(pold[k] as *tryte);
        }
        free(pname[k] as *tryte);
        k += 1;
    }
    return status;
}

// A simple command. in_child: we are already a forked child, so exec directly.
fn exec_simple(n: int, in_child: int) -> int {
    var ex_mark: int = exp;
    var f_mark: int = nfields;
    expand_error = 0;
    var a: int = na[n];
    var b: int = nb[n];
    var t: int = a;
    var first_word: int = b;
    while (t < b) {
        if (tkind[t] == T_REDIR) { t += 2; continue; }
        if (assignment_eq(t) < 0) { first_word = t; break; }
        t += 1;
    }
    if (first_word < b) {
        var al: int = alias_of(first_word);
        if (al >= 0) { return run_alias(n, first_word, al); }
    }
    var argv_start: int = nfields;
    // export and local are declaration utilities: NAME=value arguments are
    // not split or globbed
    var declaring: int = first_word < b && (tok_is(first_word, "export") || tok_is(first_word, "local"));
    t = first_word;
    while (t < b && !expand_error) {
        if (tkind[t] == T_REDIR) { t += 2; continue; }
        expand_word(t, !(declaring && t > first_word && assignment_eq(t) >= 0));
        t += 1;
    }
    var status: int = 0;
    var argc: int = nfields - argv_start;
    if (expand_error) {
        exp = ex_mark;
        nfields = f_mark;
        return expansion_failed();
    }
    push_field(null);
    var argv: **char = &fields[argv_start];
    if (argc == 0) {
        // assignments (and redirections) only; $? is that of the last $(...)
        last_status = 0;
        t = a;
        while (t < b && !expand_error) {
            if (tkind[t] == T_REDIR) { t += 2; continue; }
            var eq: int = assignment_eq(t);
            var m: int = exp;
            var value: *char = expand_one(t, eq + 1);
            var name: [81]char;
            assignment_name(t, eq, &name[0]);
            if (!expand_error) { var_set(&name[0], value, is_exported(&name[0])); }
            exp = m;
            t += 1;
        }
        status = expand_error ? expansion_failed() : last_status;
        save_begin();
        if (redirect(a, b, 1) < 0) { status = 1; }
        save_restore();
        exp = ex_mark;
        nfields = f_mark;
        return status;
    }
    if (opt_xtrace) { xtrace(argc, argv); }
    if (streq(argv[0], "exec")) {
        if (redirect(a, b, 0) < 0) { exp = ex_mark; nfields = f_mark; return 1; }
        if (argc > 1) {
            apply_prefix_assignments(a, first_word);
            exec_external(argc - 1, &argv[1]);
        }
        exp = ex_mark;
        nfields = f_mark;
        return 0;
    }
    if (!is_special(argv[0])) {
        var fi: int = func_find(argv[0]);
        if (fi >= 0) {
            status = call_function(fi, a, b, first_word, argc, argv);
            exp = ex_mark;
            nfields = f_mark;
            return status;
        }
    }
    if (is_builtin(argv[0])) {
        save_begin();
        if (redirect(a, b, 1) < 0) { status = 1; }
        else { status = builtin(argc, argv); }
        save_restore();
        exp = ex_mark;
        nfields = f_mark;
        return status;
    }
    if (in_child) {
        if (redirect(a, b, 0) < 0) { _exit(1); }
        apply_prefix_assignments(a, first_word);
        exec_external(argc, argv);
    }
    var j: int = new_job(n);
    if (j < 0) { err("too many jobs", null); exp = ex_mark; nfields = f_mark; return 1; }
    var pid: int = fork();
    if (pid < 0) { perror2("sh", "fork"); jobs[j].used = 0; exp = ex_mark; nfields = f_mark; return 1; }
    if (pid == 0) {
        child_setup(j, 0);
        if (redirect(a, b, 0) < 0) { _exit(1); }
        apply_prefix_assignments(a, first_word);
        exec_external(argc, argv);
    }
    parent_track(j, pid, 0);
    status = wait_fg(j);
    exp = ex_mark;
    nfields = f_mark;
    return status;
}

// Run node n in a forked child (pipe ends already in place); never returns.
fn run_in_child(n: int) {
    if (nkind[n] == N_CMD) { _exit(exec_simple(n, 1)); }
    _exit(exec_node(n));
}

fn exec_pipeline(n: int) -> int {
    var first: int = na[n];
    var status: int;
    if (nnext[first] < 0) {
        if (nkind[first] == N_CMD) { status = exec_simple(first, 0); }
        else { status = exec_node(first); }
    } else {
        var j: int = new_job(n);
        if (j < 0) { err("too many jobs", null); return 1; }
        var prev: int = -1;
        var e: int = first;
        while (e >= 0) {
            var p: [2]int;
            var last: int = nnext[e] < 0;
            if (!last && pipe(&p[0]) < 0) { perror2("sh", "pipe"); break; }
            var pid: int = fork();
            if (pid < 0) { perror2("sh", "fork"); break; }
            if (pid == 0) {
                child_setup(j, 0);
                if (prev >= 0) { dup2(prev, 0); close(prev); }
                if (!last) { close(p[0]); dup2(p[1], 1); close(p[1]); }
                run_in_child(e);
            }
            parent_track(j, pid, 0);
            if (prev >= 0) { close(prev); }
            if (!last) { close(p[1]); prev = p[0]; }
            e = nnext[e];
        }
        if (prev >= 0) { close(prev); }
        if (jobs[j].npids == 0) { jobs[j].used = 0; return 1; }
        status = wait_fg(j);
    }
    if (nd[n]) { status = status == 0 ? 1 : 0; }
    return status;
}

fn run_background(n: int) -> int {
    var j: int = new_job(n);
    if (j < 0) { err("too many jobs", null); return 1; }
    var pid: int = fork();
    if (pid < 0) { perror2("sh", "fork"); jobs[j].used = 0; return 1; }
    if (pid == 0) {
        child_setup(j, 1);
        // a single simple command needs no further fork
        if (nkind[n] == N_PIPELINE && nd[n] == 0 && nnext[na[n]] < 0 && nkind[na[n]] == N_CMD) { run_in_child(na[n]); }
        _exit(exec_node(n));
    }
    parent_track(j, pid, 1);
    last_bg = pid;
    if (interactive) {
        puts("[");
        put_int(j + 1);
        puts("] ");
        put_int(pid);
        puts("\n");
    }
    return 0;
}

// An expansion error abandons the whole command line (POSIX), and a
// non-interactive shell exits.
var abort_line: int;

fn expansion_failed() -> int {
    if (!interactive) { _exit(1); }
    abort_line = 1;
    return 1;
}

fn loop_should_stop() -> int { return break_count > 0 || continue_count > 0 || abort_line || return_pending; }

fn exec_list(n: int) -> int {
    var status: int = 0;
    var it: int = na[n];
    while (it >= 0) {
        if (nbg[it]) { status = run_background(it); }
        else {
            status = exec_node(it);
            if (opt_errexit && status != 0 && in_condition == 0 && nkind[it] != N_AND && nkind[it] != N_OR
                && !(nkind[it] == N_PIPELINE && nd[it])) {
                _exit(status);
            }
        }
        last_status = status;
        if (loop_should_stop()) { break; }
        it = nnext[it];
    }
    return status;
}

// A loop body finished: 1 if the loop must stop now.
fn loop_after_body() -> int {
    if (abort_line || return_pending) { return 1; }
    if (break_count > 0) { break_count -= 1; return 1; }
    if (continue_count > 0) {
        continue_count -= 1;
        if (continue_count > 0) { return 1; }               // continue an outer loop
    }
    return 0;
}

fn exec_compound(n: int) -> int {
    var status: int = 0;
    switch (nkind[n]) {
        case N_LIST: return exec_list(n);
        case N_AND, N_OR: {
            in_condition += 1;
            status = exec_node(na[n]);
            in_condition -= 1;
            last_status = status;
            if (loop_should_stop()) { return status; }
            if ((nkind[n] == N_AND) == (status == 0)) { status = exec_node(nb[n]); }
            return status;
        }
        case N_IF: {
            in_condition += 1;
            var c: int = exec_node(na[n]);
            in_condition -= 1;
            if (loop_should_stop()) { return c; }
            if (c == 0) { return exec_node(nb[n]); }
            if (nc[n] >= 0) { return exec_node(nc[n]); }
            return 0;
        }
        case N_WHILE: {
            loop_depth += 1;
            loop {
                in_condition += 1;
                var c2: int = exec_node(na[n]);
                in_condition -= 1;
                if (loop_should_stop()) { if (loop_after_body()) { break; } continue; }
                if ((c2 == 0) == (nd[n] != 0)) { break; }
                status = exec_node(nb[n]);
                if (loop_after_body()) { break; }
            }
            loop_depth -= 1;
            return status;
        }
        case N_FOR: {
            var ex_mark: int = exp;
            var f_mark: int = nfields;
            var name: [81]char;
            var len: int = tend[na[n]] - tstart[na[n]];
            if (len > 80) { len = 80; }
            var k: int = 0;
            while (k < len) { name[k] = src[tstart[na[n]] + k]; k += 1; }
            name[k] = 0;
            if (!valid_name(&name[0])) { err("for: bad variable name: ", &name[0]); return 2; }
            var first: int = nfields;
            expand_error = 0;
            if (nb[n] < 0) {
                var p: int = 0;
                while (p < npos) { push_field(pos_args[p]); p += 1; }
            } else {
                var t: int = nb[n];
                while (t < nc[n]) { expand_word(t, 1); t += 1; }
            }
            if (expand_error) { exp = ex_mark; nfields = f_mark; return expansion_failed(); }
            var count: int = nfields - first;
            loop_depth += 1;
            var i: int = 0;
            while (i < count) {
                var_set(&name[0], fields[first + i], is_exported(&name[0]));
                status = exec_node(nd[n]);
                if (loop_after_body()) { break; }
                i += 1;
            }
            loop_depth -= 1;
            exp = ex_mark;
            nfields = f_mark;
            return status;
        }
        case N_CASE: {
            var ex_mark2: int = exp;
            expand_error = 0;
            var word: *char = expand_one(na[n], tstart[na[n]]);
            if (expand_error) { exp = ex_mark2; return expansion_failed(); }
            var it: int = nb[n];
            while (it >= 0) {
                var t2: int = na[it];
                while (t2 < nb[it]) {
                    if (tkind[t2] == T_WORD) {
                        var m: int = exp;
                        var pat: *char = expand_one(t2, tstart[t2]);
                        var hit: int = fnmatch(pat, word);
                        exp = m;
                        if (hit) {
                            status = exec_node(nc[it]);
                            exp = ex_mark2;
                            return status;
                        }
                    }
                    t2 += 1;
                }
                it = nnext[it];
            }
            exp = ex_mark2;
            return 0;
        }
        case N_SUBSHELL: {
            var pid: int = fork();
            if (pid < 0) { perror2("sh", "fork"); return 1; }
            if (pid == 0) {
                job_control = 0;
                interactive = 0;
                _exit(exec_node(na[n]));
            }
            var st: int = 0;
            while (waitpid(pid, &st, 0) < 0 && errno == EINTR) {}
            return status_of(st);
        }
        case N_GROUP: return exec_node(na[n]);
        case N_FUNC: {
            var fnm: [81]char;
            var fl: int = tend[na[n]] - tstart[na[n]];
            if (fl > 80) { fl = 80; }
            var fk: int = 0;
            while (fk < fl) { fnm[fk] = src[tstart[na[n]] + fk]; fk += 1; }
            fnm[fk] = 0;
            if (!valid_name(&fnm[0]) || is_special(&fnm[0])) { err(&fnm[0], ": bad function name"); return 2; }
            return func_set(&fnm[0], nsa[nb[n]], nsb[nb[n]]);
        }
        case N_PIPELINE: return exec_pipeline(n);
        case N_CMD: return exec_simple(n, 0);
    }
    return 0;
}

fn exec_node(n: int) -> int {
    if (n < 0) { return 0; }
    var k: int = nkind[n];
    if (k != N_CMD && k != N_PIPELINE && nrb[n] > nra[n]) {
        // redirections on a compound command: save, apply, run, restore
        var outer: [10]int;
        var i: int = 0;
        while (i < 10) { outer[i] = saved_fd[i]; i += 1; }
        save_begin();
        var status: int = 1;
        if (redirect(nra[n], nrb[n], 1) == 0) {
            var mine: [10]int;
            i = 0;
            while (i < 10) { mine[i] = saved_fd[i]; saved_fd[i] = -2; i += 1; }
            status = exec_compound(n);
            i = 0;
            while (i < 10) { saved_fd[i] = mine[i]; i += 1; }
        }
        save_restore();
        i = 0;
        while (i < 10) { saved_fd[i] = outer[i]; i += 1; }
        return status;
    }
    return exec_compound(n);
}

// Tokenize, parse and run src. Returns the status (2 for a syntax error).
fn run_source() -> int {
    if (lex() != 0) {
        if (lex_incomplete) { err(lex_error_message(), null); }
        return 2;
    }
    var n: int = parse();
    if (n < 0) {
        if (parse_incomplete) { err("syntax error: unexpected end of file", null); }
        return 2;
    }
    var status: int = exec_node(n);
    last_status = status;
    return status;
}

// Run text s[0..n) in this shell (eval, function bodies, . files): it goes
// after the program being run (past its NUL), is lexed and parsed into new
// tokens and nodes, runs, and is dropped again. The running program's text,
// tokens and nodes are untouched.
fn eval_text(s: *char, n: int) -> int {
    var save_len: int = src_len;
    var save_tok: int = ntok;
    var save_nodes: int = nnodes;
    var base: int = src_len + 1;
    if (base + n >= SRC_MAX - 1) { err("program too large", null); return 2; }
    var k: int = 0;
    while (k < n) { src[base + k] = s[k]; k += 1; }
    src_len = base + n;
    var status: int = 2;
    if (lex_range(base) != 0) {
        if (lex_incomplete) { err(lex_error_message(), null); }
    } else {
        var root: int = parse_from(save_tok);
        if (root < 0) {
            if (parse_incomplete) { err("syntax error: unexpected end of file", null); }
        } else {
            status = exec_node(root);
        }
    }
    src_len = save_len;
    ntok = save_tok;
    nnodes = save_nodes;
    src[src_len] = 0;
    return status;
}

// ---- input ----------------------------------------------------------------------------------------------------

var inbuf: [2187]char;
var in_len: int;
var in_pos: int;
var got_sigint: int;

fn on_sigint(sig: int) { got_sigint = 1; }

// Append the next line from fd to src (with its newline): 1 = a line,
// 0 = end of file, -1 = interrupted.
fn read_line_into_src(fd: int) -> int {
    var n: int = 0;
    loop {
        if (in_pos == in_len) {
            var r: int = read(fd, &inbuf[0], 2187);
            if (r < 0 && errno == EINTR) { in_pos = 0; in_len = 0; return -1; }
            if (r <= 0) { return n > 0; }
            in_len = r;
            in_pos = 0;
        }
        var c: char = inbuf[in_pos];
        in_pos += 1;
        if (src_len < SRC_MAX - 2) { src[src_len] = c; src_len += 1; }
        n += 1;
        if (c == '\n') { return 1; }
    }
}

fn prompt(name: *char, dflt: *char) {
    var p: *char = var_get(name);
    fputs(STDERR_FILENO, p == null ? dflt : p);
}

// ---- line editing --------------------------------------------------------------------------------
//
// At a terminal the shell reads each line itself, with the terminal in raw
// mode (no ICANON or ECHO; ISIG stays on, so ^C still interrupts):
//   Left Right Home End, ^A ^E    move          Up Down     the history
//   Backspace Delete ^K ^U ^W     delete        Tab         complete a name
//   ^D on an empty line           end of input  Enter       done
// Typing at the end of the line echoes just the character, so the output is
// what canonical mode would have shown; other edits redraw the line with
// \r, ESC[K and ESC[nD (the console and the terminal window both have them).

const HIST_MAX: int = 81;
const ED_MAX: int = 2186;

var hist: [81]*char;                  // oldest first
var nhist: int;
var ed_buf: [2187]char;
var ed_len: int;
var ed_pos: int;
var ed_prompt: *char;
var ed_saved: [2187]char;             // the line being typed while browsing the history
var ed_hist_at: int;
var ed_tabs: int;                     // Tabs in a row (the second lists the choices)

fn ed_write(s: *char, n: int) { if (n > 0) { write(STDERR_FILENO, s, n); } }
fn ed_puts(s: *char) { ed_write(s, strlen(s)); }

fn ed_putc(c: int) {
    var b: [1]char;
    b[0] = c as char;
    ed_write(&b[0], 1);
}

fn ed_left(n: int) {
    if (n <= 0) { return; }
    var b: [15]char;
    ed_puts("\e[");
    ed_puts(itoa(n, &b[0]));
    ed_puts("D");
}

fn ed_redraw() {
    ed_puts("\r");
    ed_puts(ed_prompt);
    ed_write(&ed_buf[0], ed_len);
    ed_puts("\e[K");
    ed_left(ed_len - ed_pos);
}

// Insert n characters at the cursor.
fn ed_insert(s: *char, n: int) {
    if (ed_len + n > ED_MAX) { n = ED_MAX - ed_len; }
    if (n <= 0) { return; }
    var at_end: int = ed_pos == ed_len;
    var k: int = ed_len - 1;
    while (k >= ed_pos) { ed_buf[k + n] = ed_buf[k]; k -= 1; }
    k = 0;
    while (k < n) { ed_buf[ed_pos + k] = s[k]; k += 1; }
    ed_len += n;
    ed_pos += n;
    if (at_end) { ed_write(s, n); } else { ed_redraw(); }
}

// Delete n characters starting at index i.
fn ed_delete(i: int, n: int) {
    if (i < 0) { n += i; i = 0; }
    if (i + n > ed_len) { n = ed_len - i; }
    if (n <= 0) { return; }
    var at_end: int = i + n == ed_len && ed_pos == ed_len;
    var k: int = i;
    while (k + n < ed_len) { ed_buf[k] = ed_buf[k + n]; k += 1; }
    ed_len -= n;
    if (ed_pos > i + n) { ed_pos -= n; } else if (ed_pos > i) { ed_pos = i; }
    if (at_end && n == 1) { ed_putc(8); ed_putc(' '); ed_putc(8); } else { ed_redraw(); }   // as ECHOE does
}

fn ed_load(s: *char) {
    ed_len = strlen(s);
    if (ed_len > ED_MAX) { ed_len = ED_MAX; }
    var k: int = 0;
    while (k < ed_len) { ed_buf[k] = s[k]; k += 1; }
    ed_pos = ed_len;
    ed_redraw();
}

fn hist_add(s: *char) {
    if (s[0] == 0) { return; }
    if (nhist > 0 && streq(hist[nhist - 1], s)) { return; }
    if (nhist == HIST_MAX) {
        free(hist[0] as *tryte);
        var k: int = 1;
        while (k < nhist) { hist[k - 1] = hist[k]; k += 1; }
        nhist -= 1;
    }
    hist[nhist] = strdup(s);
    nhist += 1;
}

fn ed_history(dir: int) {
    if (dir < 0 && ed_hist_at == 0) { return; }
    if (dir > 0 && ed_hist_at >= nhist) { return; }
    if (ed_hist_at == nhist) {                         // leaving the line being typed: keep it
        var k: int = 0;
        while (k < ed_len) { ed_saved[k] = ed_buf[k]; k += 1; }
        ed_saved[ed_len] = 0;
    }
    ed_hist_at += dir;
    ed_load(ed_hist_at == nhist ? &ed_saved[0] : hist[ed_hist_at]);
}

// ---- completion ----

const CMAX: int = 243;
var cand: [243]*char;
var ncand: int;

fn cand_add(s: *char, dir: int) {
    var k: int = 0;
    while (k < ncand) { if (strncmp(cand[k], s, strlen(s)) == 0 && strlen(cand[k]) == strlen(s) + dir) { return; } k += 1; }
    if (ncand == CMAX) { return; }
    var c: *char = malloc(strlen(s) + 2) as *char;
    strcpy(c, s);
    if (dir) { strcat(c, "/"); }
    cand[ncand] = c;
    ncand += 1;
}

fn cand_clear() {
    var k: int = 0;
    while (k < ncand) { free(cand[k] as *tryte); k += 1; }
    ncand = 0;
}

fn starts_with(s: *char, p: *char, n: int) -> int { return strncmp(s, p, n) == 0; }

// Entries of directory dir starting with prefix p (n characters).
fn cand_dir(dir: *char, p: *char, n: int, only_programs: int) {
    var d: *DIR = opendir(dir);
    if (d == null) { return; }
    loop {
        var e: *dirent = readdir(d);
        if (e == null) { break; }
        var name: *char = &e.d_name[0];
        if (name[0] == '.' && p[0] != '.') { continue; }
        if (streq(name, ".") || streq(name, "..")) { continue; }
        if (!starts_with(name, p, n)) { continue; }
        var path: [486]char;
        strncpy(&path[0], dir, 240);
        path[240] = 0;
        strcat(&path[0], "/");
        strncat(&path[0], name, 240);
        var st: stat_t;
        var isdir: int = stat(&path[0], &st) == 0 && S_ISDIR(st.st_mode);
        if (only_programs && isdir) { continue; }
        cand_add(name, isdir);
    }
    closedir(d);
}

fn ed_complete() {
    var ws: int = ed_pos;
    while (ws > 0 && ed_buf[ws - 1] != ' ' && ed_buf[ws - 1] != '\t' && strchr(";&|<>(", ed_buf[ws - 1]) == null) { ws -= 1; }
    var word: [243]char;
    var wl: int = ed_pos - ws;
    if (wl > 242) { return; }
    var k: int = 0;
    while (k < wl) { word[k] = ed_buf[ws + k]; k += 1; }
    word[wl] = 0;
    var b: int = ws;
    while (b > 0 && (ed_buf[b - 1] == ' ' || ed_buf[b - 1] == '\t')) { b -= 1; }
    var command: int = (b == 0 || strchr(";&|(", ed_buf[b - 1]) != null) && strchr(&word[0], '/') == null;
    cand_clear();
    var stem: int = 0;                                  // where the completed part starts in word
    if (command) {
        var names: [31]*char = { ":", "true", "false", "echo", "cd", "pwd", "exit", "export", "unset", "set", "shift", "read",
            "test", "break", "continue", "jobs", "fg", "bg", "kill", "wait", "umask", "exec", "type", "eval",
            "return", "local", "alias", "unalias", "history", null, null };
        k = 0;
        while (names[k] != null) { if (starts_with(names[k], &word[0], wl)) { cand_add(names[k], 0); } k += 1; }
        k = 0;
        while (k < nfuncs) { if (fname[k] != null && starts_with(fname[k], &word[0], wl)) { cand_add(fname[k], 0); } k += 1; }
        k = 0;
        while (k < naliases) { if (aname[k] != null && starts_with(aname[k], &word[0], wl)) { cand_add(aname[k], 0); } k += 1; }
        var path: *char = var_get("PATH");
        if (path == null) { path = "/bin:/sbin"; }
        var i: int = 0;
        loop {
            var dir: [243]char;
            var n: int = 0;
            while (path[i] != 0 && path[i] != ':' && n < 242) { dir[n] = path[i]; n += 1; i += 1; }
            dir[n] = 0;
            cand_dir(n == 0 ? "." : &dir[0], &word[0], wl, 1);
            if (path[i] == 0) { break; }
            i += 1;
        }
    } else {
        var slash: int = -1;
        k = 0;
        while (k < wl) { if (word[k] == '/') { slash = k; } k += 1; }
        var dir2: [243]char;
        if (slash < 0) { strcpy(&dir2[0], "."); }
        else if (slash == 0) { strcpy(&dir2[0], "/"); }
        else { strncpy(&dir2[0], &word[0], slash); dir2[slash] = 0; }
        stem = slash + 1;
        cand_dir(&dir2[0], &word[stem], wl - stem, 0);
    }
    if (ncand == 0) { return; }
    // the longest common prefix of the candidates
    var common: int = strlen(cand[0]);
    k = 1;
    while (k < ncand) {
        var j: int = 0;
        while (j < common && cand[k][j] == cand[0][j]) { j += 1; }
        common = j;
        k += 1;
    }
    var have: int = wl - stem;
    if (common > have) {
        ed_insert(&cand[0][have], common - have);
        if (ncand == 1 && cand[0][common - 1] != '/') { ed_insert(" ", 1); }
        ed_tabs = 0;
        return;
    }
    if (ncand == 1) {
        if (cand[0][common - 1] != '/') { ed_insert(" ", 1); }
        return;
    }
    if (ed_tabs < 2) { return; }                       // the second Tab lists them
    qsort((&cand[0]) as *int, ncand, &cmp_fields);
    ed_puts("\n");
    k = 0;
    while (k < ncand) {
        if (k > 0) { ed_puts("  "); }
        ed_puts(cand[k]);
        k += 1;
    }
    ed_puts("\n");
    ed_redraw();
}

// One key from the terminal: a character, or one of these for an escape
// sequence. -1 = interrupted, -2 = end of input.
const K_UP: int = 100000;
const K_DOWN: int = 100001;
const K_RIGHT: int = 100002;
const K_LEFT: int = 100003;
const K_HOME: int = 100004;
const K_END: int = 100005;
const K_DEL: int = 100006;
const K_NONE: int = 100007;

fn ed_getc() -> int {
    var c: [1]char;
    var r: int = read(STDIN_FILENO, &c[0], 1);
    if (r < 0) { return errno == EINTR ? -1 : -2; }
    if (r == 0) { return -2; }
    return c[0];
}

fn ed_key() -> int {
    var c: int = ed_getc();
    if (c != 27) { return c; }
    c = ed_getc();
    if (c < 0) { return c; }
    if (c != '[' && c != 'O') { return K_NONE; }
    var num: int = 0;
    loop {
        c = ed_getc();
        if (c < 0) { return c; }
        if (c >= '0' && c <= '9') { num = num * 10 + c - '0'; continue; }
        if (c == ';') { continue; }
        break;
    }
    if (c == 'A') { return K_UP; }
    if (c == 'B') { return K_DOWN; }
    if (c == 'C') { return K_RIGHT; }
    if (c == 'D') { return K_LEFT; }
    if (c == 'H') { return K_HOME; }
    if (c == 'F') { return K_END; }
    if (c == '~') {
        if (num == 1 || num == 7) { return K_HOME; }
        if (num == 4 || num == 8) { return K_END; }
        if (num == 3) { return K_DEL; }
    }
    return K_NONE;
}

// Read a line with editing, after prompt p, onto src (with its newline):
// 1 = a line, 0 = end of input, -1 = interrupted. Falls back to plain
// reading when standard input is not a terminal.
fn edit_line_into_src(p: *char) -> int {
    var saved: termios;
    if (tcgetattr(STDIN_FILENO, &saved) < 0) {
        fputs(STDERR_FILENO, p);
        return read_line_into_src(STDIN_FILENO);
    }
    var raw: termios;
    tcgetattr(STDIN_FILENO, &raw);
    if (raw.c_lflag / ICANON % 2 != 0) { raw.c_lflag -= ICANON; }
    if (raw.c_lflag / ECHO % 2 != 0) { raw.c_lflag -= ECHO; }
    raw.c_cc[VMIN] = 1;
    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
    ed_prompt = p;
    ed_len = 0;
    ed_pos = 0;
    ed_hist_at = nhist;
    ed_tabs = 0;
    ed_puts(p);
    var result: int = 1;
    loop {
        var c: int = ed_key();
        if (c != '\t') { ed_tabs = 0; }
        if (c == -1) { ed_puts("^C"); result = -1; break; }
        if (c == -2) { result = ed_len > 0 ? 1 : 0; if (ed_len > 0) { ed_puts("\n"); } break; }
        if (c == '\n' || c == '\r') { ed_puts("\n"); break; }
        if (c == 4) {                                   // ^D
            if (ed_len == 0) { result = 0; break; }
            ed_delete(ed_pos, 1);
        } else if (c == 127 || c == 8) { ed_delete(ed_pos - 1, 1); }
        else if (c == K_DEL) { ed_delete(ed_pos, 1); }
        else if (c == K_LEFT) { if (ed_pos > 0) { ed_pos -= 1; ed_left(1); } }
        else if (c == K_RIGHT) { if (ed_pos < ed_len) { ed_pos += 1; ed_puts("\e[C"); } }
        else if (c == K_HOME || c == 1) { ed_pos = 0; ed_redraw(); }
        else if (c == K_END || c == 5) { ed_pos = ed_len; ed_redraw(); }
        else if (c == K_UP) { ed_history(-1); }
        else if (c == K_DOWN) { ed_history(1); }
        else if (c == 11) { ed_delete(ed_pos, ed_len - ed_pos); }      // ^K
        else if (c == 21) { ed_delete(0, ed_pos); }                     // ^U
        else if (c == 23) {                                             // ^W: the word before the cursor
            var w: int = ed_pos;
            while (w > 0 && ed_buf[w - 1] == ' ') { w -= 1; }
            while (w > 0 && ed_buf[w - 1] != ' ') { w -= 1; }
            ed_delete(w, ed_pos - w);
        } else if (c == '\t') { ed_tabs += 1; ed_complete(); }
        else if (c >= 32 && c < K_UP) {
            var ch: [1]char;
            ch[0] = c as char;
            ed_insert(&ch[0], 1);
        }
    }
    tcsetattr(STDIN_FILENO, TCSANOW, &saved);
    if (result != 1) { return result; }
    ed_buf[ed_len] = 0;
    hist_add(&ed_buf[0]);
    var k: int = 0;
    while (k < ed_len && src_len < SRC_MAX - 2) { src[src_len] = ed_buf[k]; src_len += 1; k += 1; }
    if (src_len < SRC_MAX - 2) { src[src_len] = '\n'; src_len += 1; }
    return 1;
}

fn prompt_text(name: *char, dflt: *char) -> *char {
    var p: *char = var_get(name);
    return p == null ? dflt : p;
}

fn interactive_loop() -> int {
    loop {
        reap_jobs();
        src_len = 0;
        abort_line = 0;
        break_count = 0;
        continue_count = 0;
        var r: int = edit_line_into_src(prompt_text("PS1", "$ "));
        if (r < 0) { puts("\n"); continue; }
        if (r == 0) { break; }
        // more lines while the command is unfinished
        loop {
            var l: int = lex();
            if (l == 0) {
                var n: int = parse();
                if (n >= 0) {
                    exp = 0;
                    nfields = 0;
                    last_status = exec_node(n);
                    break;
                }
                if (!parse_incomplete) { last_status = 2; break; }
            } else if (l != 1) {
                last_status = 2;
                break;
            }
            var r2: int = edit_line_into_src(prompt_text("PS2", "> "));
            if (r2 < 0) { puts("\n"); break; }
            if (r2 == 0) {
                err("syntax error: unexpected end of file", null);
                last_status = 2;
                break;
            }
        }
    }
    fputs(STDERR_FILENO, "exit\n");
    return last_status;
}

fn read_script(fd: int, name: *char) -> int {
    src_len = 0;
    loop {
        var r: int = read(fd, &src[src_len], SRC_MAX - 1 - src_len);
        if (r < 0) { perror2("sh", name); return -1; }
        if (r == 0) { break; }
        src_len += r;
        if (src_len >= SRC_MAX - 1) { err(name, ": script too long"); return -1; }
    }
    return 0;
}

fn main(argc: int, argv: **char) -> int {
    shell_pgid = getpgrp();
    import_environ();
    if (var_get("PATH") == null) { var_set("PATH", "/bin:/sbin", 1); }
    arg0 = argv[0];
    save_begin();
    if (argc > 2 && streq(argv[1], "-c")) {
        if (argc > 3) { arg0 = argv[3]; set_positional(argc - 4, &argv[4]); }
        var n: int = strlen(argv[2]);
        if (n >= SRC_MAX - 1) { err("-c: command too long", null); return 2; }
        strcpy(&src[0], argv[2]);
        src_len = n;
        return run_source();
    }
    if (argc > 1) {
        var fd: int = open(argv[1], O_RDONLY, 0);
        if (fd < 0) { perror2("sh", argv[1]); return 127; }
        arg0 = argv[1];
        set_positional(argc - 2, &argv[2]);
        if (read_script(fd, argv[1]) < 0) { return 2; }
        close(fd);
        return run_source();
    }
    interactive = isatty(STDIN_FILENO);
    if (!interactive) {
        if (read_script(STDIN_FILENO, "stdin") < 0) { return 2; }
        return run_source();
    }
    job_control = 1;
    setpgid(0, 0);
    shell_pgid = getpgrp();
    tcsetpgrp(STDIN_FILENO, shell_pgid);
    signal(SIGINT, &on_sigint as int);                 // ^C at the prompt: a fresh prompt
    signal(SIGQUIT, SIG_IGN);
    signal(SIGTSTP, SIG_IGN);
    signal(SIGTTIN, SIG_IGN);
    signal(SIGTTOU, SIG_IGN);
    return interactive_loop();
}
