// ls [-acltur] [path ...]: list directory contents, sorted by name; -l
// long form with the modification time, -t sorted by time (newest
// first), -u the access time and -c the change time instead, -r reversed.

import "../lib/tlibc.tri";
import "../lib/pwd.tri";
import "../lib/time.tri";

var names: [243][27]char;
var times: [243]int;
var count: int;
var show_all: int;
var long_form: int;
var by_time: int;
var which_time: int;                     // 'm', 'a' (-u) or 'c' (-c)
var reverse: int;
var now: int;

fn copy_name(dst: *char, src: *char) {
    var k: int = 0;
    while (src[k] != 0) { dst[k] = src[k]; k += 1; }
    dst[k] = 0;
}

// The time ls shows and sorts by.
fn chosen_time(st: *stat_t) -> int {
    if (which_time == 'a') { return st.st_atime; }
    if (which_time == 'c') { return st.st_ctime; }
    return st.st_mtime;
}

// Does entry a come before entry b? By name, or by time (newest first,
// then by name); -r reverses either.
fn before(a: *char, ta: int, b: *char, tb: int) -> int {
    var r: int;
    if (by_time && ta != tb) {
        r = ta > tb ? -1 : 1;
    } else {
        r = strcmp(a, b);
    }
    return reverse ? r > 0 : r < 0;
}

fn sort_names() {
    var i: int = 1;
    while (i < count) {
        var tmp: [27]char;
        copy_name(&tmp[0], &names[i][0]);
        var tt: int = times[i];
        var j: int = i - 1;
        while (j >= 0 && before(&tmp[0], tt, &names[j][0], times[j])) {
            copy_name(&names[j + 1][0], &names[j][0]);
            times[j + 1] = times[j];
            j -= 1;
        }
        copy_name(&names[j + 1][0], &tmp[0]);
        times[j + 1] = tt;
        i += 1;
    }
}

fn type_char(m: int) -> *char {
    if (S_ISDIR(m)) { return "d"; }
    if (S_ISCHR(m)) { return "c"; }
    if (S_ISFIFO(m)) { return "p"; }
    return "-";
}

// "-rwxr-xr-x", with s for set-user/group-ID and t for sticky in the
// execute places (S and T when that execute bit is off).
fn put_mode(m: int) {
    puts(type_char(m));
    var bits: *char = "rwxrwxrwx";
    var k: int = 0;
    var w: int = 256;
    while (k < 9) {
        var on: int = m / w % 2 != 0;
        var special: int = (k == 2 && m / 2048 % 2 != 0) || (k == 5 && m / 1024 % 2 != 0) || (k == 8 && m / 512 % 2 != 0);
        if (special) { puts(k == 8 ? (on ? "t" : "T") : (on ? "s" : "S")); }
        else if (on) { write(STDOUT_FILENO, &bits[k], 1); } else { puts("-"); }
        w = w / 2;
        k += 1;
    }
}

// The names of owners and groups, looked up once each.
var last_uid: int = -1;
var last_user: [27]char;
var last_gid: int = -1;
var last_group: [27]char;

fn put_name(s: *char) {
    puts(s);
    var n: int = strlen(s);
    while (n < 8) { puts(" "); n += 1; }
}

fn put_padded(v: int, width: int) {
    var buf: [15]char;
    var s: *char = itoa(v, &buf[0]);
    var n: int = strlen(s);
    while (n < width) { puts(" "); n += 1; }
    puts(s);
}

// "Oct  8 13:30" within six months of now, "Oct  8  2025" otherwise (as
// POSIX ls -l).
fn put_time(t: int) {
    var b: tm;
    gmtime_r(t, &b);
    var buf: [41]char;
    var half_year: int = 15778476;
    if (t <= now && now - t < half_year) {
        strftime(&buf[0], 41, "%b %e %H:%M", &b);
    } else {
        strftime(&buf[0], 41, "%b %e  %Y", &b);
    }
    puts(&buf[0]);
}

fn path_of(dir: *char, name: *char, path: *char) {
    var k: int = 0;
    if (dir != null) {
        while (dir[k] != 0) { path[k] = dir[k]; k += 1; }
        path[k] = '/';
        k += 1;
    }
    copy_name(&path[k], name);
}

// One entry; `dir` is null when `name` is already a path.
fn show(dir: *char, name: *char) {
    if (long_form) {
        var path: [243]char;
        path_of(dir, name, &path[0]);
        var st: stat_t;
        if (stat(&path[0], &st) == 0) {
            put_mode(st.st_mode);
            puts(" ");
            put_int(st.st_nlink);
            puts(" ");
            if (st.st_uid != last_uid) { strncpy(&last_user[0], user_name(st.st_uid), 26); last_user[26] = 0; last_uid = st.st_uid; }
            if (st.st_gid != last_gid) { strncpy(&last_group[0], group_name(st.st_gid), 26); last_group[26] = 0; last_gid = st.st_gid; }
            put_name(&last_user[0]);
            puts(" ");
            put_name(&last_group[0]);
            puts(" ");
            put_padded(st.st_size, 7);
            puts(" ");
            put_time(chosen_time(&st));
            puts(" ");
        }
    }
    puts(name);
    puts("\n");
}

fn list(path: *char, heading: int) -> int {
    var st: stat_t;
    if (stat(path, &st) < 0) { perror2("ls", path); return 1; }
    if (!S_ISDIR(st.st_mode)) {
        show(null, path);
        return 0;
    }
    var d: *DIR = opendir(path);
    if (d == null) { perror2("ls", path); return 1; }
    count = 0;
    loop {
        var e: *dirent = readdir(d);
        if (e == null) { break; }
        if (e.d_name[0] == '.' && !show_all) { continue; }
        if (count < 243) {
            copy_name(&names[count][0], &e.d_name[0]);
            times[count] = 0;
            count += 1;
        }
    }
    closedir(d);
    if (by_time) {
        var i0: int = 0;
        while (i0 < count) {
            var p: [243]char;
            path_of(path, &names[i0][0], &p[0]);
            var es: stat_t;
            if (stat(&p[0], &es) == 0) { times[i0] = chosen_time(&es); }
            i0 += 1;
        }
    }
    sort_names();
    if (heading) { puts(path); puts(":\n"); }
    var i: int = 0;
    while (i < count) { show(path, &names[i][0]); i += 1; }
    return 0;
}

fn main(argc: int, argv: **char) -> int {
    which_time = 'm';
    var i: int = 1;
    while (i < argc && argv[i][0] == '-' && argv[i][1] != 0) {
        var k: int = 1;
        while (argv[i][k] != 0) {
            var c: int = argv[i][k];
            if (c == 'a') { show_all = 1; }
            else if (c == 'l') { long_form = 1; }
            else if (c == 't') { by_time = 1; }
            else if (c == 'u') { which_time = 'a'; }
            else if (c == 'c') { which_time = 'c'; }
            else if (c == 'r') { reverse = 1; }
            else { fputs(STDERR_FILENO, "usage: ls [-acltur] [path ...]\n"); return 2; }
            k += 1;
        }
        i += 1;
    }
    now = time(null);
    if (i == argc) { return list(".", 0); }
    var status: int = 0;
    var many: int = argc - i > 1;
    while (i < argc) {
        if (list(argv[i], many) != 0) { status = 1; }
        i += 1;
    }
    return status;
}
