// ls [-a] [-l] [path ...]: list directory contents, sorted by name.

import "../lib/tlibc.tri";

var names: [243][27]char;
var count: int;
var show_all: int;
var long_form: int;

fn copy_name(dst: *char, src: *char) {
    var k: int = 0;
    while (src[k] != 0) { dst[k] = src[k]; k += 1; }
    dst[k] = 0;
}

fn sort_names() {
    var i: int = 1;
    while (i < count) {
        var tmp: [27]char;
        copy_name(&tmp[0], &names[i][0]);
        var j: int = i - 1;
        while (j >= 0 && strcmp(&names[j][0], &tmp[0]) > 0) {
            copy_name(&names[j + 1][0], &names[j][0]);
            j -= 1;
        }
        copy_name(&names[j + 1][0], &tmp[0]);
        i += 1;
    }
}

fn type_char(m: int) -> *char {
    if (S_ISDIR(m)) { return "d"; }
    if (S_ISCHR(m)) { return "c"; }
    if (S_ISFIFO(m)) { return "p"; }
    return "-";
}

fn put_mode(m: int) {
    puts(type_char(m));
    var bits: *char = "rwxrwxrwx";
    var k: int = 0;
    var w: int = 256;
    while (k < 9) {
        if (m / w % 2 != 0) { write(STDOUT_FILENO, &bits[k], 1); } else { puts("-"); }
        w = w / 2;
        k += 1;
    }
}

fn put_padded(v: int, width: int) {
    var buf: [15]char;
    var s: *char = itoa(v, &buf[0]);
    var n: int = strlen(s);
    while (n < width) { puts(" "); n += 1; }
    puts(s);
}

// One entry; `dir` is null when `name` is already a path.
fn show(dir: *char, name: *char) {
    if (long_form) {
        var path: [243]char;
        var k: int = 0;
        if (dir != null) {
            while (dir[k] != 0) { path[k] = dir[k]; k += 1; }
            path[k] = '/';
            k += 1;
        }
        copy_name(&path[k], name);
        var st: stat_t;
        if (stat(&path[0], &st) == 0) {
            put_mode(st.st_mode);
            puts(" ");
            put_int(st.st_nlink);
            puts(" root root ");
            put_padded(st.st_size, 7);
            puts(" ");
        }
    }
    puts(name);
    puts("\n");
}

fn list(path: *char, heading: int) -> int {
    var st: stat_t;
    if (stat(path, &st) < 0) { perror2("ls", path); return 1; }
    if (!S_ISDIR(st.st_mode)) {
        show(null, path);
        return 0;
    }
    var d: *DIR = opendir(path);
    if (d == null) { perror2("ls", path); return 1; }
    count = 0;
    loop {
        var e: *dirent = readdir(d);
        if (e == null) { break; }
        if (e.d_name[0] == '.' && !show_all) { continue; }
        if (count < 243) {
            copy_name(&names[count][0], &e.d_name[0]);
            count += 1;
        }
    }
    closedir(d);
    sort_names();
    if (heading) { puts(path); puts(":\n"); }
    var i: int = 0;
    while (i < count) { show(path, &names[i][0]); i += 1; }
    return 0;
}

fn main(argc: int, argv: **char) -> int {
    var i: int = 1;
    while (i < argc && argv[i][0] == '-' && argv[i][1] != 0) {
        var k: int = 1;
        while (argv[i][k] != 0) {
            if (argv[i][k] == 'a') { show_all = 1; }
            else if (argv[i][k] == 'l') { long_form = 1; }
            else { fputs(STDERR_FILENO, "usage: ls [-al] [path ...]\n"); return 2; }
            k += 1;
        }
        i += 1;
    }
    if (i == argc) { return list(".", 0); }
    var status: int = 0;
    var many: int = argc - i > 1;
    while (i < argc) {
        if (list(argv[i], many) != 0) { status = 1; }
        i += 1;
    }
    return status;
}
