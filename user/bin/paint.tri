// paint: draw with the mouse. The strip on top picks a colour; drag on the
// canvas below to paint 3 x 3 dots.

import "../lib/tlibc.tri";
import "../lib/gfx.tri";
import "../lib/trw.tri";

const W: int = 243;
const H: int = 162;
const STRIP: int = 18;

var palette: [9]int;
var current: int;

fn draw_strip() {
    var k: int = 0;
    while (k < 9) {
        trw_fill(k * 27, 0, 27, STRIP, palette[k]);
        if (k == current) { trw_fill(k * 27 + 9, STRIP - 4, 9, 3, k == 0 ? -9841 : 9841); }
        k += 1;
    }
}

fn main(argc: int, argv: **char) -> int {
    palette[0] = rgb(13, 13, 13);
    palette[1] = rgb(-13, -13, -13);
    palette[2] = rgb(13, -13, -13);
    palette[3] = rgb(-13, 13, -13);
    palette[4] = rgb(-13, -13, 13);
    palette[5] = rgb(13, 13, -13);
    palette[6] = rgb(13, -13, 13);
    palette[7] = rgb(-13, 13, 13);
    palette[8] = rgb(0, 0, 0);
    current = 2;
    trw_create(W, H, "Paint");
    trw_fill(0, 0, W, H, 9841);
    draw_strip();
    trw_flush();
    var ev: trw_event;
    loop {
        var r: int = trw_wait(&ev, -1, -1);
        if (r < 0 || (r == 1 && ev.type == TRW_CLOSE)) { return 0; }
        if (ev.type != TRW_BUTTON && ev.type != TRW_MOTION) { continue; }
        if (ev.c % 3 == 0) { continue; }             // only while the left button is down
        if (ev.b < STRIP) {
            if (ev.type == TRW_BUTTON && ev.a >= 0 && ev.a < 9 * 27) {
                current = ev.a / 27;
                draw_strip();
                trw_flush();
            }
            continue;
        }
        trw_fill(ev.a - 1, ev.b - 1, 3, 3, palette[current]);
        trw_flush();
    }
}
