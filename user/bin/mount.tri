// mount                          list mounted file systems (/proc/mounts)
// mount -t type source dir       mount ramfs/tmpfs or proc on dir

import "../lib/tlibc.tri";

var buf: [2187]char;

fn main(argc: int, argv: **char) -> int {
    if (argc == 1) {
        var fd: int = open("/proc/mounts", O_RDONLY, 0);
        if (fd < 0) { perror2("mount", "/proc/mounts"); return 1; }
        loop {
            var n: int = read(fd, &buf[0], 2187);
            if (n <= 0) { break; }
            write(STDOUT_FILENO, &buf[0], n);
        }
        close(fd);
        return 0;
    }
    if (argc != 5 || !streq(argv[1], "-t")) {
        fputs(STDERR_FILENO, "usage: mount [-t type source dir]\n");
        return 2;
    }
    if (mount(argv[3], argv[4], argv[2], 0, null) < 0) { perror2("mount", argv[4]); return 1; }
    return 0;
}
