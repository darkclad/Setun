// sort [-rnu] [file ...]: sort lines.

import "../lib/tlibc.tri";
import "../lib/string.tri";
import "../lib/stdlib.tri";
import "../lib/stdio.tri";
import "../lib/getopt.tri";

var reverse: int;
var numeric: int;
var unique: int;
var lines: **char;
var nlines: int;
var cap: int;

fn cmp_lines(a: int, b: int) -> int {
    var r: int;
    if (numeric) {
        var x: int = strtol(a as *char, null, 10);
        var y: int = strtol(b as *char, null, 10);
        sign (x <=> y) {
            neg: { r = -1; }
            zero: { r = strcmp(a as *char, b as *char); }
            pos: { r = 1; }
        }
    } else {
        r = strcmp(a as *char, b as *char);
    }
    return reverse ? -r : r;
}

fn add_line(s: *char) -> int {
    if (nlines == cap) {
        cap = cap == 0 ? 243 : cap * 3;
        lines = realloc(lines as *tryte, 3 * cap) as **char;
        if (lines == null) { return 0; }
    }
    lines[nlines] = strdup(s);
    if (lines[nlines] == null) { return 0; }
    nlines += 1;
    return 1;
}

var buf: [2187]char;

fn slurp(f: *FILE) -> int {
    while (fgets(&buf[0], 2187, f) != null) {
        var n: int = strlen(&buf[0]);
        if (n > 0 && buf[n - 1] == '\n') { buf[n - 1] = 0; }
        if (!add_line(&buf[0])) { fputs(STDERR_FILENO, "sort: out of memory\n"); return 0; }
    }
    return 1;
}

fn main(argc: int, argv: **char) -> int {
    var c: int = getopt(argc, argv, "rnu");
    while (c != -1) {
        if (c == 'r') { reverse = 1; }
        else if (c == 'n') { numeric = 1; }
        else if (c == 'u') { unique = 1; }
        else { fputs(STDERR_FILENO, "usage: sort [-rnu] [file ...]\n"); return 2; }
        c = getopt(argc, argv, "rnu");
    }
    if (optind == argc) {
        if (!slurp(stdin())) { return 2; }
    }
    var i: int = optind;
    while (i < argc) {
        var f: *FILE = fopen(argv[i], "r");
        if (f == null) { perror2("sort", argv[i]); return 2; }
        if (!slurp(f)) { return 2; }
        fclose(f);
        i += 1;
    }
    qsort(lines as *int, nlines, &cmp_lines);
    i = 0;
    while (i < nlines) {
        if (!unique || i == 0 || cmp_lines(lines[i - 1] as int, lines[i] as int) != 0) {
            puts(lines[i]);
            puts("\n");
        }
        i += 1;
    }
    return 0;
}
