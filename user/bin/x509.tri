// x509 [-C CAFILE] [-n HOST] [-t SECONDS] FILE: check a certificate chain
// the way a TLS client would (lib/x509.tri). FILE holds PEM certificates,
// the server's own first. Each is listed with its issuer, then "verify: ok"
// or the reason it fails. The trust store is /etc/ssl/cert.pem unless -C
// names another; -n checks the name too; -t checks at another time.
// x509 -l [-C CAFILE] lists the trust store instead.
// Exit status: 0 if the chain holds, 1 if not, 2 for trouble reading.

import "../lib/tlibc.tri";
import "../lib/stdlib.tri";
import "../lib/getopt.tri";
import "../lib/time.tri";
import "../lib/x509.tri";

var chain_certs: [9]x509;
var chain_der: [59049]tryte;
var chain: pem_set;

fn usage() -> int {
    fputs(STDERR_FILENO, "usage: x509 [-C cafile] [-n host] [-t seconds] chain.pem | x509 -l [-C cafile]\n");
    return 2;
}

fn main(argc: int, argv: **char) -> int {
    var cafile: *char = "/etc/ssl/cert.pem";
    var host: *char = null;
    var list: int = 0;
    var now: int = time(null);
    var c: int = getopt(argc, argv, "lC:n:t:");
    while (c != -1) {
        switch (c) {
            case 'l': list = 1;
            case 'C': cafile = optarg;
            case 'n': host = optarg;
            case 't': now = atoi(optarg);
            default: return usage();
        }
        c = getopt(argc, argv, "lC:n:t:");
    }
    if (optind != argc - (list ? 0 : 1)) { return usage(); }
    bin32_init();
    if (x509_load_store(cafile) < 0) {
        fputs(STDERR_FILENO, "x509: cannot read ");
        fputs(STDERR_FILENO, cafile);
        fputs(STDERR_FILENO, "\n");
        return 2;
    }
    var name: [81]char;
    if (list) {
        var i: int = 0;
        while (i < x509_store_count()) {
            x509_name(x509_store_cert(i), 0, &name[0], 81);
            puts(&name[0]);
            puts("\n");
            i += 1;
        }
        return 0;
    }
    chain.certs = &chain_certs[0];
    chain.max = 9;
    chain.der = &chain_der[0];
    chain.dermax = 59049;
    var r: int = x509_read_pem(&chain, argv[optind], 1);
    if (r < 0 || chain.n == 0) {
        fputs(STDERR_FILENO, "x509: ");
        fputs(STDERR_FILENO, argv[optind]);
        fputs(STDERR_FILENO, ": ");
        fputs(STDERR_FILENO, r < 0 ? x509_error(r) : "no certificates");
        fputs(STDERR_FILENO, "\n");
        return 2;
    }
    var k: int = 0;
    while (k < chain.n) {
        put_int(k);
        puts(": ");
        x509_name(&chain_certs[k], 0, &name[0], 81);
        puts(&name[0]);
        puts(" (issued by ");
        x509_name(&chain_certs[k], 1, &name[0], 81);
        puts(&name[0]);
        puts(")\n");
        k += 1;
    }
    r = x509_verify_chain(&chain_certs[0], chain.n, host, now);
    puts("verify: ");
    puts(r == 0 ? "ok" : x509_error(r));
    puts("\n");
    return r == 0 ? 0 : 1;
}
