// grep [-ivcnq] pattern [file ...]: print lines matching a basic regular
// expression: literals, . * ^ $ [abc] [^a-z] and \ escapes.
// Exit status: 0 if a line matched, 1 if none did, 2 on an error.

import "../lib/tlibc.tri";
import "../lib/ctype.tri";
import "../lib/stdlib.tri";
import "../lib/stdio.tri";
import "../lib/getopt.tri";

var ignore_case: int;
var invert: int;
var count_only: int;
var numbers: int;
var quiet: int;

fn fold(c: int) -> int { return ignore_case ? tolower(c) : c; }

// Length of the [...] class at p (including the brackets), or 0 if unclosed.
fn class_len(p: *char) -> int {
    var k: int = 1;
    if (p[k] == '^') { k += 1; }
    if (p[k] == ']') { k += 1; }
    while (p[k] != 0 && p[k] != ']') { k += 1; }
    return p[k] == ']' ? k + 1 : 0;
}

fn class_match(p: *char, c: int) -> int {
    var k: int = 1;
    var neg: int = p[1] == '^';
    if (neg) { k = 2; }
    var hit: int = 0;
    var first: int = 1;
    while (p[k] != ']' || first) {
        if (p[k + 1] == '-' && p[k + 2] != ']') {
            if (fold(c) >= fold(p[k]) && fold(c) <= fold(p[k + 2])) { hit = 1; }
            k += 3;
        } else {
            if (fold(c) == fold(p[k])) { hit = 1; }
            k += 1;
        }
        first = 0;
    }
    return hit != neg;
}

// One pattern element at p: its length, or -1 for a bad pattern.
fn elem_len(p: *char) -> int {
    if (p[0] == '\\') { return p[1] != 0 ? 2 : -1; }
    if (p[0] == '[') { var n: int = class_len(p); return n > 0 ? n : -1; }
    return 1;
}

fn elem_match(p: *char, c: int) -> int {
    if (c == 0) { return 0; }
    if (p[0] == '\\') { return fold(p[1]) == fold(c); }
    if (p[0] == '[') { return class_match(p, c); }
    if (p[0] == '.') { return 1; }
    return fold(p[0]) == fold(c);
}

// Does pattern p match at the start of s? (Kernighan and Pike's matcher.)
fn match_here(p: *char, s: *char) -> int {
    if (p[0] == 0) { return 1; }
    if (p[0] == '$' && p[1] == 0) { return s[0] == 0; }
    var n: int = elem_len(p);
    if (p[n] == '*') {
        // zero or more of this element, longest first
        var k: int = 0;
        while (s[k] != 0 && elem_match(p, s[k])) { k += 1; }
        while (k >= 0) {
            if (match_here(&p[n + 1], &s[k])) { return 1; }
            k -= 1;
        }
        return 0;
    }
    if (s[0] != 0 && elem_match(p, s[0])) { return match_here(&p[n], &s[1]); }
    return 0;
}

fn matches(p: *char, s: *char) -> int {
    if (p[0] == '^') { return match_here(&p[1], s); }
    var i: int = 0;
    loop {
        if (match_here(p, &s[i])) { return 1; }
        if (s[i] == 0) { return 0; }
        i += 1;
    }
}

fn valid(p: *char) -> int {
    var i: int = 0;
    while (p[i] != 0) {
        var n: int = elem_len(&p[i]);
        if (n < 0) { return 0; }
        i += n;
    }
    return 1;
}

var line: [2187]char;

// Returns the number of matching lines.
fn grep(p: *char, f: *FILE, name: *char, many: int) -> int {
    var found: int = 0;
    var lineno: int = 0;
    while (fgets(&line[0], 2187, f) != null) {
        lineno += 1;
        var n: int = strlen(&line[0]);
        if (n > 0 && line[n - 1] == '\n') { line[n - 1] = 0; }
        if (matches(p, &line[0]) != invert) {
            found += 1;
            if (quiet) { return found; }
            if (!count_only) {
                if (many) { puts(name); puts(":"); }
                if (numbers) { put_int(lineno); puts(":"); }
                puts(&line[0]);
                puts("\n");
            }
        }
    }
    if (count_only) {
        if (many) { puts(name); puts(":"); }
        put_int(found);
        puts("\n");
    }
    return found;
}

fn main(argc: int, argv: **char) -> int {
    var c: int = getopt(argc, argv, "ivcnq");
    while (c != -1) {
        if (c == 'i') { ignore_case = 1; }
        else if (c == 'v') { invert = 1; }
        else if (c == 'c') { count_only = 1; }
        else if (c == 'n') { numbers = 1; }
        else if (c == 'q') { quiet = 1; }
        else { fputs(STDERR_FILENO, "usage: grep [-ivcnq] pattern [file ...]\n"); return 2; }
        c = getopt(argc, argv, "ivcnq");
    }
    if (optind == argc) { fputs(STDERR_FILENO, "usage: grep [-ivcnq] pattern [file ...]\n"); return 2; }
    var pat: *char = argv[optind];
    if (!valid(pat)) {
        fputs(STDERR_FILENO, "grep: invalid pattern: ");
        fputs(STDERR_FILENO, pat);
        fputs(STDERR_FILENO, "\n");
        return 2;
    }
    optind += 1;
    var found: int = 0;
    var errors: int = 0;
    if (optind == argc) { found = grep(pat, stdin(), "(standard input)", 0); }
    var many: int = argc - optind > 1;
    var i: int = optind;
    while (i < argc) {
        var f: *FILE = fopen(argv[i], "r");
        if (f == null) { perror2("grep", argv[i]); errors = 1; }
        else { found += grep(pat, f, argv[i], many); fclose(f); }
        if (quiet && found > 0) { return 0; }
        i += 1;
    }
    if (errors && !quiet) { return 2; }
    return found > 0 ? 0 : (errors ? 2 : 1);
}
