// ssh [-p PORT] [-l USER] [-i KEY] [-t | -T] [USER@]HOST [COMMAND ...]
//
// The SSH client: the same transport as sshd (lib/ssh.tri), as the other
// side. The server's host key is checked against ~/.ssh/known_hosts: a new
// host is added (OpenSSH's StrictHostKeyChecking=accept-new); a changed key
// ends the connection. Login tries the key ~/.ssh/id_ed25519 (or -i) and
// then a password, three times. Without COMMAND, on a terminal, the
// session is a shell on a pty, with the terminal in raw mode; "~." at the
// start of a line disconnects. The exit status is the remote command's,
// or 255 when ssh itself fails.

import "../lib/tlibc.tri";
import "../lib/stdlib.tri";
import "../lib/string.tri";
import "../lib/getopt.tri";
import "../lib/pwd.tri";
import "../lib/sshclient.tri";

// ---- the session --------------------------------------------------------------------------

const WINDOW: int = 59049;
var rwin: int;                            // what the server lets us send
var rmax: int;
var lwin: int;
var server_ch: int;
var exit_code: int = 255;
var got_status: int;
var raw_tty: int;
var saved_tty: termios;
var dec: utf8_state;
var dec_err: utf8_state;
var text: [2187]char;
var inbuf: [729]char;
var pend: [6600]tryte;                    // typed input waiting for window
var pend_len: int;
var line_start: int = 1;                  // for "~."
var tilde: int;

fn restore_tty() {
    if (raw_tty) {
        tcsetattr(STDIN_FILENO, TCSANOW, &saved_tty);
        raw_tty = 0;
    }
}

fn finish(code: int) {
    restore_tty();
    close(sock);
    _exit(code);
}

// Wait for the reply to a channel request.
fn channel_reply() -> int {
    loop {
        var t: int = read_packet();
        if (t == SSH_MSG_CHANNEL_SUCCESS) { return 1; }
        if (t == SSH_MSG_CHANNEL_FAILURE) { return 0; }
        if (t == SSH_MSG_CHANNEL_WINDOW_ADJUST) {
            get_u32();
            rwin += get_u32();
            continue;
        }
        if (t == SSH_MSG_GLOBAL_REQUEST) { continue; }
        disconnect(DISCONNECT_PROTOCOL_ERROR, "unexpected message while starting the session");
    }
}

fn flush_pending() {
    var at: int = 0;
    while (at < pend_len && rwin > 0) {
        var n: int = pend_len - at;
        if (n > rwin) { n = rwin; }
        if (n > rmax) { n = rmax; }
        out_start(SSH_MSG_CHANNEL_DATA);
        put_u32(server_ch);
        put_string(&pend[at], n);
        send_packet();
        rwin -= n;
        at += n;
    }
    var k: int = 0;
    while (at + k < pend_len) { pend[k] = pend[at + k]; k += 1; }
    pend_len -= at;
}

fn write_all_fd(fd: int, p: *char, n: int) {
    var k: int = 0;
    while (k < n) {
        var w: int = write(fd, p + k, n - k);
        if (w <= 0) { return; }
        k += w;
    }
}

// One message from the server during the session.
fn session_message(t: int) {
    switch (t) {
        case SSH_MSG_CHANNEL_DATA, SSH_MSG_CHANNEL_EXTENDED_DATA: {
            get_u32();
            var ext: int = t == SSH_MSG_CHANNEL_EXTENDED_DATA;
            if (ext) { get_u32(); }
            var at: int = 0;
            var n: int = get_string(&at);
            if (bad) { disconnect(DISCONNECT_PROTOCOL_ERROR, "bad CHANNEL_DATA"); }
            if (n > lwin) { disconnect(DISCONNECT_PROTOCOL_ERROR, "the server ignored the window"); }
            lwin -= n;
            var done: int = 0;
            while (done < n) {
                var part: int = n - done > 2187 ? 2187 : n - done;
                var m: int = utf8_to_text(ext ? &dec_err : &dec, &pkt[at + done], part, &text[0]);
                write_all_fd(ext ? STDERR_FILENO : STDOUT_FILENO, &text[0], m);
                done += part;
            }
            if (lwin < WINDOW / 2) {
                out_start(SSH_MSG_CHANNEL_WINDOW_ADJUST);
                put_u32(server_ch);
                put_u32(WINDOW - lwin);
                send_packet();
                lwin = WINDOW;
            }
        }
        case SSH_MSG_CHANNEL_WINDOW_ADJUST: {
            get_u32();
            rwin += get_u32();
            flush_pending();
        }
        case SSH_MSG_CHANNEL_REQUEST: {
            get_u32();
            var type: [64]char;
            get_text(&type[0], 64);
            var want: int = get_bool();
            if (streq(&type[0], "exit-status")) {
                exit_code = get_u32();
                got_status = 1;
            } else if (streq(&type[0], "exit-signal")) {
                exit_code = 255;
                got_status = 1;
            }
            if (want) {
                out_start(SSH_MSG_CHANNEL_FAILURE);
                put_u32(server_ch);
                send_packet();
            }
        }
        case SSH_MSG_CHANNEL_EOF: {}
        case SSH_MSG_CHANNEL_CLOSE: {
            out_start(SSH_MSG_CHANNEL_CLOSE);
            put_u32(server_ch);
            send_packet();
            finish(exit_code);
        }
        case SSH_MSG_GLOBAL_REQUEST: {
            var name: [64]char;
            get_text(&name[0], 64);
            if (get_bool()) {
                out_start(SSH_MSG_REQUEST_FAILURE);
                send_packet();
            }
        }
        case SSH_MSG_KEXINIT: {
            take_kexinit();
            send_kexinit();
            kex_client();
        }
        default: {}
    }
}

fn session(command: *char, want_pty: int) {
    out_start(SSH_MSG_CHANNEL_OPEN);
    put_text("session");
    put_u32(0);
    put_u32(WINDOW);
    put_u32(19683);
    send_packet();
    lwin = WINDOW;
    loop {
        var t: int = read_packet();
        if (t == SSH_MSG_CHANNEL_OPEN_CONFIRMATION) { break; }
        if (t == SSH_MSG_CHANNEL_OPEN_FAILURE) {
            fputs(STDERR_FILENO, "ssh: the server refused a session\n");
            finish(255);
        }
        if (t == SSH_MSG_GLOBAL_REQUEST) { continue; }
        disconnect(DISCONNECT_PROTOCOL_ERROR, "unexpected message opening the session");
    }
    get_u32();
    server_ch = get_u32();
    rwin = get_u32();
    rmax = get_u32();
    if (bad || rmax < 1) { disconnect(DISCONNECT_PROTOCOL_ERROR, "bad CHANNEL_OPEN_CONFIRMATION"); }
    if (rmax > 32768) { rmax = 32768; }
    if (want_pty) {
        var ws: winsize;
        ws.ws_row = 24;
        ws.ws_col = 80;
        ioctl(STDIN_FILENO, TIOCGWINSZ, &ws as int);
        var term: *char = getenv("TERM");
        out_start(SSH_MSG_CHANNEL_REQUEST);
        put_u32(server_ch);
        put_text("pty-req");
        put_byte(1);
        put_text(term == null ? "vt100" : term);
        put_u32(ws.ws_col);
        put_u32(ws.ws_row);
        put_u32(0);
        put_u32(0);
        put_string(&pend[0], 0);
        send_packet();
        if (!channel_reply()) { fputs(STDERR_FILENO, "ssh: PTY allocation request failed\n"); want_pty = 0; }
    }
    out_start(SSH_MSG_CHANNEL_REQUEST);
    put_u32(server_ch);
    put_text(command == null ? "shell" : "exec");
    put_byte(1);
    if (command != null) { put_utf8(command); }
    send_packet();
    if (!channel_reply()) {
        fputs(STDERR_FILENO, "ssh: the server would not start the session\n");
        finish(255);
    }
    if (want_pty && tcgetattr(STDIN_FILENO, &saved_tty) == 0) {
        var raw: termios;
        tcgetattr(STDIN_FILENO, &raw);
        if (raw.c_lflag / ICANON % 2 != 0) { raw.c_lflag -= ICANON; }
        if (raw.c_lflag / ECHO % 2 != 0) { raw.c_lflag -= ECHO; }
        if (raw.c_lflag / ISIG % 2 != 0) { raw.c_lflag -= ISIG; }
        tcsetattr(STDIN_FILENO, TCSANOW, &raw);
        raw_tty = 1;
    }
    var stdin_open: int = 1;
    loop {
        while (packet_ready()) {
            var t: int = get_byte();
            if (t == SSH_MSG_DISCONNECT) { finish(255); }
            if (t == SSH_MSG_IGNORE || t == SSH_MSG_DEBUG || t == SSH_MSG_UNIMPLEMENTED) { continue; }
            session_message(t);
        }
        var p: [2]pollfd;
        p[0].fd = sock;
        p[0].events = POLLIN;
        p[1].fd = stdin_open && pend_len == 0 ? STDIN_FILENO : -1;
        p[1].events = POLLIN;
        if (poll(&p[0], 2, -1) < 0) {
            if (errno == EINTR) { continue; }
            finish(255);
        }
        if (p[0].revents != 0) { net_read(0); }
        if (p[1].fd >= 0 && p[1].revents != 0) {
            var n: int = read(STDIN_FILENO, &inbuf[0], 729);
            if (n <= 0) {
                stdin_open = 0;
                if (!want_pty) {
                    out_start(SSH_MSG_CHANNEL_EOF);
                    put_u32(server_ch);
                    send_packet();
                }
                continue;
            }
            var m: int = 0;
            var k: int = 0;
            while (k < n) {
                var ch: char = inbuf[k];
                k += 1;
                // "~." at the start of a line disconnects (on a pty)
                if (raw_tty && tilde) {
                    tilde = 0;
                    if (ch == '.') {
                        fputs(STDERR_FILENO, "\nConnection to ");
                        fputs(STDERR_FILENO, &host[0]);
                        fputs(STDERR_FILENO, " closed.\n");
                        finish(255);
                    }
                    if (ch != '~') { m += utf8_encode('~', &pend[pend_len + m]); }
                }
                if (raw_tty && line_start && ch == '~') { tilde = 1; continue; }
                line_start = ch == '\r' || ch == '\n';
                m += utf8_encode(ch, &pend[pend_len + m]);
            }
            pend_len += m;
            flush_pending();
        }
    }
}

fn usage() -> int {
    fputs(STDERR_FILENO, "usage: ssh [-p port] [-l user] [-i key] [-o KexAlgorithms=list] [-t | -T] [user@]host [command ...]\n");
    return 255;
}

fn main(argc: int, argv: **char) -> int {
    var identity: [300]char;
    identity[0] = 0;
    var force_pty: int = 0;
    var no_pty: int = 0;
    user[0] = 0;
    var c: int = getopt(argc, argv, "p:l:i:o:tT");
    while (c != -1) {
        switch (c) {
            case 'p': { port = atoi(optarg); if (port <= 0 || port > 65535) { return usage(); } }
            case 'l': { strncpy(&user[0], optarg, 80); user[80] = 0; }
            case 'i': { strncpy(&identity[0], optarg, 290); identity[290] = 0; }
            case 't': force_pty = 1;
            case 'T': no_pty = 1;
            case 'o': {
                // only KexAlgorithms: the exchanges to offer, in order
                if (strncmp(optarg, "KexAlgorithms=", 14) != 0 || strlen(optarg) > 14 + 700) { return usage(); }
                strcpy(&kex_want[0], &optarg[14]);
            }
            default: return usage();
        }
        c = getopt(argc, argv, "p:l:i:o:tT");
    }
    if (optind >= argc) { return usage(); }
    client_target(argv[optind]);
    // the command: the remaining arguments, joined by spaces
    var cmd: [2187]char;
    cmd[0] = 0;
    var i: int = optind + 1;
    while (i < argc) {
        if (i > optind + 1) { strcat(&cmd[0], " "); }
        strncat(&cmd[0], argv[i], 2000 - strlen(&cmd[0]));
        i += 1;
    }
    var command: *char = argc > optind + 1 ? &cmd[0] : null;
    var want_pty: int = !no_pty && (force_pty || (command == null && isatty(STDIN_FILENO)));
    client_connect(&identity[0]);
    session(command, want_pty);
    return 255;
}
