// /bin/o1test: code shapes for tric's optimization level 1 (selfhost.rs
// compares tric -O1 with the host): loops on constant tests (rotated),
// `if (c) break;` and `continue;` as one jump, && || ! jumping straight to
// their targets, and values recomputed in straight-line code.

import "../lib/tlibc.tri";

var g: [27]int;

fn shapes(n: int) -> int {
    var s: int = 0;
    var i: int = 0;
    while (1) {                          // a constant test: rotated
        i += 1;
        if (i > n) { break; }            // one jump
        if (i % 3 == 0) { continue; }
        if ((i > 2 && i < 20) || !(i != 7)) { s += i; }
        if (!(i < 5) && !(i > 9 || i == 8)) { s += 100; }
    }
    for (var k: int = 0; 1; k += 1) {    // also rotated
        if (k >= 4) { break; }
        g[k] = k * 3;
        g[k + 1] = k * 3;                // the same index arithmetic again
        s += g[k] + g[k + 1];
    }
    while (n > 0 && s < 10000) { n -= 1; s += n; }
    return s;
}

// compound assignment narrows a trit or a tryte as `as` would, with a
// constant or a variable right side, in memory and in a field
struct NT { k: trit; t: tryte; }
var gnt: NT;

fn narrows(x: int) -> int {
    var k: trit = true;
    var t: tryte = 9800 as tryte;
    var tk: [3]trit;
    k += 1;                              // 2: -1
    t += x;                              // 9900: -9783
    gnt.k += x;                          // 100: low trit +1
    gnt.t -= x * 3;
    tk[1] = true;
    tk[1] *= 2;                          // -1
    return k == -1 && t == -9783 && gnt.k == 1 && gnt.t == -300 && tk[1] == -1;
}

fn main() -> int {
    var r: int = shapes(25);
    puts(r == shapes(25) && narrows(100) ? "o1test: ok\n" : "o1test: FAILED\n");
    return r % 7;
}
