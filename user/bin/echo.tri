// echo [-n] [string ...]: write the arguments, separated by spaces.

import "../lib/tlibc.tri";

fn main(argc: int, argv: **char) -> int {
    var i: int = 1;
    var newline: int = 1;
    if (argc > 1 && streq(argv[1], "-n")) { newline = 0; i = 2; }
    var first: int = 1;
    while (i < argc) {
        if (!first) { puts(" "); }
        puts(argv[i]);
        first = 0;
        i += 1;
    }
    if (newline) { puts("\n"); }
    return 0;
}
