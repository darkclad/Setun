// host [-s SERVER] NAME: look a name up in DNS (A records), the way
// bind's host(1) reports it. /etc/hosts is not consulted.
// Exit status: 0 found, 1 not found or no answer, 2 usage.

import "../lib/tlibc.tri";
import "../lib/string.tri";
import "../lib/getopt.tri";
import "../lib/socket.tri";

fn main(argc: int, argv: **char) -> int {
    var server: int = dns_server();
    var c: int = getopt(argc, argv, "s:");
    while (c != -1) {
        if (c == 's' && inet_aton(optarg, &server)) {
        } else {
            fputs(STDERR_FILENO, "usage: host [-s server] name\n");
            return 2;
        }
        c = getopt(argc, argv, "s:");
    }
    if (optind != argc - 1) {
        fputs(STDERR_FILENO, "usage: host [-s server] name\n");
        return 2;
    }
    var name: *char = argv[optind];
    var addrs: [9]int;
    var n: int = dns_lookup(name, server, &addrs[0], 9);
    if (n == DNS_TIMEOUT) {
        puts(";; connection timed out; no servers could be reached\n");
        return 1;
    }
    if (n == DNS_BAD_NAME) {
        fputs(STDERR_FILENO, "host: '");
        fputs(STDERR_FILENO, name);
        fputs(STDERR_FILENO, "' is not a legal name\n");
        return 1;
    }
    if (n <= 0) {
        puts("Host ");
        puts(name);
        puts(n == 0 ? " not found: 3(NXDOMAIN)\n" : " not found: 2(SERVFAIL)\n");
        return 1;
    }
    var k: int = 0;
    while (k < n) {
        puts(name);
        puts(" has address ");
        puts(inet_ntoa(addrs[k]));
        puts("\n");
        k += 1;
    }
    return 0;
}
