// base64.tri: RFC 4648 base64 of octets, as text.

// Encode n octets into out (NUL-terminated); pad with '=' unless nopad.
fn base64_encode(p: *tryte, n: int, out: *char, nopad: int) -> int {
    var abc: *char = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var m: int = 0;
    var k: int = 0;
    while (k < n) {
        var b0: int = p[k];
        var b1: int = k + 1 < n ? p[k + 1] : 0;
        var b2: int = k + 2 < n ? p[k + 2] : 0;
        var v: int = (b0 * 256 + b1) * 256 + b2;
        out[m] = abc[v / 262144];
        out[m + 1] = abc[v / 4096 % 64];
        m += 2;
        if (k + 1 < n) { out[m] = abc[v / 64 % 64]; m += 1; } else if (!nopad) { out[m] = '='; m += 1; }
        if (k + 2 < n) { out[m] = abc[v % 64]; m += 1; } else if (!nopad) { out[m] = '='; m += 1; }
        k += 3;
    }
    out[m] = 0;
    return m;
}

fn _b64val(c: int) -> int {
    if (c >= 'A' && c <= 'Z') { return c - 'A'; }
    if (c >= 'a' && c <= 'z') { return c - 'a' + 26; }
    if (c >= '0' && c <= '9') { return c - '0' + 52; }
    if (c == '+') { return 62; }
    if (c == '/') { return 63; }
    return -1;
}

// Decode n characters of base64 (padding optional) into at most max
// octets; the count, or -1 if the text is not base64 or does not fit.
fn base64_decode(s: *char, n: int, out: *tryte, max: int) -> int {
    var m: int = 0;
    var acc: int = 0;
    var bits: int = 0;
    var k: int = 0;
    while (k < n) {
        var c: int = s[k];
        k += 1;
        if (c == '=') { break; }
        var v: int = _b64val(c);
        if (v < 0) { return -1; }
        acc = acc * 64 + v;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            var div: int = 1;
            var j: int = 0;
            while (j < bits) { div *= 2; j += 1; }
            if (m >= max) { return -1; }
            out[m] = (acc / div) as tryte;
            m += 1;
            acc = acc % div;
        }
    }
    while (k < n) {
        if (s[k] != '=') { return -1; }
        k += 1;
    }
    return m;
}
