// octets.tri: Trinux files (trytes) as octets for the network, the rules
// sftp-server, scp and sftp share (docs/NETWORK.md §11):
//   - a file whose trytes are all 0..255 travels octet for octet;
//   - a file with any other tryte (a character beyond 255, an overlined
//     one) travels as UTF-8 text;
//   - octets that arrive as valid UTF-8 with multi-octet characters are
//     stored as characters.

import "tlibc.tri";
import "stdlib.tri";
import "socket.tri";

const MAX_FILE: int = 1594323;            // 3^13 trytes: the largest file handled whole

// Read a whole file (at most MAX_FILE trytes) into a new buffer: its length,
// or -1 (errno set; EFBIG if too large).
fn slurp(fd: int, into: **tryte) -> int {
    var cap: int = 19683;
    var buf: *tryte = malloc(cap);
    var n: int = 0;
    loop {
        if (n == cap) {
            if (cap >= MAX_FILE) { free(buf); errno = EFBIG; return -1; }
            cap = cap * 3 > MAX_FILE ? MAX_FILE : cap * 3;
            buf = realloc(buf, cap);
            if (buf == null) { errno = ENOMEM; return -1; }
        }
        var r: int = read(fd, (buf + n) as *char, cap - n);
        if (r < 0) { free(buf); return -1; }
        if (r == 0) { break; }
        n += r;
    }
    *into = buf;
    return n;
}

// Does the content need to travel as UTF-8 text (a tryte outside 0..255)?
fn needs_utf8(p: *tryte, n: int) -> int {
    var k: int = 0;
    while (k < n) {
        if (p[k] < 0 || p[k] > 255) { return 1; }
        k += 1;
    }
    return 0;
}

// The octets the content travels as: itself, or UTF-8. *len gets the size.
fn as_octets(p: *tryte, n: int, len: *int) -> *tryte {
    if (!needs_utf8(p, n)) { *len = n; return p; }
    var size: int = 0;
    var tmp: [8]tryte;
    var k: int = 0;
    while (k < n) { size += utf8_encode(p[k], &tmp[0]); k += 1; }
    var o: *tryte = malloc(size + 1);
    var m: int = 0;
    k = 0;
    while (k < n) { m += utf8_encode(p[k], o + m); k += 1; }
    free(p);
    *len = m;
    return o;
}

// Strict UTF-8 with at least one multi-octet character: decode into the
// same buffer (code points never take more trytes than octets); the new
// length, or -1 to leave the file as it is.
fn utf8_in_place(p: *tryte, n: int) -> int {
    var multi: int = 0;
    var m: int = 0;
    var k: int = 0;
    while (k < n) {
        var b: int = p[k];
        var need: int;
        var cp: int;
        if (b < 128) { need = 0; cp = b; }
        else if (b >= 194 && b < 224) { need = 1; cp = b % 32; }
        else if (b >= 224 && b < 240) { need = 2; cp = b % 16; }
        else { return -1; }                     // 4-octet characters do not fit a tryte
        if (need > 0 && k + need >= n) { return -1; }   // cut short
        var j: int = 1;
        while (j <= need) {
            var c: int = p[k + j];
            if (c < 128 || c >= 192) { return -1; }
            cp = cp * 64 + c % 64;
            j += 1;
        }
        if (need == 2 && cp < 2048) { return -1; }      // overlong
        if (cp > 9841) { return -1; }
        if (need > 0) { multi = 1; }
        // a combining overline makes the character before it negative
        if (cp == 773 && m > 0 && p[m - 1] > 32) {
            p[m - 1] = (-p[m - 1]) as tryte;
        } else {
            p[m] = cp as tryte;
            m += 1;
        }
        k += 1 + need;
    }
    return multi ? m : -1;
}

