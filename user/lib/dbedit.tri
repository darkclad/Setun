// dbedit: rewrite the user and group databases safely: the new text goes to
// "<file>+" and is renamed over the file, so a reader never sees half of it.

import "tlibc.tri";
import "string.tri";
import "stdlib.tri";
import "pwd.tri";

// Does line (up to its newline) start with the field "name:"?
fn line_is(line: *char, name: *char) -> int {
    var n: int = strlen(name);
    return strncmp(line, name, n) == 0 && line[n] == ':';
}

fn db_write(path: *char, text: *char, n: int, mode: int) -> int {
    var tmp: [243]char;
    strncpy(&tmp[0], path, 230);
    tmp[230] = 0;
    strcat(&tmp[0], "+");
    var fd: int = open(&tmp[0], O_WRONLY + O_CREAT + O_TRUNC, mode);
    if (fd < 0) { return -1; }
    chmod(&tmp[0], mode);
    var off: int = 0;
    while (off < n) {
        var w: int = write(fd, &text[off], n - off);
        if (w <= 0) { close(fd); unlink(&tmp[0]); return -1; }
        off += w;
    }
    close(fd);
    if (rename(&tmp[0], path) < 0) { unlink(&tmp[0]); return -1; }
    return 0;
}

// Replace the line for `name` with `newline` (null: remove it); with add,
// append newline when there was none. 0, or -1 with errno set.
fn db_replace(path: *char, name: *char, newline: *char, add: int, mode: int) -> int {
    var n: int = db_load(path);
    if (n < 0) { n = 0; db_text[0] = 0; }
    var out: *char = malloc(n + (newline == null ? 0 : strlen(newline)) + 3) as *char;
    var o: int = 0;
    var i: int = 0;
    var found: int = 0;
    while (db_text[i] != 0) {
        var start: int = i;
        while (db_text[i] != 0 && db_text[i] != '\n') { i += 1; }
        var end: int = i;
        if (db_text[i] == '\n') { i += 1; }
        if (line_is(&db_text[start], name)) {
            found = 1;
            if (newline != null) {
                strcpy(&out[o], newline);
                o += strlen(newline);
                out[o] = '\n';
                o += 1;
            }
            continue;
        }
        var k: int = start;
        while (k < end) { out[o] = db_text[k]; o += 1; k += 1; }
        out[o] = '\n';
        o += 1;
    }
    if (!found && add && newline != null) {
        strcpy(&out[o], newline);
        o += strlen(newline);
        out[o] = '\n';
        o += 1;
    }
    var r: int = db_write(path, out, o, mode);
    free(out as *tryte);
    return r;
}

// Take `user` out of every member list in /etc/group.
fn db_drop_member(user: *char) -> int {
    var n: int = db_load("/etc/group");
    if (n < 0) { return -1; }
    var out: *char = malloc(n + 3) as *char;
    var o: int = 0;
    var i: int = 0;
    var ul: int = strlen(user);
    while (db_text[i] != 0) {
        var start: int = i;
        while (db_text[i] != 0 && db_text[i] != '\n') { i += 1; }
        var end: int = i;
        if (db_text[i] == '\n') { i += 1; }
        // copy up to and including the third ':', then filter the members
        var colons: int = 0;
        var k: int = start;
        while (k < end && colons < 3) { if (db_text[k] == ':') { colons += 1; } out[o] = db_text[k]; o += 1; k += 1; }
        var first: int = 1;
        while (k < end) {
            var m: int = k;
            while (k < end && db_text[k] != ',') { k += 1; }
            var len: int = k - m;
            if (!(len == ul && strncmp(&db_text[m], user, ul) == 0) && len > 0) {
                if (!first) { out[o] = ','; o += 1; }
                var j: int = m;
                while (j < k) { out[o] = db_text[j]; o += 1; j += 1; }
                first = 0;
            }
            if (k < end) { k += 1; }
        }
        out[o] = '\n';
        o += 1;
    }
    var r: int = db_write("/etc/group", out, o, 420);
    free(out as *tryte);
    return r;
}
