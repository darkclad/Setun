// sntrup.tri: sntrup761 (Streamlined NTRU Prime), for ssh's
// sntrup761x25519-sha512. The ring is Z[x]/(x^761 - x - 1); small
// polynomials have coefficients -1, 0, +1 (balanced trits!), short ones
// exactly 286 of them nonzero. The reference is tools/sntrup761.py.
//
//   sntrup_keygen(pk, sk)          pk 1158 octets, sk 1763 (random)
//   sntrup_encaps(pk, key, ct)     key 32, ct 1039 (random)
//   sntrup_decaps(sk, ct, key)     key 32
//   sntrup_keygen_from(g, f, rho, pk, sk)   deterministic, for the tests
//   sntrup_encaps_with(pk, r, key, ct)      deterministic

import "sha2.tri";

const SNP: int = 761;
const SNQ: int = 4591;
const SNQ12: int = 2295;
const SNW: int = 286;
const SN_SMALL: int = 191;
const SN_RQ: int = 1158;
const SN_ROUNDED: int = 1007;
const SN_PK: int = 1158;
const SN_CT: int = 1039;
const SN_SK: int = 1763;

fn _snq(x: int) -> int {                 // modulo q, as -q12 .. q12
    var r: int = (x + SNQ12) % SNQ;
    if (r < 0) { r += SNQ; }
    return r - SNQ12;
}

fn _sn3(x: int) -> int {                 // modulo 3, as -1 .. 1
    var r: int = (x + 1) % 3;
    if (r < 0) { r += 3; }
    return r - 1;
}

// ---- the ring ----

var _snprod: [1521]int;

// h := f · g modulo x^761 - x - 1, then each coefficient modulo q (m = 0)
// or 3 (m = 1). h may be f or g.
fn _snmult(h: *int, f: *int, g: *int, m: int) {
    var i: int = 0;
    while (i < 2 * SNP - 1) { _snprod[i] = 0; i += 1; }
    i = 0;
    while (i < SNP) {
        var a: int = f[i];
        if (a != 0) {
            var j: int = 0;
            while (j < SNP) {
                _snprod[i + j] += a * g[j];
                j += 1;
            }
            // keep the sums small: a product term is at most q^2 / 4
            if (i % 64 == 63) {
                var k: int = 0;
                while (k < 2 * SNP - 1) { _snprod[k] = m == 0 ? _snq(_snprod[k]) : _sn3(_snprod[k]); k += 1; }
            }
        }
        i += 1;
    }
    i = 2 * SNP - 2;
    while (i >= SNP) {
        _snprod[i - SNP] += _snprod[i];
        _snprod[i - SNP + 1] += _snprod[i];
        i -= 1;
    }
    i = 0;
    while (i < SNP) { h[i] = m == 0 ? _snq(_snprod[i]) : _sn3(_snprod[i]); i += 1; }
}

var _snf: [762]int;
var _sng: [762]int;
var _snv: [762]int;
var _snr: [762]int;

fn _snswap(a: *int, b: *int) {
    var i: int = 0;
    while (i <= SNP) { var t: int = a[i]; a[i] = b[i]; b[i] = t; i += 1; }
}

// The divstep inversion of NTRU Prime's reference code: out := 1/in
// modulo 3 (m = 1), or 1/(3·in) modulo q (m = 0). 0, or -1 if in is not
// invertible.
fn _snrecip(out: *int, in: *int, m: int) -> int {
    var i: int = 0;
    while (i <= SNP) { _snv[i] = 0; _snr[i] = 0; _snf[i] = 0; i += 1; }
    _snr[0] = m == 0 ? -1530 : 1;           // 1/3 modulo q: 3 · -1530 = 1 - q
    _snf[0] = 1;
    _snf[SNP - 1] = -1;
    _snf[SNP] = -1;
    i = 0;
    while (i < SNP) { _sng[SNP - 1 - i] = in[i]; i += 1; }
    _sng[SNP] = 0;
    var delta: int = 1;
    var step: int = 0;
    while (step < 2 * SNP - 1) {
        i = SNP;
        while (i > 0) { _snv[i] = _snv[i - 1]; i -= 1; }
        _snv[0] = 0;
        if (delta > 0 && _sng[0] != 0) {
            _snswap(&_snf[0], &_sng[0]);
            _snswap(&_snv[0], &_snr[0]);
            delta = -delta;
        }
        delta += 1;
        var f0: int = _snf[0];
        var g0: int = _sng[0];
        i = 0;
        if (m == 1) {
            var sg: int = -g0 * f0;
            while (i <= SNP) {
                _sng[i] = _sn3(_sng[i] + sg * _snf[i]);
                _snr[i] = _sn3(_snr[i] + sg * _snv[i]);
                i += 1;
            }
        } else {
            while (i <= SNP) {
                _sng[i] = _snq(f0 * _sng[i] - g0 * _snf[i]);
                _snr[i] = _snq(f0 * _snr[i] - g0 * _snv[i]);
                i += 1;
            }
        }
        i = 0;
        while (i < SNP) { _sng[i] = _sng[i + 1]; i += 1; }
        _sng[SNP] = 0;
        step += 1;
    }
    var scale: int = _snf[0];
    if (m == 0) {
        // 1/f[0] modulo q: f0^(q-2)
        var b: int = _snq(scale);
        var e: int = SNQ - 2;
        scale = 1;
        while (e > 0) {
            if (e % 2 == 1) { scale = _snq(scale * b); }
            b = _snq(b * b);
            e /= 2;
        }
    }
    i = 0;
    while (i < SNP) {
        out[i] = m == 0 ? _snq(scale * _snv[SNP - 1 - i]) : _sn3(scale * _snv[SNP - 1 - i]);
        i += 1;
    }
    return delta != 0 ? -1 : 0;
}

// ---- encodings ----

fn _snsmall_encode(f: *int, out: *tryte) {
    var i: int = 0;
    while (i < SNP / 4) {
        out[i] = ((f[4 * i] + 1) + 4 * (f[4 * i + 1] + 1) + 16 * (f[4 * i + 2] + 1) + 64 * (f[4 * i + 3] + 1)) as tryte;
        i += 1;
    }
    out[SNP / 4] = (f[SNP - 1] + 1) as tryte;
}

fn _snsmall_decode(s: *tryte, f: *int) {
    var i: int = 0;
    while (i < SNP / 4) {
        var x: int = s[i];
        f[4 * i] = x % 4 - 1;
        f[4 * i + 1] = x / 4 % 4 - 1;
        f[4 * i + 2] = x / 16 % 4 - 1;
        f[4 * i + 3] = x / 64 % 4 - 1;
        i += 1;
    }
    f[SNP - 1] = s[SNP / 4] % 4 - 1;
}

// Scratch for Encode and Decode's recursion, taken and given back in
// order (the deepest level last): the halves of 761 sum to under 1600.
var _snpool: [6561]int;
var _snpool_top: int;

fn _snalloc(n: int) -> *int {
    var p: *int = &_snpool[_snpool_top];
    _snpool_top += n;
    return p;
}

// NTRU Prime's Encode: R[i] in 0 .. M[i]-1 into octets at out; the count.
fn _snencode(out: *tryte, R: *int, M: *int, len: int) -> int {
    var o: int = 0;
    if (len == 1) {
        var r: int = R[0];
        var m: int = M[0];
        while (m > 1) {
            out[o] = (r % 256) as tryte;
            o += 1;
            r /= 256;
            m = (m + 255) / 256;
        }
        return o;
    }
    var half: int = (len + 1) / 2;
    var R2: *int = _snalloc(half);
    var M2: *int = _snalloc(half);
    var i: int = 0;
    while (i < len - 1) {
        var m0: int = M[i];
        var r2: int = R[i] + R[i + 1] * m0;
        var mm: int = M[i + 1] * m0;
        while (mm >= 16384) {
            out[o] = (r2 % 256) as tryte;
            o += 1;
            r2 /= 256;
            mm = (mm + 255) / 256;
        }
        R2[i / 2] = r2;
        M2[i / 2] = mm;
        i += 2;
    }
    if (i < len) {
        R2[i / 2] = R[i];
        M2[i / 2] = M[i];
    }
    o += _snencode(out + o, R2, M2, half);
    _snpool_top -= 2 * half;
    return o;
}

// NTRU Prime's Decode, the inverse: len values into R.
fn _sndecode(R: *int, s: *tryte, M: *int, len: int) {
    if (len == 1) {
        if (M[0] == 1) { R[0] = 0; }
        else if (M[0] <= 256) { R[0] = s[0] % M[0]; }
        else { R[0] = (s[0] + 256 * s[1]) % M[0]; }
        return;
    }
    var half: int = (len + 1) / 2;
    var R2: *int = _snalloc(half);
    var M2: *int = _snalloc(half);
    var bot: *int = _snalloc(half);
    var bt: *int = _snalloc(half);
    var i: int = 0;
    var at: int = 0;
    while (i < len - 1) {
        var m: int = M[i] * M[i + 1];
        if (m > 256 * 16383) {
            bt[i / 2] = 65536;
            bot[i / 2] = s[at] + 256 * s[at + 1];
            at += 2;
            M2[i / 2] = ((m + 255) / 256 + 255) / 256;
        } else if (m >= 16384) {
            bt[i / 2] = 256;
            bot[i / 2] = s[at];
            at += 1;
            M2[i / 2] = (m + 255) / 256;
        } else {
            bt[i / 2] = 1;
            bot[i / 2] = 0;
            M2[i / 2] = m;
        }
        i += 2;
    }
    if (i < len) { M2[i / 2] = M[i]; }
    _sndecode(R2, s + at, M2, half);
    i = 0;
    while (i < len - 1) {
        var r: int = bot[i / 2] + bt[i / 2] * R2[i / 2];
        R[i] = r % M[i];
        R[i + 1] = r / M[i] % M[i + 1];
        i += 2;
    }
    if (i < len) { R[i] = R2[i / 2]; }
    _snpool_top -= 4 * half;
}

var _snR: [761]int;
var _snM: [761]int;

fn _snrq_encode(h: *int, out: *tryte) {
    var i: int = 0;
    while (i < SNP) { _snR[i] = h[i] + SNQ12; _snM[i] = SNQ; i += 1; }
    _snencode(out, &_snR[0], &_snM[0], SNP);
}

fn _snrq_decode(s: *tryte, h: *int) {
    var i: int = 0;
    while (i < SNP) { _snM[i] = SNQ; i += 1; }
    _sndecode(&_snR[0], s, &_snM[0], SNP);
    i = 0;
    while (i < SNP) { h[i] = _snR[i] - SNQ12; i += 1; }
}

fn _snrounded_encode(c: *int, out: *tryte) {
    var i: int = 0;
    while (i < SNP) { _snR[i] = (c[i] + SNQ12) * 10923 / 32768; _snM[i] = 1531; i += 1; }
    _snencode(out, &_snR[0], &_snM[0], SNP);
}

fn _snrounded_decode(s: *tryte, c: *int) {
    var i: int = 0;
    while (i < SNP) { _snM[i] = 1531; i += 1; }
    _sndecode(&_snR[0], s, &_snM[0], SNP);
    i = 0;
    while (i < SNP) { c[i] = _snR[i] * 3 - SNQ12; i += 1; }
}

// ---- hashing ----

// The first 32 octets of SHA-512(b || p[0..n]).
fn _snhash(b: int, p: *tryte, n: int, out: *tryte) {
    var c: sha512_ctx;
    sha512_init(&c);
    var bb: [1]tryte;
    bb[0] = b as tryte;
    sha512_update(&c, &bb[0], 1);
    sha512_update(&c, p, n);
    var full: [64]tryte;
    sha512_final(&c, &full[0]);
    var k: int = 0;
    while (k < 32) { out[k] = full[k]; k += 1; }
}

var _snx: [1071]tryte;                  // 32 + the ciphertext

fn _snconfirm(r_enc: *tryte, cache: *tryte, out: *tryte) {
    _snhash(3, r_enc, SN_SMALL, &_snx[0]);
    var k: int = 0;
    while (k < 32) { _snx[32 + k] = cache[k]; k += 1; }
    _snhash(2, &_snx[0], 64, out);
}

fn _snsession(b: int, y: *tryte, ct: *tryte, out: *tryte) {
    _snhash(3, y, SN_SMALL, &_snx[0]);
    var k: int = 0;
    while (k < SN_CT) { _snx[32 + k] = ct[k]; k += 1; }
    _snhash(b, &_snx[0], 32 + SN_CT, out);
}

// ---- the scheme ----

var _snh: [761]int;
var _snc: [761]int;
var _snt: [761]int;
var _snu: [761]int;
var _snrenc: [191]tryte;

// ct := Rounded(h · r) || HashConfirm(r, cache); r_enc := Small(r)
fn _snhide(r: *int, pk: *tryte, cache: *tryte, ct: *tryte) {
    _snsmall_encode(r, &_snrenc[0]);
    _snrq_decode(pk, &_snh[0]);
    _snmult(&_snc[0], &_snh[0], r, 0);
    var i: int = 0;
    while (i < SNP) { _snc[i] = _snc[i] - _sn3(_snc[i]); i += 1; }
    _snrounded_encode(&_snc[0], ct);
    _snconfirm(&_snrenc[0], cache, ct + SN_ROUNDED);
}

fn sntrup_encaps_with(pk: *tryte, r: *int, key: *tryte, ct: *tryte) {
    bin32_init();
    var cache: [32]tryte;
    _snhash(4, pk, SN_PK, &cache[0]);
    _snhide(r, pk, &cache[0], ct);
    _snsession(1, &_snrenc[0], ct, key);
}

fn sntrup_keygen_from(g: *int, f: *int, rho: *tryte, pk: *tryte, sk: *tryte) -> int {
    bin32_init();
    if (_snrecip(&_snt[0], g, 1) < 0) { return -1; }        // 1/g mod 3
    _snrecip(&_snu[0], f, 0);                               // 1/(3f) mod q
    _snmult(&_snh[0], &_snu[0], g, 0);
    _snrq_encode(&_snh[0], pk);
    _snsmall_encode(f, sk);
    _snsmall_encode(&_snt[0], sk + SN_SMALL);
    var k: int = 0;
    while (k < SN_PK) { sk[2 * SN_SMALL + k] = pk[k]; k += 1; }
    k = 0;
    while (k < SN_SMALL) { sk[2 * SN_SMALL + SN_PK + k] = rho[k]; k += 1; }
    _snhash(4, pk, SN_PK, sk + 3 * SN_SMALL + SN_PK);
    return 0;
}

var _sncnew: [1039]tryte;

fn sntrup_decaps(sk: *tryte, ct: *tryte, key: *tryte) {
    bin32_init();
    _snsmall_decode(sk, &_snt[0]);                          // f
    _snsmall_decode(sk + SN_SMALL, &_snu[0]);               // 1/g
    _snrounded_decode(ct, &_snc[0]);
    _snmult(&_snh[0], &_snc[0], &_snt[0], 0);               // c · f
    var i: int = 0;
    while (i < SNP) { _snh[i] = _sn3(_snq(3 * _snh[i])); i += 1; }
    _snmult(&_snc[0], &_snh[0], &_snu[0], 1);               // e · (1/g)
    var wt: int = 0;
    i = 0;
    while (i < SNP) { if (_snc[i] != 0) { wt += 1; } i += 1; }
    if (wt != SNW) {
        i = 0;
        while (i < SNP) { _snc[i] = i < SNW ? 1 : 0; i += 1; }
    }
    var pk: *tryte = sk + 2 * SN_SMALL;
    _snhide(&_snc[0], pk, sk + 3 * SN_SMALL + SN_PK, &_sncnew[0]);
    var same: int = 1;
    i = 0;
    while (i < SN_CT) { if (ct[i] != _sncnew[i]) { same = 0; } i += 1; }
    if (same) { _snsession(1, &_snrenc[0], ct, key); }
    else { _snsession(0, sk + 2 * SN_SMALL + SN_PK, ct, key); }
}

// ---- with fresh randomness ----

fn _snrandom(n: int) -> int {          // 0 .. n-1
    var b: [3]tryte;
    getrandom(&b[0], 3, 0);
    return (b[0] + 256 * b[1] + 65536 * b[2]) % n;
}

// A short polynomial: 286 coefficients of +1 or -1 at random places.
fn _snshort(f: *int) {
    var i: int = 0;
    while (i < SNP) { f[i] = i < SNW ? (_snrandom(2) == 0 ? 1 : -1) : 0; i += 1; }
    i = SNP - 1;
    while (i > 0) {
        var j: int = _snrandom(i + 1);
        var t: int = f[i];
        f[i] = f[j];
        f[j] = t;
        i -= 1;
    }
}

var _sngr: [761]int;
var _snfr: [761]int;
var _snrr: [761]int;

fn sntrup_keygen(pk: *tryte, sk: *tryte) {
    var rho: [191]tryte;
    getrandom(&rho[0], SN_SMALL, 0);
    _snshort(&_snfr[0]);
    loop {
        var i: int = 0;
        while (i < SNP) { _sngr[i] = _snrandom(3) - 1; i += 1; }
        if (sntrup_keygen_from(&_sngr[0], &_snfr[0], &rho[0], pk, sk) == 0) { break; }
    }
}

fn sntrup_encaps(pk: *tryte, key: *tryte, ct: *tryte) {
    _snshort(&_snrr[0]);
    sntrup_encaps_with(pk, &_snrr[0], key, ct);
}
