// bin32.tri: binary arithmetic on 32-bit values for the crypto code.
//
// A 32-bit value is an int in 0 .. 2^32-1 (a word holds ±3.8·10^12, so
// it fits with room to spare). Adding, shifting and rotating are plain
// arithmetic. XOR and AND have no ternary instruction, so they go octet by
// octet through two 256×256 tables built once (bin32_init) on the heap.

import "tlibc.tri";
import "stdlib.tri";
import "u32.tri";                     // TWO32

const MASK32: int = 4294967295;

var _xor8: *tryte;
var _and8: *tryte;
var _pow2: [33]int;

fn bin32_init() {
    if (_xor8 != null) { return; }
    _xor8 = malloc(65536);
    _and8 = malloc(65536);
    var k: int = 0;
    var p: int = 1;
    while (k <= 32) { _pow2[k] = p; p *= 2; k += 1; }
    // x op y from (x/2 op y/2) and the low bits: every entry needs only
    // entries already made (smaller indexes)
    var a: int = 0;
    while (a < 256) {
        var b: int = 0;
        while (b < 256) {
            var i: int = a * 256 + b;
            var up: int = (a / 2) * 256 + b / 2;
            var la: int = a % 2;
            var lb: int = b % 2;
            if (a == 0 && b == 0) {
                _xor8[0] = 0;
                _and8[0] = 0;
            } else {
                _xor8[i] = (_xor8[up] * 2 + (la != lb)) as tryte;
                _and8[i] = (_and8[up] * 2 + la * lb) as tryte;
            }
            b += 1;
        }
        a += 1;
    }
}

fn pow2(k: int) -> int { return _pow2[k]; }

fn xor32(a: int, b: int) -> int {
    var r: int = _xor8[(a / 16777216) * 256 + b / 16777216];
    r = r * 256 + _xor8[(a / 65536 % 256) * 256 + b / 65536 % 256];
    r = r * 256 + _xor8[(a / 256 % 256) * 256 + b / 256 % 256];
    return r * 256 + _xor8[(a % 256) * 256 + b % 256];
}

fn and32(a: int, b: int) -> int {
    var r: int = _and8[(a / 16777216) * 256 + b / 16777216];
    r = r * 256 + _and8[(a / 65536 % 256) * 256 + b / 65536 % 256];
    r = r * 256 + _and8[(a / 256 % 256) * 256 + b / 256 % 256];
    return r * 256 + _and8[(a % 256) * 256 + b % 256];
}

fn not32(a: int) -> int { return MASK32 - a; }

fn xor8(a: int, b: int) -> int { return _xor8[a * 256 + b]; }

fn add32(a: int, b: int) -> int { return (a + b) % TWO32; }

fn rotr32(x: int, n: int) -> int { return x / _pow2[n] + x % _pow2[n] * _pow2[32 - n]; }
fn rotl32(x: int, n: int) -> int { return rotr32(x, 32 - n); }
fn shr32(x: int, n: int) -> int { return x / _pow2[n]; }

// Big- and little-endian 32-bit loads and stores of octets.
fn be32(p: *tryte) -> int { return ((p[0] * 256 + p[1]) * 256 + p[2]) * 256 + p[3]; }
fn le32(p: *tryte) -> int { return ((p[3] * 256 + p[2]) * 256 + p[1]) * 256 + p[0]; }

fn put_be32(p: *tryte, v: int) {
    p[0] = (v / 16777216) as tryte;
    p[1] = (v / 65536 % 256) as tryte;
    p[2] = (v / 256 % 256) as tryte;
    p[3] = (v % 256) as tryte;
}

fn put_le32(p: *tryte, v: int) {
    p[3] = (v / 16777216) as tryte;
    p[2] = (v / 65536 % 256) as tryte;
    p[1] = (v / 256 % 256) as tryte;
    p[0] = (v % 256) as tryte;
}

// Compare n octets without an early exit (the time does not depend on
// where they differ).
fn octets_equal(a: *tryte, b: *tryte, n: int) -> int {
    var d: int = 0;
    var k: int = 0;
    while (k < n) {
        d += a[k] != b[k];
        k += 1;
    }
    return d == 0;
}
