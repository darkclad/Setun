const F_SETFL: int = 4;
const F_DUPFD_CLOEXEC: int = 1030;
const FD_CLOEXEC: int = 1;
const O_CLOEXEC: int = 524288;
fn fcntl(fd: int, cmd: int, arg: int) -> int { return _ret(syscall(25, fd, cmd, arg)); }

// sys/utsname.h
struct utsname {
    sysname: [65]char;
    nodename: [65]char;
    release: [65]char;
    version: [65]char;
    machine: [65]char;
