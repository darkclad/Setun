// ---- poll.h ---------------------------------------------------------------------------

struct pollfd {
    fd: int;
    events: int;
    revents: int;
}

const POLLIN: int = 1;
const POLLOUT: int = 4;
const POLLERR: int = 8;
const POLLHUP: int = 16;
const POLLNVAL: int = 32;
const O_NONBLOCK: int = 2048;
const EAGAIN: int = 11;

// poll: timeout in milliseconds, -1 = forever.
fn poll(fds: *pollfd, n: int, timeout_ms: int) -> int {
    if (timeout_ms < 0) { return _ret(syscall(73, fds, n, 0, 0)); }
    var ts: [2]int;
    ts[0] = timeout_ms / 1000;
    ts[1] = timeout_ms % 1000 * 1000000;
    return _ret(syscall(73, fds, n, &ts[0], 0));
}

// ---- sys/mman.h (the framebuffer is the only mappable file) -----------------------------

const PROT_READ: int = 1;
const PROT_WRITE: int = 2;
const MAP_SHARED: int = 1;
const MAP_FAILED: int = -1;

// User addresses are negative here (user space is the negative half), so
// only -1..-4095 are errors, as Linux does it.
fn mmap(addr: int, len: int, prot: int, flags: int, fd: int, off: int) -> int {
    var r: int = syscall(222, addr, len, prot, flags, fd, off);
    if (r < 0 && r > -4096) { errno = -r; return MAP_FAILED; }
    return r;
}
fn munmap(addr: int, len: int) -> int { return _ret(syscall(215, addr, len)); }

// ---- pseudo-terminals (stdlib.h) ------------------------------------------------------

const TIOCGPTN: int = 2147767344;
const TIOCSPTLCK: int = 1074025521;
const TIOCSWINSZ: int = 21524;

fn posix_openpt(flags: int) -> int { return open("/dev/ptmx", flags, 0); }
fn grantpt(fd: int) -> int { return 0; }              // single-user: nothing to grant
fn unlockpt(fd: int) -> int {
    var zero: int = 0;
    return ioctl(fd, TIOCSPTLCK, &zero as int);
}

// ptsname_r: the slave's path ("/dev/pts/N") into buf.
fn ptsname_r(fd: int, buf: *char, size: int) -> int {
    var n: int;
    if (ioctl(fd, TIOCGPTN, &n as int) < 0) { return -1; }
    if (size < 12) { errno = ERANGE; return -1; }
    var p: *char = "/dev/pts/";
    var k: int = 0;
    while (p[k] != 0) { buf[k] = p[k]; k += 1; }
    itoa(n, &buf[k]);
    return 0;
}

// ---- the framebuffer (linux/fb.h, Trinux's word layout) --------------------------------

const FBIOGET_VSCREENINFO: int = 17920;
const FBIOPUT_VSCREENINFO: int = 17921;
const FBIO_CURSOR: int = 17928;

struct fb_info {
    xres: int;
    yres: int;
    pitch: int;
    mode: int;                         // -1 text, 0 = 640x480, 1 = 800x600
}

struct fb_cursor {
    x: int;
    y: int;
    enable: int;
}
fn brk(addr: int) -> int { return syscall(214, addr); }

// getcwd: the working directory into buf; returns buf, or null.
fn getcwd(buf: *char, size: int) -> *char {
    if (_ret(syscall(17, buf, size)) < 0) { return null; }
    return buf;
}

// sbrk: grow the heap by n trytes; returns the old break, or -1.
fn sbrk(n: int) -> int {
    var old: int = brk(0);
    if (n == 0) { return old; }
    if (brk(old + n) != old + n) { errno = 12; return -1; }
    return old;
}

// ---- fcntl.h, sys/stat.h ---------------------------------------------------------

fn open(path: *char, flags: int, mode: int) -> int { return _ret(syscall(56, AT_FDCWD, path, flags, mode)); }
fn creat(path: *char, mode: int) -> int { return open(path, O_WRONLY + O_CREAT + O_TRUNC, mode); }
fn mkdir(path: *char, mode: int) -> int { return _ret(syscall(34, AT_FDCWD, path, mode)); }

// One word per field (the kernel's layout, kernel/fs/file.tri).
struct stat_t {
    st_dev: int;
    st_ino: int;
    st_mode: int;
    st_nlink: int;
    st_uid: int;
    st_gid: int;
    st_rdev: int;
    st_size: int;
    st_blksize: int;
    st_blocks: int;
    st_atime: int;
    st_mtime: int;
    st_ctime: int;
}

fn stat(path: *char, st: *stat_t) -> int { return _ret(syscall(79, AT_FDCWD, path, st, 0)); }
fn fstat(fd: int, st: *stat_t) -> int { return _ret(syscall(80, fd, st)); }
fn S_IFMT_OF(m: int) -> int { return m / 4096 % 16 * 4096; }
fn S_ISDIR(m: int) -> int { return S_IFMT_OF(m) == S_IFDIR; }
fn S_ISREG(m: int) -> int { return S_IFMT_OF(m) == S_IFREG; }
fn S_ISCHR(m: int) -> int { return S_IFMT_OF(m) == S_IFCHR; }
fn S_ISFIFO(m: int) -> int { return S_IFMT_OF(m) == S_IFIFO; }

// ---- dirent.h ----------------------------------------------------------------------
//
// getdents64 records: d_ino, d_off, d_reclen (words), d_type (tryte 9), the
// NUL-terminated name from tryte 10; every record is a whole number of words.

const DT_FIFO: int = 1;
const DT_CHR: int = 2;
const DT_DIR: int = 4;
const DT_REG: int = 8;

struct DIR {
    fd: int;
    pos: int;                          // next record, in trytes
    len: int;                          // trytes in buf
    buf: [2187]tryte;
}

struct dirent {
    d_ino: int;
    d_type: int;
    d_name: [27]char;
}

var _dir: DIR;                         // one open directory at a time in v1
var _dirent: dirent;

fn getdents64(fd: int, buf: *tryte, n: int) -> int { return _ret(syscall(61, fd, buf, n)); }

fn opendir(path: *char) -> *DIR {
    var fd: int = open(path, O_RDONLY + O_DIRECTORY, 0);
    if (fd < 0) { return null; }
    _dir.fd = fd;
    _dir.pos = 0;
    _dir.len = 0;
    return &_dir;
}

fn readdir(d: *DIR) -> *dirent {
    if (d.pos >= d.len) {
        var n: int = getdents64(d.fd, &d.buf[0], 2187);
        if (n <= 0) { return null; }
        d.len = n;
        d.pos = 0;
    }
    var rec: *tryte = &d.buf[d.pos];
    var w: *int = ((rec as int) + 1) as *int;          // the record's words
    _dirent.d_ino = w[0];
    _dirent.d_type = rec[9];
    var k: int = 0;
    while (rec[10 + k] != 0 && k < 26) { _dirent.d_name[k] = rec[10 + k]; k += 1; }
    _dirent.d_name[k] = 0;
    d.pos += w[2];
    return &_dirent;
}

fn closedir(d: *DIR) -> int { return close(d.fd); }

