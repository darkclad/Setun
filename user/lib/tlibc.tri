struct termios {
    c_iflag: int;
    c_oflag: int;
    c_cflag: int;
    c_lflag: int;
    c_line: tryte;
    c_cc: [19]tryte;
}

struct winsize {
    ws_row: int;
    ws_col: int;
    ws_xpixel: int;
    ws_ypixel: int;
}

const ISIG: int = 1;
const ICANON: int = 2;
const ECHO: int = 8;
const VMIN: int = 6;
const TCSANOW: int = 0;
const TCGETS: int = 21505;
const TCSETS: int = 21506;
const TIOCGPGRP: int = 21519;
const TIOCSPGRP: int = 21520;
const TIOCGWINSZ: int = 21523;

// sys/random.h
fn getrandom(buf: *tryte, n: int, flags: int) -> int { return _ret(syscall(278, buf, n, flags)); }

fn ioctl(fd: int, cmd: int, arg: int) -> int { return _ret(syscall(29, fd, cmd, arg)); }
fn tcgetattr(fd: int, t: *termios) -> int { return ioctl(fd, TCGETS, t as int); }
fn tcsetattr(fd: int, when: int, t: *termios) -> int { return ioctl(fd, TCSETS + when, t as int); }
fn tcgetpgrp(fd: int) -> int {
    var g: int;
    if (ioctl(fd, TIOCGPGRP, &g as int) < 0) { return -1; }
    return g;
}
fn tcsetpgrp(fd: int, pgrp: int) -> int { return ioctl(fd, TIOCSPGRP, &pgrp as int); }
fn isatty(fd: int) -> int {
    var t: termios;
    return tcgetattr(fd, &t) == 0;
}

// ---- sys/wait.h ----------------------------------------------------------------

fn waitpid(pid: int, status: *int, options: int) -> int {
    return _ret(syscall(260, pid, status, options, 0));
}
fn wait(status: *int) -> int { return waitpid(-1, status, 0); }

// Status encoding as on Linux: exit code * 256, the terminating signal, or
// stop signal * 256 + 127 for a stopped child (WUNTRACED).
fn WIFEXITED(s: int) -> int { return s % 256 == 0; }
fn WEXITSTATUS(s: int) -> int { return s / 256 % 256; }
fn WIFSIGNALED(s: int) -> int { return s % 256 != 0 && s % 256 != 127; }
fn WTERMSIG(s: int) -> int { return s % 256; }
fn WIFSTOPPED(s: int) -> int { return s % 256 == 127; }
fn WSTOPSIG(s: int) -> int { return s / 256 % 256; }

// ---- signal.h --------------------------------------------------------------------
//
// Sets are one word, bit (sig - 1). Handlers return through __restore_rt,
// which calls rt_sigreturn (139).

struct sigaction_t {
    sa_handler: int;                   // SIG_DFL, SIG_IGN, or &handler as int
    sa_flags: int;
    sa_restorer: int;
    sa_mask: int;
}

extern fn __restore_rt();

fn _tlibc_asm() {
    asm {
        "        b     _tlibc_asm_end"
        "__restore_rt:"
        "        sys   139"
        "_tlibc_asm_end:"
    }
}

fn sigbit(sig: int) -> int {
    var b: int = 1;
    while (sig > 1) { b *= 2; sig -= 1; }
    return b;
}
fn sigemptyset(set: *int) -> int { *set = 0; return 0; }
fn sigismember(set: *int, sig: int) -> int { return *set / sigbit(sig) % 2 != 0; }
fn sigaddset(set: *int, sig: int) -> int { if (!sigismember(set, sig)) { *set += sigbit(sig); } return 0; }
fn sigdelset(set: *int, sig: int) -> int { if (sigismember(set, sig)) { *set -= sigbit(sig); } return 0; }

fn sigaction(sig: int, act: *sigaction_t, old: *sigaction_t) -> int {
    if (act != null) {
        if (act.sa_flags / SA_RESTORER % 2 == 0) { act.sa_flags += SA_RESTORER; }
        act.sa_restorer = &__restore_rt as int;
    }
    return _ret(syscall(134, sig, act, old, 3));
}

// signal(sig, SIG_DFL | SIG_IGN | &handler as int): returns the old handler.
fn signal(sig: int, handler: int) -> int {
    var sa: sigaction_t;
    var old: sigaction_t;
    sa.sa_handler = handler;
    sa.sa_flags = 0;
    sa.sa_mask = 0;
    if (sigaction(sig, &sa, &old) < 0) { return SIG_ERR; }
    return old.sa_handler;
}

fn sigprocmask(how: int, set: *int, old: *int) -> int { return _ret(syscall(135, how, set, old, 3)); }
fn sigpending(set: *int) -> int { return _ret(syscall(136, set, 3)); }
fn sigsuspend(mask: *int) -> int { return _ret(syscall(133, mask, 3)); }
fn kill(pid: int, sig: int) -> int { return _ret(syscall(129, pid, sig)); }
fn raise(sig: int) -> int { return kill(getpid(), sig); }
fn pause() -> int {
    var m: int;
    sigprocmask(SIG_BLOCK, null, &m);
    return sigsuspend(&m);
}

// ---- time.h, unistd.h sleep ---------------------------------------------------------

struct timespec {
    tv_sec: int;
    tv_nsec: int;
}

fn nanosleep(req: *timespec, rem: *timespec) -> int { return _ret(syscall(101, req, rem)); }

const CLOCK_REALTIME: int = 0;
const CLOCK_MONOTONIC: int = 1;
fn clock_gettime(clk: int, ts: *timespec) -> int { return _ret(syscall(113, clk, ts)); }

// sleep: returns the seconds left if a signal cut it short.
fn sleep(seconds: int) -> int {
    var req: timespec;
    var rem: timespec;
    req.tv_sec = seconds;
    req.tv_nsec = 0;
    if (nanosleep(&req, &rem) < 0) { return rem.tv_sec + (rem.tv_nsec > 0); }
    return 0;
}

// ---- sys/sysinfo.h ---------------------------------------------------------------

struct sysinfo_t {
    uptime: int;
    load1: int;
    load5: int;
    load15: int;
    totalram: int;
    freeram: int;
    sharedram: int;
    bufferram: int;
    totalswap: int;
    freeswap: int;
    procs: int;
    totalhigh: int;
    freehigh: int;
    mem_unit: int;
}

fn sysinfo(info: *sysinfo_t) -> int { return _ret(syscall(179, info)); }

// ---- string.h -------------------------------------------------------------------

fn streq(a: *char, b: *char) -> int { return strcmp(a, b) == 0; }

// Signal names without "SIG", indexed by number ("" where there is none).
fn signame(sig: int) -> *char {
    switch (sig) {
        case 1: return "HUP";
        case 2: return "INT";
        case 3: return "QUIT";
        case 4: return "ILL";
        case 5: return "TRAP";
        case 6: return "ABRT";
        case 7: return "BUS";
        case 8: return "FPE";
        case 9: return "KILL";
        case 10: return "USR1";
        case 11: return "SEGV";
        case 12: return "USR2";
        case 13: return "PIPE";
        case 14: return "ALRM";
        case 15: return "TERM";
        case 17: return "CHLD";
        case 18: return "CONT";
        case 19: return "STOP";
        case 20: return "TSTP";
        case 21: return "TTIN";
        case 22: return "TTOU";
    }
    return "";
}

// What a shell prints for a signal, as Linux's strsignal does.
fn strsignal(sig: int) -> *char {
    switch (sig) {
        case 1: return "Hangup";
        case 2: return "Interrupt";
        case 3: return "Quit";
        case 4: return "Illegal instruction";
        case 5: return "Trace/breakpoint trap";
        case 6: return "Aborted";
        case 7: return "Bus error";
        case 8: return "Floating point exception";
        case 9: return "Killed";
        case 10: return "User defined signal 1";
        case 11: return "Segmentation fault";
        case 12: return "User defined signal 2";
        case 13: return "Broken pipe";
        case 14: return "Alarm clock";
        case 15: return "Terminated";
        case 19: return "Stopped (signal)";
        case 20: return "Stopped";
        case 21: return "Stopped (tty input)";
        case 22: return "Stopped (tty output)";
    }
    return "Unknown signal";
}

fn strerror(e: int) -> *char {
    switch (e) {
        case EPERM: return "Operation not permitted";
        case ENOENT: return "No such file or directory";
        case ESRCH: return "No such process";
        case EINTR: return "Interrupted system call";
        case EIO: return "Input/output error";
        case ENOEXEC: return "Exec format error";
        case EBADF: return "Bad file descriptor";
        case ECHILD: return "No child processes";
        case ENOMEM: return "Out of memory";
        case EACCES: return "Permission denied";
        case EFAULT: return "Bad address";
        case EBUSY: return "Device or resource busy";
        case EEXIST: return "File exists";
        case ENOTDIR: return "Not a directory";
        case EISDIR: return "Is a directory";
        case EINVAL: return "Invalid argument";
        case EMFILE: return "Too many open files";
        case ENFILE: return "Too many open files in system";
        case ENOTTY: return "Not a tty";
        case ENOSPC: return "No space left on device";
        case ESPIPE: return "Illegal seek";
        case EPIPE: return "Broken pipe";
        case ERANGE: return "Result out of range";
        case ENAMETOOLONG: return "File name too long";
        case ENOSYS: return "Function not implemented";
        case ENOTEMPTY: return "Directory not empty";
        case EXDEV: return "Invalid cross-device link";
        case E2BIG: return "Argument list too long";
        case EMLINK: return "Too many links";
        case EDOM: return "Numerical argument out of domain";
        case ENODEV: return "No such device";
        case EFBIG: return "File too large";
        case EAGAIN: return "Resource temporarily unavailable";
        case ENOTSOCK: return "Socket operation on non-socket";
        case EDESTADDRREQ: return "Destination address required";
        case EMSGSIZE: return "Message too long";
        case ENOPROTOOPT: return "Protocol not available";
        case EPROTONOSUPPORT: return "Protocol not supported";
        case ESOCKTNOSUPPORT: return "Socket type not supported";
        case EOPNOTSUPP: return "Operation not supported";
        case EAFNOSUPPORT: return "Address family not supported by protocol";
        case EADDRINUSE: return "Address already in use";
        case EADDRNOTAVAIL: return "Cannot assign requested address";
        case ENETUNREACH: return "Network is unreachable";
        case ECONNABORTED: return "Software caused connection abort";
        case ECONNRESET: return "Connection reset by peer";
        case ENOBUFS: return "No buffer space available";
        case EISCONN: return "Transport endpoint is already connected";
        case ENOTCONN: return "Transport endpoint is not connected";
        case ETIMEDOUT: return "Connection timed out";
        case ECONNREFUSED: return "Connection refused";
        case EHOSTUNREACH: return "No route to host";
        case EALREADY: return "Operation already in progress";
        case EINPROGRESS: return "Operation now in progress";
    }
    return "Unknown error";
}

// ---- small stdio helpers (no varargs printf: see KERNEL.md §10) -----------------

fn fputs(fd: int, s: *char) -> int { return write(fd, s, strlen(s)); }

fn puts(s: *char) -> int {
    var n: int = strlen(s);
    if (write(STDOUT_FILENO, s, n) < 0) { return -1; }
    return n;
}

fn put_int(v: int) {
    var buf: [15]char;
    puts(itoa(v, &buf[0]));
}

// "prog: what: <strerror(errno)>" on stderr, like perror.
fn perror2(prog: *char, what: *char) {
    fputs(STDERR_FILENO, prog);
    fputs(STDERR_FILENO, ": ");
    fputs(STDERR_FILENO, what);
    fputs(STDERR_FILENO, ": ");
    fputs(STDERR_FILENO, strerror(errno));
    fputs(STDERR_FILENO, "\n");
}
