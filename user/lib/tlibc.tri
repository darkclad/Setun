var errno: int;
var environ: **char;                   // set by the startup code (envp)

fn _ret(r: int) -> int {
    if (r < 0) { errno = -r; return -1; }
    return r;
}

// ---- unistd.h ------------------------------------------------------------------

fn read(fd: int, buf: *char, n: int) -> int { return _ret(syscall(63, fd, buf, n)); }
fn write(fd: int, buf: *char, n: int) -> int { return _ret(syscall(64, fd, buf, n)); }
fn close(fd: int) -> int { return _ret(syscall(57, fd)); }
fn lseek(fd: int, off: int, whence: int) -> int { return _ret(syscall(62, fd, off, whence)); }
fn dup(fd: int) -> int { return _ret(syscall(23, fd)); }
fn dup2(fd: int, nfd: int) -> int {
    if (fd == nfd) {                                   // dup3 refuses this; dup2 only checks fd
        var st: stat_t;
        if (fstat(fd, &st) < 0) { return -1; }
        return nfd;
    }
    return _ret(syscall(24, fd, nfd, 0));
}
fn pipe(fds: *int) -> int { return _ret(syscall(59, fds, 0)); }
fn chdir(path: *char) -> int { return _ret(syscall(49, path)); }
fn rmdir(path: *char) -> int { return _ret(syscall(35, AT_FDCWD, path, AT_REMOVEDIR)); }
fn unlink(path: *char) -> int { return _ret(syscall(35, AT_FDCWD, path, 0)); }
fn rename(old: *char, new: *char) -> int { return _ret(syscall(38, AT_FDCWD, old, AT_FDCWD, new)); }
fn sync() { syscall(81); }
fn fsync(fd: int) -> int { return _ret(syscall(82, fd)); }

// sys/mount.h
fn mount(source: *char, target: *char, type: *char, flags: int, data: *char) -> int {
    return _ret(syscall(40, source, target, type, flags, data));
}
fn umount(target: *char) -> int { return _ret(syscall(39, target, 0)); }

// sys/reboot.h (glibc's reboot(cmd) adds Linux's magic numbers)
const RB_AUTOBOOT: int = 19088743;
const RB_POWER_OFF: int = 1126301404;
const RB_HALT_SYSTEM: int = 3454992675;
fn reboot(cmd: int) -> int { return _ret(syscall(142, 4276215469, 672274793, cmd, 0)); }

// sys/statfs.h, one word per field
struct statfs_t {
    f_type: int;
    f_bsize: int;
    f_blocks: int;
    f_bfree: int;
    f_bavail: int;
    f_files: int;
    f_ffree: int;
    f_fsid: int;
    f_namelen: int;
    f_frsize: int;
    f_flags: int;
}
fn statfs(path: *char, buf: *statfs_t) -> int { return _ret(syscall(43, path, buf)); }
fn getpid() -> int { return syscall(172); }
fn setpgid(pid: int, pgid: int) -> int { return _ret(syscall(154, pid, pgid)); }
fn getpgid(pid: int) -> int { return _ret(syscall(155, pid)); }
fn getpgrp() -> int { return syscall(155, 0); }
fn getsid(pid: int) -> int { return _ret(syscall(156, pid)); }
fn setsid() -> int { return _ret(syscall(157)); }
fn getppid() -> int { return syscall(173); }
fn sched_yield() -> int { return _ret(syscall(124)); }
fn _exit(code: int) { syscall(93, code); }
fn exit(code: int) { syscall(93, code); }           // no atexit handlers; stdio FILEs flush on fclose
fn fork() -> int { return _ret(syscall(220, SIGCHLD, 0, 0, 0, 0)); }
fn execve(path: *char, argv: **char, envp: **char) -> int { return _ret(syscall(221, path, argv, envp)); }
fn execv(path: *char, argv: **char) -> int { return execve(path, argv, environ); }

// execvp: a name without '/' is looked up in $PATH (default /bin:/sbin).
fn execvp(file: *char, argv: **char) -> int {
    var k: int = 0;
    while (file[k] != 0) {
        if (file[k] == '/') { return execve(file, argv, environ); }
        k += 1;
    }
    var path: *char = getenv("PATH");
    if (path == null) { path = "/bin:/sbin"; }
    var saw_eacces: int = 0;
    var i: int = 0;
    loop {
        var full: [243]char;
        var n: int = 0;
        while (path[i] != 0 && path[i] != ':' && n < 200) { full[n] = path[i]; n += 1; i += 1; }
        if (n == 0) { full[n] = '.'; n += 1; }
        full[n] = '/';
        n += 1;
        var j: int = 0;
        while (file[j] != 0 && n < 242) { full[n] = file[j]; n += 1; j += 1; }
        full[n] = 0;
        execve(&full[0], argv, environ);
        if (errno == EACCES) { saw_eacces = 1; }
        else if (errno != ENOENT && errno != ENOTDIR) { return -1; }
        if (path[i] == 0) { break; }
        i += 1;
    }
    errno = saw_eacces ? EACCES : ENOENT;
    return -1;
}

// getenv: the value of `name` in the environment, or null.
fn getenv(name: *char) -> *char {
    if (environ == null) { return null; }
    var i: int = 0;
    while (environ[i] != null) {
        var e: *char = environ[i];
        var k: int = 0;
        while (name[k] != 0 && e[k] == name[k]) { k += 1; }
        if (name[k] == 0 && e[k] == '=') { return &e[k + 1]; }
        i += 1;
    }
    return null;
}

fn getuid() -> int { return syscall(174); }
fn geteuid() -> int { return syscall(175); }
fn getgid() -> int { return syscall(176); }
fn getegid() -> int { return syscall(177); }
fn setuid(u: int) -> int { return _ret(syscall(146, u)); }
fn setgid(g: int) -> int { return _ret(syscall(144, g)); }
fn setreuid(r: int, e: int) -> int { return _ret(syscall(145, r, e)); }
fn setregid(r: int, e: int) -> int { return _ret(syscall(143, r, e)); }
fn setresuid(r: int, e: int, s: int) -> int { return _ret(syscall(147, r, e, s)); }
fn setresgid(r: int, e: int, s: int) -> int { return _ret(syscall(149, r, e, s)); }
fn getresuid(r: *int, e: *int, s: *int) -> int { return _ret(syscall(148, r, e, s)); }
fn getresgid(r: *int, e: *int, s: *int) -> int { return _ret(syscall(150, r, e, s)); }
fn seteuid(e: int) -> int { return setresuid(-1, e, -1); }
fn setegid(e: int) -> int { return setresgid(-1, e, -1); }
fn getgroups(size: int, list: *int) -> int { return _ret(syscall(158, size, list)); }
fn setgroups(n: int, list: *int) -> int { return _ret(syscall(159, n, list)); }
fn chown(path: *char, u: int, g: int) -> int { return _ret(syscall(54, AT_FDCWD, path, u, g, 0)); }
fn fchown(fd: int, u: int, g: int) -> int { return _ret(syscall(55, fd, u, g)); }
fn umask(mask: int) -> int { return syscall(166, mask); }
fn chmod(path: *char, mode: int) -> int { return _ret(syscall(53, AT_FDCWD, path, mode, 0)); }
fn link(old: *char, new: *char) -> int { return _ret(syscall(37, AT_FDCWD, old, AT_FDCWD, new, 0)); }

// fcntl.h
const F_DUPFD: int = 0;
const F_GETFD: int = 1;
const F_SETFD: int = 2;
