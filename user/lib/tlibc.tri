// tlibc: the Trinux C library, in Trine (docs/KERNEL.md §10).
//
// System calls use the Linux generic numbers and return -errno on failure;
// these wrappers set `errno` and return -1, as POSIX specifies.
//
// This file is the core (unistd.h, fcntl.h, signal.h, ...). Like C headers,
// the rest is imported only where needed: string.tri, ctype.tri,
// stdlib.tri (malloc, setenv, strtol, qsort), stdio.tri (FILE),
// getopt.tri and time.tri.

import "rt.tri";

