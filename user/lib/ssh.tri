// ssh.tri: the SSH transport (RFC 4253) for sshd and the ssh client:
// version lines, binary packets with chacha20-poly1305@openssh.com,
// KEXINIT, mlkem768x25519-sha256 (ML-KEM-768 with X25519, preferred) and
// curve25519-sha256 with strict KEX, key derivation.
//
// One connection per process: the state is in globals. ssh_server says
// which side this is (it picks the strict-KEX name, whose KEXINIT is I_C
// and which version is V_C, and the key letters).

import "tlibc.tri";
import "stdlib.tri";
import "string.tri";
import "socket.tri";
import "c25519.tri";
import "chacha.tri";
import "base64.tri";
import "mlkem.tri";

const SSH_MSG_DISCONNECT: int = 1;
const SSH_MSG_IGNORE: int = 2;
const SSH_MSG_UNIMPLEMENTED: int = 3;
const SSH_MSG_DEBUG: int = 4;
const SSH_MSG_SERVICE_REQUEST: int = 5;
const SSH_MSG_SERVICE_ACCEPT: int = 6;
const SSH_MSG_KEXINIT: int = 20;
const SSH_MSG_NEWKEYS: int = 21;
const SSH_MSG_KEX_ECDH_INIT: int = 30;
const SSH_MSG_KEX_ECDH_REPLY: int = 31;
const SSH_MSG_USERAUTH_REQUEST: int = 50;
const SSH_MSG_USERAUTH_FAILURE: int = 51;
const SSH_MSG_USERAUTH_SUCCESS: int = 52;
const SSH_MSG_USERAUTH_PK_OK: int = 60;
const SSH_MSG_GLOBAL_REQUEST: int = 80;
const SSH_MSG_REQUEST_FAILURE: int = 82;
const SSH_MSG_CHANNEL_OPEN: int = 90;
const SSH_MSG_CHANNEL_OPEN_CONFIRMATION: int = 91;
const SSH_MSG_CHANNEL_OPEN_FAILURE: int = 92;
const SSH_MSG_CHANNEL_WINDOW_ADJUST: int = 93;
const SSH_MSG_CHANNEL_DATA: int = 94;
const SSH_MSG_CHANNEL_EXTENDED_DATA: int = 95;
const SSH_MSG_CHANNEL_EOF: int = 96;
const SSH_MSG_CHANNEL_CLOSE: int = 97;
const SSH_MSG_CHANNEL_REQUEST: int = 98;
const SSH_MSG_CHANNEL_SUCCESS: int = 99;
const SSH_MSG_CHANNEL_FAILURE: int = 100;

const DISCONNECT_PROTOCOL_ERROR: int = 2;
const DISCONNECT_KEY_EXCHANGE_FAILED: int = 3;
const DISCONNECT_MAC_ERROR: int = 5;
const DISCONNECT_SERVICE_NOT_AVAILABLE: int = 7;
const DISCONNECT_NO_MORE_AUTH_METHODS: int = 14;
const DISCONNECT_BY_APPLICATION: int = 11;

const VERSION: *char = "SSH-2.0-TrinuxSSH_0.1";
const SSH_MSG_EXT_INFO: int = 7;
const SSH_MSG_USERAUTH_BANNER: int = 53;
const MAX_PACKET: int = 35000;            // the longest packet_length we accept
const LOCAL_WINDOW: int = 59049;          // 3^10
const LOCAL_MAX_PACKET: int = 19683;      // 3^9
const MAX_AUTH_TRIES: int = 6;
const KEY_PATH: *char = "/etc/ssh/ssh_host_ed25519_key";

var ssh_server: int;                      // 1 in sshd, 0 in the client
var ssh_prog: *char = "ssh";             // the client's name in messages
var sock: int;
var peer: [16]char;

// ---- transport: buffers and keys ----------------------------------------------------------

var inb: [72000]tryte;                    // received, not yet taken
var in_len: int;
var pkt: [36000]tryte;                    // the payload of the packet just read
var pkt_len: int;
var pkt_pos: int;
var bad: int;                             // a read ran past the payload
var outp: [36000]tryte;                   // the payload being built
var out_len: int;
var wire: [36100]tryte;

var enc_in: int;
var enc_out: int;
var key_in: [64]tryte;                    // K_1 (payload) then K_2 (length)
var key_out: [64]tryte;
var seq_in: int;
var seq_out: int;
var strict: int;                          // strict KEX (kex-strict-*-v00@openssh.com)
var kexes: int;                           // key exchanges done

var host_sk: [64]tryte;
var host_pk: [32]tryte;
var v_c: [256]tryte;                      // the client's version line (without CR LF)
var v_c_len: int;
var v_s: [256]tryte;                      // the server's
var v_s_len: int;
var i_c: [4096]tryte;                     // the client's KEXINIT payload
var i_c_len: int;
var i_s: [4096]tryte;                     // the server's KEXINIT payload
var i_s_len: int;
var session_id: [32]tryte;

// The program's messages: "sshd[pid]: ..." in the server, "ssh: ..." in the client.
fn log2(a: *char, b: *char) {
    if (ssh_server) {
        fputs(STDERR_FILENO, "sshd[");
        var tmp: [15]char;
        fputs(STDERR_FILENO, itoa(getpid(), &tmp[0]));
        fputs(STDERR_FILENO, "]: ");
    } else {
        fputs(STDERR_FILENO, ssh_prog);
        fputs(STDERR_FILENO, ": ");
    }
    fputs(STDERR_FILENO, a);
    fputs(STDERR_FILENO, b);
    fputs(STDERR_FILENO, "\n");
}

fn write_all(fd: int, p: *tryte, n: int) -> int {
    var k: int = 0;
    while (k < n) {
        var w: int = write(fd, (p + k) as *char, n - k);
        if (w < 0) {
            if (errno == EINTR) { continue; }
            return -1;
        }
        k += w;
    }
    return 0;
}

fn nonce_of(seq: int, n: *tryte) {
    n[0] = 0; n[1] = 0; n[2] = 0; n[3] = 0;
    put_be32(n + 4, seq);
}

// ---- building a payload ------------------------------------------------------------------------

fn out_start(msg: int) {
    outp[0] = msg as tryte;
    out_len = 1;
}

fn put_byte(v: int) {
    outp[out_len] = v as tryte;
    out_len += 1;
}

fn put_u32(v: int) {
    put_be32(&outp[out_len], v);
    out_len += 4;
}

fn put_raw(p: *tryte, n: int) {
    var k: int = 0;
    while (k < n) { outp[out_len + k] = p[k]; k += 1; }
    out_len += n;
}

fn put_string(p: *tryte, n: int) {
    put_u32(n);
    put_raw(p, n);
}

fn put_text(s: *char) { put_string(s as *tryte, strlen(s)); }

// Text with code points beyond ASCII, as a UTF-8 string.
fn put_utf8(s: *char) {
    var at: int = out_len;
    out_len += 4;
    var k: int = 0;
    while (s[k] != 0) {
        out_len += utf8_encode(s[k], &outp[out_len]);
        k += 1;
    }
    put_be32(&outp[at], out_len - at - 4);
}

// ---- reading a payload --------------------------------------------------------------------------

fn get_byte() -> int {
    if (pkt_pos >= pkt_len) { bad = 1; return 0; }
    pkt_pos += 1;
    return pkt[pkt_pos - 1];
}

fn get_u32() -> int {
    if (pkt_pos + 4 > pkt_len) { bad = 1; return 0; }
    pkt_pos += 4;
    return be32(&pkt[pkt_pos - 4]);
}

fn get_bool() -> int { return get_byte() != 0; }

// A string: its length; *at is its offset in pkt.
fn get_string(at: *int) -> int {
    var n: int = get_u32();
    if (bad || n < 0 || pkt_pos + n > pkt_len) { bad = 1; *at = pkt_pos; return 0; }
    *at = pkt_pos;
    pkt_pos += n;
    return n;
}

// A string as ASCII text into buf (max-1 characters at most).
fn get_text(buf: *char, max: int) -> int {
    var at: int = 0;
    var n: int = get_string(&at);
    if (n > max - 1) { bad = 1; n = 0; }
    var k: int = 0;
    while (k < n) { buf[k] = pkt[at + k] as char; k += 1; }
    buf[n] = 0;
    return n;
}

// A UTF-8 string as text into buf.
fn get_utf8(buf: *char, max: int) -> int {
    var at: int = 0;
    var n: int = get_string(&at);
    if (n > max - 1) { bad = 1; n = 0; }
    var st: utf8_state;
    st.need = 0;
    var m: int = utf8_to_text(&st, &pkt[at], n, buf);
    buf[m] = 0;
    return m;
}

fn is_text(at: int, n: int, s: *char) -> int {
    if (strlen(s) != n) { return 0; }
    var k: int = 0;
    while (k < n) {
        if (pkt[at + k] != s[k]) { return 0; }
        k += 1;
    }
    return 1;
}

// Does the name-list (pkt[at..at+n)) contain name?
fn list_has(at: int, n: int, name: *char) -> int {
    var k: int = 0;
    while (k <= n) {
        var e: int = k;
        while (e < n && pkt[at + e] != ',') { e += 1; }
        if (is_text(at + k, e - k, name)) { return 1; }
        k = e + 1;
    }
    return 0;
}

// The index of name in the name-list, or -1.
fn list_pos(at: int, n: int, name: *char) -> int {
    var k: int = 0;
    var i: int = 0;
    while (k <= n) {
        var e: int = k;
        while (e < n && pkt[at + e] != ',') { e += 1; }
        if (is_text(at + k, e - k, name)) { return i; }
        k = e + 1;
        i += 1;
    }
    return -1;
}

// Is name the first entry of the name-list?
fn list_first_is(at: int, n: int, name: *char) -> int {
    var e: int = 0;
    while (e < n && pkt[at + e] != ',') { e += 1; }
    return is_text(at, e, name);
}

// ---- packets -----------------------------------------------------------------------------------

fn send_packet() {
    var pad: int;
    if (enc_out) { pad = 8 - (1 + out_len) % 8; } else { pad = 8 - (5 + out_len) % 8; }
    if (pad < 4) { pad += 8; }
    var len: int = 1 + out_len + pad;
    put_be32(&wire[0], len);
    wire[4] = pad as tryte;
    var k: int = 0;
    while (k < out_len) { wire[5 + k] = outp[k]; k += 1; }
    getrandom(&wire[5 + out_len], pad, 0);
    var total: int = 4 + len;
    if (enc_out) {
        var nonce: [8]tryte;
        nonce_of(seq_out, &nonce[0]);
        var polykey: [64]tryte;
        chacha20_block(&polykey[0], &key_out[0], &nonce[0], 0);
        chacha20_xor(&wire[0], &wire[0], 4, &key_out[32], &nonce[0], 0);
        chacha20_xor(&wire[4], &wire[4], len, &key_out[0], &nonce[0], 1);
        poly1305(&wire[total], &wire[0], total, &polykey[0]);
        total += 16;
    }
    seq_out = (seq_out + 1) % TWO32;
    if (write_all(sock, &wire[0], total) < 0) {
        log2("write to the client failed: ", strerror(errno));
        _exit(1);
    }
}

// Tell the client why, and end the connection.
fn disconnect(reason: int, why: *char) {
    log2("disconnecting: ", why);
    out_start(SSH_MSG_DISCONNECT);
    put_u32(reason);
    put_text(why);
    put_text("");
    send_packet();
    shutdown(sock, SHUT_RDWR);
    close(sock);
    _exit(1);
}

// Read more from the socket into inb: the count (exits on EOF).
fn net_read(block: int) -> int {
    if (in_len >= 72000) { disconnect(DISCONNECT_PROTOCOL_ERROR, "input overflow"); }
    var n: int = recv(sock, &inb[in_len], 72000 - in_len, block ? 0 : MSG_DONTWAIT);
    if (n < 0) {
        if (errno == EAGAIN || errno == EINTR) { return 0; }
        log2("read from the client: ", strerror(errno));
        _exit(1);
    }
    if (n == 0) {
        log2("connection closed by ", &peer[0]);
        _exit(0);
    }
    in_len += n;
    return n;
}

fn consume(n: int) {
    var k: int = 0;
    while (k + n < in_len) { inb[k] = inb[k + n]; k += 1; }
    in_len -= n;
}

// Take one whole packet from inb into pkt, if one is there.
fn packet_ready() -> int {
    if (in_len < 4) { return 0; }
    var len: int;
    var nonce: [8]tryte;
    if (enc_in) {
        nonce_of(seq_in, &nonce[0]);
        var l: [4]tryte;
        chacha20_xor(&l[0], &inb[0], 4, &key_in[32], &nonce[0], 0);
        len = be32(&l[0]);
    } else {
        len = be32(&inb[0]);
    }
    if (len < 5 || len > MAX_PACKET) { disconnect(DISCONNECT_PROTOCOL_ERROR, "bad packet length"); }
    if (enc_in ? len % 8 != 0 : (4 + len) % 8 != 0) { disconnect(DISCONNECT_PROTOCOL_ERROR, "packet length not a multiple of the block size"); }
    var need: int = 4 + len + (enc_in ? 16 : 0);
    if (in_len < need) { return 0; }
    if (enc_in) {
        var polykey: [64]tryte;
        chacha20_block(&polykey[0], &key_in[0], &nonce[0], 0);
        var tag: [16]tryte;
        poly1305(&tag[0], &inb[0], 4 + len, &polykey[0]);
        if (!octets_equal(&tag[0], &inb[4 + len], 16)) { disconnect(DISCONNECT_MAC_ERROR, "message authentication failed"); }
        chacha20_xor(&inb[4], &inb[4], len, &key_in[0], &nonce[0], 1);
    }
    var pad: int = inb[4];
    if (pad < 4 || pad > len - 1) { disconnect(DISCONNECT_PROTOCOL_ERROR, "bad padding"); }
    pkt_len = len - 1 - pad;
    var k: int = 0;
    while (k < pkt_len) { pkt[k] = inb[5 + k]; k += 1; }
    pkt_pos = 0;
    bad = 0;
    consume(need);
    seq_in = (seq_in + 1) % TWO32;
    return 1;
}

// The next packet, waiting for it; IGNORE and DEBUG are skipped (not
// during the first key exchange in strict mode, which allows none).
fn read_packet() -> int {
    loop {
        while (!packet_ready()) { net_read(1); }
        var t: int = get_byte();
        if ((t == SSH_MSG_IGNORE || t == SSH_MSG_DEBUG || t == SSH_MSG_UNIMPLEMENTED) && !(strict && kexes == 0)) { continue; }
        if (t == SSH_MSG_DISCONNECT) {
            log2("the client disconnected: ", &peer[0]);
            _exit(0);
        }
        return t;
    }
}

// ---- key exchange ----------------------------------------------------------------------------

var kbuf: [40]tryte;                      // the shared secret as an mpint string (length first)
var kbuf_len: int;
var hash_h: [32]tryte;
var kex_mlkem: int;                       // this exchange is mlkem768x25519-sha256

const KEX_HYBRID_INIT_LEN: int = 1216;    // ML-KEM encapsulation key, then X25519 key
const KEX_HYBRID_REPLY_LEN: int = 1120;   // ML-KEM ciphertext, then X25519 key

// K for a hybrid exchange: SHA-256(ML-KEM key || X25519 key), as a string.
fn hybrid_k(kpq: *tryte, kcl: *tryte) {
    var both: [64]tryte;
    var k: int = 0;
    while (k < 32) { both[k] = kpq[k]; both[32 + k] = kcl[k]; k += 1; }
    put_be32(&kbuf[0], 32);
    sha256(&both[0], 64, &kbuf[4]);
    kbuf_len = 36;
}

// K for curve25519-sha256: the 32 octets as an mpint.
fn mpint_k(sh: *tryte) {
    var lead: int = 0;
    while (lead < 32 && sh[lead] == 0) { lead += 1; }
    var mlen: int = 32 - lead + (sh[lead] >= 128);
    put_be32(&kbuf[0], mlen);
    var k: int = 4;
    if (sh[lead] >= 128) { kbuf[4] = 0; k = 5; }
    var j: int = lead;
    while (j < 32) { kbuf[k] = sh[j]; k += 1; j += 1; }
    kbuf_len = 4 + mlen;
}

fn hash_string(c: *sha256_ctx, p: *tryte, n: int) {
    var l: [4]tryte;
    put_be32(&l[0], n);
    sha256_update(c, &l[0], 4);
    sha256_update(c, p, n);
}

fn derive(letter: int, out: *tryte) {
    var c: sha256_ctx;
    var x: [1]tryte;
    x[0] = letter as tryte;
    sha256_init(&c);
    sha256_update(&c, &kbuf[0], kbuf_len);
    sha256_update(&c, &hash_h[0], 32);
    sha256_update(&c, &x[0], 1);
    sha256_update(&c, &session_id[0], 32);
    sha256_final(&c, out);
    sha256_init(&c);
    sha256_update(&c, &kbuf[0], kbuf_len);
    sha256_update(&c, &hash_h[0], 32);
    sha256_update(&c, out, 32);
    sha256_final(&c, out + 32);
}

fn send_kexinit() {
    out_start(SSH_MSG_KEXINIT);
    getrandom(&outp[1], 16, 0);
    out_len = 17;
    if (kexes > 0) { put_text("mlkem768x25519-sha256,curve25519-sha256,curve25519-sha256@libssh.org"); }
    else if (ssh_server) { put_text("mlkem768x25519-sha256,curve25519-sha256,curve25519-sha256@libssh.org,kex-strict-s-v00@openssh.com"); }
    else { put_text("mlkem768x25519-sha256,curve25519-sha256,curve25519-sha256@libssh.org,kex-strict-c-v00@openssh.com"); }
    put_text("ssh-ed25519");
    put_text("chacha20-poly1305@openssh.com");
    put_text("chacha20-poly1305@openssh.com");
    put_text("hmac-sha2-256");                 // never used: the cipher is an AEAD
    put_text("hmac-sha2-256");
    put_text("none");
    put_text("none");
    put_text("");
    put_text("");
    put_byte(0);
    put_u32(0);
    var k: int = 0;
    var mine: *tryte = ssh_server ? &i_s[0] : &i_c[0];
    while (k < out_len) { mine[k] = outp[k]; k += 1; }
    if (ssh_server) { i_s_len = out_len; } else { i_c_len = out_len; }
    send_packet();
}

// The peer's KEXINIT is in pkt (its type already read). Agree on the
// algorithms; returns 1 if the peer's guessed first packet must be dropped.
fn take_kexinit() -> int {
    if (pkt_len > 4096) { disconnect(DISCONNECT_PROTOCOL_ERROR, "KEXINIT too long"); }
    var k: int = 0;
    var theirs: *tryte = ssh_server ? &i_c[0] : &i_s[0];
    while (k < pkt_len) { theirs[k] = pkt[k]; k += 1; }
    if (ssh_server) { i_c_len = pkt_len; } else { i_s_len = pkt_len; }
    pkt_pos = 17;                               // type + cookie
    var at: [10]int;
    var n: [10]int;
    var i: int = 0;
    while (i < 10) { n[i] = get_string(&at[i]); i += 1; }
    var guess: int = get_bool();
    get_u32();
    if (bad) { disconnect(DISCONNECT_PROTOCOL_ERROR, "bad KEXINIT"); }
    // the client's first choice that both have (RFC 4253 §7.1)
    var curve: int = list_has(at[0], n[0], "curve25519-sha256") || list_has(at[0], n[0], "curve25519-sha256@libssh.org");
    var hybrid: int = list_has(at[0], n[0], "mlkem768x25519-sha256");
    if (!curve && !hybrid) {
        disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "no common key exchange (mlkem768x25519-sha256 or curve25519-sha256 is needed)");
    }
    if (ssh_server) {
        // the client's order decides: which of ours comes first in its list?
        var ph: int = list_pos(at[0], n[0], "mlkem768x25519-sha256");
        var pc: int = list_pos(at[0], n[0], "curve25519-sha256");
        var pl: int = list_pos(at[0], n[0], "curve25519-sha256@libssh.org");
        if (pc < 0 || (pl >= 0 && pl < pc)) { pc = pl; }
        kex_mlkem = ph >= 0 && (pc < 0 || ph < pc);
    } else {
        kex_mlkem = hybrid;                       // ours lists it first, and the server goes by ours
    }
    if (!list_has(at[1], n[1], "ssh-ed25519")) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "no common host key type (ssh-ed25519 is needed)"); }
    if (!list_has(at[2], n[2], "chacha20-poly1305@openssh.com") || !list_has(at[3], n[3], "chacha20-poly1305@openssh.com")) {
        disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "no common cipher (chacha20-poly1305@openssh.com is needed)");
    }
    if (!list_has(at[6], n[6], "none") || !list_has(at[7], n[7], "none")) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "no common compression"); }
    if (kexes == 0) { strict = list_has(at[0], n[0], ssh_server ? "kex-strict-c-v00@openssh.com" : "kex-strict-s-v00@openssh.com"); }
    var first_ok: int = (kex_mlkem ? list_first_is(at[0], n[0], "mlkem768x25519-sha256")
        : (list_first_is(at[0], n[0], "curve25519-sha256") || list_first_is(at[0], n[0], "curve25519-sha256@libssh.org")))
        && list_first_is(at[1], n[1], "ssh-ed25519");
    return guess && !first_ok;
}

// The rest of a key exchange after both KEXINITs, as the server.
fn kex_server(drop_guess: int) {
    log2("key exchange ", kex_mlkem ? "mlkem768x25519-sha256" : "curve25519-sha256");
    var t: int = read_packet();
    if (drop_guess) { t = read_packet(); }
    if (t != SSH_MSG_KEX_ECDH_INIT) { disconnect(DISCONNECT_PROTOCOL_ERROR, "expected KEX_ECDH_INIT"); }
    var qc_at: int = 0;
    var qc_len: int = get_string(&qc_at);
    var want: int = kex_mlkem ? KEX_HYBRID_INIT_LEN : 32;
    if (bad || qc_len != want) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "bad client public key"); }
    var qc: [32]tryte;                          // the client's X25519 key
    var k: int = 0;
    while (k < 32) { qc[k] = pkt[qc_at + qc_len - 32 + k]; k += 1; }
    var kpq: [32]tryte;
    if (kex_mlkem) {
        if (!mlkem_ek_ok(&pkt[qc_at])) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "a malformed ML-KEM key"); }
        var mrand: [32]tryte;
        getrandom(&mrand[0], 32, 0);
        mlkem_encaps(&pkt[qc_at], &mrand[0], &kpq[0], &hyb_reply[0]);
        k = 0;
        while (k < KEX_HYBRID_INIT_LEN) { hyb_init[k] = pkt[qc_at + k]; k += 1; }
    }
    var e: [32]tryte;
    getrandom(&e[0], 32, 0);
    var qs: [32]tryte;
    x25519_base(&qs[0], &e[0]);
    var sh: [32]tryte;
    x25519(&sh[0], &e[0], &qc[0]);
    var zero: int = 1;
    k = 0;
    while (k < 32) { if (sh[k] != 0) { zero = 0; } k += 1; }
    if (zero) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "a degenerate shared secret"); }
    if (kex_mlkem) {
        hybrid_k(&kpq[0], &sh[0]);
        k = 0;
        while (k < 32) { hyb_reply[1088 + k] = qs[k]; k += 1; }
    } else {
        mpint_k(&sh[0]);
    }
    // the host key blob
    var blob: [51]tryte;
    put_be32(&blob[0], 11);
    k = 0;
    var name: *char = "ssh-ed25519";
    while (k < 11) { blob[4 + k] = name[k] as tryte; k += 1; }
    put_be32(&blob[15], 32);
    k = 0;
    while (k < 32) { blob[19 + k] = host_pk[k]; k += 1; }
    // H = HASH(V_C || V_S || I_C || I_S || K_S || Q_C || Q_S || K)
    var c: sha256_ctx;
    sha256_init(&c);
    hash_string(&c, &v_c[0], v_c_len);
    hash_string(&c, &v_s[0], v_s_len);
    hash_string(&c, &i_c[0], i_c_len);
    hash_string(&c, &i_s[0], i_s_len);
    hash_string(&c, &blob[0], 51);
    if (kex_mlkem) {
        hash_string(&c, &hyb_init[0], KEX_HYBRID_INIT_LEN);
        hash_string(&c, &hyb_reply[0], KEX_HYBRID_REPLY_LEN);
    } else {
        hash_string(&c, &qc[0], 32);
        hash_string(&c, &qs[0], 32);
    }
    sha256_update(&c, &kbuf[0], kbuf_len);
    sha256_final(&c, &hash_h[0]);
    if (kexes == 0) {
        k = 0;
        while (k < 32) { session_id[k] = hash_h[k]; k += 1; }
    }
    var sig: [64]tryte;
    ed25519_sign(&sig[0], &hash_h[0], 32, &host_sk[0]);
    out_start(SSH_MSG_KEX_ECDH_REPLY);
    put_string(&blob[0], 51);
    if (kex_mlkem) { put_string(&hyb_reply[0], KEX_HYBRID_REPLY_LEN); } else { put_string(&qs[0], 32); }
    put_u32(83);                                // the signature blob
    put_text("ssh-ed25519");
    put_string(&sig[0], 64);
    send_packet();
    out_start(SSH_MSG_NEWKEYS);
    send_packet();
    derive('D', &key_out[0]);                   // server to client
    enc_out = 1;
    if (strict) { seq_out = 0; }
    t = read_packet();
    if (t != SSH_MSG_NEWKEYS) { disconnect(DISCONNECT_PROTOCOL_ERROR, "expected NEWKEYS"); }
    derive('C', &key_in[0]);                    // client to server
    enc_in = 1;
    if (strict) { seq_in = 0; }
    kexes += 1;
    k = 0;
    while (k < 32) { sh[k] = 0; e[k] = 0; kpq[k] = 0; k += 1; }
}

var hyb_init: [1216]tryte;
var hyb_reply: [1120]tryte;
var hyb_dk: [2400]tryte;

// ---- version lines -----------------------------------------------------------------------

// Send our version line and read the peer's (lines before it are allowed,
// at most 20, each at most 255 octets with CR LF).
fn version_exchange() {
    var hello: [32]char;
    strcpy(&hello[0], VERSION);
    strcat(&hello[0], "\r\n");
    var k: int = 0;
    var vlen: int = strlen(VERSION);
    var mine: *tryte = ssh_server ? &v_s[0] : &v_c[0];
    while (k < vlen) { mine[k] = VERSION[k] as tryte; k += 1; }
    if (ssh_server) { v_s_len = vlen; } else { v_c_len = vlen; }
    write_all(sock, &hello[0] as *tryte, strlen(&hello[0]));
    var lines: int = 0;
    loop {
        var nl: int = -1;
        k = 0;
        while (k < in_len) {
            if (inb[k] == 10) { nl = k; k = in_len; }
            k += 1;
        }
        if (nl < 0) {
            if (in_len > 255) { log2("no version line from ", &peer[0]); _exit(1); }
            net_read(1);
            continue;
        }
        var end: int = nl;
        if (end > 0 && inb[end - 1] == 13) { end -= 1; }
        if (end > 253) { log2("an overlong line before the version from ", &peer[0]); _exit(1); }   // RFC 4253: 255 with CR LF
        var is_ssh: int = end >= 4 && inb[0] == 'S' && inb[1] == 'S' && inb[2] == 'H' && inb[3] == '-';
        if (is_ssh) {
            var v2: int = end >= 8 && inb[4] == '2' && inb[5] == '.' && inb[6] == '0' && inb[7] == '-';
            var v199: int = end >= 9 && inb[4] == '1' && inb[5] == '.' && inb[6] == '9' && inb[7] == '9' && inb[8] == '-';
            if (!v2 && !v199) {
                write_all(sock, "Protocol mismatch.\r\n" as *tryte, 20);
                log2("not SSH 2 from ", &peer[0]);
                _exit(1);
            }
            var theirs: *tryte = ssh_server ? &v_c[0] : &v_s[0];
            k = 0;
            while (k < end) { theirs[k] = inb[k]; k += 1; }
            if (ssh_server) { v_c_len = end; } else { v_s_len = end; }
            consume(nl + 1);
            return;
        }
        consume(nl + 1);
        lines += 1;
        if (lines > 20) { log2("no version line from ", &peer[0]); _exit(1); }
    }
}

// ---- the client's side of a key exchange ------------------------------------------------------

// Set by the client: is this host key blob (51 octets) the right one for
// the host? (known_hosts)
var ssh_host_key_ok: fn(*tryte) -> int;
var server_key: [51]tryte;                // the host key blob of the last exchange

fn kex_client() {
    var e: [32]tryte;
    getrandom(&e[0], 32, 0);
    var qc: [32]tryte;
    x25519_base(&qc[0], &e[0]);
    out_start(SSH_MSG_KEX_ECDH_INIT);
    if (kex_mlkem) {
        var dz: [64]tryte;
        getrandom(&dz[0], 64, 0);
        mlkem_keygen(&dz[0], &dz[32], &hyb_init[0], &hyb_dk[0]);
        var q: int = 0;
        while (q < 32) { hyb_init[1184 + q] = qc[q]; dz[q] = 0; dz[32 + q] = 0; q += 1; }
        put_string(&hyb_init[0], KEX_HYBRID_INIT_LEN);
    } else {
        put_string(&qc[0], 32);
    }
    send_packet();
    var t: int = read_packet();
    if (t != SSH_MSG_KEX_ECDH_REPLY) { disconnect(DISCONNECT_PROTOCOL_ERROR, "expected KEX_ECDH_REPLY"); }
    var ks_at: int = 0;
    var ks_n: int = get_string(&ks_at);
    var qs_at: int = 0;
    var qs_n: int = get_string(&qs_at);
    var sig_at: int = 0;
    var sig_n: int = get_string(&sig_at);
    if (bad || ks_n != 51 || qs_n != (kex_mlkem ? KEX_HYBRID_REPLY_LEN : 32) || sig_n != 83) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "a host key or signature this client does not take"); }
    // K_S: string "ssh-ed25519", string key (32)
    if (be32(&pkt[ks_at]) != 11 || !is_text(ks_at + 4, 11, "ssh-ed25519") || be32(&pkt[ks_at + 15]) != 32) {
        disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "not an ssh-ed25519 host key");
    }
    if (be32(&pkt[sig_at]) != 11 || !is_text(sig_at + 4, 11, "ssh-ed25519") || be32(&pkt[sig_at + 15]) != 64) {
        disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "not an ssh-ed25519 signature");
    }
    var k: int = 0;
    while (k < 51) { server_key[k] = pkt[ks_at + k]; k += 1; }
    var qs: [32]tryte;
    k = 0;
    while (k < 32) { qs[k] = pkt[qs_at + qs_n - 32 + k]; k += 1; }
    var kpq: [32]tryte;
    if (kex_mlkem) {
        k = 0;
        while (k < KEX_HYBRID_REPLY_LEN) { hyb_reply[k] = pkt[qs_at + k]; k += 1; }
        mlkem_decaps(&hyb_dk[0], &hyb_reply[0], &kpq[0]);
    }
    var sig: [64]tryte;
    k = 0;
    while (k < 64) { sig[k] = pkt[sig_at + 19 + k]; k += 1; }
    var sh: [32]tryte;
    x25519(&sh[0], &e[0], &qs[0]);
    var zero: int = 1;
    k = 0;
    while (k < 32) { if (sh[k] != 0) { zero = 0; } k += 1; }
    if (zero) { disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "a degenerate shared secret"); }
    if (kex_mlkem) { hybrid_k(&kpq[0], &sh[0]); } else { mpint_k(&sh[0]); }
    var c: sha256_ctx;
    sha256_init(&c);
    hash_string(&c, &v_c[0], v_c_len);
    hash_string(&c, &v_s[0], v_s_len);
    hash_string(&c, &i_c[0], i_c_len);
    hash_string(&c, &i_s[0], i_s_len);
    hash_string(&c, &server_key[0], 51);
    if (kex_mlkem) {
        hash_string(&c, &hyb_init[0], KEX_HYBRID_INIT_LEN);
        hash_string(&c, &hyb_reply[0], KEX_HYBRID_REPLY_LEN);
    } else {
        hash_string(&c, &qc[0], 32);
        hash_string(&c, &qs[0], 32);
    }
    sha256_update(&c, &kbuf[0], kbuf_len);
    sha256_final(&c, &hash_h[0]);
    if (!ed25519_verify(&sig[0], &hash_h[0], 32, &server_key[19])) {
        disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "the server's signature does not verify");
    }
    if (!ssh_host_key_ok(&server_key[0])) {
        disconnect(DISCONNECT_KEY_EXCHANGE_FAILED, "host key verification failed");
    }
    if (kexes == 0) {
        k = 0;
        while (k < 32) { session_id[k] = hash_h[k]; k += 1; }
    }
    out_start(SSH_MSG_NEWKEYS);
    send_packet();
    derive('C', &key_out[0]);                   // client to server
    enc_out = 1;
    if (strict) { seq_out = 0; }
    t = read_packet();
    if (t != SSH_MSG_NEWKEYS) { disconnect(DISCONNECT_PROTOCOL_ERROR, "expected NEWKEYS"); }
    derive('D', &key_in[0]);                    // server to client
    enc_in = 1;
    if (strict) { seq_in = 0; }
    kexes += 1;
    k = 0;
    while (k < 32) { sh[k] = 0; e[k] = 0; kpq[k] = 0; k += 1; }
    k = 0;
    while (k < 2400) { hyb_dk[k] = 0; k += 1; }
}
