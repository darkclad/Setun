// ecdsa.tri: ECDSA signature verification on NIST P-256 and P-384
// (FIPS 186-4), for TLS and X.509. Points are in Jacobian coordinates with
// coordinates in Montgomery form (bignum.tri); a = -3 on both curves.

import "bignum.tri";

const CURVE_P256: int = 1;
const CURVE_P384: int = 2;

struct curve {
    limbs: int;
    octets: int;
    fp: mont;                             // the field
    fq: mont;                             // the group order n
    b: [260]int;                          // in Montgomery form
    gx: [260]int;
    gy: [260]int;
}

var _p256: curve;
var _p384: curve;
var _curves_ready: int;

fn _hexval(c: int) -> int {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return c - 'A' + 10;
}

// A hex constant into n limbs.
fn _hex(a: *int, n: int, s: *char) {
    bn_zero(a, n);
    var len: int = strlen(s);
    var k: int = 0;
    while (k < len) {
        var v: int = _hexval(s[len - 1 - k]);
        var limb: int = k / 4;
        var shift: int = 1;
        var j: int = 0;
        while (j < k % 4) { shift *= 16; j += 1; }
        a[limb] += v * shift;
        k += 1;
    }
}

fn _curve_init(c: *curve, limbs: int, p: *char, b: *char, gx: *char, gy: *char, n: *char) {
    var t: [260]int;
    c.limbs = limbs;
    c.octets = limbs * 2;
    _hex(&t[0], limbs, p);
    mont_init(&c.fp, &t[0], limbs);
    _hex(&t[0], limbs, n);
    mont_init(&c.fq, &t[0], limbs);
    _hex(&t[0], limbs, b);
    mont_to(&c.fp, &c.b[0], &t[0]);
    _hex(&t[0], limbs, gx);
    mont_to(&c.fp, &c.gx[0], &t[0]);
    _hex(&t[0], limbs, gy);
    mont_to(&c.fp, &c.gy[0], &t[0]);
}

fn curves_init() {
    if (_curves_ready) { return; }
    _curve_init(&_p256, 16,
        "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff",
        "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b",
        "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296",
        "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
        "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551");
    _curve_init(&_p384, 24,
        "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff",
        "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef",
        "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
        "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f",
        "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973");
    _curves_ready = 1;
}

fn curve_of(id: int) -> *curve {
    curves_init();
    return id == CURVE_P384 ? &_p384 : &_p256;
}

// ---- points --------------------------------------------------------------------------------

struct jpoint {
    x: [24]int;
    y: [24]int;
    z: [24]int;                           // zero: the point at infinity
}

var _ec: *curve;                          // the curve the point functions use

fn _fm(o: *int, a: *int, b: *int) { mont_mul(&_ec.fp, o, a, b); }
fn _fa(o: *int, a: *int, b: *int) { mod_add(&_ec.fp, o, a, b); }
fn _fs(o: *int, a: *int, b: *int) { mod_sub(&_ec.fp, o, a, b); }

fn _is_inf(p: *jpoint) -> int { return bn_is_zero(&p.z[0], _ec.limbs); }

fn _pcopy(d: *jpoint, s: *jpoint) {
    bn_copy(&d.x[0], &s.x[0], _ec.limbs);
    bn_copy(&d.y[0], &s.y[0], _ec.limbs);
    bn_copy(&d.z[0], &s.z[0], _ec.limbs);
}

// p = 2p (dbl-2001-b, a = -3)
fn _pdouble(p: *jpoint) {
    if (_is_inf(p)) { return; }
    var n: int = _ec.limbs;
    var delta: [24]int;
    var gamma: [24]int;
    var beta: [24]int;
    var alpha: [24]int;
    var t: [24]int;
    var u: [24]int;
    _fm(&delta[0], &p.z[0], &p.z[0]);
    _fm(&gamma[0], &p.y[0], &p.y[0]);
    _fm(&beta[0], &p.x[0], &gamma[0]);
    _fs(&t[0], &p.x[0], &delta[0]);
    _fa(&u[0], &p.x[0], &delta[0]);
    _fm(&alpha[0], &t[0], &u[0]);
    _fa(&t[0], &alpha[0], &alpha[0]);
    _fa(&alpha[0], &t[0], &alpha[0]);           // 3(X-δ)(X+δ)
    // Z3 = (Y+Z)^2 - γ - δ
    _fa(&t[0], &p.y[0], &p.z[0]);
    _fm(&t[0], &t[0], &t[0]);
    _fs(&t[0], &t[0], &gamma[0]);
    _fs(&p.z[0], &t[0], &delta[0]);
    // X3 = α^2 - 8β
    var b4: [24]int;
    _fa(&b4[0], &beta[0], &beta[0]);
    _fa(&b4[0], &b4[0], &b4[0]);                // 4β
    var b8: [24]int;
    _fa(&b8[0], &b4[0], &b4[0]);
    _fm(&t[0], &alpha[0], &alpha[0]);
    _fs(&p.x[0], &t[0], &b8[0]);
    // Y3 = α(4β - X3) - 8γ^2
    _fs(&t[0], &b4[0], &p.x[0]);
    _fm(&t[0], &alpha[0], &t[0]);
    _fm(&u[0], &gamma[0], &gamma[0]);
    _fa(&u[0], &u[0], &u[0]);
    _fa(&u[0], &u[0], &u[0]);
    _fa(&u[0], &u[0], &u[0]);
    _fs(&p.y[0], &t[0], &u[0]);
    bn_zero(&t[0], n);
}

// p = p + q (add-2007-bl)
fn _padd(p: *jpoint, q: *jpoint) {
    if (_is_inf(q)) { return; }
    if (_is_inf(p)) { _pcopy(p, q); return; }
    var z1z1: [24]int;
    var z2z2: [24]int;
    var u1: [24]int;
    var u2: [24]int;
    var s1: [24]int;
    var s2: [24]int;
    var h: [24]int;
    var r: [24]int;
    var t: [24]int;
    _fm(&z1z1[0], &p.z[0], &p.z[0]);
    _fm(&z2z2[0], &q.z[0], &q.z[0]);
    _fm(&u1[0], &p.x[0], &z2z2[0]);
    _fm(&u2[0], &q.x[0], &z1z1[0]);
    _fm(&t[0], &q.z[0], &z2z2[0]);
    _fm(&s1[0], &p.y[0], &t[0]);
    _fm(&t[0], &p.z[0], &z1z1[0]);
    _fm(&s2[0], &q.y[0], &t[0]);
    _fs(&h[0], &u2[0], &u1[0]);
    _fs(&r[0], &s2[0], &s1[0]);
    if (bn_is_zero(&h[0], _ec.limbs)) {
        if (bn_is_zero(&r[0], _ec.limbs)) { _pdouble(p); return; }
        bn_zero(&p.z[0], _ec.limbs);            // P + (-P)
        return;
    }
    _fa(&r[0], &r[0], &r[0]);                   // r = 2(S2 - S1)
    var i: [24]int;
    _fa(&i[0], &h[0], &h[0]);
    _fm(&i[0], &i[0], &i[0]);                   // I = (2H)^2
    var j: [24]int;
    _fm(&j[0], &h[0], &i[0]);
    var v: [24]int;
    _fm(&v[0], &u1[0], &i[0]);
    // X3 = r^2 - J - 2V
    _fm(&t[0], &r[0], &r[0]);
    _fs(&t[0], &t[0], &j[0]);
    _fs(&t[0], &t[0], &v[0]);
    _fs(&t[0], &t[0], &v[0]);
    // Z3 = ((Z1+Z2)^2 - Z1Z1 - Z2Z2) H
    var z: [24]int;
    _fa(&z[0], &p.z[0], &q.z[0]);
    _fm(&z[0], &z[0], &z[0]);
    _fs(&z[0], &z[0], &z1z1[0]);
    _fs(&z[0], &z[0], &z2z2[0]);
    _fm(&p.z[0], &z[0], &h[0]);
    // Y3 = r(V - X3) - 2 S1 J
    _fs(&v[0], &v[0], &t[0]);
    _fm(&v[0], &r[0], &v[0]);
    _fm(&s1[0], &s1[0], &j[0]);
    _fa(&s1[0], &s1[0], &s1[0]);
    _fs(&p.y[0], &v[0], &s1[0]);
    bn_copy(&p.x[0], &t[0], _ec.limbs);
}

// Is (x, y) (Montgomery form) on the curve: y^2 = x^3 - 3x + b?
fn _on_curve(x: *int, y: *int) -> int {
    var l: [24]int;
    var r: [24]int;
    var t: [24]int;
    _fm(&l[0], y, y);
    _fm(&r[0], x, x);
    _fm(&r[0], &r[0], x);
    _fa(&t[0], x, x);
    _fa(&t[0], &t[0], x);
    _fs(&r[0], &r[0], &t[0]);
    _fa(&r[0], &r[0], &_ec.b[0]);
    return bn_cmp(&l[0], &r[0], _ec.limbs) == 0;
}

// ---- verification --------------------------------------------------------------------------

// Verify a signature (r, s as big-endian integers) by the public key
// pub (04 || X || Y) over the hash h (hlen octets). 1 if it holds.
fn ecdsa_verify(id: int, pub: *tryte, publen: int, h: *tryte, hlen: int, r: *tryte, rlen: int, s: *tryte, slen: int) -> int {
    var c: *curve = curve_of(id);
    _ec = c;
    var n: int = c.limbs;
    var ob: int = c.octets;
    if (publen != 1 + 2 * ob || pub[0] != 4) { return 0; }
    var qx: [24]int;
    var qy: [24]int;
    var tmp: [24]int;
    if (!bn_from_octets(&tmp[0], n, pub + 1, ob) || bn_cmp(&tmp[0], &c.fp.m[0], n) >= 0) { return 0; }
    mont_to(&c.fp, &qx[0], &tmp[0]);
    if (!bn_from_octets(&tmp[0], n, pub + 1 + ob, ob) || bn_cmp(&tmp[0], &c.fp.m[0], n) >= 0) { return 0; }
    mont_to(&c.fp, &qy[0], &tmp[0]);
    if (!_on_curve(&qx[0], &qy[0])) { return 0; }
    // r, s in 1 .. n-1
    var rr: [24]int;
    var ss: [24]int;
    if (!bn_from_octets(&rr[0], n, r, rlen) || !bn_from_octets(&ss[0], n, s, slen)) { return 0; }
    if (bn_is_zero(&rr[0], n) || bn_is_zero(&ss[0], n)) { return 0; }
    if (bn_cmp(&rr[0], &c.fq.m[0], n) >= 0 || bn_cmp(&ss[0], &c.fq.m[0], n) >= 0) { return 0; }
    // e: the leftmost bits of the hash, as many as n has
    var e: [48]int;
    var hl: int = hlen > ob ? ob : hlen;
    bn_zero(&e[0], 2 * n);
    bn_from_octets(&e[0], 2 * n, h, hl);
    var em: [24]int;
    mod_reduce_wide(&c.fq, &em[0], &e[0]);
    // w = s^-1; u1 = e w; u2 = r w (mod n)
    var sm: [24]int;
    mont_to(&c.fq, &sm[0], &ss[0]);
    var w: [24]int;
    mont_inv(&c.fq, &w[0], &sm[0]);
    var u1: [24]int;
    var u2: [24]int;
    mont_to(&c.fq, &tmp[0], &em[0]);
    mont_mul(&c.fq, &u1[0], &tmp[0], &w[0]);
    mont_from(&c.fq, &u1[0], &u1[0]);
    mont_to(&c.fq, &tmp[0], &rr[0]);
    mont_mul(&c.fq, &u2[0], &tmp[0], &w[0]);
    mont_from(&c.fq, &u2[0], &u2[0]);
    // X = u1 G + u2 Q, by Shamir's trick
    var g: jpoint;
    bn_copy(&g.x[0], &c.gx[0], n);
    bn_copy(&g.y[0], &c.gy[0], n);
    bn_copy(&g.z[0], &c.fp.one[0], n);
    var q: jpoint;
    bn_copy(&q.x[0], &qx[0], n);
    bn_copy(&q.y[0], &qy[0], n);
    bn_copy(&q.z[0], &c.fp.one[0], n);
    var gq: jpoint;
    _pcopy(&gq, &g);
    _padd(&gq, &q);
    var acc: jpoint;
    bn_zero(&acc.x[0], n);
    bn_zero(&acc.y[0], n);
    bn_zero(&acc.z[0], n);
    var bits: int = bn_bits(&u1[0], n);
    var b2: int = bn_bits(&u2[0], n);
    if (b2 > bits) { bits = b2; }
    var i: int = bits - 1;
    while (i >= 0) {
        _pdouble(&acc);
        var b1: int = bn_bit(&u1[0], i);
        var bq: int = bn_bit(&u2[0], i);
        if (b1 && bq) { _padd(&acc, &gq); }
        else if (b1) { _padd(&acc, &g); }
        else if (bq) { _padd(&acc, &q); }
        i -= 1;
    }
    if (_is_inf(&acc)) { return 0; }
    // x = X / Z^2, back to an ordinary number, mod n
    var zi: [24]int;
    mont_inv(&c.fp, &zi[0], &acc.z[0]);
    mont_mul(&c.fp, &zi[0], &zi[0], &zi[0]);
    var x: [24]int;
    mont_mul(&c.fp, &x[0], &acc.x[0], &zi[0]);
    mont_from(&c.fp, &x[0], &x[0]);
    var xw: [48]int;
    bn_zero(&xw[0], 2 * n);
    bn_copy(&xw[0], &x[0], n);
    var v: [24]int;
    mod_reduce_wide(&c.fq, &v[0], &xw[0]);
    return bn_cmp(&v[0], &rr[0], n) == 0;
}

// ---- key exchange (ECDH) ---------------------------------------------------------------------
//
// For TLS's secp256r1 and secp384r1 groups. The scalar multiplication is a
// plain double-and-add, not constant-time: its timing depends on the secret
// scalar (one-off ephemeral keys here, never long-term ones).

// k·(px, py) (k: n ordinary limbs; the point in Montgomery form) into
// x, y (ob octets each, big-endian). 0 if the result is the point at infinity.
fn _ec_mult(c: *curve, k: *int, px: *int, py: *int, x: *tryte, y: *tryte) -> int {
    _ec = c;
    var n: int = c.limbs;
    var p: jpoint;
    bn_copy(&p.x[0], px, n);
    bn_copy(&p.y[0], py, n);
    bn_copy(&p.z[0], &c.fp.one[0], n);
    var acc: jpoint;
    bn_zero(&acc.x[0], n);
    bn_zero(&acc.y[0], n);
    bn_zero(&acc.z[0], n);
    var i: int = bn_bits(k, n) - 1;
    while (i >= 0) {
        _pdouble(&acc);
        if (bn_bit(k, i)) { _padd(&acc, &p); }
        i -= 1;
    }
    if (_is_inf(&acc)) { return 0; }
    // affine: x = X/Z^2, y = Y/Z^3
    var zi: [24]int;
    var zi2: [24]int;
    var t: [24]int;
    mont_inv(&c.fp, &zi[0], &acc.z[0]);
    mont_mul(&c.fp, &zi2[0], &zi[0], &zi[0]);
    mont_mul(&c.fp, &t[0], &acc.x[0], &zi2[0]);
    mont_from(&c.fp, &t[0], &t[0]);
    bn_to_octets(x, c.octets, &t[0], n);
    mont_mul(&c.fp, &zi2[0], &zi2[0], &zi[0]);
    mont_mul(&c.fp, &t[0], &acc.y[0], &zi2[0]);
    mont_from(&c.fp, &t[0], &t[0]);
    bn_to_octets(y, c.octets, &t[0], n);
    return 1;
}

// The public key (04 || X || Y) of priv (octets bytes, 1 .. n-1).
fn ec_pubkey(id: int, priv: *tryte, pub: *tryte) -> int {
    var c: *curve = curve_of(id);
    var d: [24]int;
    bn_from_octets(&d[0], c.limbs, priv, c.octets);
    pub[0] = 4;
    return _ec_mult(c, &d[0], &c.gx[0], &c.gy[0], pub + 1, pub + 1 + c.octets);
}

// A new key pair: priv (octets bytes, 1 .. n-1, from getrandom) and pub
// (04 || X || Y). 1, or 0 if no good private key came (it never should).
fn ec_keygen(id: int, priv: *tryte, pub: *tryte) -> int {
    var c: *curve = curve_of(id);
    var n: int = c.limbs;
    var d: [24]int;
    var tries: int = 0;
    while (tries < 27) {
        getrandom(priv, c.octets, 0);
        bn_from_octets(&d[0], n, priv, c.octets);
        if (!bn_is_zero(&d[0], n) && bn_cmp(&d[0], &c.fq.m[0], n) < 0) { return ec_pubkey(id, priv, pub); }
        tries += 1;
    }
    return 0;
}

// The shared secret: the x coordinate of priv·peer (octets bytes) into
// out. 0 if the peer's key is not an uncompressed point of the curve, or
// the result is the point at infinity.
fn ecdh(id: int, priv: *tryte, peer: *tryte, plen: int, out: *tryte) -> int {
    var c: *curve = curve_of(id);
    _ec = c;
    var n: int = c.limbs;
    var ob: int = c.octets;
    if (plen != 1 + 2 * ob || peer[0] != 4) { return 0; }
    var qx: [24]int;
    var qy: [24]int;
    var t: [24]int;
    if (!bn_from_octets(&t[0], n, peer + 1, ob) || bn_cmp(&t[0], &c.fp.m[0], n) >= 0) { return 0; }
    mont_to(&c.fp, &qx[0], &t[0]);
    if (!bn_from_octets(&t[0], n, peer + 1 + ob, ob) || bn_cmp(&t[0], &c.fp.m[0], n) >= 0) { return 0; }
    mont_to(&c.fp, &qy[0], &t[0]);
    if (!_on_curve(&qx[0], &qy[0])) { return 0; }
    var d: [24]int;
    bn_from_octets(&d[0], n, priv, ob);
    var y: [48]tryte;
    return _ec_mult(c, &d[0], &qx[0], &qy[0], out, &y[0]);
}
