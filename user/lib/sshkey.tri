// sshkey.tri: Trinux's ssh-ed25519 key files, for ssh and ssh-keygen.
//
// A private key file holds the 32-octet seed in hex (one line, mode 0600);
// its .pub file is OpenSSH's one-line format, "ssh-ed25519 BASE64 comment",
// so it can go straight into an authorized_keys file anywhere.

import "tlibc.tri";
import "string.tri";
import "c25519.tri";
import "base64.tri";

fn _hexval(c: int) -> int {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return -1;
}

// The public-key blob: string "ssh-ed25519", string key (51 octets).
fn key_blob(pk: *tryte, blob: *tryte) {
    put_be32(blob, 11);
    var name: *char = "ssh-ed25519";
    var k: int = 0;
    while (k < 11) { blob[4 + k] = name[k] as tryte; k += 1; }
    put_be32(blob + 15, 32);
    k = 0;
    while (k < 32) { blob[19 + k] = pk[k]; k += 1; }
}

// "SHA256:..." of a blob, as OpenSSH prints it.
fn key_fingerprint(blob: *tryte, n: int, out: *char) {
    var d: [32]tryte;
    sha256(blob, n, &d[0]);
    strcpy(out, "SHA256:");
    base64_encode(&d[0], 32, out + 7, 1);
}

// Read a private key file: 0 with sk (64) and pk (32) filled, -1 if it
// cannot be read, -2 if it is not a key.
fn key_load(path: *char, sk: *tryte, pk: *tryte) -> int {
    var text: [80]char;
    var fd: int = open(path, O_RDONLY, 0);
    if (fd < 0) { return -1; }
    var n: int = read(fd, &text[0], 80);
    close(fd);
    if (n < 64) { return -2; }
    var seed: [32]tryte;
    var k: int = 0;
    while (k < 32) {
        var hi: int = _hexval(text[2 * k]);
        var lo: int = _hexval(text[2 * k + 1]);
        if (hi < 0 || lo < 0) { return -2; }
        seed[k] = (hi * 16 + lo) as tryte;
        k += 1;
    }
    ed25519_keypair(&seed[0], sk, pk);
    k = 0;
    while (k < 32) { seed[k] = 0; k += 1; }
    return 0;
}

// Make a new key: path (0600) and path.pub. 0, or -1 (errno set).
fn key_create(path: *char, comment: *char, pk: *tryte) -> int {
    var seed: [32]tryte;
    if (getrandom(&seed[0], 32, 0) != 32) { return -1; }
    var text: [66]char;
    var d: *char = "0123456789abcdef";
    var k: int = 0;
    while (k < 32) {
        text[2 * k] = d[seed[k] / 16];
        text[2 * k + 1] = d[seed[k] % 16];
        k += 1;
    }
    text[64] = '\n';
    var fd: int = open(path, O_WRONLY + O_CREAT + O_TRUNC, 384);
    if (fd < 0) { return -1; }
    var w: int = write(fd, &text[0], 65);
    close(fd);
    if (w != 65) { return -1; }
    var sk: [64]tryte;
    ed25519_keypair(&seed[0], &sk[0], pk);
    var blob: [51]tryte;
    key_blob(pk, &blob[0]);
    var line: [400]char;
    strcpy(&line[0], "ssh-ed25519 ");
    base64_encode(&blob[0], 51, &line[12], 0);
    strcat(&line[0], " ");
    strncat(&line[0], comment, 200);
    strcat(&line[0], "\n");
    var pub: [300]char;
    strncpy(&pub[0], path, 290);
    pub[290] = 0;
    strcat(&pub[0], ".pub");
    fd = open(&pub[0], O_WRONLY + O_CREAT + O_TRUNC, 420);
    if (fd < 0) { return -1; }
    write(fd, &line[0], strlen(&line[0]));
    close(fd);
    k = 0;
    while (k < 32) { seed[k] = 0; sk[k] = 0; k += 1; }
    return 0;
}
