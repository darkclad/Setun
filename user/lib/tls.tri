// tls.tri: TLS 1.3 (RFC 8446) over a connected socket, client and server.
//
// Cipher suites TLS_CHACHA20_POLY1305_SHA256 (preferred: fastest here),
// TLS_AES_128_GCM_SHA256 and TLS_AES_256_GCM_SHA384. Key exchange X25519;
// the first ClientHello carries only an X25519 key share but offers
// secp256r1 and secp384r1 too, so a server that wants one of those asks
// again (HelloRetryRequest) and gets its share then. The server proves
// itself with its certificate chain (x509.tri, checked against the trust
// store and the host name) and a CertificateVerify signature: ECDSA
// P-256/P-384, RSA-PSS or Ed25519. No session resumption, no early data,
// no TLS 1.2. A server that asks for a client certificate gets none.
//
// The server side (tls_accept) speaks the same. It takes its own
// preference among the suites the client offers (ChaCha20-Poly1305, then
// AES-128-GCM, then AES-256-GCM) and the client's X25519, P-256 or P-384
// share, asking with a HelloRetryRequest when the client offers a group it
// supports but sent no share for it. It proves itself with an ECDSA P-256
// or P-384 key and its certificate chain.

import "certgen.tri";
import "x509.tri";
import "hmac.tri";
import "chacha.tri";
import "aes.tri";
import "ctype.tri";

const TLS_CHACHA20_POLY1305_SHA256: int = 4867;     // 0x1303
const TLS_AES_128_GCM_SHA256: int = 4865;           // 0x1301
const TLS_AES_256_GCM_SHA384: int = 4866;           // 0x1302
const TLS_X25519: int = 29;
const TLS_SECP256R1: int = 23;
const TLS_SECP384R1: int = 24;

const TLS_E_FAIL: int = -1;                 // the handshake or a record failed
const TLS_E_CERT: int = -2;                 // the certificate did not verify

const TLS_REC_MAX: int = 16640;             // 2^14 + 256: the largest record body
const TLS_MSG_MAX: int = 59049;             // the largest handshake message taken

struct tls {
    fd: int;
    host: *char;                            // checked against the certificate (null: not)
    verify: int;                            // check the chain (0: --no-check-certificate)
    now: int;                               // seconds since 1970, for the validity check
    why: [243]char;                         // what went wrong
    cert_err: int;                          // X509_E_* when the certificate failed
    done: int;                              // the handshake is over
    eof: int;                               // close_notify came
    unclean: int;                           // the connection ended without close_notify
    server: int;                            // this end is the server
    deadline: int;                          // reads give up after this (ms, monotonic; 0: never)
    th: hash_ctx;                           // the transcript
    suite: int;                             // the cipher suite chosen,
    hid: int;                               // its hash,
    hlen: int;                              // the hash's length
    klen: int;                              // and the key's
    group: int;                             // the key exchange
    hrr: int;                               // the server asked again
    // traffic secrets and record keys
    rsec: [48]tryte;
    wsec: [48]tryte;
    rgcm: gcm;
    wgcm: gcm;
    rkey: [32]tryte;
    riv: [12]tryte;
    rseq: int;
    wkey: [32]tryte;
    wiv: [12]tryte;
    wseq: int;
    rprot: int;                             // records are protected (each way)
    wprot: int;
    // the record being read
    rec: [16650]tryte;
    rtype: int;
    rpos: int;
    rn: int;
    // the handshake message being read, header and all
    msg: [59049]tryte;
    mlen: int;
    sigscheme: int;                         // the server's CertificateVerify scheme
}

// The server's certificates (the chain as sent).
var tls_certs: [9]x509;
var tls_ncerts: int;
var _tls_der: [59049]tryte;
var _tls_out: [16700]tryte;

// ---- failing ----------------------------------------------------------------------------------

fn _alert_name(d: int) -> *char {
    if (d == 0) { return "close notify"; }
    if (d == 10) { return "unexpected message"; }
    if (d == 20) { return "bad record mac"; }
    if (d == 22) { return "record overflow"; }
    if (d == 40) { return "handshake failure"; }
    if (d == 42) { return "bad certificate"; }
    if (d == 43) { return "unsupported certificate"; }
    if (d == 44) { return "certificate revoked"; }
    if (d == 45) { return "certificate expired"; }
    if (d == 46) { return "certificate unknown"; }
    if (d == 47) { return "illegal parameter"; }
    if (d == 48) { return "unknown ca"; }
    if (d == 50) { return "decode error"; }
    if (d == 51) { return "decrypt error"; }
    if (d == 70) { return "protocol version"; }
    if (d == 71) { return "insufficient security"; }
    if (d == 80) { return "internal error"; }
    if (d == 86) { return "inappropriate fallback"; }
    if (d == 90) { return "user canceled"; }
    if (d == 109) { return "missing extension"; }
    if (d == 110) { return "unsupported extension"; }
    if (d == 112) { return "unrecognized name"; }
    if (d == 116) { return "certificate required"; }
    if (d == 120) { return "no application protocol"; }
    return "unknown alert";
}

fn _why(t: *tls, a: *char, b: *char) {
    strcpy(&t.why[0], a);
    strncat(&t.why[0], b, 242 - strlen(&t.why[0]));
}

// Tell the server (alert d, fatal), note why; TLS_E_FAIL.
fn _fail(t: *tls, d: int, why: *char) -> int {
    if (t.why[0] == 0) { _why(t, why, ""); }
    if (d > 0) {
        var a: [2]tryte;
        a[0] = 2;
        a[1] = d as tryte;
        _send_record(t, 21, &a[0], 2);
    }
    return TLS_E_FAIL;
}

// ---- records ----------------------------------------------------------------------------------

fn _write_all(fd: int, p: *tryte, n: int) -> int {
    var done: int = 0;
    while (done < n) {
        var w: int = write(fd, (p + done) as *char, n - done);
        if (w <= 0) { return -1; }
        done += w;
    }
    return 0;
}

fn _now_ms() -> int {
    var ts: timespec;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

var _tls_deadline: int;                     // the deadline of the read in progress

// n octets: n, 0 at a clean end before any, -1 otherwise (-2: too late).
fn _read_full(fd: int, p: *tryte, n: int) -> int {
    var got: int = 0;
    while (got < n) {
        if (_tls_deadline > 0) {
            var left: int = _tls_deadline - _now_ms();
            var pf: pollfd;
            pf.fd = fd;
            pf.events = POLLIN;
            pf.revents = 0;
            if (left <= 0 || poll(&pf, 1, left) == 0) { return -2; }
        }
        var r: int = read(fd, (p + got) as *char, n - got);
        if (r <= 0) { return got == 0 && r == 0 ? 0 : -1; }
        got += r;
    }
    return n;
}

// The per-record nonce: the IV with the sequence number XORed into its end.
fn _nonce(out: *tryte, iv: *tryte, seq: int) {
    var k: int = 0;
    while (k < 12) { out[k] = iv[k]; k += 1; }
    k = 11;
    while (seq > 0) {
        out[k] = xor8(out[k], seq % 256) as tryte;
        seq = seq / 256;
        k -= 1;
    }
}

// Send one record (protected once the keys are set).
fn _send_record(t: *tls, type: int, p: *tryte, n: int) -> int {
    var o: *tryte = &_tls_out[0];
    var k: int = 0;
    while (k < n) { o[5 + k] = p[k]; k += 1; }
    var len: int = n;
    o[0] = type as tryte;
    if (t.wprot) {
        o[5 + n] = type as tryte;               // TLSInnerPlaintext: content, type
        len = n + 1 + 16;
        o[0] = 23;
    }
    o[1] = 3;
    o[2] = (type == 22 && !t.wprot && !t.server ? 1 : 3) as tryte;    // a ClientHello's record says TLS 1.0
    o[3] = (len / 256) as tryte;
    o[4] = (len % 256) as tryte;
    if (t.wprot) {
        var nonce: [12]tryte;
        _nonce(&nonce[0], &t.wiv[0], t.wseq);
        if (t.suite == TLS_CHACHA20_POLY1305_SHA256) { aead_seal(&t.wkey[0], &nonce[0], o, 5, o + 5, n + 1); }
        else { gcm_seal(&t.wgcm, &nonce[0], o, 5, o + 5, n + 1); }
        t.wseq += 1;
    }
    return _write_all(t.fd, o, 5 + len);
}

// Read the next record (opened if protected) into t.rec: 1, 0 at the end
// of the connection or a close_notify, or TLS_E_FAIL. Alerts end here.
fn _record_in(t: *tls) -> int {
    loop {
        var h: [5]tryte;
        _tls_deadline = t.deadline;
        var r: int = _read_full(t.fd, &h[0], 5);
        if (r == -2) { return _fail(t, 0, "the peer was too slow"); }
        if (r == 0) {
            t.unclean = 1;
            if (!t.done) { return _fail(t, 0, t.server ? "the client closed the connection during the handshake" : "the server closed the connection during the handshake"); }
            return 0;
        }
        if (r < 0) { return _fail(t, 0, "the connection broke"); }
        var type: int = h[0];
        var len: int = h[3] * 256 + h[4];
        if (h[1] != 3 || len > TLS_REC_MAX || (!t.rprot && len > 16384)) {
            return _fail(t, 22, h[1] != 3 ? (t.server ? "not a TLS client" : "not a TLS server") : "record overflow");
        }
        if (len == 0 && type != 23) { return _fail(t, 10, "an empty record"); }
        var rl: int = _read_full(t.fd, &t.rec[0], len);
        if (rl == -2) { return _fail(t, 0, "the peer was too slow"); }
        if (rl != len) { return _fail(t, 0, "the connection broke"); }
        // the compatibility ChangeCipherSpec: one octet 1, during the handshake
        if (type == 20) {
            if (t.done || len != 1 || t.rec[0] != 1) { return _fail(t, 10, "an unexpected change_cipher_spec"); }
            continue;
        }
        if (t.rprot) {
            if (type != 23) { return _fail(t, 10, "an unprotected record after the handshake keys"); }
            if (len < 17) { return _fail(t, 50, "a record too short"); }
            var nonce: [12]tryte;
            _nonce(&nonce[0], &t.riv[0], t.rseq);
            var good: int = 0;
            if (t.suite == TLS_CHACHA20_POLY1305_SHA256) { good = aead_open(&t.rkey[0], &nonce[0], &h[0], 5, &t.rec[0], len - 16); }
            else { good = gcm_open(&t.rgcm, &nonce[0], &h[0], 5, &t.rec[0], len - 16); }
            if (!good) {
                return _fail(t, 20, "bad record MAC");
            }
            t.rseq += 1;
            var n: int = len - 16;
            while (n > 0 && t.rec[n - 1] == 0) { n -= 1; }
            if (n == 0) { return _fail(t, 10, "a record with no content type"); }
            t.rtype = t.rec[n - 1];
            t.rn = n - 1;
        } else {
            if (type != 22 && type != 21) { return _fail(t, 10, "an unexpected record"); }
            t.rtype = type;
            t.rn = len;
        }
        t.rpos = 0;
        if (t.rtype == 21) {
            if (t.rn != 2) { return _fail(t, 50, "a bad alert"); }
            if (t.rec[1] == 0) { t.eof = 1; return 0; }
            if (t.rec[1] == 90) { continue; }    // user_canceled: a close_notify follows
            _why(t, t.server ? "the client sent an alert: " : "the server sent an alert: ", _alert_name(t.rec[1]));
            return TLS_E_FAIL;
        }
        if (t.rtype != 22 && t.rtype != 23) { return _fail(t, 10, "an unexpected record type"); }
        if (t.rtype == 23 && !t.done) { return _fail(t, 10, "application data during the handshake"); }
        if (t.rn == 0 && t.rtype == 22) { return _fail(t, 10, "an empty handshake record"); }
        return 1;
    }
    return TLS_E_FAIL;
}

// The next handshake message into t.msg (t.mlen octets, header and all):
// its type, or TLS_E_FAIL.
fn _hs_msg(t: *tls) -> int {
    var have: int = 0;
    var need: int = 4;
    while (have < need) {
        if (t.rpos >= t.rn) {
            var r: int = _record_in(t);
            if (r == 0) { return _fail(t, 0, "the connection ended in a handshake message"); }
            if (r < 0) { return r; }
            if (t.rtype != 22) { return _fail(t, 10, "a record inside a handshake message"); }
        }
        while (have < need && t.rpos < t.rn) {
            t.msg[have] = t.rec[t.rpos];
            have += 1;
            t.rpos += 1;
        }
        if (have == 4 && need == 4) {
            need = 4 + (t.msg[1] * 256 + t.msg[2]) * 256 + t.msg[3];
            if (need > TLS_MSG_MAX) { return _fail(t, 22, "a handshake message too long"); }
        }
    }
    t.mlen = need;
    return t.msg[0];
}

// ---- the key schedule -------------------------------------------------------------------------

// Derive-Secret: HKDF-Expand-Label(secret, label, transcript hash), a hash long
fn _derive(t: *tls, secret: *tryte, label: *char, th: *tryte, out: *tryte) {
    hkdf_expand_label(t.hid, secret, label, th, t.hlen, out, t.hlen);
}

// Record keys from a traffic secret.
fn _keys(t: *tls, sec: *tryte, key: *tryte, iv: *tryte) {
    var none: [1]tryte;
    hkdf_expand_label(t.hid, sec, "key", &none[0], 0, key, t.klen);
    hkdf_expand_label(t.hid, sec, "iv", &none[0], 0, iv, 12);
}

fn _set_read(t: *tls, sec: *tryte) {
    var k: int = 0;
    while (k < t.hlen) { t.rsec[k] = sec[k]; k += 1; }
    _keys(t, &t.rsec[0], &t.rkey[0], &t.riv[0]);
    if (t.suite != TLS_CHACHA20_POLY1305_SHA256) { gcm_setkey(&t.rgcm, &t.rkey[0], t.klen); }
    t.rseq = 0;
    t.rprot = 1;
}

fn _set_write(t: *tls, sec: *tryte) {
    var k: int = 0;
    while (k < t.hlen) { t.wsec[k] = sec[k]; k += 1; }
    _keys(t, &t.wsec[0], &t.wkey[0], &t.wiv[0]);
    if (t.suite != TLS_CHACHA20_POLY1305_SHA256) { gcm_setkey(&t.wgcm, &t.wkey[0], t.klen); }
    t.wseq = 0;
    t.wprot = 1;
}

// HMAC(finished_key(base), transcript hash)
fn _finished(t: *tls, base: *tryte, th: *tryte, out: *tryte) {
    var fk: [48]tryte;
    var none: [1]tryte;
    hkdf_expand_label(t.hid, base, "finished", &none[0], 0, &fk[0], t.hlen);
    hmac(t.hid, &fk[0], t.hlen, th, t.hlen, out);
}

// ---- building messages ------------------------------------------------------------------------

var _b: *tryte;
var _bn: int;

fn _p8(v: int) { _b[_bn] = v as tryte; _bn += 1; }
fn _p16(v: int) { _p8(v / 256); _p8(v % 256); }
fn _p24(v: int) { _p8(v / 65536); _p16(v % 65536); }
fn _pn(p: *tryte, n: int) { var k: int = 0; while (k < n) { _p8(p[k]); k += 1; } }
// fill in a 16- or 24-bit length at off, counting from it
fn _len16(off: int) { var n: int = _bn - off - 2; _b[off] = (n / 256) as tryte; _b[off + 1] = (n % 256) as tryte; }
fn _len24(off: int) { var n: int = _bn - off - 3; _b[off] = (n / 65536) as tryte; _b[off + 1] = (n / 256 % 256) as tryte; _b[off + 2] = (n % 256) as tryte; }

fn _is_ipv4(h: *char) -> int {
    var k: int = 0;
    while (h[k] != 0) {
        if ((h[k] < '0' || h[k] > '9') && h[k] != '.') { return 0; }
        k += 1;
    }
    return k > 0;
}

// A ClientHello with one key share (group, share: shlen octets) and, after
// a HelloRetryRequest, the server's cookie (clen > 0).
fn _client_hello(t: *tls, buf: *tryte, random: *tryte, sid: *tryte, group: int, share: *tryte, shlen: int, cookie: *tryte, clen: int) -> int {
    _b = buf;
    _bn = 0;
    _p8(1);
    var hl: int = _bn;
    _p24(0);
    _p16(771);                                  // legacy_version 0x0303
    _pn(random, 32);
    _p8(32);                                     // a session id, for middleboxes
    _pn(sid, 32);
    _p16(6);
    _p16(TLS_CHACHA20_POLY1305_SHA256);
    _p16(TLS_AES_128_GCM_SHA256);
    _p16(TLS_AES_256_GCM_SHA384);
    _p8(1);
    _p8(0);                                      // no compression
    var el: int = _bn;
    _p16(0);
    if (t.host != null && !_is_ipv4(t.host)) {  // server_name
        var n: int = strlen(t.host);
        _p16(0);
        _p16(n + 5);
        _p16(n + 3);
        _p8(0);
        _p16(n);
        var k: int = 0;
        while (k < n) { _p8(t.host[k]); k += 1; }
    }
    _p16(10);                                    // supported_groups
    _p16(8);
    _p16(6);
    _p16(TLS_X25519);
    _p16(TLS_SECP256R1);
    _p16(TLS_SECP384R1);
    _p16(13);                                    // signature_algorithms
    var algs: [9]int = { 1027, 1283, 2052, 2053, 2054, 2055, 1025, 1281, 1537 };
    _p16(20);
    _p16(18);
    var i: int = 0;
    while (i < 9) { _p16(algs[i]); i += 1; }
    _p16(43);                                    // supported_versions: TLS 1.3
    _p16(3);
    _p8(2);
    _p16(772);
    _p16(51);                                    // key_share: one
    _p16(shlen + 6);
    _p16(shlen + 4);
    _p16(group);
    _p16(shlen);
    _pn(share, shlen);
    if (clen > 0) {                              // cookie, echoed
        _p16(44);
        _p16(clen);
        _pn(cookie, clen);
    }
    _len16(el);
    _len24(hl);
    return _bn;
}

// ---- reading messages -------------------------------------------------------------------------

var _m: *tryte;
var _mp: int;
var _mend: int;
var _mbad: int;

fn _g8() -> int {
    if (_mp >= _mend) { _mbad = 1; return 0; }
    _mp += 1;
    return _m[_mp - 1];
}
fn _g16() -> int { var a: int = _g8(); return a * 256 + _g8(); }
fn _g24() -> int { var a: int = _g8(); return a * 65536 + _g16(); }
fn _skip(n: int) { if (n < 0 || _mp + n > _mend) { _mbad = 1; _mp = _mend; } else { _mp += n; } }

fn _mstart(t: *tls) {
    _m = &t.msg[0];
    _mp = 4;
    _mend = t.mlen;
    _mbad = 0;
}

// ServerHello or HelloRetryRequest (t.hrr): the suite into t.suite (and
// its hash), the group into t.group; a ServerHello's key share into spub
// (*splen octets), a HelloRetryRequest's cookie into cookie (*clen). 0 or
// TLS_E_FAIL.
fn _server_hello(t: *tls, sid: *tryte, spub: *tryte, splen: *int, cookie: *tryte, clen: *int) -> int {
    _mstart(t);
    var ver: int = _g16();
    var random: *tryte = _m + _mp;
    _skip(32);
    // a HelloRetryRequest has this "random" (SHA-256 of "HelloRetryRequest")
    t.hrr = der_is(random, 32, "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c");
    var sl: int = _g8();
    if (sl != 32 || !octets_equal(_m + _mp, sid, 32)) { return _fail(t, 47, "a bad session id echo"); }
    _skip(32);
    var suite: int = _g16();
    var comp: int = _g8();
    var have_ver: int = 0;
    var have_key: int = 0;
    clen[0] = 0;
    if (_mp == _mend) {
        // no extensions: TLS 1.2 or older
        return _fail(t, 70, "the server does not speak TLS 1.3");
    }
    var el: int = _g16();
    if (_mp + el != _mend) { return _fail(t, 50, "a malformed ServerHello"); }
    while (_mp < _mend && !_mbad) {
        var et: int = _g16();
        var len: int = _g16();
        var end: int = _mp + len;
        if (end > _mend) { return _fail(t, 50, "a malformed ServerHello"); }
        if (et == 43) {
            if (len != 2 || _g16() != 772) { return _fail(t, 47, "the server chose another TLS version"); }
            have_ver = 1;
        } else if (et == 51) {
            var g: int = _g16();
            if (g != TLS_X25519 && g != TLS_SECP256R1 && g != TLS_SECP384R1) { return _fail(t, 47, "the server chose a key exchange not offered"); }
            t.group = g;
            if (t.hrr) {
                if (len != 2) { return _fail(t, 50, "a malformed HelloRetryRequest"); }
            } else {
                var kl: int = _g16();
                if (kl != len - 4 || kl > 97) { return _fail(t, 50, "a malformed key share"); }
                var k: int = 0;
                while (k < kl) { spub[k] = _m[_mp + k]; k += 1; }
                splen[0] = kl;
            }
            have_key = 1;
        } else if (et == 44 && t.hrr) {
            var cl: int = _g16();
            if (cl != len - 2 || cl < 1 || cl > 243) { return _fail(t, 50, "a malformed cookie"); }
            var k2: int = 0;
            while (k2 < cl) { cookie[k2] = _m[_mp + k2]; k2 += 1; }
            clen[0] = cl;
        } else {
            return _fail(t, 110, "an unexpected ServerHello extension");
        }
        _mp = end;
    }
    if (_mbad) { return _fail(t, 50, "a malformed ServerHello"); }
    if (!have_ver) { return _fail(t, 70, "the server does not speak TLS 1.3"); }
    if (ver != 771 || comp != 0) { return _fail(t, 47, "a bad ServerHello"); }
    if (suite != TLS_CHACHA20_POLY1305_SHA256 && suite != TLS_AES_128_GCM_SHA256 && suite != TLS_AES_256_GCM_SHA384) {
        return _fail(t, 47, "the server chose a cipher suite not offered");
    }
    if (!have_key) { return _fail(t, 109, "no key share from the server"); }
    t.suite = suite;
    t.hid = suite == TLS_AES_256_GCM_SHA384 ? HASH_SHA384 : HASH_SHA256;
    t.hlen = hash_len(t.hid);
    t.klen = suite == TLS_AES_128_GCM_SHA256 ? 16 : 32;
    return 0;
}

fn _encrypted_extensions(t: *tls) -> int {
    _mstart(t);
    var el: int = _g16();
    if (_mp + el != _mend) { return _fail(t, 50, "malformed EncryptedExtensions"); }
    while (_mp < _mend && !_mbad) {
        var et: int = _g16();
        var len: int = _g16();
        // what only a ServerHello may carry must not come here
        if (et == 43 || et == 51 || et == 41) { return _fail(t, 47, "a ServerHello extension in EncryptedExtensions"); }
        _skip(len);
    }
    if (_mbad) { return _fail(t, 50, "malformed EncryptedExtensions"); }
    return 0;
}

fn _certificate(t: *tls) -> int {
    _mstart(t);
    var cl: int = _g8();
    _skip(cl);                                   // the request context: empty from a server
    var ll: int = _g24();
    if (_mbad || _mp + ll != _mend) { return _fail(t, 50, "a malformed Certificate"); }
    tls_ncerts = 0;
    var used: int = 0;
    while (_mp < _mend && !_mbad) {
        var n: int = _g24();
        if (_mbad || n == 0 || _mp + n > _mend) { return _fail(t, 50, "a malformed Certificate"); }
        if (tls_ncerts < X509_MAX_CHAIN && used + n <= 59049) {
            var d: *tryte = &_tls_der[used];
            var k: int = 0;
            while (k < n) { d[k] = _m[_mp + k]; k += 1; }
            var r: int = x509_parse(&tls_certs[tls_ncerts], d, n);
            if (r < 0) {
                if (tls_ncerts == 0) {
                    t.cert_err = r;
                    _why(t, "the server's certificate: ", x509_error(r));
                    _fail(t, r == X509_E_ALG ? 43 : 42, "");
                    return TLS_E_CERT;
                }
                // a spare certificate this cannot read: leave it out
            } else {
                used += n;
                tls_ncerts += 1;
            }
        }
        _skip(n);
        var xl: int = _g16();
        _skip(xl);
    }
    if (_mbad || tls_ncerts == 0) { return _fail(t, 50, "a malformed Certificate"); }
    if (t.verify) {
        var r: int = x509_verify_chain(&tls_certs[0], tls_ncerts, t.host, t.now);
        if (r < 0) {
            t.cert_err = r;
            _why(t, x509_error(r), "");
            var a: int = 42;
            if (r == X509_E_EXPIRED || r == X509_E_NOTYET) { a = 45; }
            else if (r == X509_E_ISSUER || r == X509_E_SELF) { a = 48; }
            else if (r == X509_E_ALG) { a = 43; }
            _fail(t, a, "");
            return TLS_E_CERT;
        }
    }
    return 0;
}

// CertificateVerify, over the transcript hash th
fn _certificate_verify(t: *tls, th: *tryte) -> int {
    _mstart(t);
    var scheme: int = _g16();
    var sl: int = _g16();
    if (_mbad || _mp + sl != _mend) { return _fail(t, 50, "a malformed CertificateVerify"); }
    var leaf: *x509 = &tls_certs[0];
    var sig: int = 0;
    var id: int = 0;
    var key: int = 0;
    if (scheme == 1027) { sig = SIG_ECDSA; id = HASH_SHA256; key = KEY_P256; }
    else if (scheme == 1283) { sig = SIG_ECDSA; id = HASH_SHA384; key = KEY_P384; }
    else if (scheme == 2052) { sig = SIG_RSA_PSS; id = HASH_SHA256; key = KEY_RSA; }
    else if (scheme == 2053) { sig = SIG_RSA_PSS; id = HASH_SHA384; key = KEY_RSA; }
    else if (scheme == 2054) { sig = SIG_RSA_PSS; id = HASH_SHA512; key = KEY_RSA; }
    else if (scheme == 2055) { sig = SIG_ED25519; key = KEY_ED25519; }
    if (sig == 0 || leaf.key != key) { return _fail(t, 47, "a CertificateVerify scheme not offered or not the key's"); }
    t.sigscheme = scheme;
    // 64 spaces, the context string, a zero, the transcript hash
    var content: [146]tryte;
    var k: int = 0;
    while (k < 64) { content[k] = 32; k += 1; }
    var ctx: *char = "TLS 1.3, server CertificateVerify";
    k = 0;
    while (k < 33) { content[64 + k] = ctx[k] as tryte; k += 1; }
    content[97] = 0;
    k = 0;
    while (k < t.hlen) { content[98 + k] = th[k]; k += 1; }
    if (!pk_verify(leaf, sig, id, &content[0], 98 + t.hlen, _m + _mp, sl)) {
        return _fail(t, 51, "the server's CertificateVerify signature is wrong");
    }
    return 0;
}

// ---- the handshake ----------------------------------------------------------------------------

// Shake hands over the connected socket fd: 0, TLS_E_CERT if the
// certificate did not verify, TLS_E_FAIL otherwise (t.why says why).
fn tls_connect(t: *tls, fd: int, host: *char, verify: int, now: int) -> int {
    t.fd = fd;
    t.host = host;
    t.verify = verify;
    t.now = now;
    t.why[0] = 0;
    t.cert_err = 0;
    t.done = 0;
    t.eof = 0;
    t.unclean = 0;
    t.rprot = 0;
    t.wprot = 0;
    t.rpos = 0;
    t.rn = 0;
    t.sigscheme = 0;
    t.hrr = 0;
    t.suite = 0;
    t.server = 0;
    t.deadline = 0;
    tls_ncerts = 0;
    bin32_init();
    // ClientHello, with an X25519 share
    var random: [32]tryte;
    var sid: [32]tryte;
    var priv: [48]tryte;
    var pub: [97]tryte;
    getrandom(&random[0], 32, 0);
    getrandom(&sid[0], 32, 0);
    getrandom(&priv[0], 32, 0);
    x25519_base(&pub[0], &priv[0]);
    var ch: [729]tryte;
    var chn: int = _client_hello(t, &ch[0], &random[0], &sid[0], TLS_X25519, &pub[0], 32, &pub[0], 0);
    if (_send_record(t, 22, &ch[0], chn) < 0) { return _fail(t, 0, "the connection broke"); }
    // ServerHello, or HelloRetryRequest
    var type: int = _hs_msg(t);
    if (type < 0) { return type; }
    if (type != 2) { return _fail(t, 10, "no ServerHello"); }
    var spub: [97]tryte;
    var splen: int = 0;
    var cookie: [243]tryte;
    var clen: int = 0;
    if (_server_hello(t, &sid[0], &spub[0], &splen, &cookie[0], &clen) < 0) { return TLS_E_FAIL; }
    if (t.rpos < t.rn) { return _fail(t, 10, "more in the record after the ServerHello"); }
    var hash1: [48]tryte;
    if (t.hrr) {
        // the transcript starts again from message_hash(ClientHello1), the
        // HelloRetryRequest and a new ClientHello with the share asked for
        if (t.group == TLS_X25519) { return _fail(t, 47, "a HelloRetryRequest for the share already sent"); }
        var hrr_suite: int = t.suite;
        hash_octets(t.hid, &ch[0], chn, &hash1[0]);
        hash_init(&t.th, t.hid);
        var mh: [4]tryte;
        mh[0] = 254;
        mh[1] = 0;
        mh[2] = 0;
        mh[3] = t.hlen as tryte;
        hash_update(&t.th, &mh[0], 4);
        hash_update(&t.th, &hash1[0], t.hlen);
        hash_update(&t.th, &t.msg[0], t.mlen);
        var cid: int = t.group == TLS_SECP256R1 ? CURVE_P256 : CURVE_P384;
        if (!ec_keygen(cid, &priv[0], &pub[0])) { return _fail(t, 80, "no key pair"); }
        var publen: int = t.group == TLS_SECP256R1 ? 65 : 97;
        chn = _client_hello(t, &ch[0], &random[0], &sid[0], t.group, &pub[0], publen, &cookie[0], clen);
        hash_update(&t.th, &ch[0], chn);
        // (the compatibility ChangeCipherSpec goes before the second ClientHello)
        var ccs1: [1]tryte;
        ccs1[0] = 1;
        if (_send_record(t, 20, &ccs1[0], 1) < 0) { return _fail(t, 0, "the connection broke"); }
        if (_send_record(t, 22, &ch[0], chn) < 0) { return _fail(t, 0, "the connection broke"); }
        var asked: int = t.group;
        type = _hs_msg(t);
        if (type < 0) { return type; }
        if (type != 2) { return _fail(t, 10, "no ServerHello"); }
        if (_server_hello(t, &sid[0], &spub[0], &splen, &cookie[0], &clen) < 0) { return TLS_E_FAIL; }
        if (t.hrr) { return _fail(t, 10, "a second HelloRetryRequest"); }
        if (t.suite != hrr_suite || t.group != asked) { return _fail(t, 47, "the ServerHello does not match the HelloRetryRequest"); }
        if (t.rpos < t.rn) { return _fail(t, 10, "more in the record after the ServerHello"); }
        hash_update(&t.th, &t.msg[0], t.mlen);
    } else {
        hash_init(&t.th, t.hid);
        hash_update(&t.th, &ch[0], chn);
        hash_update(&t.th, &t.msg[0], t.mlen);
    }
    // the shared secret
    var shared: [48]tryte;
    var shlen: int = 32;
    var k: int = 0;
    if (t.group == TLS_X25519) {
        if (splen != 32) { return _fail(t, 47, "a bad X25519 key share"); }
        x25519(&shared[0], &priv[0], &spub[0]);
        var z: int = 0;
        while (k < 32) { z = z + shared[k]; k += 1; }
        if (z == 0) { return _fail(t, 47, "a degenerate X25519 key"); }
    } else {
        var cv: int = t.group == TLS_SECP256R1 ? CURVE_P256 : CURVE_P384;
        shlen = t.group == TLS_SECP256R1 ? 32 : 48;
        if (!ecdh(cv, &priv[0], &spub[0], splen, &shared[0])) { return _fail(t, 47, "a bad ECDH key share"); }
    }
    // the handshake secrets
    var hl: int = t.hlen;
    var zero: [48]tryte;
    k = 0;
    while (k < 48) { zero[k] = 0; k += 1; }
    var early: [48]tryte;
    hkdf_extract(t.hid, &zero[0], hl, &zero[0], hl, &early[0]);
    var empty: [48]tryte;
    hash_octets(t.hid, &zero[0], 0, &empty[0]);
    var derived: [48]tryte;
    _derive(t, &early[0], "derived", &empty[0], &derived[0]);
    var hs: [48]tryte;
    hkdf_extract(t.hid, &derived[0], hl, &shared[0], shlen, &hs[0]);
    var th: [48]tryte;
    hash_peek(&t.th, &th[0]);
    var chs: [48]tryte;
    var shs: [48]tryte;
    _derive(t, &hs[0], "c hs traffic", &th[0], &chs[0]);
    _derive(t, &hs[0], "s hs traffic", &th[0], &shs[0]);
    _set_read(t, &shs[0]);
    // EncryptedExtensions
    type = _hs_msg(t);
    if (type < 0) { return type; }
    if (type != 8) { return _fail(t, 10, "no EncryptedExtensions"); }
    if (_encrypted_extensions(t) < 0) { return TLS_E_FAIL; }
    hash_update(&t.th, &t.msg[0], t.mlen);
    // CertificateRequest?
    type = _hs_msg(t);
    if (type < 0) { return type; }
    var creq: [256]tryte;
    var creqlen: int = -1;
    if (type == 13) {
        _mstart(t);
        creqlen = _g8();
        if (_mbad || _mp + creqlen > _mend) { return _fail(t, 50, "a malformed CertificateRequest"); }
        k = 0;
        while (k < creqlen) { creq[k] = _m[_mp + k]; k += 1; }
        hash_update(&t.th, &t.msg[0], t.mlen);
        type = _hs_msg(t);
        if (type < 0) { return type; }
    }
    // Certificate, CertificateVerify
    if (type != 11) { return _fail(t, 10, "no Certificate"); }
    var r: int = _certificate(t);
    if (r < 0) { return r; }
    hash_update(&t.th, &t.msg[0], t.mlen);
    type = _hs_msg(t);
    if (type < 0) { return type; }
    if (type != 15) { return _fail(t, 10, "no CertificateVerify"); }
    hash_peek(&t.th, &th[0]);
    if (_certificate_verify(t, &th[0]) < 0) { return TLS_E_FAIL; }
    hash_update(&t.th, &t.msg[0], t.mlen);
    // the server's Finished
    type = _hs_msg(t);
    if (type < 0) { return type; }
    if (type != 20 || t.mlen != 4 + hl) { return _fail(t, 10, "no Finished"); }
    hash_peek(&t.th, &th[0]);
    var want: [48]tryte;
    _finished(t, &shs[0], &th[0], &want[0]);
    if (!octets_equal(&want[0], &t.msg[4], hl)) { return _fail(t, 51, "the server's Finished is wrong"); }
    if (t.rpos < t.rn) { return _fail(t, 10, "more in the record after the Finished"); }
    hash_update(&t.th, &t.msg[0], t.mlen);
    // the application secrets, from the transcript up to here
    hash_peek(&t.th, &th[0]);
    _derive(t, &hs[0], "derived", &empty[0], &derived[0]);
    var master: [48]tryte;
    hkdf_extract(t.hid, &derived[0], hl, &zero[0], hl, &master[0]);
    var cap: [48]tryte;
    var sap: [48]tryte;
    _derive(t, &master[0], "c ap traffic", &th[0], &cap[0]);
    _derive(t, &master[0], "s ap traffic", &th[0], &sap[0]);
    // our flight: (a compatibility ChangeCipherSpec, unless sent already),
    // [an empty Certificate], Finished
    if (!t.hrr) {
        var ccs: [1]tryte;
        ccs[0] = 1;
        if (_send_record(t, 20, &ccs[0], 1) < 0) { return _fail(t, 0, "the connection broke"); }
    }
    _set_write(t, &chs[0]);
    var out: [300]tryte;
    if (creqlen >= 0) {
        _b = &out[0];
        _bn = 0;
        _p8(11);
        _p24(creqlen + 4);
        _p8(creqlen);
        _pn(&creq[0], creqlen);
        _p24(0);
        hash_update(&t.th, &out[0], _bn);
        if (_send_record(t, 22, &out[0], _bn) < 0) { return _fail(t, 0, "the connection broke"); }
    }
    hash_peek(&t.th, &th[0]);
    out[0] = 20;
    out[1] = 0;
    out[2] = 0;
    out[3] = hl as tryte;
    _finished(t, &chs[0], &th[0], &out[4]);
    if (_send_record(t, 22, &out[0], 4 + hl) < 0) { return _fail(t, 0, "the connection broke"); }
    _set_read(t, &sap[0]);
    _set_write(t, &cap[0]);
    t.done = 1;
    return 0;
}

// ---- after the handshake ----------------------------------------------------------------------

// The handshake messages that come later: tickets (unused) and key updates.
fn _post_handshake(t: *tls) -> int {
    var type: int = _hs_msg(t);
    if (type < 0) { return type; }
    if (type == 4) { return 0; }                 // NewSessionTicket: no resumption here
    if (type == 24) {                            // KeyUpdate
        if (t.mlen != 5 || t.msg[4] > 1) { return _fail(t, 50, "a malformed KeyUpdate"); }
        if (t.rpos < t.rn) { return _fail(t, 10, "more in the record after a KeyUpdate"); }
        var next: [48]tryte;
        var none: [1]tryte;
        hkdf_expand_label(t.hid, &t.rsec[0], "traffic upd", &none[0], 0, &next[0], t.hlen);
        _set_read(t, &next[0]);
        if (t.msg[4] == 1) {
            // update_requested: answer with ours, then change our keys
            var ku: [5]tryte;
            ku[0] = 24; ku[1] = 0; ku[2] = 0; ku[3] = 1; ku[4] = 0;
            if (_send_record(t, 22, &ku[0], 5) < 0) { return _fail(t, 0, "the connection broke"); }
            hkdf_expand_label(t.hid, &t.wsec[0], "traffic upd", &none[0], 0, &next[0], t.hlen);
            _set_write(t, &next[0]);
        }
        return 0;
    }
    return _fail(t, 10, "an unexpected handshake message");
}

// Read application data: up to n octets, 0 at the end, TLS_E_FAIL.
fn tls_read(t: *tls, p: *tryte, n: int) -> int {
    while (t.rpos >= t.rn || t.rtype != 23) {
        if (t.eof || t.unclean) { return 0; }
        if (t.rpos < t.rn && t.rtype == 22) {
            if (_post_handshake(t) < 0) { return TLS_E_FAIL; }
            continue;
        }
        var r: int = _record_in(t);
        if (r <= 0) { return r; }
        if (t.rtype == 22) {
            if (_post_handshake(t) < 0) { return TLS_E_FAIL; }
        }
    }
    var k: int = 0;
    while (k < n && t.rpos < t.rn) {
        p[k] = t.rec[t.rpos];
        k += 1;
        t.rpos += 1;
    }
    return k;
}

// Send application data: 0 or TLS_E_FAIL.
fn tls_write(t: *tls, p: *tryte, n: int) -> int {
    var done: int = 0;
    while (done < n) {
        var m: int = n - done > 16384 ? 16384 : n - done;
        if (_send_record(t, 23, p + done, m) < 0) { return _fail(t, 0, "the connection broke"); }
        done += m;
    }
    return 0;
}

// Say goodbye (close_notify); the socket stays open.
fn tls_close(t: *tls) {
    var a: [2]tryte;
    a[0] = 1;
    a[1] = 0;
    _send_record(t, 21, &a[0], 2);
}

fn tls_signature_name(scheme: int) -> *char {
    if (scheme == 1027) { return "ecdsa_secp256r1_sha256"; }
    if (scheme == 1283) { return "ecdsa_secp384r1_sha384"; }
    if (scheme == 2052) { return "rsa_pss_rsae_sha256"; }
    if (scheme == 2053) { return "rsa_pss_rsae_sha384"; }
    if (scheme == 2054) { return "rsa_pss_rsae_sha512"; }
    if (scheme == 2055) { return "ed25519"; }
    return "?";
}

fn tls_suite_name(suite: int) -> *char {
    if (suite == TLS_CHACHA20_POLY1305_SHA256) { return "TLS_CHACHA20_POLY1305_SHA256"; }
    if (suite == TLS_AES_128_GCM_SHA256) { return "TLS_AES_128_GCM_SHA256"; }
    if (suite == TLS_AES_256_GCM_SHA384) { return "TLS_AES_256_GCM_SHA384"; }
    return "?";
}

fn tls_group_name(group: int) -> *char {
    if (group == TLS_X25519) { return "x25519"; }
    if (group == TLS_SECP256R1) { return "secp256r1"; }
    if (group == TLS_SECP384R1) { return "secp384r1"; }
    return "?";
}

// ---- the server side ---------------------------------------------------------------------------

// What the server proves itself with.
struct tls_identity {
    cid: int;                               // CURVE_P256 or CURVE_P384
    priv: [48]tryte;
    chain: *tryte;                          // the certificates (DER), one after another,
    lens: [9]int;                           // their lengths,
    n: int;                                 // how many
}

// Load a key (lib/certgen.tri formats) and a PEM chain (the server's own
// certificate first): 0, or -1 (said why on standard error).
fn tls_identity_load(id: *tls_identity, keyfile: *char, certfile: *char, buf: *tryte, max: int) -> int {
    var pub: [97]tryte;
    if (ec_key_read(keyfile, &id.cid, &id.priv[0], &pub[0]) < 0) {
        fputs(STDERR_FILENO, keyfile);
        fputs(STDERR_FILENO, ": not a P-256 or P-384 private key\n");
        return -1;
    }
    var certs: [9]x509;
    var set: pem_set;
    set.certs = &certs[0];
    set.max = 9;
    set.der = buf;
    set.dermax = max;
    set.n = 0;
    set.used = 0;
    var r: int = x509_read_pem(&set, certfile, 1);
    if (r <= 0 || set.n == 0) {
        fputs(STDERR_FILENO, certfile);
        fputs(STDERR_FILENO, ": ");
        fputs(STDERR_FILENO, r < 0 ? x509_error(r) : "no certificates");
        fputs(STDERR_FILENO, "\n");
        return -1;
    }
    // the certificate must be for the key
    var want: int = id.cid == CURVE_P256 ? KEY_P256 : KEY_P384;
    if (certs[0].key != want || certs[0].publen != 1 + 2 * curve_octets(id.cid)
        || !octets_equal(certs[0].p + certs[0].pub, &pub[0], certs[0].publen)) {
        fputs(STDERR_FILENO, certfile);
        fputs(STDERR_FILENO, ": the certificate is not for the key in ");
        fputs(STDERR_FILENO, keyfile);
        fputs(STDERR_FILENO, "\n");
        return -1;
    }
    id.chain = buf;
    id.n = set.n;
    var k: int = 0;
    while (k < set.n) { id.lens[k] = certs[k].len; k += 1; }
    return 0;
}

// What the ClientHello offered.
var _ch_sid: [32]tryte;
var _ch_sidlen: int;
var _ch_suite: int;                         // our choice among its suites (0: none)
var _ch_share: [97]tryte;                   // its share for _ch_group (or none: length 0)
var _ch_sharelen: int;
var _ch_group: int;                         // the group of the share we take
var _ch_want_group: int;                    // a group it supports, if no share fits
var _ch_sigok: int;                         // it accepts our signature scheme
var _ch_tls13: int;
var _ch_cookie: int;                        // it echoed a cookie (only after our HRR)

fn _client_hello_in(t: *tls, scheme: int) -> int {
    _mstart(t);
    _g16();                                 // legacy_version: ignored, as RFC 8446 says
    _skip(32);
    _ch_sidlen = _g8();
    if (_ch_sidlen > 32 || _mp + _ch_sidlen > _mend) { return _fail(t, 47, "a bad session id"); }
    var k: int = 0;
    while (k < _ch_sidlen) { _ch_sid[k] = _m[_mp + k]; k += 1; }
    _skip(_ch_sidlen);
    var sl: int = _g16();
    if (sl < 2 || sl % 2 != 0 || _mp + sl > _mend) { return _fail(t, 50, "a malformed ClientHello"); }
    var chacha: int = 0;
    var aes128: int = 0;
    var aes256: int = 0;
    var send: int = _mp + sl;
    while (_mp < send) {
        var cs: int = _g16();
        if (cs == TLS_CHACHA20_POLY1305_SHA256) { chacha = 1; }
        if (cs == TLS_AES_128_GCM_SHA256) { aes128 = 1; }
        if (cs == TLS_AES_256_GCM_SHA384) { aes256 = 1; }
    }
    _ch_suite = chacha ? TLS_CHACHA20_POLY1305_SHA256 : aes128 ? TLS_AES_128_GCM_SHA256 : aes256 ? TLS_AES_256_GCM_SHA384 : 0;
    var cl: int = _g8();
    if (cl != 1 || _g8() != 0) { return _fail(t, 47, "compression in a TLS 1.3 ClientHello"); }
    _ch_tls13 = 0;
    _ch_sigok = 0;
    _ch_sharelen = 0;
    _ch_group = 0;
    _ch_want_group = 0;
    _ch_cookie = 0;
    if (_mp == _mend) { return 0; }                     // no extensions: an old client
    var el: int = _g16();
    if (_mbad || _mp + el != _mend) { return _fail(t, 50, "a malformed ClientHello"); }
    var x25519: int = 0;
    var p256: int = 0;
    var p384: int = 0;
    while (_mp < _mend && !_mbad) {
        var et: int = _g16();
        var len: int = _g16();
        var end: int = _mp + len;
        if (end > _mend) { return _fail(t, 50, "a malformed ClientHello"); }
        if (et == 43) {                                 // supported_versions
            var vl: int = _g8();
            if (vl + 1 != len || vl % 2 != 0) { return _fail(t, 50, "malformed supported_versions"); }
            while (_mp < end) { if (_g16() == 772) { _ch_tls13 = 1; } }
        } else if (et == 10) {                          // supported_groups
            var gl: int = _g16();
            if (gl + 2 != len || gl % 2 != 0) { return _fail(t, 50, "malformed supported_groups"); }
            while (_mp < end) {
                var g: int = _g16();
                if (g == TLS_X25519) { x25519 = 1; }
                if (g == TLS_SECP256R1) { p256 = 1; }
                if (g == TLS_SECP384R1) { p384 = 1; }
            }
        } else if (et == 13) {                          // signature_algorithms
            var al: int = _g16();
            if (al + 2 != len || al % 2 != 0) { return _fail(t, 50, "malformed signature_algorithms"); }
            while (_mp < end) { if (_g16() == scheme) { _ch_sigok = 1; } }
        } else if (et == 51) {                          // key_share
            var kl: int = _g16();
            if (kl + 2 != len) { return _fail(t, 50, "a malformed key_share"); }
            while (_mp < end && !_mbad) {
                var g2: int = _g16();
                var ln: int = _g16();
                if (_mp + ln > end) { return _fail(t, 50, "a malformed key_share"); }
                // the first share in our order of preference: X25519, P-256, P-384
                var rank: int = g2 == TLS_X25519 ? 3 : g2 == TLS_SECP256R1 ? 2 : g2 == TLS_SECP384R1 ? 1 : 0;
                var have: int = _ch_group == TLS_X25519 ? 3 : _ch_group == TLS_SECP256R1 ? 2 : _ch_group == TLS_SECP384R1 ? 1 : 0;
                if (rank > have && ln <= 97) {
                    _ch_group = g2;
                    _ch_sharelen = ln;
                    var j: int = 0;
                    while (j < ln) { _ch_share[j] = _m[_mp + j]; j += 1; }
                }
                _skip(ln);
            }
        } else if (et == 44) {
            _ch_cookie = 1;
        }
        _mp = end;
    }
    if (_mbad) { return _fail(t, 50, "a malformed ClientHello"); }
    if (_ch_group == 0) {
        _ch_want_group = x25519 ? TLS_X25519 : p256 ? TLS_SECP256R1 : p384 ? TLS_SECP384R1 : 0;
    }
    return 0;
}

// A ServerHello (or, with hrr, a HelloRetryRequest for group) into buf.
fn _server_hello_out(t: *tls, buf: *tryte, hrr: int, group: int, share: *tryte, shlen: int) -> int {
    _b = buf;
    _bn = 0;
    _p8(2);
    var hl: int = _bn;
    _p24(0);
    _p16(771);
    if (hrr) {
        var hr: [32]tryte;
        unhex_into("cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c", &hr[0]);
        _pn(&hr[0], 32);
    } else {
        var random: [32]tryte;
        getrandom(&random[0], 32, 0);
        _pn(&random[0], 32);
    }
    _p8(_ch_sidlen);
    _pn(&_ch_sid[0], _ch_sidlen);
    _p16(t.suite);
    _p8(0);
    var el: int = _bn;
    _p16(0);
    _p16(43);
    _p16(2);
    _p16(772);
    _p16(51);
    if (hrr) {
        _p16(2);
        _p16(group);
    } else {
        _p16(shlen + 4);
        _p16(group);
        _p16(shlen);
        _pn(share, shlen);
    }
    _len16(el);
    _len24(hl);
    return _bn;
}

fn unhex_into(h: *char, out: *tryte) {
    var k: int = 0;
    while (h[2 * k] != 0) { out[k] = (xdigit_val(h[2 * k]) * 16 + xdigit_val(h[2 * k + 1])) as tryte; k += 1; }
}

// The server's handshake over the accepted socket fd, as id: 0, or
// TLS_E_FAIL (t.why says why; the client was told with an alert).
// timeout_ms: how long the client gets for the whole handshake (0: forever).
fn tls_accept(t: *tls, fd: int, id: *tls_identity, timeout_ms: int) -> int {
    t.fd = fd;
    t.host = null;
    t.verify = 0;
    t.now = 0;
    t.why[0] = 0;
    t.cert_err = 0;
    t.done = 0;
    t.eof = 0;
    t.unclean = 0;
    t.rprot = 0;
    t.wprot = 0;
    t.rpos = 0;
    t.rn = 0;
    t.sigscheme = id.cid == CURVE_P256 ? 1027 : 1283;
    t.hrr = 0;
    t.suite = 0;
    t.server = 1;
    t.deadline = timeout_ms > 0 ? _now_ms() + timeout_ms : 0;
    bin32_init();
    var type: int = _hs_msg(t);
    if (type < 0) { return type; }
    if (type != 1) { return _fail(t, 10, "no ClientHello"); }
    if (_client_hello_in(t, t.sigscheme) < 0) { return TLS_E_FAIL; }
    if (!_ch_tls13) { return _fail(t, 70, "the client does not speak TLS 1.3"); }
    if (_ch_suite == 0) { return _fail(t, 40, "no cipher suite in common"); }
    if (!_ch_sigok) { return _fail(t, 40, "the client does not take our signature scheme"); }
    if (_ch_cookie) { return _fail(t, 47, "a cookie we never sent"); }
    t.suite = _ch_suite;
    t.hid = t.suite == TLS_AES_256_GCM_SHA384 ? HASH_SHA384 : HASH_SHA256;
    t.hlen = hash_len(t.hid);
    t.klen = t.suite == TLS_AES_128_GCM_SHA256 ? 16 : 32;
    var sh: [729]tryte;
    var n: int = 0;
    if (_ch_group == 0) {
        if (_ch_want_group == 0) { return _fail(t, 40, "no key exchange group in common"); }
        // ask again: message_hash(ClientHello1), the HelloRetryRequest, ClientHello2
        var h1: [48]tryte;
        hash_octets(t.hid, &t.msg[0], t.mlen, &h1[0]);
        hash_init(&t.th, t.hid);
        var mh: [4]tryte;
        mh[0] = 254;
        mh[1] = 0;
        mh[2] = 0;
        mh[3] = t.hlen as tryte;
        hash_update(&t.th, &mh[0], 4);
        hash_update(&t.th, &h1[0], t.hlen);
        var asked: int = _ch_want_group;
        var suite1: int = t.suite;
        n = _server_hello_out(t, &sh[0], 1, asked, &sh[0], 0);
        hash_update(&t.th, &sh[0], n);
        if (_send_record(t, 22, &sh[0], n) < 0) { return _fail(t, 0, "the connection broke"); }
        var ccs0: [1]tryte;
        ccs0[0] = 1;
        if (_send_record(t, 20, &ccs0[0], 1) < 0) { return _fail(t, 0, "the connection broke"); }
        t.hrr = 1;
        type = _hs_msg(t);
        if (type < 0) { return type; }
        if (type != 1) { return _fail(t, 10, "no second ClientHello"); }
        if (_client_hello_in(t, t.sigscheme) < 0) { return TLS_E_FAIL; }
        if (_ch_group != asked || _ch_suite != suite1) { return _fail(t, 47, "the second ClientHello does not answer the HelloRetryRequest"); }
        hash_update(&t.th, &t.msg[0], t.mlen);
    } else {
        hash_init(&t.th, t.hid);
        hash_update(&t.th, &t.msg[0], t.mlen);
    }
    if (t.rpos < t.rn) { return _fail(t, 10, "more in the record after the ClientHello"); }
    t.group = _ch_group;
    // our share and the shared secret
    var priv: [48]tryte;
    var pub: [97]tryte;
    var publen: int = 32;
    var shared: [48]tryte;
    var shlen: int = 32;
    if (t.group == TLS_X25519) {
        if (_ch_sharelen != 32) { return _fail(t, 47, "a bad X25519 key share"); }
        getrandom(&priv[0], 32, 0);
        x25519_base(&pub[0], &priv[0]);
        x25519(&shared[0], &priv[0], &_ch_share[0]);
        var z: int = 0;
        var k: int = 0;
        while (k < 32) { z = z + shared[k]; k += 1; }
        if (z == 0) { return _fail(t, 47, "a degenerate X25519 key"); }
    } else {
        var cv: int = t.group == TLS_SECP256R1 ? CURVE_P256 : CURVE_P384;
        publen = t.group == TLS_SECP256R1 ? 65 : 97;
        shlen = publen == 65 ? 32 : 48;
        if (!ec_keygen(cv, &priv[0], &pub[0])) { return _fail(t, 80, "no key pair"); }
        if (!ecdh(cv, &priv[0], &_ch_share[0], _ch_sharelen, &shared[0])) { return _fail(t, 47, "a bad ECDH key share"); }
    }
    n = _server_hello_out(t, &sh[0], 0, t.group, &pub[0], publen);
    hash_update(&t.th, &sh[0], n);
    if (_send_record(t, 22, &sh[0], n) < 0) { return _fail(t, 0, "the connection broke"); }
    if (!t.hrr) {
        var ccs: [1]tryte;
        ccs[0] = 1;
        if (_send_record(t, 20, &ccs[0], 1) < 0) { return _fail(t, 0, "the connection broke"); }
    }
    // the handshake secrets
    var hl: int = t.hlen;
    var zero: [48]tryte;
    var k2: int = 0;
    while (k2 < 48) { zero[k2] = 0; k2 += 1; }
    var early: [48]tryte;
    hkdf_extract(t.hid, &zero[0], hl, &zero[0], hl, &early[0]);
    var empty: [48]tryte;
    hash_octets(t.hid, &zero[0], 0, &empty[0]);
    var derived: [48]tryte;
    _derive(t, &early[0], "derived", &empty[0], &derived[0]);
    var hs: [48]tryte;
    hkdf_extract(t.hid, &derived[0], hl, &shared[0], shlen, &hs[0]);
    var th: [48]tryte;
    hash_peek(&t.th, &th[0]);
    var chs: [48]tryte;
    var shs: [48]tryte;
    _derive(t, &hs[0], "c hs traffic", &th[0], &chs[0]);
    _derive(t, &hs[0], "s hs traffic", &th[0], &shs[0]);
    _set_write(t, &shs[0]);
    _set_read(t, &chs[0]);
    // EncryptedExtensions (none), Certificate, CertificateVerify, Finished
    var ee: [6]tryte;
    ee[0] = 8; ee[1] = 0; ee[2] = 0; ee[3] = 2; ee[4] = 0; ee[5] = 0;
    hash_update(&t.th, &ee[0], 6);
    if (_send_record(t, 22, &ee[0], 6) < 0) { return _fail(t, 0, "the connection broke"); }
    _b = &t.msg[0];
    _bn = 0;
    _p8(11);
    var cl: int = _bn;
    _p24(0);
    _p8(0);                                          // no request context
    var ll: int = _bn;
    _p24(0);
    var off: int = 0;
    var c: int = 0;
    while (c < id.n) {
        _p24(id.lens[c]);
        _pn(id.chain + off, id.lens[c]);
        _p16(0);                                     // no extensions
        off += id.lens[c];
        c += 1;
    }
    var p: *tryte = &t.msg[0];
    var lv: int = _bn - ll - 3;
    p[ll] = (lv / 65536) as tryte; p[ll + 1] = (lv / 256 % 256) as tryte; p[ll + 2] = (lv % 256) as tryte;
    lv = _bn - cl - 3;
    p[cl] = (lv / 65536) as tryte; p[cl + 1] = (lv / 256 % 256) as tryte; p[cl + 2] = (lv % 256) as tryte;
    n = _bn;
    hash_update(&t.th, p, n);
    // (a long chain goes out in several records)
    var sent: int = 0;
    while (sent < n) {
        var part: int = n - sent > 16384 ? 16384 : n - sent;
        if (_send_record(t, 22, p + sent, part) < 0) { return _fail(t, 0, "the connection broke"); }
        sent += part;
    }
    // CertificateVerify: 64 spaces, the context, 0, the transcript hash
    hash_peek(&t.th, &th[0]);
    var content: [146]tryte;
    var j: int = 0;
    while (j < 64) { content[j] = 32; j += 1; }
    var ctx: *char = "TLS 1.3, server CertificateVerify";
    j = 0;
    while (j < 33) { content[64 + j] = ctx[j] as tryte; j += 1; }
    content[97] = 0;
    j = 0;
    while (j < hl) { content[98 + j] = th[j]; j += 1; }
    var sig: [128]tryte;
    var sigl: int = ecdsa_sign_der(id.cid, &id.priv[0], &content[0], 98 + hl, &sig[0]);
    if (sigl < 0) { return _fail(t, 80, "signing failed"); }
    var cv2: [140]tryte;
    cv2[0] = 15;
    cv2[1] = 0;
    cv2[2] = 0;
    cv2[3] = (sigl + 4) as tryte;
    cv2[4] = (t.sigscheme / 256) as tryte;
    cv2[5] = (t.sigscheme % 256) as tryte;
    cv2[6] = 0;
    cv2[7] = sigl as tryte;
    j = 0;
    while (j < sigl) { cv2[8 + j] = sig[j]; j += 1; }
    hash_update(&t.th, &cv2[0], 8 + sigl);
    if (_send_record(t, 22, &cv2[0], 8 + sigl) < 0) { return _fail(t, 0, "the connection broke"); }
    hash_peek(&t.th, &th[0]);
    var fin: [52]tryte;
    fin[0] = 20;
    fin[1] = 0;
    fin[2] = 0;
    fin[3] = hl as tryte;
    _finished(t, &shs[0], &th[0], &fin[4]);
    hash_update(&t.th, &fin[0], 4 + hl);
    if (_send_record(t, 22, &fin[0], 4 + hl) < 0) { return _fail(t, 0, "the connection broke"); }
    // the application secrets, from the transcript up to our Finished
    hash_peek(&t.th, &th[0]);
    _derive(t, &hs[0], "derived", &empty[0], &derived[0]);
    var master: [48]tryte;
    hkdf_extract(t.hid, &derived[0], hl, &zero[0], hl, &master[0]);
    var cap: [48]tryte;
    var sap: [48]tryte;
    _derive(t, &master[0], "c ap traffic", &th[0], &cap[0]);
    _derive(t, &master[0], "s ap traffic", &th[0], &sap[0]);
    // the client's Finished (a Certificate first is not asked for: refused)
    type = _hs_msg(t);
    if (type < 0) { return type; }
    if (type != 20 || t.mlen != 4 + hl) { return _fail(t, 10, "no Finished from the client"); }
    var want: [48]tryte;
    _finished(t, &chs[0], &th[0], &want[0]);
    if (!octets_equal(&want[0], &t.msg[4], hl)) { return _fail(t, 51, "the client's Finished is wrong"); }
    if (t.rpos < t.rn) { return _fail(t, 10, "more in the record after the Finished"); }
    _set_read(t, &cap[0]);
    _set_write(t, &sap[0]);
    t.done = 1;
    t.deadline = 0;
    return 0;
}

// The deadline for reads from now on (ms from now; 0: none).
fn tls_set_timeout(t: *tls, ms: int) {
    t.deadline = ms > 0 ? _now_ms() + ms : 0;
}

// Is a decrypted record waiting (so a poll on the socket would not show it)?
fn tls_pending(t: *tls) -> int {
    return t.rtype == 23 && t.rpos < t.rn;
}
