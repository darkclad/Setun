// ---- SHA-256 ------------------------------------------------------------------------------

struct sha256_ctx {
    h: [8]int;
    total: int;                       // octets so far
    n: int;                           // octets in buf
    buf: [64]tryte;
}

var _w256: [64]int;

fn sha256_init(c: *sha256_ctx) {
    bin32_init();
    var k: int = 0;
    while (k < 8) { c.h[k] = _h256[k]; k += 1; }
    c.total = 0;
    c.n = 0;
}

fn _sha256_block(c: *sha256_ctx, p: *tryte) {
    var w: *int = &_w256[0];
    var t: int = 0;
    while (t < 16) { w[t] = be32(p + 4 * t); t += 1; }
    while (t < 64) {
        var x: int = w[t - 15];
        var y: int = w[t - 2];
        // (a right rotation by n is BROT left by 32 - n)
        var s0: int = bxor(bxor(brot(x, 25, 32), brot(x, 14, 32)), bsh(x, -3));
        var s1: int = bxor(bxor(brot(y, 15, 32), brot(y, 13, 32)), bsh(y, -10));
        w[t] = bext(w[t - 16] + s0 + w[t - 7] + s1, 0, 32);
        t += 1;
    }
    var a: int = c.h[0];
    var b: int = c.h[1];
    var cc: int = c.h[2];
    var d: int = c.h[3];
    var e: int = c.h[4];
    var f: int = c.h[5];
    var g: int = c.h[6];
    var h: int = c.h[7];
    t = 0;
    while (t < 64) {
        var S1: int = bxor(bxor(brot(e, 26, 32), brot(e, 21, 32)), brot(e, 7, 32));
        var ch: int = band(e, f) + bandn(g, e);                     // disjoint bits: + is XOR
        var t1: int = bext(h + S1 + ch + _k256[t] + w[t], 0, 32);
        var S0: int = bxor(bxor(brot(a, 30, 32), brot(a, 19, 32)), brot(a, 10, 32));
        var maj: int = band(a, b) + band(cc, bxor(a, b));           // likewise
        var t2: int = bext(S0 + maj, 0, 32);
        h = g;
        g = f;
        f = e;
        e = bext(d + t1, 0, 32);
        d = cc;
        cc = b;
        b = a;
        a = bext(t1 + t2, 0, 32);
        t += 1;
    }
    c.h[0] = (c.h[0] + a) % TWO32;
    c.h[1] = (c.h[1] + b) % TWO32;
    c.h[2] = (c.h[2] + cc) % TWO32;
    c.h[3] = (c.h[3] + d) % TWO32;
    c.h[4] = (c.h[4] + e) % TWO32;
    c.h[5] = (c.h[5] + f) % TWO32;
    c.h[6] = (c.h[6] + g) % TWO32;
    c.h[7] = (c.h[7] + h) % TWO32;
}

fn sha256_update(c: *sha256_ctx, p: *tryte, n: int) {
    c.total += n;
    var k: int = 0;
    while (k < n) {
        if (c.n == 0 && n - k >= 64) {
            _sha256_block(c, p + k);
            k += 64;
            continue;
        }
        c.buf[c.n] = p[k];
        c.n += 1;
        k += 1;
        if (c.n == 64) {
            _sha256_block(c, &c.buf[0]);
            c.n = 0;
        }
    }
}

fn sha256_final(c: *sha256_ctx, out: *tryte) {
    var bits: int = c.total * 8;
    var pad: [72]tryte;
    var m: int = (c.n < 56 ? 56 : 120) - c.n;
    pad[0] = 128;
    var k: int = 1;
    while (k < m) { pad[k] = 0; k += 1; }
    put_be32(&pad[m], bits / TWO32);
    put_be32(&pad[m + 4], bits % TWO32);
    sha256_update(c, &pad[0], m + 8);
    k = 0;
    while (k < 8) { put_be32(out + 4 * k, c.h[k]); k += 1; }
}

fn sha256(p: *tryte, n: int, out: *tryte) {
    var c: sha256_ctx;
    sha256_init(&c);
    sha256_update(&c, p, n);
    sha256_final(&c, out);
}

// ---- SHA-512 ------------------------------------------------------------------------------

struct sha512_ctx {
    hi: [8]int;
    lo: [8]int;
    total: int;
    n: int;
    buf: [128]tryte;
}

var _whi: [80]int;
var _wlo: [80]int;

// The result of a 64-bit operation: (_rh, _rl).
var _rh: int;
var _rl: int;

fn _rotr64(hi: int, lo: int, n: int) {
    if (n >= 32) {
        var t: int = hi;
        hi = lo;
        lo = t;
        n -= 32;
    }
    if (n == 0) { _rh = hi; _rl = lo; return; }
    var p: int = _pow2[n];
    var q: int = _pow2[32 - n];
    _rh = hi / p + lo % p * q;
    _rl = lo / p + hi % p * q;
}

fn _shr64(hi: int, lo: int, n: int) {
    var p: int = _pow2[n];
    _rh = hi / p;
    _rl = lo / p + hi % p * _pow2[32 - n];
}

fn sha512_init(c: *sha512_ctx) {
    bin32_init();
    var k: int = 0;
    while (k < 8) { c.hi[k] = _h512hi[k]; c.lo[k] = _h512lo[k]; k += 1; }
    c.total = 0;
    c.n = 0;
}

fn _sha512_block(c: *sha512_ctx, p: *tryte) {
    var t: int = 0;
    while (t < 16) {
        _whi[t] = be32(p + 8 * t);
        _wlo[t] = be32(p + 8 * t + 4);
        t += 1;
    }
    while (t < 80) {
        // s0 = rotr 1 ^ rotr 8 ^ shr 7 of w[t-15]; s1 = rotr 19 ^ rotr 61 ^ shr 6 of w[t-2]
        var xh: int = _whi[t - 15];
        var xl: int = _wlo[t - 15];
        _rotr64(xh, xl, 1);
        var ah: int = _rh;
        var al: int = _rl;
        _rotr64(xh, xl, 8);
        ah = xor32(ah, _rh);
        al = xor32(al, _rl);
        _shr64(xh, xl, 7);
        var s0h: int = xor32(ah, _rh);
        var s0l: int = xor32(al, _rl);
        xh = _whi[t - 2];
        xl = _wlo[t - 2];
        _rotr64(xh, xl, 19);
        ah = _rh;
        al = _rl;
        _rotr64(xh, xl, 61);
        ah = xor32(ah, _rh);
        al = xor32(al, _rl);
        _shr64(xh, xl, 6);
        var s1h: int = xor32(ah, _rh);
        var s1l: int = xor32(al, _rl);
        var lo: int = _wlo[t - 16] + s0l + _wlo[t - 7] + s1l;
        _wlo[t] = lo % TWO32;
        _whi[t] = (_whi[t - 16] + s0h + _whi[t - 7] + s1h + lo / TWO32) % TWO32;
        t += 1;
    }
    var vh: [8]int;
    var vl: [8]int;
    var k: int = 0;
    while (k < 8) { vh[k] = c.hi[k]; vl[k] = c.lo[k]; k += 1; }
    t = 0;
    while (t < 80) {
        // S1 = rotr 14 ^ rotr 18 ^ rotr 41 of e
        _rotr64(vh[4], vl[4], 14);
        var ah: int = _rh;
        var al: int = _rl;
        _rotr64(vh[4], vl[4], 18);
        ah = xor32(ah, _rh);
        al = xor32(al, _rl);
        _rotr64(vh[4], vl[4], 41);
        var S1h: int = xor32(ah, _rh);
        var S1l: int = xor32(al, _rl);
        var chh: int = and32(vh[4], vh[5]) + and32(not32(vh[4]), vh[6]);
        var chl: int = and32(vl[4], vl[5]) + and32(not32(vl[4]), vl[6]);
        var t1l: int = vl[7] + S1l + chl + _k512lo[t] + _wlo[t];
        var t1h: int = (vh[7] + S1h + chh + _k512hi[t] + _whi[t] + t1l / TWO32) % TWO32;
        t1l = t1l % TWO32;
        // S0 = rotr 28 ^ rotr 34 ^ rotr 39 of a
        _rotr64(vh[0], vl[0], 28);
        ah = _rh;
        al = _rl;
        _rotr64(vh[0], vl[0], 34);
        ah = xor32(ah, _rh);
        al = xor32(al, _rl);
        _rotr64(vh[0], vl[0], 39);
        var S0h: int = xor32(ah, _rh);
        var S0l: int = xor32(al, _rl);
        var majh: int = and32(vh[0], vh[1]) + and32(vh[2], xor32(vh[0], vh[1]));
        var majl: int = and32(vl[0], vl[1]) + and32(vl[2], xor32(vl[0], vl[1]));
        var t2l: int = S0l + majl;
        var t2h: int = (S0h + majh + t2l / TWO32) % TWO32;
        t2l = t2l % TWO32;
        k = 7;
        while (k > 0) { vh[k] = vh[k - 1]; vl[k] = vl[k - 1]; k -= 1; }
        var el: int = vl[4] + t1l;                                  // vl[4] now holds the old d
        vh[4] = (vh[4] + t1h + el / TWO32) % TWO32;
        vl[4] = el % TWO32;
        var nl: int = t1l + t2l;
        vh[0] = (t1h + t2h + nl / TWO32) % TWO32;
        vl[0] = nl % TWO32;
        t += 1;
    }
    k = 0;
    while (k < 8) {
        var l: int = c.lo[k] + vl[k];
        c.hi[k] = (c.hi[k] + vh[k] + l / TWO32) % TWO32;
        c.lo[k] = l % TWO32;
        k += 1;
    }
}

fn sha512_update(c: *sha512_ctx, p: *tryte, n: int) {
    c.total += n;
    var k: int = 0;
    while (k < n) {
        if (c.n == 0 && n - k >= 128) {
            _sha512_block(c, p + k);
            k += 128;
            continue;
        }
        c.buf[c.n] = p[k];
        c.n += 1;
        k += 1;
        if (c.n == 128) {
            _sha512_block(c, &c.buf[0]);
            c.n = 0;
        }
    }
}

fn sha512_final(c: *sha512_ctx, out: *tryte) {
    var bits: int = c.total * 8;
    var pad: [144]tryte;
    var m: int = (c.n < 112 ? 112 : 240) - c.n;
    pad[0] = 128;
    var k: int = 1;
    while (k < m + 8) { pad[k] = 0; k += 1; }                       // the high 64 bits of the length
    put_be32(&pad[m + 8], bits / TWO32);
    put_be32(&pad[m + 12], bits % TWO32);
    sha512_update(c, &pad[0], m + 16);
    k = 0;
    while (k < 8) {
        put_be32(out + 8 * k, c.hi[k]);
        put_be32(out + 8 * k + 4, c.lo[k]);
        k += 1;
    }
}

fn sha512(p: *tryte, n: int, out: *tryte) {
    var c: sha512_ctx;
    sha512_init(&c);
    sha512_update(&c, p, n);
    sha512_final(&c, out);
}

// ---- SHA-384: SHA-512 with other initial values, cut to 48 octets ------------------------

var _h384hi: [8]int = { 3418070365, 1654270250, 2438529370, 355462360, 1731405415, 2394180231, 3675008525, 1203062813 };
var _h384lo: [8]int = { 3238371032, 914150663, 812702999, 4144912697, 4290775857, 1750603025, 1694076839, 3204075428 };

fn sha384_init(c: *sha512_ctx) {
    sha512_init(c);
    var k: int = 0;
    while (k < 8) { c.hi[k] = _h384hi[k]; c.lo[k] = _h384lo[k]; k += 1; }
}

fn sha384_final(c: *sha512_ctx, out: *tryte) {
    var full: [64]tryte;
    sha512_final(c, &full[0]);
    var k: int = 0;
    while (k < 48) { out[k] = full[k]; k += 1; }
}

fn sha384(p: *tryte, n: int, out: *tryte) {
    var c: sha512_ctx;
    sha384_init(&c);
    sha512_update(&c, p, n);
    sha384_final(&c, out);
}

// ---- one interface for the three -------------------------------------------------------------

const HASH_SHA256: int = 1;
const HASH_SHA384: int = 2;
const HASH_SHA512: int = 3;

fn hash_len(id: int) -> int { return id == HASH_SHA256 ? 32 : id == HASH_SHA384 ? 48 : 64; }
fn hash_block(id: int) -> int { return id == HASH_SHA256 ? 64 : 128; }

fn hash_octets(id: int, p: *tryte, n: int, out: *tryte) {
    if (id == HASH_SHA256) { sha256(p, n, out); }
    else if (id == HASH_SHA384) { sha384(p, n, out); }
    else { sha512(p, n, out); }
}

// A running hash of any of the three.
struct hash_ctx {
    id: int;
    s256: sha256_ctx;
    s512: sha512_ctx;
}

fn hash_init(h: *hash_ctx, id: int) {
    h.id = id;
    if (id == HASH_SHA256) { sha256_init(&h.s256); }
    else if (id == HASH_SHA384) { sha384_init(&h.s512); }
    else { sha512_init(&h.s512); }
}

fn hash_update(h: *hash_ctx, p: *tryte, n: int) {
    if (h.id == HASH_SHA256) { sha256_update(&h.s256, p, n); } else { sha512_update(&h.s512, p, n); }
}

fn hash_final(h: *hash_ctx, out: *tryte) {
    if (h.id == HASH_SHA256) { sha256_final(&h.s256, out); }
    else if (h.id == HASH_SHA384) { sha384_final(&h.s512, out); }
    else { sha512_final(&h.s512, out); }
}

// The hash of what h has taken so far, leaving h running (a TLS transcript).
fn hash_peek(h: *hash_ctx, out: *tryte) {
    var c: hash_ctx;
    c.id = h.id;
    var k: int = 0;
    while (k < 8) {
        c.s256.h[k] = h.s256.h[k];
        c.s512.hi[k] = h.s512.hi[k];
        c.s512.lo[k] = h.s512.lo[k];
        k += 1;
    }
    c.s256.total = h.s256.total;
    c.s256.n = h.s256.n;
    c.s512.total = h.s512.total;
    c.s512.n = h.s512.n;
    k = 0;
    while (k < 128) {
        if (k < 64) { c.s256.buf[k] = h.s256.buf[k]; }
        c.s512.buf[k] = h.s512.buf[k];
        k += 1;
    }
    hash_final(&c, out);
}
