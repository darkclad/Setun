// bignum.tri: big unsigned integers for public-key crypto (RSA, ECDSA).
//
// A number is an array of 16-bit limbs (0..65535), least significant first,
// in ints. A product of two limbs is under 2^32, and a word holds the sum
// of 887 of them, so a whole column of a product is added up before its
// one carry. Multiplication modulo m is Montgomery's by product scanning,
// with R = 2^(16·n); for 16 and 24 limbs (P-256, P-384) it is written out
// in full (made by tools/gen_mont.py).
//
// Sizes: up to BN_MAX limbs (4104 bits: RSA-4096 and its slack).

import "tlibc.tri";

const BN_MAX: int = 260;
const LIMB: int = 65536;

// A modulus prepared for Montgomery multiplication.
struct mont {
    n: int;                               // limbs
    m: [260]int;
    minv: int;                            // -m^-1 mod 2^16
    r2: [260]int;                         // R^2 mod m
    one: [260]int;                        // R mod m (1 in Montgomery form)
}

fn bn_zero(a: *int, n: int) {
    var k: int = 0;
    while (k < n) { a[k] = 0; k += 1; }
}

fn bn_copy(d: *int, a: *int, n: int) {
    var k: int = 0;
    while (k < n) { d[k] = a[k]; k += 1; }
}

fn bn_is_zero(a: *int, n: int) -> int {
    var k: int = 0;
    while (k < n) { if (a[k] != 0) { return 0; } k += 1; }
    return 1;
}

// -1, 0, +1 as a < b, a = b, a > b.
fn bn_cmp(a: *int, b: *int, n: int) -> int {
    var k: int = n - 1;
    while (k >= 0) {
        if (a[k] != b[k]) { return a[k] < b[k] ? -1 : 1; }
        k -= 1;
    }
    return 0;
}

// a -= b (a >= b); the borrow out (0 or 1).
fn bn_sub(a: *int, b: *int, n: int) -> int {
    var borrow: int = 0;
    var k: int = 0;
    while (k < n) {
        var x: int = a[k] - b[k] - borrow;
        borrow = x < 0;
        a[k] = x + LIMB * borrow;
        k += 1;
    }
    return borrow;
}

// a += b; the carry out.
fn bn_add(a: *int, b: *int, n: int) -> int {
    var carry: int = 0;
    var k: int = 0;
    while (k < n) {
        var x: int = a[k] + b[k] + carry;
        carry = x / LIMB;
        a[k] = x % LIMB;
        k += 1;
    }
    return carry;
}

// Big-endian octets (len of them) into n limbs; 0 if they do not fit.
fn bn_from_octets(a: *int, n: int, p: *tryte, len: int) -> int {
    bn_zero(a, n);
    var k: int = 0;
    while (k < len) {
        var pos: int = len - 1 - k;               // octet k from the low end
        var v: int = p[pos];
        if (k / 2 >= n) {
            if (v != 0) { return 0; }
        } else if (k % 2 == 0) {
            a[k / 2] += v;
        } else {
            a[k / 2] += v * 256;
        }
        k += 1;
    }
    return 1;
}

// n limbs into len big-endian octets.
fn bn_to_octets(p: *tryte, len: int, a: *int, n: int) {
    var k: int = 0;
    while (k < len) {
        var v: int = 0;
        if (k / 2 < n) { v = k % 2 == 0 ? a[k / 2] % 256 : a[k / 2] / 256; }
        p[len - 1 - k] = v as tryte;
        k += 1;
    }
}

// Bits in a (the position of the top one, plus one).
fn bn_bits(a: *int, n: int) -> int {
    var k: int = n - 1;
    while (k >= 0 && a[k] == 0) { k -= 1; }
    if (k < 0) { return 0; }
    var b: int = 0;
    var v: int = a[k];
    while (v > 0) { b += 1; v = v / 2; }
    return 16 * k + b;
}

fn bn_bit(a: *int, i: int) -> int {
    var v: int = a[i / 16];
    var s: int = i % 16;
    while (s > 0) { v = v / 2; s -= 1; }
    return v % 2;
}

// ---- Montgomery ------------------------------------------------------------------------------

var _bn_t: [263]int;
var _bn_u: [263]int;

// p[0]·q[0] + p[1]·q[-1] + ... (c products), four at a time.
fn _dot(p: *int, q: *int, c: int) -> int {
    var s: int = 0;
    while (c >= 4) {
        s += p[0] * q[0] + p[1] * q[-1] + p[2] * q[-2] + p[3] * q[-3];
        p = p + 4;
        q = q - 4;
        c -= 4;
    }
    while (c > 0) {
        s += p[0] * q[0];
        p = p + 1;
        q = q - 1;
        c -= 1;
    }
    return s;
}

// mont_mul's columns for any number of limbs: t (n+1 limbs) = a·b·R^-1,
// below 2m.
fn _mont_cols(n: int, a: *int, b: *int, m: *int, minv: int) {
    var t: *int = &_bn_t[0];
    var u: *int = &_bn_u[0];
    var acc: int = 0;
    var k: int = 0;
    while (k < n) {
        acc += _dot(a, b + k, k + 1) + _dot(u, m + k, k);
        var uk: int = bext(bext(acc, 0, 16) * minv, 0, 16);
        u[k] = uk;
        acc = bsh(acc + uk * m[0], -16);          // the low 16 bits are now 0
        k += 1;
    }
    while (k < 2 * n - 1) {
        var j: int = k - n + 1;
        var c: int = 2 * n - 1 - k;
        acc += _dot(a + j, b + (n - 1), c) + _dot(u + j, m + (n - 1), c);
        t[k - n] = bext(acc, 0, 16);
        acc = bsh(acc, -16);
        k += 1;
    }
    t[n - 1] = bext(acc, 0, 16);
    t[n] = bsh(acc, -16);
}

// The columns of mont_mul for 16 limbs, written out (tools/gen_mont.py).
fn _mont_cols16(a: *int, b: *int, m: *int, minv: int) {
    var u: *int = &_bn_u[0];
    var t: *int = &_bn_t[0];
    var acc: int = 0;
    var uk: int = 0;
    acc = acc + a[0] * b[0];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[0] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[1] + a[1] * b[0] + u[0] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[1] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[2] + a[1] * b[1] + a[2] * b[0] + u[0] * m[2]
        + u[1] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[2] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[3] + a[1] * b[2] + a[2] * b[1] + a[3] * b[0]
        + u[0] * m[3] + u[1] * m[2] + u[2] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[3] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[4] + a[1] * b[3] + a[2] * b[2] + a[3] * b[1]
        + a[4] * b[0] + u[0] * m[4] + u[1] * m[3] + u[2] * m[2]
        + u[3] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[4] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[5] + a[1] * b[4] + a[2] * b[3] + a[3] * b[2]
        + a[4] * b[1] + a[5] * b[0] + u[0] * m[5] + u[1] * m[4]
        + u[2] * m[3] + u[3] * m[2] + u[4] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[5] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[6] + a[1] * b[5] + a[2] * b[4] + a[3] * b[3]
        + a[4] * b[2] + a[5] * b[1] + a[6] * b[0] + u[0] * m[6]
        + u[1] * m[5] + u[2] * m[4] + u[3] * m[3] + u[4] * m[2]
        + u[5] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[6] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[7] + a[1] * b[6] + a[2] * b[5] + a[3] * b[4]
        + a[4] * b[3] + a[5] * b[2] + a[6] * b[1] + a[7] * b[0]
        + u[0] * m[7] + u[1] * m[6] + u[2] * m[5] + u[3] * m[4]
        + u[4] * m[3] + u[5] * m[2] + u[6] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[7] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[8] + a[1] * b[7] + a[2] * b[6] + a[3] * b[5]
        + a[4] * b[4] + a[5] * b[3] + a[6] * b[2] + a[7] * b[1]
        + a[8] * b[0] + u[0] * m[8] + u[1] * m[7] + u[2] * m[6]
        + u[3] * m[5] + u[4] * m[4] + u[5] * m[3] + u[6] * m[2]
        + u[7] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[8] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[9] + a[1] * b[8] + a[2] * b[7] + a[3] * b[6]
        + a[4] * b[5] + a[5] * b[4] + a[6] * b[3] + a[7] * b[2]
        + a[8] * b[1] + a[9] * b[0] + u[0] * m[9] + u[1] * m[8]
        + u[2] * m[7] + u[3] * m[6] + u[4] * m[5] + u[5] * m[4]
        + u[6] * m[3] + u[7] * m[2] + u[8] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[9] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[10] + a[1] * b[9] + a[2] * b[8] + a[3] * b[7]
        + a[4] * b[6] + a[5] * b[5] + a[6] * b[4] + a[7] * b[3]
        + a[8] * b[2] + a[9] * b[1] + a[10] * b[0] + u[0] * m[10]
        + u[1] * m[9] + u[2] * m[8] + u[3] * m[7] + u[4] * m[6]
        + u[5] * m[5] + u[6] * m[4] + u[7] * m[3] + u[8] * m[2]
        + u[9] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[10] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[11] + a[1] * b[10] + a[2] * b[9] + a[3] * b[8]
        + a[4] * b[7] + a[5] * b[6] + a[6] * b[5] + a[7] * b[4]
        + a[8] * b[3] + a[9] * b[2] + a[10] * b[1] + a[11] * b[0]
        + u[0] * m[11] + u[1] * m[10] + u[2] * m[9] + u[3] * m[8]
        + u[4] * m[7] + u[5] * m[6] + u[6] * m[5] + u[7] * m[4]
        + u[8] * m[3] + u[9] * m[2] + u[10] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[11] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[12] + a[1] * b[11] + a[2] * b[10] + a[3] * b[9]
        + a[4] * b[8] + a[5] * b[7] + a[6] * b[6] + a[7] * b[5]
        + a[8] * b[4] + a[9] * b[3] + a[10] * b[2] + a[11] * b[1]
        + a[12] * b[0] + u[0] * m[12] + u[1] * m[11] + u[2] * m[10]
        + u[3] * m[9] + u[4] * m[8] + u[5] * m[7] + u[6] * m[6]
        + u[7] * m[5] + u[8] * m[4] + u[9] * m[3] + u[10] * m[2]
        + u[11] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[12] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[13] + a[1] * b[12] + a[2] * b[11] + a[3] * b[10]
        + a[4] * b[9] + a[5] * b[8] + a[6] * b[7] + a[7] * b[6]
        + a[8] * b[5] + a[9] * b[4] + a[10] * b[3] + a[11] * b[2]
        + a[12] * b[1] + a[13] * b[0] + u[0] * m[13] + u[1] * m[12]
        + u[2] * m[11] + u[3] * m[10] + u[4] * m[9] + u[5] * m[8]
        + u[6] * m[7] + u[7] * m[6] + u[8] * m[5] + u[9] * m[4]
        + u[10] * m[3] + u[11] * m[2] + u[12] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[13] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[14] + a[1] * b[13] + a[2] * b[12] + a[3] * b[11]
        + a[4] * b[10] + a[5] * b[9] + a[6] * b[8] + a[7] * b[7]
        + a[8] * b[6] + a[9] * b[5] + a[10] * b[4] + a[11] * b[3]
        + a[12] * b[2] + a[13] * b[1] + a[14] * b[0] + u[0] * m[14]
        + u[1] * m[13] + u[2] * m[12] + u[3] * m[11] + u[4] * m[10]
        + u[5] * m[9] + u[6] * m[8] + u[7] * m[7] + u[8] * m[6]
        + u[9] * m[5] + u[10] * m[4] + u[11] * m[3] + u[12] * m[2]
        + u[13] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[14] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[0] * b[15] + a[1] * b[14] + a[2] * b[13] + a[3] * b[12]
        + a[4] * b[11] + a[5] * b[10] + a[6] * b[9] + a[7] * b[8]
        + a[8] * b[7] + a[9] * b[6] + a[10] * b[5] + a[11] * b[4]
        + a[12] * b[3] + a[13] * b[2] + a[14] * b[1] + a[15] * b[0]
        + u[0] * m[15] + u[1] * m[14] + u[2] * m[13] + u[3] * m[12]
        + u[4] * m[11] + u[5] * m[10] + u[6] * m[9] + u[7] * m[8]
        + u[8] * m[7] + u[9] * m[6] + u[10] * m[5] + u[11] * m[4]
        + u[12] * m[3] + u[13] * m[2] + u[14] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[15] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[1] * b[15] + a[2] * b[14] + a[3] * b[13] + a[4] * b[12]
        + a[5] * b[11] + a[6] * b[10] + a[7] * b[9] + a[8] * b[8]
        + a[9] * b[7] + a[10] * b[6] + a[11] * b[5] + a[12] * b[4]
        + a[13] * b[3] + a[14] * b[2] + a[15] * b[1] + u[1] * m[15]
        + u[2] * m[14] + u[3] * m[13] + u[4] * m[12] + u[5] * m[11]
        + u[6] * m[10] + u[7] * m[9] + u[8] * m[8] + u[9] * m[7]
        + u[10] * m[6] + u[11] * m[5] + u[12] * m[4] + u[13] * m[3]
        + u[14] * m[2] + u[15] * m[1];
    t[0] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[2] * b[15] + a[3] * b[14] + a[4] * b[13] + a[5] * b[12]
        + a[6] * b[11] + a[7] * b[10] + a[8] * b[9] + a[9] * b[8]
        + a[10] * b[7] + a[11] * b[6] + a[12] * b[5] + a[13] * b[4]
        + a[14] * b[3] + a[15] * b[2] + u[2] * m[15] + u[3] * m[14]
        + u[4] * m[13] + u[5] * m[12] + u[6] * m[11] + u[7] * m[10]
        + u[8] * m[9] + u[9] * m[8] + u[10] * m[7] + u[11] * m[6]
        + u[12] * m[5] + u[13] * m[4] + u[14] * m[3] + u[15] * m[2];
    t[1] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[3] * b[15] + a[4] * b[14] + a[5] * b[13] + a[6] * b[12]
        + a[7] * b[11] + a[8] * b[10] + a[9] * b[9] + a[10] * b[8]
        + a[11] * b[7] + a[12] * b[6] + a[13] * b[5] + a[14] * b[4]
        + a[15] * b[3] + u[3] * m[15] + u[4] * m[14] + u[5] * m[13]
        + u[6] * m[12] + u[7] * m[11] + u[8] * m[10] + u[9] * m[9]
        + u[10] * m[8] + u[11] * m[7] + u[12] * m[6] + u[13] * m[5]
        + u[14] * m[4] + u[15] * m[3];
    t[2] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[4] * b[15] + a[5] * b[14] + a[6] * b[13] + a[7] * b[12]
        + a[8] * b[11] + a[9] * b[10] + a[10] * b[9] + a[11] * b[8]
        + a[12] * b[7] + a[13] * b[6] + a[14] * b[5] + a[15] * b[4]
        + u[4] * m[15] + u[5] * m[14] + u[6] * m[13] + u[7] * m[12]
        + u[8] * m[11] + u[9] * m[10] + u[10] * m[9] + u[11] * m[8]
        + u[12] * m[7] + u[13] * m[6] + u[14] * m[5] + u[15] * m[4];
    t[3] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[5] * b[15] + a[6] * b[14] + a[7] * b[13] + a[8] * b[12]
        + a[9] * b[11] + a[10] * b[10] + a[11] * b[9] + a[12] * b[8]
        + a[13] * b[7] + a[14] * b[6] + a[15] * b[5] + u[5] * m[15]
        + u[6] * m[14] + u[7] * m[13] + u[8] * m[12] + u[9] * m[11]
        + u[10] * m[10] + u[11] * m[9] + u[12] * m[8] + u[13] * m[7]
        + u[14] * m[6] + u[15] * m[5];
    t[4] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[6] * b[15] + a[7] * b[14] + a[8] * b[13] + a[9] * b[12]
        + a[10] * b[11] + a[11] * b[10] + a[12] * b[9] + a[13] * b[8]
        + a[14] * b[7] + a[15] * b[6] + u[6] * m[15] + u[7] * m[14]
        + u[8] * m[13] + u[9] * m[12] + u[10] * m[11] + u[11] * m[10]
        + u[12] * m[9] + u[13] * m[8] + u[14] * m[7] + u[15] * m[6];
    t[5] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[7] * b[15] + a[8] * b[14] + a[9] * b[13] + a[10] * b[12]
        + a[11] * b[11] + a[12] * b[10] + a[13] * b[9] + a[14] * b[8]
        + a[15] * b[7] + u[7] * m[15] + u[8] * m[14] + u[9] * m[13]
        + u[10] * m[12] + u[11] * m[11] + u[12] * m[10] + u[13] * m[9]
        + u[14] * m[8] + u[15] * m[7];
    t[6] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[8] * b[15] + a[9] * b[14] + a[10] * b[13] + a[11] * b[12]
        + a[12] * b[11] + a[13] * b[10] + a[14] * b[9] + a[15] * b[8]
        + u[8] * m[15] + u[9] * m[14] + u[10] * m[13] + u[11] * m[12]
        + u[12] * m[11] + u[13] * m[10] + u[14] * m[9] + u[15] * m[8];
    t[7] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
