// bignum.tri: big unsigned integers for public-key crypto (RSA, ECDSA).
//
// A number is an array of 16-bit limbs (0..65535), least significant first,
// in ints. A product of two limbs is under 2^32 and a sum of a few such
// under 2^34, far inside a 27-trit word, so the inner loops need no tricks.
// Multiplication modulo m is Montgomery's (CIOS), with R = 2^(16·n).
//
// Sizes: up to BN_MAX limbs (4104 bits: RSA-4096 and its slack).

import "tlibc.tri";

const BN_MAX: int = 260;
const LIMB: int = 65536;

// A modulus prepared for Montgomery multiplication.
struct mont {
    n: int;                               // limbs
    m: [260]int;
    minv: int;                            // -m^-1 mod 2^16
    r2: [260]int;                         // R^2 mod m
    one: [260]int;                        // R mod m (1 in Montgomery form)
}

fn bn_zero(a: *int, n: int) {
    var k: int = 0;
    while (k < n) { a[k] = 0; k += 1; }
}

fn bn_copy(d: *int, a: *int, n: int) {
    var k: int = 0;
    while (k < n) { d[k] = a[k]; k += 1; }
}

fn bn_is_zero(a: *int, n: int) -> int {
    var k: int = 0;
    while (k < n) { if (a[k] != 0) { return 0; } k += 1; }
    return 1;
}

// -1, 0, +1 as a < b, a = b, a > b.
fn bn_cmp(a: *int, b: *int, n: int) -> int {
    var k: int = n - 1;
    while (k >= 0) {
        if (a[k] != b[k]) { return a[k] < b[k] ? -1 : 1; }
        k -= 1;
    }
    return 0;
}

// a -= b (a >= b); the borrow out (0 or 1).
fn bn_sub(a: *int, b: *int, n: int) -> int {
    var borrow: int = 0;
    var k: int = 0;
    while (k < n) {
        var x: int = a[k] - b[k] - borrow;
        borrow = x < 0;
        a[k] = x + LIMB * borrow;
        k += 1;
    }
    return borrow;
}

// a += b; the carry out.
fn bn_add(a: *int, b: *int, n: int) -> int {
    var carry: int = 0;
    var k: int = 0;
    while (k < n) {
        var x: int = a[k] + b[k] + carry;
        carry = x / LIMB;
        a[k] = x % LIMB;
        k += 1;
    }
    return carry;
}

// Big-endian octets (len of them) into n limbs; 0 if they do not fit.
fn bn_from_octets(a: *int, n: int, p: *tryte, len: int) -> int {
    bn_zero(a, n);
    var k: int = 0;
    while (k < len) {
        var pos: int = len - 1 - k;               // octet k from the low end
        var v: int = p[pos];
        if (k / 2 >= n) {
            if (v != 0) { return 0; }
        } else if (k % 2 == 0) {
            a[k / 2] += v;
        } else {
            a[k / 2] += v * 256;
        }
        k += 1;
    }
    return 1;
}

// n limbs into len big-endian octets.
fn bn_to_octets(p: *tryte, len: int, a: *int, n: int) {
    var k: int = 0;
    while (k < len) {
        var v: int = 0;
        if (k / 2 < n) { v = k % 2 == 0 ? a[k / 2] % 256 : a[k / 2] / 256; }
        p[len - 1 - k] = v as tryte;
        k += 1;
    }
}

// Bits in a (the position of the top one, plus one).
fn bn_bits(a: *int, n: int) -> int {
    var k: int = n - 1;
    while (k >= 0 && a[k] == 0) { k -= 1; }
    if (k < 0) { return 0; }
    var b: int = 0;
    var v: int = a[k];
    while (v > 0) { b += 1; v = v / 2; }
    return 16 * k + b;
}

fn bn_bit(a: *int, i: int) -> int {
    var v: int = a[i / 16];
    var s: int = i % 16;
    while (s > 0) { v = v / 2; s -= 1; }
    return v % 2;
}

// ---- Montgomery ------------------------------------------------------------------------------

var _bn_t: [263]int;

// o = a·b·R^-1 mod m (o may be a or b).
fn mont_mul(md: *mont, o: *int, a: *int, b: *int) {
    var n: int = md.n;
    var m: *int = &md.m[0];
    var t: *int = &_bn_t[0];
    var k: int = 0;
    while (k < n + 2) { t[k] = 0; k += 1; }
    var i: int = 0;
    while (i < n) {
        var ai: int = a[i];
        var c: int = 0;
        var j: int = 0;
        while (j < n) {
            var x: int = t[j] + ai * b[j] + c;
            c = x / LIMB;
            t[j] = x % LIMB;
            j += 1;
        }
        var x2: int = t[n] + c;
        t[n] = x2 % LIMB;
        t[n + 1] += x2 / LIMB;
        var u: int = t[0] * md.minv % LIMB;
        var y: int = t[0] + u * m[0];
        c = y / LIMB;
        j = 1;
        while (j < n) {
            var z: int = t[j] + u * m[j] + c;
            c = z / LIMB;
            t[j - 1] = z % LIMB;
            j += 1;
        }
        var w: int = t[n] + c;
        t[n - 1] = w % LIMB;
        t[n] = t[n + 1] + w / LIMB;
        t[n + 1] = 0;
        i += 1;
    }
    // t < 2m: one subtraction at most
    if (t[n] != 0 || bn_cmp(t, m, n) >= 0) { bn_sub(t, m, n); }
    bn_copy(o, t, n);
}

// Prepare m (n limbs, odd) for Montgomery arithmetic.
fn mont_init(md: *mont, m: *int, n: int) {
    md.n = n;
    bn_copy(&md.m[0], m, n);
    // -m^-1 mod 2^16 by Newton's iteration on the low limb
    var x: int = 1;
    var k: int = 0;
    while (k < 5) {
        x = x * (2 - m[0] * x % LIMB + LIMB) % LIMB;
        k += 1;
    }
    md.minv = (LIMB - x) % LIMB;
    // R mod m and R^2 mod m by doubling 1 (16n and then 32n times)
    var r: [261]int;
    bn_zero(&r[0], n + 1);
    r[0] = 1;
    var steps: int = 0;
    while (steps < 32 * n) {
        // r = 2r mod m
        var carry: int = 0;
        var j: int = 0;
        while (j < n) {
            var v: int = r[j] * 2 + carry;
            carry = v / LIMB;
            r[j] = v % LIMB;
            j += 1;
        }
        if (carry != 0 || bn_cmp(&r[0], m, n) >= 0) { bn_sub(&r[0], m, n); }
        steps += 1;
        if (steps == 16 * n) { bn_copy(&md.one[0], &r[0], n); }
    }
    bn_copy(&md.r2[0], &r[0], n);
}

fn mont_to(md: *mont, o: *int, a: *int) { mont_mul(md, o, a, &md.r2[0]); }

fn mont_from(md: *mont, o: *int, a: *int) {
    var one: [260]int;
    bn_zero(&one[0], md.n);
    one[0] = 1;
    mont_mul(md, o, a, &one[0]);
}

// o = a^e mod m, all in Montgomery form except e (elen limbs, ordinary).
fn mont_pow(md: *mont, o: *int, a: *int, e: *int, elen: int) {
    var acc: [260]int;
    bn_copy(&acc[0], &md.one[0], md.n);
    var i: int = bn_bits(e, elen) - 1;
    while (i >= 0) {
        mont_mul(md, &acc[0], &acc[0], &acc[0]);
        if (bn_bit(e, i)) { mont_mul(md, &acc[0], &acc[0], a); }
        i -= 1;
    }
    bn_copy(o, &acc[0], md.n);
}

// o = a^-1 mod m for a prime m (Fermat: a^(m-2)), Montgomery form.
fn mont_inv(md: *mont, o: *int, a: *int) {
    var e: [260]int;
    bn_copy(&e[0], &md.m[0], md.n);
    var two: [260]int;
    bn_zero(&two[0], md.n);
    two[0] = 2;
    bn_sub(&e[0], &two[0], md.n);
    mont_pow(md, o, a, &e[0], md.n);
}

// Modular addition and subtraction (inputs below m).
fn mod_add(md: *mont, o: *int, a: *int, b: *int) {
    var t: [261]int;
    bn_copy(&t[0], a, md.n);
    t[md.n] = bn_add(&t[0], b, md.n);
    if (t[md.n] != 0 || bn_cmp(&t[0], &md.m[0], md.n) >= 0) { bn_sub(&t[0], &md.m[0], md.n); }
    bn_copy(o, &t[0], md.n);
}

fn mod_sub(md: *mont, o: *int, a: *int, b: *int) {
    var t: [260]int;
    bn_copy(&t[0], a, md.n);
    if (bn_sub(&t[0], b, md.n)) { bn_add(&t[0], &md.m[0], md.n); }
    bn_copy(o, &t[0], md.n);
}

// a mod m for a of 2n limbs (by Montgomery: a·R^-1·R^2·R^-1 ... done as
// two multiplications: (a_lo + a_hi·R)).
fn mod_reduce_wide(md: *mont, o: *int, a: *int) {
    var lo: [260]int;
    var hi: [260]int;
    bn_copy(&lo[0], a, md.n);
    bn_copy(&hi[0], a + md.n, md.n);
    // bring both below m first
    while (bn_cmp(&lo[0], &md.m[0], md.n) >= 0) { bn_sub(&lo[0], &md.m[0], md.n); }
    while (bn_cmp(&hi[0], &md.m[0], md.n) >= 0) { bn_sub(&hi[0], &md.m[0], md.n); }
    // hi·R = mont_mul(hi, R^2); lo stays
    var t: [260]int;
    mont_mul(md, &t[0], &hi[0], &md.r2[0]);
    mod_add(md, o, &lo[0], &t[0]);
}
