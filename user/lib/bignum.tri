        + a[12] * b[11] + a[13] * b[10] + a[14] * b[9] + a[15] * b[8]
        + a[16] * b[7] + a[17] * b[6] + a[18] * b[5] + a[19] * b[4]
        + a[20] * b[3] + a[21] * b[2] + a[22] * b[1] + a[23] * b[0]
        + u[0] * m[23] + u[1] * m[22] + u[2] * m[21] + u[3] * m[20]
        + u[4] * m[19] + u[5] * m[18] + u[6] * m[17] + u[7] * m[16]
        + u[8] * m[15] + u[9] * m[14] + u[10] * m[13] + u[11] * m[12]
        + u[12] * m[11] + u[13] * m[10] + u[14] * m[9] + u[15] * m[8]
        + u[16] * m[7] + u[17] * m[6] + u[18] * m[5] + u[19] * m[4]
        + u[20] * m[3] + u[21] * m[2] + u[22] * m[1];
    uk = bext(bext(acc, 0, 16) * minv, 0, 16);
    u[23] = uk;
    acc = bsh(acc + uk * m[0], -16);
    acc = acc + a[1] * b[23] + a[2] * b[22] + a[3] * b[21] + a[4] * b[20]
        + a[5] * b[19] + a[6] * b[18] + a[7] * b[17] + a[8] * b[16]
        + a[9] * b[15] + a[10] * b[14] + a[11] * b[13] + a[12] * b[12]
        + a[13] * b[11] + a[14] * b[10] + a[15] * b[9] + a[16] * b[8]
        + a[17] * b[7] + a[18] * b[6] + a[19] * b[5] + a[20] * b[4]
        + a[21] * b[3] + a[22] * b[2] + a[23] * b[1] + u[1] * m[23]
        + u[2] * m[22] + u[3] * m[21] + u[4] * m[20] + u[5] * m[19]
        + u[6] * m[18] + u[7] * m[17] + u[8] * m[16] + u[9] * m[15]
        + u[10] * m[14] + u[11] * m[13] + u[12] * m[12] + u[13] * m[11]
        + u[14] * m[10] + u[15] * m[9] + u[16] * m[8] + u[17] * m[7]
        + u[18] * m[6] + u[19] * m[5] + u[20] * m[4] + u[21] * m[3]
        + u[22] * m[2] + u[23] * m[1];
    t[0] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[2] * b[23] + a[3] * b[22] + a[4] * b[21] + a[5] * b[20]
        + a[6] * b[19] + a[7] * b[18] + a[8] * b[17] + a[9] * b[16]
        + a[10] * b[15] + a[11] * b[14] + a[12] * b[13] + a[13] * b[12]
        + a[14] * b[11] + a[15] * b[10] + a[16] * b[9] + a[17] * b[8]
        + a[18] * b[7] + a[19] * b[6] + a[20] * b[5] + a[21] * b[4]
        + a[22] * b[3] + a[23] * b[2] + u[2] * m[23] + u[3] * m[22]
        + u[4] * m[21] + u[5] * m[20] + u[6] * m[19] + u[7] * m[18]
        + u[8] * m[17] + u[9] * m[16] + u[10] * m[15] + u[11] * m[14]
        + u[12] * m[13] + u[13] * m[12] + u[14] * m[11] + u[15] * m[10]
        + u[16] * m[9] + u[17] * m[8] + u[18] * m[7] + u[19] * m[6]
        + u[20] * m[5] + u[21] * m[4] + u[22] * m[3] + u[23] * m[2];
    t[1] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[3] * b[23] + a[4] * b[22] + a[5] * b[21] + a[6] * b[20]
        + a[7] * b[19] + a[8] * b[18] + a[9] * b[17] + a[10] * b[16]
        + a[11] * b[15] + a[12] * b[14] + a[13] * b[13] + a[14] * b[12]
        + a[15] * b[11] + a[16] * b[10] + a[17] * b[9] + a[18] * b[8]
        + a[19] * b[7] + a[20] * b[6] + a[21] * b[5] + a[22] * b[4]
        + a[23] * b[3] + u[3] * m[23] + u[4] * m[22] + u[5] * m[21]
        + u[6] * m[20] + u[7] * m[19] + u[8] * m[18] + u[9] * m[17]
        + u[10] * m[16] + u[11] * m[15] + u[12] * m[14] + u[13] * m[13]
        + u[14] * m[12] + u[15] * m[11] + u[16] * m[10] + u[17] * m[9]
        + u[18] * m[8] + u[19] * m[7] + u[20] * m[6] + u[21] * m[5]
        + u[22] * m[4] + u[23] * m[3];
    t[2] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[4] * b[23] + a[5] * b[22] + a[6] * b[21] + a[7] * b[20]
        + a[8] * b[19] + a[9] * b[18] + a[10] * b[17] + a[11] * b[16]
        + a[12] * b[15] + a[13] * b[14] + a[14] * b[13] + a[15] * b[12]
        + a[16] * b[11] + a[17] * b[10] + a[18] * b[9] + a[19] * b[8]
        + a[20] * b[7] + a[21] * b[6] + a[22] * b[5] + a[23] * b[4]
        + u[4] * m[23] + u[5] * m[22] + u[6] * m[21] + u[7] * m[20]
        + u[8] * m[19] + u[9] * m[18] + u[10] * m[17] + u[11] * m[16]
        + u[12] * m[15] + u[13] * m[14] + u[14] * m[13] + u[15] * m[12]
        + u[16] * m[11] + u[17] * m[10] + u[18] * m[9] + u[19] * m[8]
        + u[20] * m[7] + u[21] * m[6] + u[22] * m[5] + u[23] * m[4];
    t[3] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[5] * b[23] + a[6] * b[22] + a[7] * b[21] + a[8] * b[20]
        + a[9] * b[19] + a[10] * b[18] + a[11] * b[17] + a[12] * b[16]
        + a[13] * b[15] + a[14] * b[14] + a[15] * b[13] + a[16] * b[12]
        + a[17] * b[11] + a[18] * b[10] + a[19] * b[9] + a[20] * b[8]
        + a[21] * b[7] + a[22] * b[6] + a[23] * b[5] + u[5] * m[23]
        + u[6] * m[22] + u[7] * m[21] + u[8] * m[20] + u[9] * m[19]
        + u[10] * m[18] + u[11] * m[17] + u[12] * m[16] + u[13] * m[15]
        + u[14] * m[14] + u[15] * m[13] + u[16] * m[12] + u[17] * m[11]
        + u[18] * m[10] + u[19] * m[9] + u[20] * m[8] + u[21] * m[7]
        + u[22] * m[6] + u[23] * m[5];
    t[4] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[6] * b[23] + a[7] * b[22] + a[8] * b[21] + a[9] * b[20]
        + a[10] * b[19] + a[11] * b[18] + a[12] * b[17] + a[13] * b[16]
        + a[14] * b[15] + a[15] * b[14] + a[16] * b[13] + a[17] * b[12]
        + a[18] * b[11] + a[19] * b[10] + a[20] * b[9] + a[21] * b[8]
        + a[22] * b[7] + a[23] * b[6] + u[6] * m[23] + u[7] * m[22]
        + u[8] * m[21] + u[9] * m[20] + u[10] * m[19] + u[11] * m[18]
        + u[12] * m[17] + u[13] * m[16] + u[14] * m[15] + u[15] * m[14]
        + u[16] * m[13] + u[17] * m[12] + u[18] * m[11] + u[19] * m[10]
        + u[20] * m[9] + u[21] * m[8] + u[22] * m[7] + u[23] * m[6];
    t[5] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[7] * b[23] + a[8] * b[22] + a[9] * b[21] + a[10] * b[20]
        + a[11] * b[19] + a[12] * b[18] + a[13] * b[17] + a[14] * b[16]
        + a[15] * b[15] + a[16] * b[14] + a[17] * b[13] + a[18] * b[12]
        + a[19] * b[11] + a[20] * b[10] + a[21] * b[9] + a[22] * b[8]
        + a[23] * b[7] + u[7] * m[23] + u[8] * m[22] + u[9] * m[21]
        + u[10] * m[20] + u[11] * m[19] + u[12] * m[18] + u[13] * m[17]
        + u[14] * m[16] + u[15] * m[15] + u[16] * m[14] + u[17] * m[13]
        + u[18] * m[12] + u[19] * m[11] + u[20] * m[10] + u[21] * m[9]
        + u[22] * m[8] + u[23] * m[7];
    t[6] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[8] * b[23] + a[9] * b[22] + a[10] * b[21] + a[11] * b[20]
        + a[12] * b[19] + a[13] * b[18] + a[14] * b[17] + a[15] * b[16]
        + a[16] * b[15] + a[17] * b[14] + a[18] * b[13] + a[19] * b[12]
        + a[20] * b[11] + a[21] * b[10] + a[22] * b[9] + a[23] * b[8]
        + u[8] * m[23] + u[9] * m[22] + u[10] * m[21] + u[11] * m[20]
        + u[12] * m[19] + u[13] * m[18] + u[14] * m[17] + u[15] * m[16]
        + u[16] * m[15] + u[17] * m[14] + u[18] * m[13] + u[19] * m[12]
        + u[20] * m[11] + u[21] * m[10] + u[22] * m[9] + u[23] * m[8];
    t[7] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[9] * b[23] + a[10] * b[22] + a[11] * b[21] + a[12] * b[20]
        + a[13] * b[19] + a[14] * b[18] + a[15] * b[17] + a[16] * b[16]
        + a[17] * b[15] + a[18] * b[14] + a[19] * b[13] + a[20] * b[12]
        + a[21] * b[11] + a[22] * b[10] + a[23] * b[9] + u[9] * m[23]
        + u[10] * m[22] + u[11] * m[21] + u[12] * m[20] + u[13] * m[19]
        + u[14] * m[18] + u[15] * m[17] + u[16] * m[16] + u[17] * m[15]
        + u[18] * m[14] + u[19] * m[13] + u[20] * m[12] + u[21] * m[11]
        + u[22] * m[10] + u[23] * m[9];
    t[8] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[10] * b[23] + a[11] * b[22] + a[12] * b[21] + a[13] * b[20]
        + a[14] * b[19] + a[15] * b[18] + a[16] * b[17] + a[17] * b[16]
        + a[18] * b[15] + a[19] * b[14] + a[20] * b[13] + a[21] * b[12]
        + a[22] * b[11] + a[23] * b[10] + u[10] * m[23] + u[11] * m[22]
        + u[12] * m[21] + u[13] * m[20] + u[14] * m[19] + u[15] * m[18]
        + u[16] * m[17] + u[17] * m[16] + u[18] * m[15] + u[19] * m[14]
        + u[20] * m[13] + u[21] * m[12] + u[22] * m[11] + u[23] * m[10];
    t[9] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[11] * b[23] + a[12] * b[22] + a[13] * b[21] + a[14] * b[20]
        + a[15] * b[19] + a[16] * b[18] + a[17] * b[17] + a[18] * b[16]
        + a[19] * b[15] + a[20] * b[14] + a[21] * b[13] + a[22] * b[12]
        + a[23] * b[11] + u[11] * m[23] + u[12] * m[22] + u[13] * m[21]
        + u[14] * m[20] + u[15] * m[19] + u[16] * m[18] + u[17] * m[17]
        + u[18] * m[16] + u[19] * m[15] + u[20] * m[14] + u[21] * m[13]
        + u[22] * m[12] + u[23] * m[11];
    t[10] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[12] * b[23] + a[13] * b[22] + a[14] * b[21] + a[15] * b[20]
        + a[16] * b[19] + a[17] * b[18] + a[18] * b[17] + a[19] * b[16]
        + a[20] * b[15] + a[21] * b[14] + a[22] * b[13] + a[23] * b[12]
        + u[12] * m[23] + u[13] * m[22] + u[14] * m[21] + u[15] * m[20]
        + u[16] * m[19] + u[17] * m[18] + u[18] * m[17] + u[19] * m[16]
        + u[20] * m[15] + u[21] * m[14] + u[22] * m[13] + u[23] * m[12];
    t[11] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[13] * b[23] + a[14] * b[22] + a[15] * b[21] + a[16] * b[20]
        + a[17] * b[19] + a[18] * b[18] + a[19] * b[17] + a[20] * b[16]
        + a[21] * b[15] + a[22] * b[14] + a[23] * b[13] + u[13] * m[23]
        + u[14] * m[22] + u[15] * m[21] + u[16] * m[20] + u[17] * m[19]
        + u[18] * m[18] + u[19] * m[17] + u[20] * m[16] + u[21] * m[15]
        + u[22] * m[14] + u[23] * m[13];
    t[12] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[14] * b[23] + a[15] * b[22] + a[16] * b[21] + a[17] * b[20]
        + a[18] * b[19] + a[19] * b[18] + a[20] * b[17] + a[21] * b[16]
        + a[22] * b[15] + a[23] * b[14] + u[14] * m[23] + u[15] * m[22]
        + u[16] * m[21] + u[17] * m[20] + u[18] * m[19] + u[19] * m[18]
        + u[20] * m[17] + u[21] * m[16] + u[22] * m[15] + u[23] * m[14];
    t[13] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[15] * b[23] + a[16] * b[22] + a[17] * b[21] + a[18] * b[20]
        + a[19] * b[19] + a[20] * b[18] + a[21] * b[17] + a[22] * b[16]
        + a[23] * b[15] + u[15] * m[23] + u[16] * m[22] + u[17] * m[21]
        + u[18] * m[20] + u[19] * m[19] + u[20] * m[18] + u[21] * m[17]
        + u[22] * m[16] + u[23] * m[15];
    t[14] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[16] * b[23] + a[17] * b[22] + a[18] * b[21] + a[19] * b[20]
        + a[20] * b[19] + a[21] * b[18] + a[22] * b[17] + a[23] * b[16]
        + u[16] * m[23] + u[17] * m[22] + u[18] * m[21] + u[19] * m[20]
        + u[20] * m[19] + u[21] * m[18] + u[22] * m[17] + u[23] * m[16];
    t[15] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[17] * b[23] + a[18] * b[22] + a[19] * b[21] + a[20] * b[20]
        + a[21] * b[19] + a[22] * b[18] + a[23] * b[17] + u[17] * m[23]
        + u[18] * m[22] + u[19] * m[21] + u[20] * m[20] + u[21] * m[19]
        + u[22] * m[18] + u[23] * m[17];
    t[16] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[18] * b[23] + a[19] * b[22] + a[20] * b[21] + a[21] * b[20]
        + a[22] * b[19] + a[23] * b[18] + u[18] * m[23] + u[19] * m[22]
        + u[20] * m[21] + u[21] * m[20] + u[22] * m[19] + u[23] * m[18];
    t[17] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[19] * b[23] + a[20] * b[22] + a[21] * b[21] + a[22] * b[20]
        + a[23] * b[19] + u[19] * m[23] + u[20] * m[22] + u[21] * m[21]
        + u[22] * m[20] + u[23] * m[19];
    t[18] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[20] * b[23] + a[21] * b[22] + a[22] * b[21] + a[23] * b[20]
        + u[20] * m[23] + u[21] * m[22] + u[22] * m[21] + u[23] * m[20];
    t[19] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[21] * b[23] + a[22] * b[22] + a[23] * b[21] + u[21] * m[23]
        + u[22] * m[22] + u[23] * m[21];
    t[20] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[22] * b[23] + a[23] * b[22] + u[22] * m[23] + u[23] * m[22];
    t[21] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    acc = acc + a[23] * b[23] + u[23] * m[23];
    t[22] = bext(acc, 0, 16);
    acc = bsh(acc, -16);
    t[23] = bext(acc, 0, 16);
    t[24] = bsh(acc, -16);
}

// o = a·b·R^-1 mod m (o may be a or b), by product scanning: each column of
// the product and of the reduction is summed whole (16-bit limbs make
// products below 2^32, and a word holds 887 of them), with one carry per
// column (the FIPS method of Koç, Acar and Kaliski).
fn mont_mul(md: *mont, o: *int, a: *int, b: *int) {
    var n: int = md.n;
    var m: *int = &md.m[0];
    var t: *int = &_bn_t[0];
    if (n == 16) { _mont_cols16(a, b, m, md.minv); }
    else if (n == 24) { _mont_cols24(a, b, m, md.minv); }
    else { _mont_cols(n, a, b, m, md.minv); }
    // t < 2m: one subtraction at most
    if (t[n] != 0 || bn_cmp(t, m, n) >= 0) { bn_sub(t, m, n); }
    bn_copy(o, t, n);
}

// Prepare m (n limbs, odd) for Montgomery arithmetic.
fn mont_init(md: *mont, m: *int, n: int) {
    md.n = n;
    bn_copy(&md.m[0], m, n);
    // -m^-1 mod 2^16 by Newton's iteration on the low limb
    var x: int = 1;
    var k: int = 0;
    while (k < 5) {
        x = x * (2 - m[0] * x % LIMB + LIMB) % LIMB;
        k += 1;
    }
    md.minv = (LIMB - x) % LIMB;
    // R mod m: R - m when m's top bit is set (R/2 <= m < R), else 1
    // doubled 16n times. Then R^2 = R·2^(16n): double R up to R·2^t, with
    // 16n = t·2^s and t about 64, and square s times (Montgomery squaring
    // takes R·2^x to R·2^2x): a squaring costs about 60 doublings.
    var t: int = 16 * n;
    var s: int = 0;
    while (t % 2 == 0 && t > 64) { t = t / 2; s += 1; }
    var r: [261]int;
    bn_zero(&r[0], n + 1);
    var steps: int = 0;
    if (m[n - 1] >= 32768) {
        bn_sub(&r[0], m, n);                      // 0 - m, modulo R
        steps = 16 * n;
    } else {
        r[0] = 1;
    }
    while (steps < 16 * n + t) {
        if (steps == 16 * n) { bn_copy(&md.one[0], &r[0], n); }
        // r = 2r mod m
        var carry: int = 0;
        var j: int = 0;
        while (j < n) {
            var v: int = r[j] * 2 + carry;
            carry = bsh(v, -16);
            r[j] = bext(v, 0, 16);
            j += 1;
        }
        if (carry != 0 || bn_cmp(&r[0], m, n) >= 0) { bn_sub(&r[0], m, n); }
        steps += 1;
    }
    bn_copy(&md.r2[0], &r[0], n);
    while (s > 0) {
        mont_mul(md, &md.r2[0], &md.r2[0], &md.r2[0]);  // R·2^x to R·2^2x
        s -= 1;
    }
}

fn mont_to(md: *mont, o: *int, a: *int) { mont_mul(md, o, a, &md.r2[0]); }

fn mont_from(md: *mont, o: *int, a: *int) {
    var one: [260]int;
    bn_zero(&one[0], md.n);
    one[0] = 1;
    mont_mul(md, o, a, &one[0]);
}

// o = a^e mod m, all in Montgomery form except e (elen limbs, ordinary).
fn mont_pow(md: *mont, o: *int, a: *int, e: *int, elen: int) {
    var acc: [260]int;
    bn_copy(&acc[0], &md.one[0], md.n);
    var i: int = bn_bits(e, elen) - 1;
    while (i >= 0) {
        mont_mul(md, &acc[0], &acc[0], &acc[0]);
        if (bn_bit(e, i)) { mont_mul(md, &acc[0], &acc[0], a); }
        i -= 1;
    }
    bn_copy(o, &acc[0], md.n);
}

// o = a^-1 mod m for a prime m (Fermat: a^(m-2)), Montgomery form.
fn mont_inv(md: *mont, o: *int, a: *int) {
    var e: [260]int;
    bn_copy(&e[0], &md.m[0], md.n);
    var two: [260]int;
    bn_zero(&two[0], md.n);
    two[0] = 2;
    bn_sub(&e[0], &two[0], md.n);
    mont_pow(md, o, a, &e[0], md.n);
}

// Modular addition and subtraction (inputs below m).
fn mod_add(md: *mont, o: *int, a: *int, b: *int) {
    var t: [261]int;
    bn_copy(&t[0], a, md.n);
    t[md.n] = bn_add(&t[0], b, md.n);
    if (t[md.n] != 0 || bn_cmp(&t[0], &md.m[0], md.n) >= 0) { bn_sub(&t[0], &md.m[0], md.n); }
    bn_copy(o, &t[0], md.n);
}

fn mod_sub(md: *mont, o: *int, a: *int, b: *int) {
    var t: [260]int;
    bn_copy(&t[0], a, md.n);
    if (bn_sub(&t[0], b, md.n)) { bn_add(&t[0], &md.m[0], md.n); }
    bn_copy(o, &t[0], md.n);
}

// a mod m for a of 2n limbs (by Montgomery: a·R^-1·R^2·R^-1 ... done as
// two multiplications: (a_lo + a_hi·R)).
fn mod_reduce_wide(md: *mont, o: *int, a: *int) {
    var lo: [260]int;
    var hi: [260]int;
    bn_copy(&lo[0], a, md.n);
    bn_copy(&hi[0], a + md.n, md.n);
    // bring both below m first
    while (bn_cmp(&lo[0], &md.m[0], md.n) >= 0) { bn_sub(&lo[0], &md.m[0], md.n); }
    while (bn_cmp(&hi[0], &md.m[0], md.n) >= 0) { bn_sub(&hi[0], &md.m[0], md.n); }
    // hi·R = mont_mul(hi, R^2); lo stays
    var t: [260]int;
    mont_mul(md, &t[0], &hi[0], &md.r2[0]);
    mod_add(md, o, &lo[0], &t[0]);
}
