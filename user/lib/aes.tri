// aes.tri: AES-128/256 encryption (FIPS 197) and AES-GCM (NIST SP 800-38D)
// for TLS. The rounds use 32-bit T-tables on the binary instructions
// (ISA §3.3.1); GHASH multiplies by H with 4-bit tables (Shoup's method,
// as in mbed TLS). Only encryption is needed: GCM runs AES as a counter.

import "bin32.tri";

var _sbox: [256]int;
var _te0: [256]int;                  // (2s, s, s, 3s) as a big-endian word
var _aes_ready: int;
var _last4: [16]int;                 // GHASH: the reduction of 4 bits shifted out

// x·2 in GF(2^8) with the AES polynomial
fn _xtime(x: int) -> int {
    var y: int = bsh(x, 1);
    if (y >= 256) { y = bxor(y, 283); }               // 0x11b
    return y;
}

fn _aes_init() {
    if (_aes_ready) { return; }
    // the S-box from powers of the generator 3: p runs over the nonzero
    // field, q over its inverses (3^-1 = 0xf6)
    var p: int = 1;
    var q: int = 1;
    _sbox[0] = 99;                                     // 0x63
    var k: int = 0;
    while (k < 255) {
        p = bxor(p, _xtime(p));                        // p·3
        q = bxor(q, bsh(q, 1));                        // q/3: q·0xf6, by shifts
        q = bxor(q, bsh(q, 2));
        q = bxor(q, bsh(q, 4));
        if (band(q, 128) != 0) { q = bxor(q, 9); }
        q = band(q, 255);
        // the affine map of q, the inverse of p
        var x: int = bxor(bxor(q, brot(q, 1, 8)), bxor(brot(q, 2, 8), bxor(brot(q, 3, 8), brot(q, 4, 8))));
        _sbox[p] = bxor(x, 99);
        k += 1;
    }
    k = 0;
    while (k < 256) {
        var s: int = _sbox[k];
        var s2: int = _xtime(s);
        _te0[k] = ((s2 * 256 + s) * 256 + s) * 256 + bxor(s2, s);
        k += 1;
    }
    var l4: [16]int = { 0, 7200, 14400, 9312, 28800, 27808, 18624, 21728, 57600, 64800, 55616, 50528, 37248, 36256, 43456, 46560 };
    k = 0;
    while (k < 16) { _last4[k] = l4[k]; k += 1; }
    _aes_ready = 1;
}

struct aes {
    rk: [60]int;                     // round keys, 32-bit words
    nr: int;                         // 10 or 14 rounds
}

// Expand a 16- or 32-octet key.
fn aes_setkey(c: *aes, key: *tryte, klen: int) {
    _aes_init();
    var nk: int = klen / 4;
    c.nr = nk + 6;
    var k: int = 0;
    while (k < nk) { c.rk[k] = be32(key + 4 * k); k += 1; }
    var rcon: int = 1;
    while (k < 4 * (c.nr + 1)) {
        var w: int = c.rk[k - 1];
        if (k % nk == 0) {
            w = brot(w, 8, 32);
            w = ((_sbox[bext(w, 24, 8)] * 256 + _sbox[bext(w, 16, 8)]) * 256 + _sbox[bext(w, 8, 8)]) * 256 + _sbox[bext(w, 0, 8)];
            w = bxor(w, bsh(rcon, 24));
            rcon = _xtime(rcon);
        } else if (nk > 6 && k % nk == 4) {
            w = ((_sbox[bext(w, 24, 8)] * 256 + _sbox[bext(w, 16, 8)]) * 256 + _sbox[bext(w, 8, 8)]) * 256 + _sbox[bext(w, 0, 8)];
        }
        c.rk[k] = bxor(c.rk[k - nk], w);
        k += 1;
    }
}

// Encrypt the 16 octets at src into dst (they may be the same).
fn aes_encrypt(c: *aes, src: *tryte, dst: *tryte) {
    var rk: *int = &c.rk[0];
    var s0: int = bxor(be32(src), rk[0]);
    var s1: int = bxor(be32(src + 4), rk[1]);
    var s2: int = bxor(be32(src + 8), rk[2]);
    var s3: int = bxor(be32(src + 12), rk[3]);
    var r: int = 1;
    while (r < c.nr) {
        rk = rk + 4;
        var t0: int = bxor(bxor(_te0[bext(s0, 24, 8)], brot(_te0[bext(s1, 16, 8)], 24, 32)),
                           bxor(brot(_te0[bext(s2, 8, 8)], 16, 32), bxor(brot(_te0[bext(s3, 0, 8)], 8, 32), rk[0])));
        var t1: int = bxor(bxor(_te0[bext(s1, 24, 8)], brot(_te0[bext(s2, 16, 8)], 24, 32)),
                           bxor(brot(_te0[bext(s3, 8, 8)], 16, 32), bxor(brot(_te0[bext(s0, 0, 8)], 8, 32), rk[1])));
        var t2: int = bxor(bxor(_te0[bext(s2, 24, 8)], brot(_te0[bext(s3, 16, 8)], 24, 32)),
                           bxor(brot(_te0[bext(s0, 8, 8)], 16, 32), bxor(brot(_te0[bext(s1, 0, 8)], 8, 32), rk[2])));
        var t3: int = bxor(bxor(_te0[bext(s3, 24, 8)], brot(_te0[bext(s0, 16, 8)], 24, 32)),
                           bxor(brot(_te0[bext(s1, 8, 8)], 16, 32), bxor(brot(_te0[bext(s2, 0, 8)], 8, 32), rk[3])));
        s0 = t0;
        s1 = t1;
        s2 = t2;
        s3 = t3;
        r += 1;
    }
    rk = rk + 4;
    // the last round: no MixColumns
    put_be32(dst, bxor(((_sbox[bext(s0, 24, 8)] * 256 + _sbox[bext(s1, 16, 8)]) * 256 + _sbox[bext(s2, 8, 8)]) * 256 + _sbox[bext(s3, 0, 8)], rk[0]));
    put_be32(dst + 4, bxor(((_sbox[bext(s1, 24, 8)] * 256 + _sbox[bext(s2, 16, 8)]) * 256 + _sbox[bext(s3, 8, 8)]) * 256 + _sbox[bext(s0, 0, 8)], rk[1]));
    put_be32(dst + 8, bxor(((_sbox[bext(s2, 24, 8)] * 256 + _sbox[bext(s3, 16, 8)]) * 256 + _sbox[bext(s0, 8, 8)]) * 256 + _sbox[bext(s1, 0, 8)], rk[2]));
    put_be32(dst + 12, bxor(((_sbox[bext(s3, 24, 8)] * 256 + _sbox[bext(s0, 16, 8)]) * 256 + _sbox[bext(s1, 8, 8)]) * 256 + _sbox[bext(s2, 0, 8)], rk[3]));
}

// ---- GCM ---------------------------------------------------------------------------------------

struct gcm {
    cipher: aes;
    m: [64]int;                      // H·i for each nibble i: 4 words each, most significant first
}


fn gcm_setkey(g: *gcm, key: *tryte, klen: int) {
    aes_setkey(&g.cipher, key, klen);
    var h: [16]tryte;
    var k: int = 0;
    while (k < 16) { h[k] = 0; k += 1; }
    aes_encrypt(&g.cipher, &h[0], &h[0]);
    var w0: int = be32(&h[0]);
    var w1: int = be32(&h[4]);
    var w2: int = be32(&h[8]);
    var w3: int = be32(&h[12]);
    k = 0;
    while (k < 4) { g.m[k] = 0; k += 1; }
    g.m[32] = w0;
    g.m[33] = w1;
    g.m[34] = w2;
    g.m[35] = w3;
    // H·4, H·2, H·1 in the reflected order: halve with the reduction
    var i: int = 4;
    while (i > 0) {
        var t: int = band(w3, 1) * 3774873600;          // 0xe1000000
        w3 = bsh(w3, -1) + bsh(band(w2, 1), 31);
        w2 = bsh(w2, -1) + bsh(band(w1, 1), 31);
        w1 = bsh(w1, -1) + bsh(band(w0, 1), 31);
        w0 = bxor(bsh(w0, -1), t);
        g.m[4 * i] = w0;
        g.m[4 * i + 1] = w1;
        g.m[4 * i + 2] = w2;
        g.m[4 * i + 3] = w3;
        i = i / 2;
    }
    i = 2;
    while (i <= 8) {
        var j: int = 1;
        while (j < i) {
            k = 0;
            while (k < 4) { g.m[4 * (i + j) + k] = bxor(g.m[4 * i + k], g.m[4 * j + k]); k += 1; }
            j += 1;
        }
        i *= 2;
    }
}

var _z0: int;
var _z1: int;
var _z2: int;
var _z3: int;

// z = (z >> 4) with the reduction, then z ^= M[nib]
fn _gstep(g: *gcm, nib: int) {
    var rem: int = band(_z3, 15);
    _z3 = bsh(_z3, -4) + bsh(band(_z2, 15), 28);
    _z2 = bsh(_z2, -4) + bsh(band(_z1, 15), 28);
    _z1 = bsh(_z1, -4) + bsh(band(_z0, 15), 28);
    _z0 = bxor(bsh(_z0, -4), bsh(_last4[rem], 16));
    var m: *int = &g.m[4 * nib];
    _z0 = bxor(_z0, m[0]);
    _z1 = bxor(_z1, m[1]);
    _z2 = bxor(_z2, m[2]);
    _z3 = bxor(_z3, m[3]);
}

// x (16 octets) = x · H
fn _gmult(g: *gcm, x: *tryte) {
    var lo: int = band(x[15], 15);
    var m: *int = &g.m[4 * lo];
    _z0 = m[0];
    _z1 = m[1];
    _z2 = m[2];
    _z3 = m[3];
    var i: int = 15;
    while (i >= 0) {
        lo = band(x[i], 15);
        var hi: int = bsh(x[i], -4);
        if (i != 15) { _gstep(g, lo); }
        _gstep(g, hi);
        i -= 1;
    }
    put_be32(x, _z0);
    put_be32(x + 4, _z1);
    put_be32(x + 8, _z2);
    put_be32(x + 12, _z3);
}

// y = GHASH state: y ^= the next 16 octets (or fewer, zero padded), y = y·H
fn _gblock(g: *gcm, y: *tryte, p: *tryte, n: int) {
    var k: int = 0;
    while (k < n) { y[k] = bxor(y[k], p[k]) as tryte; k += 1; }
    _gmult(g, y);
}

// the counter block for counter value ctr
fn _gctr(nonce: *tryte, ctr: int, out: *tryte) {
    var k: int = 0;
    while (k < 12) { out[k] = nonce[k]; k += 1; }
    put_be32(out + 12, ctr);
}

// The tag over aad and the ciphertext c (n octets), into tag.
fn _gtag(g: *gcm, nonce: *tryte, aad: *tryte, alen: int, c: *tryte, n: int, tag: *tryte) {
    var y: [16]tryte;
    var k: int = 0;
    while (k < 16) { y[k] = 0; k += 1; }
    k = 0;
    while (k < alen) { _gblock(g, &y[0], aad + k, alen - k < 16 ? alen - k : 16); k += 16; }
    k = 0;
    while (k < n) { _gblock(g, &y[0], c + k, n - k < 16 ? n - k : 16); k += 16; }
    var len: [16]tryte;
    put_be32(&len[0], 0);
    put_be32(&len[4], alen * 8);
    put_be32(&len[8], 0);
    put_be32(&len[12], n * 8);
    _gblock(g, &y[0], &len[0], 16);
    var j0: [16]tryte;
    _gctr(nonce, 1, &j0[0]);
    aes_encrypt(&g.cipher, &j0[0], &j0[0]);
    k = 0;
    while (k < 16) { tag[k] = bxor(y[k], j0[k]) as tryte; k += 1; }
}

// XOR the key stream from counter 2 into p (n octets).
fn _gcrypt(g: *gcm, nonce: *tryte, p: *tryte, n: int) {
    var ks: [16]tryte;
    var ctr: int = 2;
    var k: int = 0;
    while (k < n) {
        _gctr(nonce, ctr, &ks[0]);
        aes_encrypt(&g.cipher, &ks[0], &ks[0]);
        var j: int = 0;
        while (j < 16 && k + j < n) { p[k + j] = bxor(p[k + j], ks[j]) as tryte; j += 1; }
        k += 16;
        ctr += 1;
    }
}

// Encrypt p (n octets) in place and append the 16-octet tag.
fn gcm_seal(g: *gcm, nonce: *tryte, aad: *tryte, alen: int, p: *tryte, n: int) {
    _gcrypt(g, nonce, p, n);
    _gtag(g, nonce, aad, alen, p, n, p + n);
}

// Check the tag after c (n octets) and decrypt in place: 1, or 0 (c untouched).
fn gcm_open(g: *gcm, nonce: *tryte, aad: *tryte, alen: int, c: *tryte, n: int) -> int {
    var tag: [16]tryte;
    _gtag(g, nonce, aad, alen, c, n, &tag[0]);
    if (!octets_equal(&tag[0], c + n, 16)) { return 0; }
    _gcrypt(g, nonce, c, n);
    return 1;
}
