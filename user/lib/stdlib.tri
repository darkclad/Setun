// stdlib.h for tlibc: malloc, the environment, number parsing, qsort.

import "tlibc.tri";
import "string.tri";
import "ctype.tri";

// ---- malloc -------------------------------------------------------------------------------
//
// First fit over a free list, in words. Every block has a one-word header:
// +size in words (including the header) when in use, -size when free.
// Free neighbours merge. The heap grows with sbrk, 27 pages at a time.
// Like C's malloc, the result suits any object: it is the centre of the
// first payload word, so it works as a word or struct pointer as well as
// a tryte buffer (which then starts at that address).

const HEAP_MAGIC: int = 6561;
const LONG_MAX: int = 3812798742493;       // (3^27 - 1) / 2
const LONG_MIN: int = -3812798742493;

var heap_lo: int;                     // first header (word address), 0 = not set up
var heap_hi: int;                     // one word past the last block

fn heap_grow(words: int) -> int {
    var want: int = words < 177147 ? 177147 : words;   // 27 pages
    var old: int = sbrk(3 * want + 3);
    if (old == -1) { return 0; }
    if (heap_lo == 0) {
        heap_lo = old / 3 * 3 + 3;                      // the first aligned word
        heap_hi = heap_lo;
    }
    var start: int = heap_hi;
    var top: int = brk(0);
    var n: int = (top - start) / 3 - 1;
    if (n < 2) { return 0; }
    *(start as *int) = -n;                              // one big free block
    heap_hi = start + 3 * n;
    // merge with a free block just before it
    return 1;
}

fn malloc(n: int) -> *tryte {
    if (n < 0) { errno = ENOMEM; return null; }
    var words: int = (n + 3) / 3 + 1;                  // payload (n trytes from a word centre) + header
    var tries: int = 0;
    while (tries < 2) {
        var p: int = heap_lo;
        while (p != 0 && p < heap_hi) {
            var h: int = *(p as *int);
            if (h < 0) {
                var size: int = -h;
                // merge following free blocks
                var q: int = p + 3 * size;
                while (q < heap_hi && *(q as *int) < 0) {
                    size += -*(q as *int);
                    q = p + 3 * size;
                }
                *(p as *int) = -size;
                if (size >= words) {
                    if (size - words >= 2) {
                        *((p + 3 * words) as *int) = -(size - words);
                        size = words;
                    }
                    *(p as *int) = size;
                    return (p + 3) as *tryte;          // the centre of the first payload word
                }
                p += 3 * size;
            } else if (h > 0) {
                p += 3 * h;
            } else {
                return null;                            // corrupted heap
            }
        }
        if (!heap_grow(words)) { errno = ENOMEM; return null; }
        tries += 1;
    }
    errno = ENOMEM;
    return null;
}

fn block_of(ptr: *tryte) -> int { return (ptr as int) - 3; }

fn free(ptr: *tryte) {
    if (ptr == null) { return; }
    var p: int = block_of(ptr);
    var h: int = *(p as *int);
    if (h > 0) { *(p as *int) = -h; }
}

// Usable size of an allocation, in trytes.
fn malloc_usable_size(ptr: *tryte) -> int {
    if (ptr == null) { return 0; }
    return 3 * (*(block_of(ptr) as *int) - 1) - 1;
}

fn calloc(count: int, size: int) -> *tryte {
    var p: *tryte = malloc(count * size);
    if (p != null) { memset(p, 0, count * size); }
    return p;
}

fn realloc(ptr: *tryte, n: int) -> *tryte {
    if (ptr == null) { return malloc(n); }
    var have: int = malloc_usable_size(ptr);
    if (n <= have) { return ptr; }
    var q: *tryte = malloc(n);
    if (q == null) { return null; }
    memcpy(q, ptr, have);
    free(ptr);
    return q;
}

fn strdup(s: *char) -> *char {
    var n: int = strlen(s);
    var p: *char = malloc(n + 1) as *char;
    if (p != null) { strcpy(p, s); }
    return p;
}

fn strndup(s: *char, n: int) -> *char {
    var len: int = 0;
    while (len < n && s[len] != 0) { len += 1; }
    var p: *char = malloc(len + 1) as *char;
    if (p == null) { return null; }
    var i: int = 0;
    while (i < len) { p[i] = s[i]; i += 1; }
    p[len] = 0;
    return p;
}

// ---- numbers ---------------------------------------------------------------------------------

// strtol: optional spaces and sign, base 2..36 (0 = by prefix: 0x, 0).
// Clamps to LONG_MIN/LONG_MAX with ERANGE; *end = first unused character.
fn strtol(s: *char, end: **char, base: int) -> int {
    var i: int = 0;
    while (isspace(s[i])) { i += 1; }
    var neg: int = 0;
    if (s[i] == '+' || s[i] == '-') { neg = s[i] == '-'; i += 1; }
    if ((base == 0 || base == 16) && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X') && isxdigit(s[i + 2])) {
        base = 16;
        i += 2;
    } else if (base == 0 && s[i] == '0') {
        base = 8;
    } else if (base == 0) {
        base = 10;
    }
    if (base < 2 || base > 36) {
        errno = EINVAL;
        if (end != null) { *end = s; }
        return 0;
    }
    var v: int = 0;
    var any: int = 0;
    var over: int = 0;
    loop {
        var c: int = s[i];
        var d: int = 99;
        if (isdigit(c)) { d = c - '0'; }
        else if (isalpha(c)) { d = tolower(c) - 'a' + 10; }
        if (d >= base) { break; }
        if (v > (LONG_MAX - d) / base) { over = 1; }
        else { v = v * base + d; }
        any = 1;
        i += 1;
    }
    if (end != null) { *end = any ? &s[i] : s; }
    if (over) {
        errno = ERANGE;
        return neg ? LONG_MIN : LONG_MAX;
    }
    return neg ? -v : v;
}

fn atoi(s: *char) -> int { return strtol(s, null, 10); }
fn abs(v: int) -> int { return v < 0 ? -v : v; }

// ---- the environment -----------------------------------------------------------------------
//
// The first change copies environ into a malloc'd vector we own.

var env_owned: int;

fn env_count() -> int {
    var n: int = 0;
    if (environ != null) { while (environ[n] != null) { n += 1; } }
    return n;
}

fn env_own() -> int {
    if (env_owned) { return 1; }
    var n: int = env_count();
    var v: **char = malloc(3 * (n + 81)) as **char;
    if (v == null) { return 0; }
    var i: int = 0;
    while (i < n) { v[i] = environ[i]; i += 1; }
    v[n] = null;
    environ = v;
    env_owned = 1;
    return 1;
}

fn env_valid_name(name: *char) -> int {
    if (name == null || name[0] == 0) { return 0; }
    var k: int = 0;
    while (name[k] != 0) {
        if (name[k] == '=') { return 0; }
        k += 1;
    }
    return 1;
}

fn env_find(name: *char) -> int {
    var n: int = env_count();
    var i: int = 0;
    while (i < n) {
        var e: *char = environ[i];
        var k: int = 0;
        while (name[k] != 0 && e[k] == name[k]) { k += 1; }
        if (name[k] == 0 && e[k] == '=') { return i; }
        i += 1;
    }
    return -1;
}

fn setenv(name: *char, value: *char, overwrite: int) -> int {
    if (!env_valid_name(name)) { errno = EINVAL; return -1; }
    var i: int = env_find(name);
    if (i >= 0 && !overwrite) { return 0; }
    if (!env_own()) { errno = ENOMEM; return -1; }
    var nl: int = strlen(name);
    var e: *char = malloc(nl + strlen(value) + 2) as *char;
    if (e == null) { errno = ENOMEM; return -1; }
    strcpy(e, name);
    e[nl] = '=';
    strcpy(&e[nl + 1], value);
    if (i >= 0) {
        environ[i] = e;
    } else {
        var n: int = env_count();
        if (n >= 80 + 0 && malloc_usable_size(environ as *tryte) < 3 * (n + 2)) {
            var v: **char = realloc(environ as *tryte, 3 * (n + 81)) as **char;
            if (v == null) { errno = ENOMEM; return -1; }
            environ = v;
        }
        environ[n] = e;
        environ[n + 1] = null;
    }
    return 0;
}

fn unsetenv(name: *char) -> int {
    if (!env_valid_name(name)) { errno = EINVAL; return -1; }
    var i: int = env_find(name);
    if (i < 0) { return 0; }
    if (!env_own()) { errno = ENOMEM; return -1; }
    var n: int = env_count();
    while (i < n) { environ[i] = environ[i + 1]; i += 1; }
    return 0;
}

// ---- sorting ------------------------------------------------------------------------------------

// qsort over an array of words (ints or pointers) with a three-way compare.
fn qsort(a: *int, n: int, cmp: fn(int, int) -> int) {
    if (n < 2) { return; }
    if (n < 9) {                                        // insertion sort for small runs
        var i: int = 1;
        while (i < n) {
            var x: int = a[i];
            var j: int = i - 1;
            while (j >= 0 && cmp(a[j], x) > 0) { a[j + 1] = a[j]; j -= 1; }
            a[j + 1] = x;
            i += 1;
        }
        return;
    }
    var pivot: int = a[n / 2];
    var lo: int = 0;
    var hi: int = n - 1;
    while (lo <= hi) {
        while (cmp(a[lo], pivot) < 0) { lo += 1; }
        while (cmp(a[hi], pivot) > 0) { hi -= 1; }
        if (lo <= hi) {
            var t: int = a[lo];
            a[lo] = a[hi];
            a[hi] = t;
            lo += 1;
            hi -= 1;
        }
    }
    qsort(a, hi + 1, cmp);
    qsort(&a[lo], n - lo, cmp);
}
