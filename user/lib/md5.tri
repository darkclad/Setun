// md5: the MD5 message digest (RFC 1321).
//
// The machine has no binary AND/OR/XOR, so 32-bit words are plain
// integers 0..2^32-1 for the additions, and for the boolean functions
// each half is spread to one bit per trit (see spread16). Text is hashed
// as UTF-8, so a file's digest matches md5sum elsewhere; a negative tryte
// v (not text) is hashed as the code point v + 3^9, which no positive
// tryte can be.
//
//   md5_init(); md5_put_char(c) ...; md5_final(&digest[0]);   16 bytes
//   md5_hex(s, n, &hex[0]);                                    32 hex digits

const TWO32: int = 4294967296;

var md5_k: [64]int = {
    3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313,
    1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329,
    4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
    568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562,
    4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656,
    681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
    4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497,
    1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745
};
var md5_shift: [16]int = { 7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21 };

var md5_state: [4]int;
var md5_block: [64]int;               // bytes waiting for a full block
var md5_fill: int;
var md5_bytes: int;                   // message length so far

fn md5_init() {
    if (md5_tables == 0) { md5_make_tables(); }
    md5_state[0] = 1732584193;
    md5_state[1] = 4023233417;
    md5_state[2] = 2562383102;
    md5_state[3] = 271733878;
    md5_fill = 0;
    md5_bytes = 0;
}

// Bits as trits: a 16-bit half held as the trits (each 0 or 1) of an
// integer. Then AND and OR are tritwise minimum and maximum (& and |),
// XOR is (a | b) - (a & b) and NOT is ONES16 - a, with no carries or
// borrows. Bytes are spread to trits and gathered back by table.
const T8: int = 6561;                 // 3^8: one byte's worth of trits
const ONES16: int = 21523360;         // sixteen 1 trits: (3^16 - 1) / 2
var md5_spread: [256]int;             // a byte -> its bits as trits
var md5_gather: [3281]int;            // eight 0/1 trits -> the byte
var md5_pow2: [33]int;                // 2^0 .. 2^32
var md5_g: [64]int;                   // step i's message word
var md5_s: [64]int;                   // and its rotation
var md5_tables: int;

fn md5_make_tables() {
    var b: int = 0;
    while (b < 256) {
        var v: int = 0;
        var t: int = 1;
        var k: int = b;
        while (k > 0) { v += k % 2 * t; t *= 3; k = k / 2; }
        md5_spread[b] = v;
        md5_gather[v] = b;
        b += 1;
    }
    md5_pow2[0] = 1;
    var i: int = 1;
    while (i <= 32) { md5_pow2[i] = 2 * md5_pow2[i - 1]; i += 1; }
    i = 0;
    while (i < 64) {
        var r: int = i / 16;
        if (r == 0) { md5_g[i] = i; }
        else if (r == 1) { md5_g[i] = (5 * i + 1) % 16; }
        else if (r == 2) { md5_g[i] = (3 * i + 5) % 16; }
        else { md5_g[i] = 7 * i % 16; }
        md5_s[i] = md5_shift[4 * r + i % 4];
        i += 1;
    }
    md5_tables = 1;
}

// A 16-bit value <-> its bits as trits.
fn spread16(v: int) -> int { return md5_spread[v % 256] + T8 * md5_spread[v / 256]; }
fn gather16(t: int) -> int { return md5_gather[t % T8] + 256 * md5_gather[t / T8]; }

fn md5_transform() {
    var w: [16]int;
    var i: int = 0;
    while (i < 16) {
        w[i] = md5_block[4 * i] + 256 * (md5_block[4 * i + 1] + 256 * (md5_block[4 * i + 2] + 256 * md5_block[4 * i + 3]));
        i += 1;
    }
    var a: int = md5_state[0];
    var b: int = md5_state[1];
    var c: int = md5_state[2];
    var d: int = md5_state[3];
    // b, c and d as trits too, low and high halves (c and d were b before)
    var bl: int = spread16(b % 65536);
    var bh: int = spread16(b / 65536);
    var cl: int = spread16(c % 65536);
    var ch: int = spread16(c / 65536);
    var dl: int = spread16(d % 65536);
    var dh: int = spread16(d / 65536);
    i = 0;
    while (i < 64) {
        // the round's boolean function, on both halves
        var fl: int;
        var fh: int;
        if (i < 16) {                                       // (b and c) or (not b and d)
            fl = (bl & cl) | ((ONES16 - bl) & dl);
            fh = (bh & ch) | ((ONES16 - bh) & dh);
        } else if (i < 32) {                                // (b and d) or (c and not d)
            fl = (bl & dl) | (cl & (ONES16 - dl));
            fh = (bh & dh) | (ch & (ONES16 - dh));
        } else if (i < 48) {                                // b xor c xor d
            var xl: int = (bl | cl) - (bl & cl);
            var xh: int = (bh | ch) - (bh & ch);
            fl = (xl | dl) - (xl & dl);
            fh = (xh | dh) - (xh & dh);
        } else {                                            // c xor (b or not d)
            var tl: int = bl | (ONES16 - dl);
            var th: int = bh | (ONES16 - dh);
            fl = (cl | tl) - (cl & tl);
            fh = (ch | th) - (ch & th);
        }
        var fun: int = gather16(fl) + 65536 * gather16(fh);
        var f: int = (fun + a + md5_k[i] + w[md5_g[i]]) % TWO32;
        var m: int = md5_pow2[32 - md5_s[i]];
        a = d;
        d = c;
        dl = cl;
        dh = ch;
        c = b;
        cl = bl;
        ch = bh;
        b = (b + f % m * md5_pow2[md5_s[i]] + f / m) % TWO32;
        bl = spread16(b % 65536);
        bh = spread16(b / 65536);
        i += 1;
    }
    md5_state[0] = (md5_state[0] + a) % TWO32;
    md5_state[1] = (md5_state[1] + b) % TWO32;
    md5_state[2] = (md5_state[2] + c) % TWO32;
    md5_state[3] = (md5_state[3] + d) % TWO32;
}

fn md5_put_byte(v: int) {
    md5_block[md5_fill] = v;
    md5_fill += 1;
    md5_bytes += 1;
    if (md5_fill == 64) { md5_transform(); md5_fill = 0; }
}

// One character, as UTF-8.
fn md5_put_char(c: int) {
    if (c < 0) { c += 19683; }
    if (c < 128) { md5_put_byte(c); }
    else if (c < 2048) { md5_put_byte(192 + c / 64); md5_put_byte(128 + c % 64); }
    else { md5_put_byte(224 + c / 4096); md5_put_byte(128 + c / 64 % 64); md5_put_byte(128 + c % 64); }
}

// Finish: the 16 digest bytes into out.
fn md5_final(out: *int) {
    var bits: int = md5_bytes * 8;
    md5_put_byte(128);
    while (md5_fill != 56) { md5_put_byte(0); }
    var k: int = 0;
    while (k < 8) { md5_put_byte(bits % 256); bits = bits / 256; k += 1; }
    var i: int = 0;
    while (i < 4) {
        var v: int = md5_state[i];
        k = 0;
        while (k < 4) { out[4 * i + k] = v % 256; v = v / 256; k += 1; }
        i += 1;
    }
}

// The digest as 32 lowercase hex digits (out holds 33).
fn md5_digest_hex(out: *char) {
    var d: [16]int;
    md5_final(&d[0]);
    var hex: *char = "0123456789abcdef";
    var i: int = 0;
    while (i < 16) {
        out[2 * i] = hex[d[i] / 16];
        out[2 * i + 1] = hex[d[i] % 16];
        i += 1;
    }
    out[32] = 0;
}

// MD5 of the n characters at s, as hex.
fn md5_hex(s: *char, n: int, out: *char) {
    md5_init();
    var i: int = 0;
    while (i < n) { md5_put_char(s[i]); i += 1; }
    md5_digest_hex(out);
}
