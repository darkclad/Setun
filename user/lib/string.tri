// string.h for tlibc (strlen, strcmp, memcpy, memset come from rt.tri).

import "tlibc.tri";

fn strcpy(dst: *char, src: *char) -> *char {
    var i: int = 0;
    loop {
        dst[i] = src[i];
        if (src[i] == 0) { return dst; }
        i += 1;
    }
}

// Copies at most n characters and pads with NULs, as C does.
fn strncpy(dst: *char, src: *char, n: int) -> *char {
    var i: int = 0;
    while (i < n && src[i] != 0) { dst[i] = src[i]; i += 1; }
    while (i < n) { dst[i] = 0; i += 1; }
    return dst;
}

fn strcat(dst: *char, src: *char) -> *char {
    strcpy(&dst[strlen(dst)], src);
    return dst;
}

fn strncat(dst: *char, src: *char, n: int) -> *char {
    var d: int = strlen(dst);
    var i: int = 0;
    while (i < n && src[i] != 0) { dst[d + i] = src[i]; i += 1; }
    dst[d + i] = 0;
    return dst;
}

fn strncmp(a: *char, b: *char, n: int) -> int {
    var i: int = 0;
    while (i < n) {
        if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
        if (a[i] == 0) { return 0; }
        i += 1;
    }
    return 0;
}

// Equal words are skipped whole when a and b sit alike in their words
// (see rt.tri; from 18 trytes on); the first word that differs is compared tryte by tryte.
fn memcmp(a: *tryte, b: *tryte, n: int) -> int {
    var i: int = 0;
    if (n >= 18 && ((a as int) - (b as int)) % 3 == 0) {
        while (i < n && ((a as int) + i + 1) % 3 != 0 && a[i] == b[i]) { i += 1; }
        if (i < n && a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
        var aw: *int = ((a as int) + i + 1) as *int;
        var bw: *int = ((b as int) + i + 1) as *int;
        var k: int = 0;
        while (i + 3 <= n && aw[k] == bw[k]) { k += 1; i += 3; }
    }
    while (i < n) {
        if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
        i += 1;
    }
    return 0;
}

// Overlapping copies go the safe way round: upward with memcpy (each word
// is read before anything lands on it), downward a word at a time likewise.
fn memmove(dst: *tryte, src: *tryte, n: int) -> *tryte {
    if ((dst as int) < (src as int)) {
        memcpy(dst, src, n);
        return dst;
    }
    var j: int = n;
    if (n >= 18 && ((dst as int) - (src as int)) % 3 == 0) {
        while (j > 0 && ((dst as int) + j + 1) % 3 != 0) { j -= 1; dst[j] = src[j]; }
        var dw: *int = ((dst as int) + j + 1) as *int;    // the word just past the words to copy
        var sw: *int = ((src as int) + j + 1) as *int;
        var k: int = 0;
        while (j >= 3) { k -= 1; dw[k] = sw[k]; j -= 3; }
    }
    while (j > 0) { j -= 1; dst[j] = src[j]; }
    return dst;
}

fn strchr(s: *char, c: char) -> *char {
    var i: int = 0;
    loop {
        if (s[i] == c) { return &s[i]; }
        if (s[i] == 0) { return null; }
        i += 1;
    }
}

fn strrchr(s: *char, c: char) -> *char {
    var last: *char = null;
    var i: int = 0;
    loop {
        if (s[i] == c) { last = &s[i]; }
        if (s[i] == 0) { return last; }
        i += 1;
    }
}

fn strstr(hay: *char, needle: *char) -> *char {
    if (needle[0] == 0) { return hay; }
    var i: int = 0;
    while (hay[i] != 0) {
        var k: int = 0;
        while (needle[k] != 0 && hay[i + k] == needle[k]) { k += 1; }
        if (needle[k] == 0) { return &hay[i]; }
        i += 1;
    }
    return null;
}

fn strspn(s: *char, accept: *char) -> int {
    var n: int = 0;
    while (s[n] != 0 && strchr(accept, s[n]) != null) { n += 1; }
    return n;
}

fn strcspn(s: *char, reject: *char) -> int {
    var n: int = 0;
    while (s[n] != 0 && strchr(reject, s[n]) == null) { n += 1; }
    return n;
}
