// socket.tri: sys/socket.h, netinet/in.h, arpa/inet.h, netdb.h and net/if.h
// for Trinux (docs/NETWORK.md §4-5).
//
// struct sockaddr_in is one word per field. A word is not made of octets,
// so "network byte order" means nothing inside one: htons and friends
// return their argument, and the kernel writes octets in network order.
// Socket data are octets (0..255 per tryte); text goes over the network as
// UTF-8, converted with utf8_encode/utf8_decode.

import "tlibc.tri";

const AF_UNSPEC: int = 0;
const AF_INET: int = 2;
const PF_INET: int = 2;
const AF_INET6: int = 10;
const PF_INET6: int = 10;
const IPPROTO_IPV6: int = 41;
const IPPROTO_ICMPV6: int = 58;
const IPV6_V6ONLY: int = 26;
const INET6_ADDRSTRLEN: int = 46;
const SOCK_STREAM: int = 1;
const SOCK_DGRAM: int = 2;
const SOCK_RAW: int = 3;
const SOCK_NONBLOCK: int = 2048;
const SOCK_CLOEXEC: int = 524288;
const IPPROTO_IP: int = 0;
const IPPROTO_ICMP: int = 1;
const IPPROTO_TCP: int = 6;
const IPPROTO_UDP: int = 17;
const INADDR_ANY: int = 0;
const INADDR_LOOPBACK: int = 2130706433;
const INADDR_BROADCAST: int = 4294967295;
const INADDR_NONE: int = -1;
const SOL_SOCKET: int = 1;
const SO_REUSEADDR: int = 2;
const SO_TYPE: int = 3;
const SO_ERROR: int = 4;
const SO_BROADCAST: int = 6;
const SO_SNDBUF: int = 7;
const SO_RCVBUF: int = 8;
const SO_KEEPALIVE: int = 9;
const SO_ACCEPTCONN: int = 30;
const TCP_NODELAY: int = 1;
const MSG_PEEK: int = 2;
const MSG_TRUNC: int = 32;
const MSG_DONTWAIT: int = 64;
const MSG_WAITALL: int = 256;
const MSG_NOSIGNAL: int = 16384;
const SHUT_RD: int = 0;
const SHUT_WR: int = 1;
const SHUT_RDWR: int = 2;
const SOMAXCONN: int = 27;
const S_IFSOCK: int = 49152;

struct sockaddr_in {
    sin_family: int;
    sin_port: int;
    sin_addr: int;
}

fn socket(domain: int, type: int, proto: int) -> int { return _ret(syscall(198, domain, type, proto)); }
fn bind(fd: int, a: *sockaddr_in, len: int) -> int { return _ret(syscall(200, fd, a, len)); }
fn listen(fd: int, backlog: int) -> int { return _ret(syscall(201, fd, backlog)); }
fn accept(fd: int, a: *sockaddr_in, len: *int) -> int { return _ret(syscall(202, fd, a, len)); }
fn accept4(fd: int, a: *sockaddr_in, len: *int, flags: int) -> int { return _ret(syscall(242, fd, a, len, flags)); }
fn connect(fd: int, a: *sockaddr_in, len: int) -> int { return _ret(syscall(203, fd, a, len)); }
fn getsockname(fd: int, a: *sockaddr_in, len: *int) -> int { return _ret(syscall(204, fd, a, len)); }
fn getpeername(fd: int, a: *sockaddr_in, len: *int) -> int { return _ret(syscall(205, fd, a, len)); }
fn sendto(fd: int, buf: *tryte, n: int, flags: int, a: *sockaddr_in, len: int) -> int {
    return _ret(syscall(206, fd, buf, n, flags, a, len));
}
fn recvfrom(fd: int, buf: *tryte, n: int, flags: int, a: *sockaddr_in, len: *int) -> int {
    return _ret(syscall(207, fd, buf, n, flags, a, len));
}
fn send(fd: int, buf: *tryte, n: int, flags: int) -> int { return sendto(fd, buf, n, flags, null, 0); }
fn recv(fd: int, buf: *tryte, n: int, flags: int) -> int { return recvfrom(fd, buf, n, flags, null, null); }
fn setsockopt(fd: int, level: int, opt: int, val: *int, len: int) -> int { return _ret(syscall(208, fd, level, opt, val, len)); }
fn getsockopt(fd: int, level: int, opt: int, val: *int, len: *int) -> int { return _ret(syscall(209, fd, level, opt, val, len)); }
fn shutdown(fd: int, how: int) -> int { return _ret(syscall(210, fd, how)); }

fn htons(v: int) -> int { return v; }
fn ntohs(v: int) -> int { return v; }
fn htonl(v: int) -> int { return v; }
fn ntohl(v: int) -> int { return v; }

// docs/IPV6.md §4: one word per field, the address as 16 octets.
struct sockaddr_in6 {
    sin6_family: int;
    sin6_port: int;
    sin6_flowinfo: int;
    sin6_addr: [16]int;
    sin6_scope_id: int;
}

// sin6_scope_id for a link-local address: Trinux has one link, eth0 (2).
const IF_ETH0: int = 2;

fn sockaddr6_set(a: *sockaddr_in6, addr: *int, port: int) {
    a.sin6_family = AF_INET6;
    a.sin6_port = port;
    a.sin6_flowinfo = 0;
    var k: int = 0;
    while (k < 16) { a.sin6_addr[k] = addr[k]; k += 1; }
    a.sin6_scope_id = addr[0] == 254 && addr[1] >= 128 && addr[1] < 192 ? IF_ETH0 : 0;
}

fn sockaddr_set(a: *sockaddr_in, addr: int, port: int) {
    a.sin_family = AF_INET;
    a.sin_port = port;
    a.sin_addr = addr;
}

// "a.b.c.d" (each 0..255) into *out; 1 if valid, as inet_aton.
fn inet_aton(s: *char, out: *int) -> int {
    var v: int = 0;
    var parts: int = 0;
    var k: int = 0;
    while (parts < 4) {
        if (s[k] < '0' || s[k] > '9') { return 0; }
        var part: int = 0;
        var digits: int = 0;
        while (s[k] >= '0' && s[k] <= '9') {
            part = part * 10 + s[k] - '0';
            k += 1;
            digits += 1;
            if (digits > 3 || part > 255) { return 0; }
        }
        v = v * 256 + part;
        parts += 1;
        if (parts < 4) {
            if (s[k] != '.') { return 0; }
            k += 1;
        }
    }
    if (s[k] != 0) { return 0; }
    *out = v;
    return 1;
}

fn inet_addr(s: *char) -> int {
    var v: int = 0;
    return inet_aton(s, &v) ? v : INADDR_NONE;
}

var _ntoa_buf: [16]char;

// Dotted quad of `a` in a static buffer, as inet_ntoa.
fn inet_ntoa(a: int) -> *char {
    var n: int = 0;
    var k: int = 3;
    while (k >= 0) {
        var div: int = 1;
        var j: int = 0;
        while (j < k) { div *= 256; j += 1; }
        var tmp: [5]char;
        var s: *char = itoa(a / div % 256, &tmp[0]);
        j = 0;
        while (s[j] != 0) { _ntoa_buf[n] = s[j]; n += 1; j += 1; }
        if (k > 0) { _ntoa_buf[n] = '.'; n += 1; }
        k -= 1;
    }
    _ntoa_buf[n] = 0;
    return &_ntoa_buf[0];
}

fn _hex6val(c: int) -> int {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
}

// IPv6 text (RFC 4291 §2.2: groups of 1..4 hex digits, one "::", an IPv4
// tail) into 16 octets at out; 1 if valid, as inet_pton(AF_INET6).
fn inet_pton6(s: *char, out: *int) -> int {
    var g: [8]int;
    var n: int = 0;                        // groups so far
    var gap: int = -1;                     // where "::" stands
    var k: int = 0;
    if (s[0] == ':') {
        if (s[1] != ':') { return 0; }
        gap = 0;
        k = 2;
        if (s[k] == 0) {                   // "::"
            var z: int = 0;
            while (z < 16) { out[z] = 0; z += 1; }
            return 1;
        }
    }
    loop {
        // an IPv4 tail: digits then a dot before any colon
        var j: int = k;
        while (s[j] >= '0' && s[j] <= '9') { j += 1; }
        if (s[j] == '.') {
            if (n > 6) { return 0; }
            var v4: int = 0;
            if (!inet_aton(&s[k], &v4)) { return 0; }
            g[n] = v4 / 65536;
            g[n + 1] = v4 % 65536;
            n += 2;
            break;
        }
        var v: int = 0;
        var d: int = 0;
        while (_hex6val(s[k]) >= 0) {
            v = v * 16 + _hex6val(s[k]);
            k += 1;
            d += 1;
            if (d > 4) { return 0; }
        }
        if (d == 0 || n == 8) { return 0; }
        g[n] = v;
        n += 1;
        if (s[k] == 0) { break; }
        if (s[k] != ':') { return 0; }
        k += 1;
        if (s[k] == ':') {
            if (gap >= 0) { return 0; }    // a second "::"
            gap = n;
            k += 1;
            if (s[k] == 0) { break; }
        }
    }
    if (gap < 0 && n != 8) { return 0; }
    if (gap >= 0 && n > 7) { return 0; }   // "::" must stand for at least one group
    var full: [8]int;
    var i: int = 0;
    while (i < 8) { full[i] = 0; i += 1; }
    if (gap < 0) {
        i = 0;
        while (i < 8) { full[i] = g[i]; i += 1; }
    } else {
        i = 0;
        while (i < gap) { full[i] = g[i]; i += 1; }
        var tail: int = n - gap;
        i = 0;
        while (i < tail) { full[8 - tail + i] = g[gap + i]; i += 1; }
    }
    i = 0;
    while (i < 8) {
        out[2 * i] = full[i] / 256;
        out[2 * i + 1] = full[i] % 256;
        i += 1;
    }
    return 1;
}

var _ntop6_buf: [46]char;

// RFC 5952 text of the 16 octets at a, in a static buffer: lowercase,
// no leading zeros, the longest run of two or more zero groups (the first
// on a tie) as "::".
fn inet_ntop6(a: *int) -> *char {
    var best: int = -1;
    var blen: int = 1;
    var g: int = 0;
    while (g < 8) {
        var e: int = g;
        while (e < 8 && a[2 * e] == 0 && a[2 * e + 1] == 0) { e += 1; }
        if (e - g > blen) { best = g; blen = e - g; }
        g = e > g ? e : g + 1;
    }
    var digits: *char = "0123456789abcdef";
    var n: int = 0;
    g = 0;
    while (g < 8) {
        if (g == best) {
            _ntop6_buf[n] = ':';
            n += 1;
            if (g == 0) { _ntop6_buf[n] = ':'; n += 1; }
            g += blen;
            continue;
        }
        var v: int = a[2 * g] * 256 + a[2 * g + 1];
        var started: int = 0;
        var sh: int = 4096;
        while (sh > 0) {
            var d: int = v / sh % 16;
            if (d != 0 || started || sh == 1) { _ntop6_buf[n] = digits[d]; n += 1; started = 1; }
            sh /= 16;
        }
        if (g < 7) { _ntop6_buf[n] = ':'; n += 1; }
        g += 1;
    }
    _ntop6_buf[n] = 0;
    return &_ntop6_buf[0];
}

// ---- names: /etc/hosts -------------------------------------------------------------------

var _hosts_buf: [2187]char;

// The address for `name`: a dotted quad, "localhost", or a line of
// /etc/hosts. 1 if found.
fn resolve_host(name: *char, out: *int) -> int {
    if (inet_aton(name, out)) { return 1; }
    var fd: int = open("/etc/hosts", O_RDONLY, 0);
    if (fd >= 0) {
        var n: int = read(fd, &_hosts_buf[0], 2186);
        close(fd);
        if (n < 0) { n = 0; }
        _hosts_buf[n] = 0;
        var k: int = 0;
        while (k < n) {
            // one line: address, then names
            var line: int = k;
            while (k < n && _hosts_buf[k] != '\n') { k += 1; }
            var end: int = k;
            k += 1;
            if (_hosts_buf[line] == '#') { continue; }
            var j: int = line;
            while (j < end && _hosts_buf[j] != ' ' && _hosts_buf[j] != '\t') { j += 1; }
            var saved: char = _hosts_buf[j];
            _hosts_buf[j] = 0;
            var addr: int = 0;
            var ok: int = inet_aton(&_hosts_buf[line], &addr);
            _hosts_buf[j] = saved;
            if (!ok) { continue; }
            while (j < end) {
                while (j < end && (_hosts_buf[j] == ' ' || _hosts_buf[j] == '\t')) { j += 1; }
                var w: int = j;
                while (j < end && _hosts_buf[j] != ' ' && _hosts_buf[j] != '\t') { j += 1; }
                if (j > w && _name_is(&_hosts_buf[w], j - w, name)) { *out = addr; return 1; }
            }
        }
    }
    if (_name_is("localhost", 9, name)) { *out = INADDR_LOOPBACK; return 1; }
    var addrs: [1]int;
    if (dns_lookup(name, dns_server(), &addrs[0], 1) > 0) { *out = addrs[0]; return 1; }
    return 0;
}

// ---- TNET addresses (docs/TNET.md §3, §5) ----------------------------------------------------

const AF_TNP: int = 27;
const TNP_TSP: int = 1;
const TNP_TDP: int = 2;
const TNP_TCMP: int = 3;

// "a.b.c", three trytes in decimal (each may be negative): 1 and the
// address in *out, or 0. Exactly three parts, so an IPv4 address (four)
// is never taken for one.
fn tn_aton(s: *char, out: *int) -> int {
    var v: int = 0;
    var part: int = 0;
    var k: int = 0;
    while (part < 3) {
        var neg: int = 0;
        if (s[k] == '-') { neg = 1; k += 1; }
        if (s[k] < '0' || s[k] > '9') { return 0; }
        var t: int = 0;
        while (s[k] >= '0' && s[k] <= '9') {
            t = t * 10 + (s[k] - '0');
            if (t > 9841) { return 0; }
            k += 1;
        }
        v = v * 19683 + (neg ? -t : t);
        part += 1;
        if (part < 3) {
            if (s[k] != '.') { return 0; }
            k += 1;
        }
    }
    if (s[k] != 0) { return 0; }
    *out = v;
    return 1;
}

var _tn_buf: [40]char;

// The dotted form of a TNP address (in a static buffer).
fn tn_ntoa(a: int) -> *char {
    var n: int = 0;
    var parts: [3]int;
    parts[0] = ext(a, 1, 9);
    parts[1] = ext(a, 10, 9);
    parts[2] = ext(a, 19, 9);
    var k: int = 0;
    while (k < 3) {
        var tmp: [12]char;
        var s: *char = itoa(parts[k], &tmp[0]);
        var j: int = 0;
        while (s[j] != 0) { _tn_buf[n] = s[j]; n += 1; j += 1; }
        if (k < 2) { _tn_buf[n] = '.'; n += 1; }
        k += 1;
    }
    _tn_buf[n] = 0;
    return &_tn_buf[0];
}

// The address and family for `name`: a TNP address or a dotted quad as
// written, else /etc/hosts (a name with both kinds of line gives its TNP
// address), "localhost", then DNS. The family, or 0 if not found.
fn resolve_any(name: *char, out: *int) -> int {
    if (tn_aton(name, out)) { return AF_TNP; }
    if (inet_aton(name, out)) { return AF_INET; }
    var fd: int = open("/etc/hosts", O_RDONLY, 0);
    if (fd >= 0) {
        var n: int = read(fd, &_hosts_buf[0], 2186);
        close(fd);
        if (n < 0) { n = 0; }
        _hosts_buf[n] = 0;
        var found_inet: int = 0;
        var inet_addr_found: int = 0;
        var k: int = 0;
        while (k < n) {
            var line: int = k;
            while (k < n && _hosts_buf[k] != '\n') { k += 1; }
            var end: int = k;
            k += 1;
            if (_hosts_buf[line] == '#') { continue; }
            var j: int = line;
            while (j < end && _hosts_buf[j] != ' ' && _hosts_buf[j] != '\t') { j += 1; }
            var saved: char = _hosts_buf[j];
            _hosts_buf[j] = 0;
            var addr: int = 0;
            var fam: int = tn_aton(&_hosts_buf[line], &addr) ? AF_TNP : (inet_aton(&_hosts_buf[line], &addr) ? AF_INET : 0);
            _hosts_buf[j] = saved;
            if (fam == 0) { continue; }
            while (j < end) {
                while (j < end && (_hosts_buf[j] == ' ' || _hosts_buf[j] == '\t')) { j += 1; }
                var w: int = j;
                while (j < end && _hosts_buf[j] != ' ' && _hosts_buf[j] != '\t') { j += 1; }
                if (j > w && _name_is(&_hosts_buf[w], j - w, name)) {
                    if (fam == AF_TNP) { *out = addr; return AF_TNP; }
                    if (!found_inet) { found_inet = 1; inet_addr_found = addr; }
                }
            }
        }
        if (found_inet) { *out = inet_addr_found; return AF_INET; }
    }
    if (_name_is("localhost", 9, name)) { *out = INADDR_LOOPBACK; return AF_INET; }
    var addrs: [1]int;
    if (dns_lookup(name, dns_server(), &addrs[0], 1) > 0) { *out = addrs[0]; return AF_INET; }
    return 0;
}

// A socket address of either family.
fn sockaddr_set_family(a: *sockaddr_in, family: int, addr: int, port: int) {
    a.sin_family = family;
    a.sin_port = port;
    a.sin_addr = addr;
}

// The dotted form of an address of either family.
fn addr_ntoa(family: int, a: int) -> *char { return family == AF_TNP ? tn_ntoa(a) : inet_ntoa(a); }

// ---- DNS (RFC 1035): A records over UDP ------------------------------------------------------

const DNS_TIMEOUT: int = -2;          // dns_lookup: no answer from the server
const DNS_BAD_NAME: int = -3;         //             not a name DNS can carry

// The first nameserver in /etc/resolv.conf, or 10.0.2.3.
fn dns_server() -> int {
    var buf: [729]char;
    var fd: int = open("/etc/resolv.conf", O_RDONLY, 0);
    var a: int = 167772675;                       // 10.0.2.3
    if (fd < 0) { return a; }
    var n: int = read(fd, &buf[0], 728);
    close(fd);
    if (n < 0) { n = 0; }
    buf[n] = 0;
    var k: int = 0;
    while (k < n) {
        if (_prefix(&buf[k], "nameserver")) {
            var j: int = k + 10;
            while (buf[j] == ' ' || buf[j] == '\t') { j += 1; }
            var e: int = j;
            while (buf[e] != 0 && buf[e] != '\n' && buf[e] != ' ') { e += 1; }
            var saved: char = buf[e];
            buf[e] = 0;
            var v: int = 0;
            var ok: int = inet_aton(&buf[j], &v);
            buf[e] = saved;
            if (ok) { return v; }
        }
        while (k < n && buf[k] != '\n') { k += 1; }
        k += 1;
    }
    return a;
}

fn _prefix(s: *char, p: *char) -> int {
    var k: int = 0;
    while (p[k] != 0) {
        if (s[k] != p[k]) { return 0; }
        k += 1;
    }
    return 1;
}

var _dns_q: [300]tryte;
var _dns_r: [1500]tryte;

// Skip a (possibly compressed) name at r[i]; the offset after it, or -1.
fn _dns_skip_name(r: *tryte, n: int, i: int) -> int {
    var hops: int = 0;
    while (i < n) {
        var len: int = r[i];
        if (len == 0) { return i + 1; }
        if (len >= 192) { return i + 2 <= n ? i + 2 : -1; }
        if (len > 63) { return -1; }
        i += 1 + len;
        hops += 1;
        if (hops > 127) { return -1; }
    }
    return -1;
}

const DNS_NXDOMAIN: int = -4;          // _dns_ask: the name does not exist

// Ask `server` for the A records of name: up to max addresses into out.
// The count (0: no such name, or none), or DNS_TIMEOUT / DNS_BAD_NAME / -1.
fn dns_lookup(name: *char, server: int, out: *int, max: int) -> int {
    var srv: sockaddr_in6;
    sa_set(&srv, AF_INET, server, null, 53);
    var n: int = _dns_ask(name, &srv, 1, out, max);
    return n == DNS_NXDOMAIN ? 0 : n;
}

// The same for AAAA records, from the server at srv: 16 octets per address
// into out.
fn dns_lookup6(name: *char, srv: *sockaddr_in6, out: *int, max: int) -> int {
    var n: int = _dns_ask(name, srv, 28, out, max);
    return n == DNS_NXDOMAIN ? 0 : n;
}

// The DNS server of /etc/resolv.conf's first usable nameserver line, IPv4
// or IPv6 (10.0.2.3 if there is none), port 53.
fn dns_server_sa(srv: *sockaddr_in6) {
    var buf: [729]char;
    sa_set(srv, AF_INET, 167772675, null, 53);   // 10.0.2.3
    var fd: int = open("/etc/resolv.conf", O_RDONLY, 0);
    if (fd < 0) { return; }
    var n: int = read(fd, &buf[0], 728);
    close(fd);
    if (n < 0) { n = 0; }
    buf[n] = 0;
    var k: int = 0;
    while (k < n) {
        if (_prefix(&buf[k], "nameserver")) {
            var j: int = k + 10;
            while (buf[j] == ' ' || buf[j] == '\t') { j += 1; }
            var e: int = j;
            while (buf[e] != 0 && buf[e] != '\n' && buf[e] != ' ') { e += 1; }
            var saved: char = buf[e];
            buf[e] = 0;
            var v: int = 0;
            var o: [16]int;
            if (inet_aton(&buf[j], &v)) { buf[e] = saved; sa_set(srv, AF_INET, v, null, 53); return; }
            if (inet_pton6(&buf[j], &o[0])) { buf[e] = saved; sockaddr6_set(srv, &o[0], 53); return; }
            buf[e] = saved;
        }
        while (k < n && buf[k] != '\n') { k += 1; }
        k += 1;
    }
}

// Is a the address of the server at srv (its family, address and port 53)?
fn _dns_from(a: *sockaddr_in6, srv: *sockaddr_in6) -> int {
    if (a.sin6_family != srv.sin6_family || a.sin6_port != 53) { return 0; }
    if (srv.sin6_family == AF_INET) { return (a as *sockaddr_in).sin_addr == (srv as *sockaddr_in).sin_addr; }
    var k: int = 0;
    while (k < 16) {
        if (a.sin6_addr[k] != srv.sin6_addr[k]) { return 0; }
        k += 1;
    }
    return 1;
}

// Ask the server at srv for name's records of qtype (1 A: one int each
// into out; 28 AAAA: 16 octets each): the count, DNS_NXDOMAIN,
// DNS_TIMEOUT, DNS_BAD_NAME or -1.
fn _dns_ask(name: *char, srv: *sockaddr_in6, qtype: int, out: *int, max: int) -> int {
    // the query: id, RD, one question
    var id: [2]tryte;
    getrandom(&id[0], 2, 0);
    var q: *tryte = &_dns_q[0];
    q[0] = id[0]; q[1] = id[1];
    q[2] = 1; q[3] = 0;                            // RD
    q[4] = 0; q[5] = 1;                            // QDCOUNT
    var k: int = 6;
    while (k < 12) { q[k] = 0; k += 1; }
    var at: int = 12;
    var i: int = 0;
    loop {
        var start: int = i;
        while (name[i] != 0 && name[i] != '.') {
            // no host name has these: an address literal (an IPv6 one in
            // brackets, with a port) or a URL that got this far is not a name
            var ch: int = name[i];
            if (ch < 33 || ch > 126 || ch == '[' || ch == ']' || ch == ':' || ch == '/' || ch == '@' || ch == '%') { return DNS_BAD_NAME; }
            i += 1;
        }
        var len: int = i - start;
        if (len == 0 || len > 63 || at + len + 6 > 280) { return DNS_BAD_NAME; }
        q[at] = len as tryte;
        k = 0;
        while (k < len) { q[at + 1 + k] = name[start + k] as tryte; k += 1; }
        at += 1 + len;
        if (name[i] == 0) { break; }
        i += 1;
        if (name[i] == 0) { break; }               // a trailing dot
    }
    q[at] = 0;
    q[at + 1] = 0; q[at + 2] = qtype as tryte;     // QTYPE
    q[at + 3] = 0; q[at + 4] = 1;                  // QCLASS IN
    var qlen: int = at + 5;
    var s: int = socket(srv.sin6_family, SOCK_DGRAM, 0);
    if (s < 0) { return -1; }
    var tries: int = 0;
    while (tries < 3) {
        tries += 1;
        if (sendto(s, q, qlen, 0, srv as *sockaddr_in, sa_len(srv.sin6_family)) < 0) { close(s); return -1; }
        loop {
            var p: pollfd;
            p.fd = s;
            p.events = POLLIN;
            if (poll(&p, 1, 2000) <= 0) { break; }       // try again
            var from: sockaddr_in6;
            var flen: int = sizeof(sockaddr_in6);
            var n: int = recvfrom(s, &_dns_r[0], 1500, 0, &from as *sockaddr_in, &flen);
            var r: *tryte = &_dns_r[0];
            if (n < 12 || !_dns_from(&from, srv) || r[0] != q[0] || r[1] != q[1] || r[2] < 128) { continue; }
            close(s);
            var rcode: int = r[3] % 16;
            if (rcode == 3) { return DNS_NXDOMAIN; }
            if (rcode != 0) { return -1; }
            var an: int = r[6] * 256 + r[7];
            var j: int = _dns_skip_name(r, n, 12);
            if (j < 0) { return -1; }
            j += 4;
            var count: int = 0;
            while (an > 0 && count < max) {
                j = _dns_skip_name(r, n, j);
                if (j < 0 || j + 10 > n) { return count; }
                var type: int = r[j] * 256 + r[j + 1];
                var rdlen: int = r[j + 8] * 256 + r[j + 9];
                j += 10;
                if (j + rdlen > n) { return count; }
                if (qtype == 1 && type == 1 && rdlen == 4) {
                    out[count] = ((r[j] * 256 + r[j + 1]) * 256 + r[j + 2]) * 256 + r[j + 3];
                    count += 1;
                } else if (qtype == 28 && type == 28 && rdlen == 16) {
                    var o: int = 0;
                    while (o < 16) { out[16 * count + o] = r[j + o]; o += 1; }
                    count += 1;
                }
                j += rdlen;
                an -= 1;
            }
            return count;
        }
    }
    close(s);
    return DNS_TIMEOUT;
}

fn _name_is(s: *char, len: int, name: *char) -> int {
    var k: int = 0;
    while (k < len) {
        if (name[k] != s[k]) { return 0; }
        k += 1;
    }
    return name[len] == 0;
}

// ---- interfaces (net/if.h) ---------------------------------------------------------------

const IFNAMSIZ: int = 27;
const IFF_UP: int = 1;
const IFF_BROADCAST: int = 2;
const IFF_LOOPBACK: int = 8;
const IFF_RUNNING: int = 64;
const SIOCGIFFLAGS: int = 35091;
const SIOCSIFFLAGS: int = 35092;
const SIOCGIFADDR: int = 35093;
const SIOCSIFADDR: int = 35094;
const SIOCGIFNETMASK: int = 35099;
const SIOCSIFNETMASK: int = 35100;
const SIOCGIFMTU: int = 35105;
const SIOCGIFHWADDR: int = 35111;
const SIOCGIFGW: int = 35312;          // Trinux: the default gateway
const SIOCSIFGW: int = 35313;

struct ifreq {
    ifr_name: [27]char;
    ifr_value: int;                    // address, mask, flags, MTU, or MAC octets 0..2
    ifr_value2: int;                   // MAC octets 3..5
}

// ---- UTF-8 ---------------------------------------------------------------------------------

// Encode one tryte of text as UTF-8 octets into out; returns how many (0..8).
// A negative tryte (an overlined character) is sent as its character
// followed by U+0305, the way the serial console shows it. A character
// above U+2671 is three trytes (ISA §1.1): the lead and the first trailing
// tryte return 0 and the last one the whole character, so callers may go
// tryte by tryte; a malformed one is sent as U+FFFD.
var utf8_lead: int;                    // a pending lead tryte, or 0
var utf8_hi: int;

fn utf8_encode(c: int, out: *tryte) -> int {
    if (utf8_lead != 0) {
        if (c > -33) {
            // not a trailing tryte: U+FFFD for the broken character, then this one
            utf8_lead = 0;
            var n0: int = utf8_cp(65533, out);
            return n0 + utf8_encode(c, out + n0);
        }
        if (utf8_hi == 0) { utf8_hi = c; return 0; }
        var t: [3]char = { utf8_lead as char, utf8_hi as char, c as char };
        utf8_lead = 0;
        utf8_hi = 0;
        var cp: int = 0;
        var n1: int = tstr_next(&t[0], &cp) == 3 ? utf8_cp(cp < 0 ? -cp : cp, out) : utf8_cp(65533, out);
        if (cp < 0 && n1 > 0 && t[0] == BIG_CHAR_OVERLINED) { n1 += utf8_cp(773, out + n1); }
        return n1;
    }
    if (c == BIG_CHAR || c == BIG_CHAR_OVERLINED) { utf8_lead = c; utf8_hi = 0; return 0; }
    if (c < 0 && c >= -32) { return utf8_cp(65533, out); }
    if (c < 0) {
        var n: int = utf8_cp(-c, out);
        return n + utf8_cp(773, out + n);
    }
    return utf8_cp(c, out);
}

// The code point c (0..U+10FFFF) as UTF-8 octets; how many.
fn utf8_cp(c: int, out: *tryte) -> int {
    if (c < 128) { out[0] = c as tryte; return 1; }
    if (c < 2048) {
        out[0] = (192 + c / 64) as tryte;
        out[1] = (128 + c % 64) as tryte;
        return 2;
    }
    if (c < 65536) {
        out[0] = (224 + c / 4096) as tryte;
        out[1] = (128 + c / 64 % 64) as tryte;
        out[2] = (128 + c % 64) as tryte;
        return 3;
    }
    out[0] = (240 + c / 262144) as tryte;
    out[1] = (128 + c / 4096 % 64) as tryte;
    out[2] = (128 + c / 64 % 64) as tryte;
    out[3] = (128 + c % 64) as tryte;
    return 4;
}

// An incremental UTF-8 decoder: feed octets one at a time. Returns the code
// point when one is complete, -1 while more octets are needed, and '?' for
// a malformed sequence (a bad continuation, an overlong form, a surrogate,
// or above U+10FFFF).
struct utf8_state {
    need: int;
    cp: int;
    min: int;                          // the smallest code point of this length
}

fn utf8_decode(st: *utf8_state, b: int) -> int {
    if (st.need > 0) {
        if (b < 128 || b >= 192) { st.need = 0; return '?'; }
        st.cp = st.cp * 64 + b % 64;
        st.need -= 1;
        if (st.need > 0) { return -1; }
        if (st.cp < st.min || st.cp > 1114111 || (st.cp >= 55296 && st.cp <= 57343)) { return '?'; }
        return st.cp;
    }
    if (b < 128) { return b; }
    if (b >= 194 && b < 224) { st.need = 1; st.cp = b % 32; st.min = 128; return -1; }
    if (b >= 224 && b < 240) { st.need = 2; st.cp = b % 16; st.min = 2048; return -1; }
    if (b >= 240 && b < 245) { st.need = 3; st.cp = b % 8; st.min = 65536; return -1; }
    return '?';
}

// Decode n octets into characters; a character followed by U+0305
// (combining overline) becomes overlined, as on the serial console.
// Returns how many trytes were written to out (at most n: a character
// above U+2671 takes 3 trytes and at least 3 octets).
fn utf8_to_text(st: *utf8_state, in: *tryte, n: int, out: *char) -> int {
    var m: int = 0;
    var k: int = 0;
    while (k < n) {
        var c: int = utf8_decode(st, in[k]);
        k += 1;
        if (c < 0) { continue; }
        if (c == 773 && m > 0) {
            if (m >= 3 && out[m - 3] == BIG_CHAR && out[m - 2] < -32 && out[m - 1] < -32) {
                out[m - 3] = BIG_CHAR_OVERLINED as char;
                continue;
            }
            if (out[m - 1] > 32) {
                out[m - 1] = (-out[m - 1]) as char;
                continue;
            }
        }
        m += tchar_put(c, out + m);
    }
    return m;
}

// Encode n trytes of text as UTF-8 into out (room for 8 octets per tryte);
// returns the number of octets.
fn text_to_utf8(in: *char, n: int, out: *tryte) -> int {
    var m: int = 0;
    var k: int = 0;
    while (k < n) {
        m += utf8_encode(in[k], out + m);
        k += 1;
    }
    return m;
}

// ---- any family: struct sockaddr_in6 is big enough for all ----------------------------------

fn sa_len(family: int) -> int { return family == AF_INET6 ? sizeof(sockaddr_in6) : sizeof(sockaddr_in); }

// family's address: addr (IPv4, TNET) or the 16 octets at addr6 (IPv6).
fn sa_set(a: *sockaddr_in6, family: int, addr: int, addr6: *int, port: int) {
    if (family == AF_INET6) {
        var zero: [16]int;
        var k: int = 0;
        while (k < 16) { zero[k] = 0; k += 1; }
        sockaddr6_set(a, addr6 == null ? &zero[0] : addr6, port);
        return;
    }
    sockaddr_set_family(a as *sockaddr_in, family, addr, port);
}

// The address in text, in a static buffer.
fn sa_ntoa(a: *sockaddr_in6) -> *char {
    if (a.sin6_family == AF_INET6) { return inet_ntop6(&a.sin6_addr[0]); }
    var b: *sockaddr_in = a as *sockaddr_in;
    return addr_ntoa(b.sin_family, b.sin_addr);
}

// A listening TCP socket on port for each family in fams that can have
// one (the first must: its failure is reported as -1 with errno); their
// descriptors go into fds. The count.
fn listen_on(fams: *int, nf: int, port: int, fds: *int) -> int {
    var n: int = 0;
    var i: int = 0;
    while (i < nf) {
        var l: int = socket(fams[i], SOCK_STREAM, 0);
        if (l >= 0) {
            var one: int = 1;
            setsockopt(l, SOL_SOCKET, SO_REUSEADDR, &one, 3);
            var a: sockaddr_in6;
            sa_set(&a, fams[i], 0, null, port);
            if (bind(l, &a as *sockaddr_in, sa_len(fams[i])) < 0 || listen(l, 9) < 0) {
                var e: int = errno;
                close(l);
                l = -1;
                errno = e;
            }
        }
        if (l < 0 && i == 0) { return -1; }
        if (l >= 0) { fds[n] = l; n += 1; }
        i += 1;
    }
    return n;
}

// Accept a connection on whichever of the n listening sockets has one
// (at most 3); the peer's address goes to *from. -1 with errno.
fn accept_any(fds: *int, n: int, from: *sockaddr_in6, flen: *int) -> int {
    var which: int = fds[0];
    if (n > 1) {
        var ps: [3]pollfd;
        var i: int = 0;
        while (i < n) { ps[i].fd = fds[i]; ps[i].events = POLLIN; ps[i].revents = 0; i += 1; }
        if (poll(&ps[0], n, -1) < 0) { return -1; }
        i = 0;
        while (i < n && ps[i].revents == 0) { i += 1; }
        if (i == n) { errno = EINTR; return -1; }
        which = fds[i];
    }
    *flen = sizeof(sockaddr_in6);
    return accept(which, from as *sockaddr_in, flen);
}

fn close_all(fds: *int, n: int) {
    var i: int = 0;
    while (i < n) { close(fds[i]); i += 1; }
}

// ---- names of any family (docs/IPV6.md §6) ------------------------------------------------

// An IPv6 address for name in /etc/hosts: its 16 octets into out; 1 if found.
fn _hosts6(name: *char, out: *int) -> int {
    var fd: int = open("/etc/hosts", O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var n: int = read(fd, &_hosts_buf[0], 2186);
    close(fd);
    if (n < 0) { n = 0; }
    _hosts_buf[n] = 0;
    var k: int = 0;
    while (k < n) {
        var line: int = k;
        while (k < n && _hosts_buf[k] != '\n') { k += 1; }
        var end: int = k;
        k += 1;
        if (_hosts_buf[line] == '#') { continue; }
        var j: int = line;
        while (j < end && _hosts_buf[j] != ' ' && _hosts_buf[j] != '\t') { j += 1; }
        var saved: char = _hosts_buf[j];
        _hosts_buf[j] = 0;
        var o: [16]int;
        var ok: int = inet_pton6(&_hosts_buf[line], &o[0]);
        _hosts_buf[j] = saved;
        if (!ok) { continue; }
        while (j < end) {
            while (j < end && (_hosts_buf[j] == ' ' || _hosts_buf[j] == '\t')) { j += 1; }
            var w: int = j;
            while (j < end && _hosts_buf[j] != ' ' && _hosts_buf[j] != '\t') { j += 1; }
            if (j > w && _name_is(&_hosts_buf[w], j - w, name)) {
                var c: int = 0;
                while (c < 16) { out[c] = o[c]; c += 1; }
                return 1;
            }
        }
    }
    return 0;
}

// name as a socket address with port, in *sa: an IPv6 or IPv4 literal, a
// TNET address, /etc/hosts, then DNS. want is AF_INET, AF_INET6 or AF_TNP
// to take only that family, 0 for any: IPv4 is tried before IPv6 (RFC 6724
// prefers it over a global IPv6 destination when the IPv6 source is
// unique-local, as fd00::/64 is). The family, or 0 if there is none.
fn resolve_name(name: *char, want: int, sa: *sockaddr_in6, port: int) -> int {
    var o: [16]int;
    if ((want == 0 || want == AF_INET6) && inet_pton6(name, &o[0])) {
        sockaddr6_set(sa, &o[0], port);
        return AF_INET6;
    }
    if (want != AF_INET6) {
        var a: int = 0;
        var fam: int = resolve_any(name, &a);
        if (fam != 0 && (want == 0 || want == fam)) {
            sa_set(sa, fam, a, null, port);
            return fam;
        }
        if (want != 0) { return 0; }
    }
    if (_hosts6(name, &o[0]) || (_name_is("localhost", 9, name) && inet_pton6("::1", &o[0]))) {
        sockaddr6_set(sa, &o[0], port);
        return AF_INET6;
    }
    var srv: sockaddr_in6;
    dns_server_sa(&srv);
    if (dns_lookup6(name, &srv, &o[0], 1) > 0) {
        sockaddr6_set(sa, &o[0], port);
        return AF_INET6;
    }
    return 0;
}

// Where a "[user@]host:path" target's host ends: the colon before the
// path (an IPv6 host is in brackets), or -1 if it names no remote path.
fn remote_colon(s: *char) -> int {
    var k: int = 0;
    var at: int = 0;
    while (s[k] != 0 && s[k] != '/') {
        if (s[k] == '@' && at == 0) { at = k + 1; }
        if (s[k] == '[' && k == at) {
            while (s[k] != 0 && s[k] != ']') { k += 1; }
            if (s[k] == 0) { return -1; }
        } else if (s[k] == ':') {
            return k;
        }
        k += 1;
    }
    return -1;
}
