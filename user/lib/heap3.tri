// heap3: a 3-ary min-heap of (key, value) pairs (docs/TERNARY_WORLD.md §8).
//
// Node i has children 3i+1, 3i+2, 3i+3 and parent (i-1)/3, so the tree is
// log3(n) deep instead of log2(n): fewer levels to sift through, at two
// compares a level on the way down. The compares are three-way (`<=>` and
// `sign`), one CMP and one BR3 each. Equal keys come out in no set order.

import "tlibc.tri";
import "stdlib.tri";

struct heap3 {
    keys: *int;
    vals: *int;
    n: int;
    cap: int;
}

fn h3_init(h: *heap3) {
    h.keys = null;
    h.vals = null;
    h.n = 0;
    h.cap = 0;
}

fn h3_free(h: *heap3) {
    if (h.keys != null) { free(h.keys as *tryte); free(h.vals as *tryte); }
    h3_init(h);
}

fn h3_size(h: *heap3) -> int { return h.n; }

fn h3_swap(h: *heap3, a: int, b: int) {
    var k: int = h.keys[a];
    var v: int = h.vals[a];
    h.keys[a] = h.keys[b];
    h.vals[a] = h.vals[b];
    h.keys[b] = k;
    h.vals[b] = v;
}

// Add a pair; 0 if out of memory.
fn h3_push(h: *heap3, key: int, val: int) -> int {
    if (h.n == h.cap) {
        var cap: int = h.cap == 0 ? 27 : h.cap * 3;
        var k: *int = malloc(cap * sizeof(int)) as *int;
        var v: *int = malloc(cap * sizeof(int)) as *int;
        if (k == null || v == null) { return 0; }
        var j: int = 0;
        while (j < h.n) { k[j] = h.keys[j]; v[j] = h.vals[j]; j += 1; }
        if (h.keys != null) { free(h.keys as *tryte); free(h.vals as *tryte); }
        h.keys = k;
        h.vals = v;
        h.cap = cap;
    }
    var i: int = h.n;
    h.keys[i] = key;
    h.vals[i] = val;
    h.n += 1;
    // sift up while smaller than the parent
    while (i > 0) {
        var p: int = (i - 1) / 3;
        var up: int = 0;
        sign (h.keys[i] <=> h.keys[p]) {
            neg: { up = 1; }
            zero: { }
            pos: { }
        }
        if (!up) { break; }
        h3_swap(h, i, p);
        i = p;
    }
    return 1;
}

// The smallest pair, left in place; 0 if empty.
fn h3_peek(h: *heap3, key: *int, val: *int) -> int {
    if (h.n == 0) { return 0; }
    *key = h.keys[0];
    *val = h.vals[0];
    return 1;
}

// Take the smallest pair out; 0 if empty.
fn h3_pop(h: *heap3, key: *int, val: *int) -> int {
    if (h.n == 0) { return 0; }
    *key = h.keys[0];
    *val = h.vals[0];
    h.n -= 1;
    if (h.n == 0) { return 1; }
    h.keys[0] = h.keys[h.n];
    h.vals[0] = h.vals[h.n];
    // sift down: to the smallest of up to three children while it is smaller
    var i: int = 0;
    loop {
        var best: int = i;
        var c: int = 3 * i + 1;
        var last: int = c + 3;
        while (c < last && c < h.n) {
            sign (h.keys[c] <=> h.keys[best]) {
                neg: { best = c; }
                zero: { }
                pos: { }
            }
            c += 1;
        }
        if (best == i) { break; }
        h3_swap(h, i, best);
        i = best;
    }
    return 1;
}

// Whether every node is no larger than its children (for tests).
fn h3_valid(h: *heap3) -> int {
    var i: int = 1;
    while (i < h.n) {
        if (h.keys[i] < h.keys[(i - 1) / 3]) { return 0; }
        i += 1;
    }
    return 1;
}
